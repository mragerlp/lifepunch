# Nested DXRP fork clone (separate git root — not part of monorepo index)
/lifepunchdxrp/

# Blue dev transfer package (binaries generated on VENGEANCE — run Package-BlueDevServerFromVengeance.ps1)
lifepunch/server/blue-dev-package/*.dll
lifepunch/server/blue-dev-package/*.exe
lifepunch/server/blue-dev-package/*.runtimeconfig.json
lifepunch/server/blue-dev-package/dxrp-server.cs

.dxrp-publish/
**/.dxrp-publish/
upload-assets/
upload-code/
**/upload-assets/
**/upload-code/
**/.sbox/

# Build and editor noise
bin/
obj/
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local s&box scratch/test project (not shipped)
lifepunchaddons/test/

# Third-party bitcoin mining study archives — never commit (LifePunch ships original assets only)
reference/**/third-party-bitcoin-mining-study/

# Local machine-specific remote host overrides (LAN IPs)
lifepunch/scripts/remote-hosts.local.json
lifepunch/scripts/server-host-watch.local.json
lifepunch/scripts/dxrp-editor.local.json
lifepunch/scripts/dxrp-vanilla-editor.local.json
lifepunch/scripts/modeldoc-studio.local.json
lifepunch/scripts/.session-sync-state.json

# Stopgap junction lifepunch/addons -> lifepunchaddons (removed when the
# Sync-LifePunchAddonsToDxrp path fix lands — task_cfead1e7). Never commit it.
/lifepunch/addons/

# Third-party study clones (local only — never commit)
.study-drawio/

# VENGEANCE desk PTT local runtime
lifepunch/scripts/vengeance-ptt/.venv/
lifepunch/scripts/vengeance-ptt/__pycache__/
lifepunch/scripts/vengeance-ptt/outbox/*
!lifepunch/scripts/vengeance-ptt/outbox/.gitkeep

# Local sensitive information
lifepunch/secure/*
!lifepunch/secure/.gitignore
!lifepunch/secure/README.md
!lifepunch/secure/templates/
!lifepunch/secure/templates/**
**/vengeance-smb.password

# OS files
Thumbs.db
desktop.ini

# Fab Blender sources — often >100MB; canonical mesh intake is FBX/OBJ under assets/source/.
# Keep .blend on Desktop/OneDrive UPLOAD READY ADDONS; repo tracks FBX + textures only.
**/assets/source/blend/*.blend
