   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Player Hub for DXRP" (s&box ident: lifepunch.playerhub · addon ident: playerhub)

   SLICE 2 — Factions-menu grammar shell + Overview tab body (owner reference 2026-07-18).
   Sidebar: brand head, filled accent nav pill, identity footer. Content: small-caps top
   strip, rounded cards, XP track, play-earn routes. Fixture-backed and display-only.
   No spend path exists in this slice.
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.PlayerHub
@using System
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@RootClass()">
	<div class="hub-shell">
		<div class="hub-body">

			@* ── SIDEBAR — Factions grammar: brand + close on top, nav pills, identity footer. *@
			<div class="hub-sidebar">
				<div class="hub-side-head">
					<div class="hub-brand">PLAYER HUB</div>
					<button class="hub-close" tooltip="Close" onclick="@Close">
						<i class="material-icons">close</i>
					</button>
				</div>

				<div class="hub-nav">
					@foreach ( var tab in Tabs )
					{
						<button class="@NavClass( tab )" onclick="@( () => SetTab( tab ) )">
							<div class="hub-nav-indicator"></div>
							<i class="material-icons hub-nav-icon">@LpPlayerHubTabInfo.Icon( tab )</i>
							<span class="hub-nav-label">@LpPlayerHubTabInfo.Label( tab )</span>
							@if ( BadgeFor( tab ) > 0 )
							{
								<span class="hub-nav-badge">@BadgeFor( tab )</span>
							}
						</button>
					}
				</div>

				<div class="hub-side-spacer"></div>

				<div class="hub-identity">
					<div class="hub-avatar"><i class="material-icons">person</i></div>
					<div class="hub-identity-copy">
						<div class="hub-player-name">@Vm.PlayerName</div>
						<div class="hub-player-rank">@Vm.RankLabel</div>
					</div>
				</div>
			</div>

			@* ── MAIN — small-caps top strip, then the tab body. *@
			<div class="hub-content">
				<div class="hub-topstrip">
					<div class="hub-topstrip-title">@LpPlayerHubTabInfo.Eyebrow( ActiveTab )</div>
					<div class="hub-topstrip-right">
						@if ( Vm.IsFixture )
						{
							<div class="hub-preview-tag" tooltip="@PreviewTooltip">PREVIEW &#183; FIXTURE DATA</div>
						}
						<div class="hub-stat">
							<span class="hub-stat-label">LEVEL</span>
							<span class="hub-stat-value">@Vm.Level</span>
						</div>
						<div class="hub-stat" tooltip="@LpTooltip">
							<span class="lp-mark hub-lp-mark">$LP</span>
							<span class="hub-stat-value">@LpAmount</span>
						</div>
					</div>
				</div>

				<div class="hub-tabhost">
					@if ( ActiveTab == LpPlayerHubTab.Overview )
					{
						var ov = LpPlayerHubFixture.Overview();
						<div class="hub-tab-body">
							<div class="hub-card-row">
								<div class="hub-card hub-progress-card">
									<div class="hub-card-label">PROGRESSION</div>
									<div class="hub-card-hero">Level @ov.Level</div>
									<div class="hub-xp-track">
										<div class="hub-xp-fill" style="width: @XpPercent( ov )%"></div>
									</div>
									<div class="hub-card-sub">@ov.XpIntoLevel.ToString( "N0" ) / @ov.XpForNextLevel.ToString( "N0" ) XP &#183; @XpRemaining( ov ) to next level</div>
								</div>
								<div class="hub-card">
									<div class="hub-card-label">BALANCE</div>
									<div class="hub-card-hero"><span class="lp-mark hub-lp-mark">$LP</span> <span class="hub-card-hero-amt">@ov.LpBalance.ToString( "N0" )</span></div>
									<div class="hub-card-sub">Earned through play &#183; $LP is a temporary label</div>
									<button class="hub-cta" onclick="@( () => SetTab( LpPlayerHubTab.Store ) )">Open $LP Store</button>
								</div>
								<div class="hub-card">
									<div class="hub-card-label">SKILL POINTS</div>
									<div class="hub-card-hero">@ov.SkillPointsAvailable available</div>
									<div class="hub-card-sub">@ov.SkillsUnlocked skills unlocked so far</div>
									<button class="hub-cta" onclick="@( () => SetTab( LpPlayerHubTab.Skills ) )">Spend points</button>
								</div>
							</div>

							<div class="hub-card hub-earn-card">
								<div class="hub-card-label">HOW TO EARN</div>
								@foreach ( var route in ov.EarnRoutes )
								{
									<div class="hub-earn-row">
										<div class="hub-earn-title">@route.Title</div>
										<div class="hub-earn-body">@route.Body</div>
									</div>
								}
							</div>
						</div>
					}
					else
					{
						<div class="hub-placeholder">
							<i class="material-icons hub-placeholder-icon">@LpPlayerHubTabInfo.Icon( ActiveTab )</i>
							<div class="hub-placeholder-title">@PlaceholderTitle</div>
							<div class="hub-placeholder-body">@PlaceholderBody</div>
						</div>
					}
				</div>
			</div>

		</div>
		<LifePunchUiFooter Product="Player Hub" />
	</div>
</root>

@code
{
	// SLICE 1 SENSOR -- positive code-string ID. This literal exists nowhere else in the tree,
	// so seeing it in the editor log proves the compiler read THESE bytes, not a stale copy.
	public const string SliceMark = "LP_PLAYERHUB_SLICE2_OVERVIEW_20260718";

	private static readonly LpPlayerHubTab[] Tabs = new[]
	{
		LpPlayerHubTab.Overview,
		LpPlayerHubTab.Skills,
		LpPlayerHubTab.Store,
		LpPlayerHubTab.Stats,
	};

	// THERE IS NO _open FLAG, AND THAT IS THE FIX.
	//
	// Slice 1 carried `private bool _open = true` as an in-component visibility flag. Nothing ever set it
	// back to true, so the hub could never reopen -- and nothing created the panel in the first place, so
	// it never opened at all. BOTH DEFECTS WERE THE SAME MISSING PIECE: a mount host.
	//
	// LpPlayerHubHost now CREATES this component on open and DESTROYS it on close (the StaffMenuHost
	// pattern). Re-openability is therefore BY CONSTRUCTION: every open builds a fresh component with
	// fresh state. A flag you must remember to reset is a flag someone will forget to reset -- so the
	// flag is gone, not fixed.
	private LpPlayerHubTab _activeTab = LpPlayerHubTab.Overview;

	private LpPlayerHubTab ActiveTab => _activeTab;

	/// <summary>Slice 1 reads the fixture. Slice 8 swaps this for a live projection.</summary>
	private LpPlayerHubShellVm Vm => LpPlayerHubFixture.Shell( _activeTab );

	private const string PreviewTooltip =
		"Slice 1 shell. Every value shown is fixture data, not live player state.";

	// LAW 17 / currency identity: the $LP SIGN carries the colour, the AMOUNT stays white.
	// The word TEMPORARY is load-bearing and must stay in the USER-VISIBLE string: the
	// lifepunch-design-tokens skill requires $LP to be "labelled temporary in UI copy", and a
	// comment saying so does not label anything a player can see. (cursor\0023 caught this: the
	// code said "labelled temporary" while the tooltip said neither.)
	private const string LpTooltip =
		"$LP is TEMPORARY placeholder currency. Its final sign and colour are pending ruling.";

	private string LpAmount => Vm.LpBalance.ToString( "N0" );

	private string PlaceholderTitle => LpPlayerHubTabInfo.Label( _activeTab ) + " lands in a later slice";

	// Overview XP bar math — display only, from the fixture VM.
	private static int XpPercent( LpOverviewVm ov )
		=> ov.XpForNextLevel <= 0 ? 0 : (int)Math.Clamp( 100f * ov.XpIntoLevel / ov.XpForNextLevel, 0f, 100f );

	private static string XpRemaining( LpOverviewVm ov )
		=> Math.Max( 0, ov.XpForNextLevel - ov.XpIntoLevel ).ToString( "N0" ) + " XP";

	private const string PlaceholderBody =
		"Slice 1 ships the shell only: header, navigation and this empty content region.";

	// A live instance is, by definition, an open one -- the host destroys it to close it. `is-open`
	// carries the visible/clickable state in SCSS, so it is unconditional here.
	private string RootClass() => "lp-playerhub is-open";

	private string NavClass( LpPlayerHubTab tab )
	{
		var active = tab == _activeTab ? " is-active" : string.Empty;
		return "hub-nav-item" + active;
	}

	private int BadgeFor( LpPlayerHubTab tab )
	{
		return tab == LpPlayerHubTab.Skills ? Vm.SkillsBadgeCount : 0;
	}

	private void SetTab( LpPlayerHubTab tab )
	{
		if ( _activeTab == tab )
			return;

		_activeTab = tab;
		StateHasChanged();
	}

	/// <summary>
	/// Closing is the HOST's job -- it tears the component down. The panel does not hide itself, because a
	/// panel that hides itself is still mounted, still eating input, and still unable to be reopened by
	/// anything that does not know it exists. That was the Slice 1 bug.
	/// </summary>
	private void Close() => LpPlayerHubHost.RequestClose();

	// F2 FIX (opencode\0004, dispatch\opencode\0002 D1): the hub was INVISIBLE to
	// LifePunchMenuInputBlock -- combat/use suppression never armed for the hub alone, and
	// closing the bitcoin panel under an open hub dropped the camera lock (the block's depth
	// hit 0 with the hub still up, so ReleasePlayerCombatLock fired). Registering the hub
	// keeps depth > 0 while it lives; the per-frame guard then reasserts Player.LockCamera,
	// which makes the previously ACCIDENTAL hub-close survival deliberate in both directions.
	//
	// MINIMAL BY RULING: this is registration with the EXISTING input-block writer, not a
	// sixth LockCamera writer. The refcount/stack arbiter over LockCamera's five writers is
	// an OPEN RULING (comms STATUS.json, LockCamera item) -- do not build it here.
	protected override void OnEnabled()
	{
		LifePunchMenuInputBlock.NotifyMenuOpened();
	}

	protected override void OnDisabled()
	{
		LifePunchMenuInputBlock.NotifyMenuClosed();
	}

	/// <summary>
	/// Every private flag that changes markup is hashed. Today that is `_activeTab` alone -- it drives the
	/// nav selection, the page head and the tab host.
	/// </summary>
	/// <remarks>
	/// THIS HASH MUST GROW WITH THE PANEL. The moment a slice adds tab-local state (a selected node, a
	/// filter chip, a confirm-open flag) or `Vm` becomes live rather than a pure function of `_activeTab`
	/// over a static fixture, that state goes in here IN THE SAME COMMIT. Omitting it does not error --
	/// the panel simply stops re-rendering, and a frozen readout is invisible until someone notices a
	/// number that never moves.
	/// </remarks>
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( (int)_activeTab );
		return hash.ToHashCode();
	}
}
