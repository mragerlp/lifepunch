@namespace LifePunch.DXRP.Addons.PlayerHub
@using System
@using Sandbox
@using Sandbox.UI
@inherits Panel

@attribute [StyleSheet]

<root class="lp-playerhub-stats">
	@if ( Model is not LpStatsVm model )
	{
		<LpPlayerHubError Model="@InvalidStatsState" />
	}
	else if ( IsEmpty( model ) )
	{
		<LpPlayerHubEmpty Model="@EmptyStatsState" />
	}
	else
	{
		<div class="stats-plate-row">
			@foreach ( var plate in model.HeroPlates )
			{
				<div class="stats-plate lp-hub-panel">
					<i class="material-icons stats-plate-icon">@plate.Icon</i>
					<div class="stats-plate-copy">
						<div class="stats-plate-label">@plate.Label</div>
						<div class="stats-plate-value">@plate.Value</div>
						<div class="stats-plate-hint">@plate.Hint</div>
					</div>
				</div>
			}
		</div>

		<div class="stats-workspace">
			<div class="stats-section stats-identity lp-hub-panel">
				<div class="stats-section-head lp-hub-bar">
					<div class="stats-section-title">PLAYER IDENTITY</div>
					<div class="stats-section-note">Fixture profile</div>
				</div>

				<div class="stats-identity-hero">
					<div class="stats-level-block">
						<div class="stats-level-label">LEVEL</div>
						<div class="stats-level-value">@model.Identity.Level</div>
						<div class="stats-level-hint">Fixture level</div>
					</div>

					<div class="stats-identity-copy">
						<div class="stats-identity-label">PLAYTIME TITLE</div>
						<div class="stats-identity-title">@model.Identity.PlaytimeTitle</div>
						<div class="stats-identity-hint">@model.Identity.TitleHint</div>

						<div class="stats-status-row">
							<i class="material-icons stats-status-icon">verified_user</i>
							<div class="stats-status-copy">
								<div class="stats-status-label">@model.Identity.StatusLabel</div>
								<div class="stats-identity-hint">@model.Identity.StatusHint</div>
							</div>
						</div>
					</div>
				</div>

				<div class="stats-track-head">
					<div class="stats-identity-label">TRACK PROGRESSION</div>
					<div class="stats-section-note">Fixture ranks</div>
				</div>

				<div class="stats-track-list">
					@foreach ( var track in model.Identity.Tracks )
					{
						<div class="stats-track-row">
							<div class="stats-track-copy">
								<div class="stats-track-label">@track.Label</div>
								<div class="stats-track-value">@(track.RanksPurchased + " / " + track.TotalRanks)</div>
							</div>
							<div class="stats-track-meter">
								<div class="@TrackFillClass( track )"></div>
							</div>
						</div>
					}
				</div>

				<div class="stats-identity-footnote">
					Fixture identity mirror. Portal titles and live progression remain gated.
				</div>
			</div>

			<div class="stats-right-column">
				<div class="stats-section stats-highlights lp-hub-panel">
					<div class="stats-section-head lp-hub-bar">
						<div class="stats-section-title">HIGHLIGHTS</div>
						<div class="stats-section-note">No rankings</div>
					</div>
					<div class="stats-highlight-list">
						@foreach ( var highlight in model.Highlights )
						{
							<div class="stats-highlight-row lp-hub-chip-row">
								<div class="stats-highlight-copy">
									<div class="stats-highlight-label">@highlight.Label</div>
									<div class="stats-highlight-hint">@highlight.Hint</div>
								</div>
								<div class="stats-highlight-value">@highlight.Value</div>
							</div>
						}
					</div>
				</div>

				<div class="stats-section stats-breakdown lp-hub-panel">
					<div class="stats-section-head lp-hub-bar">
						<div class="stats-section-title">SYSTEM BREAKDOWN</div>
						<div class="stats-section-note">Unknown values stay --</div>
					</div>
					<div class="stats-section-row">
						@foreach ( var section in model.Sections )
						{
							<div class="stats-table">
								<div class="stats-table-title">@section.Title</div>
								@foreach ( var row in section.Rows )
								{
									<div class="stats-table-row">
										<div class="stats-table-copy">
											<div class="stats-table-label">@row.Label</div>
											<div class="stats-table-hint">@row.Hint</div>
										</div>
										<div class="stats-table-value">@row.Value</div>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Property] public LpStatsVm Model { get; set; } = null!;

	private static readonly LpHubStateVm InvalidStatsState = new(
		Icon: "error_outline",
		Title: "Stats unavailable",
		Message: "The read-only stats projection did not receive a valid model.",
		ActionLabel: string.Empty,
		ShowAction: false,
		OnSelected: null);

	private static readonly LpHubStateVm EmptyStatsState = new(
		Icon: "query_stats",
		Title: "No stats to show",
		Message: "This fixture-backed stats projection has no rows.",
		ActionLabel: string.Empty,
		ShowAction: false,
		OnSelected: null);

	private static bool IsEmpty( LpStatsVm model )
	{
		return model.HeroPlates.Count == 0
			&& model.Identity.Tracks.Count == 0
			&& model.Highlights.Count == 0
			&& model.Sections.Count == 0;
	}

	private static string TrackFillClass( LpStatsTrackProgressVm track )
	{
		if ( track.TotalRanks <= 0 || track.RanksPurchased <= 0 )
			return "stats-track-fill fill-0";

		var percent = track.RanksPurchased * 100 / track.TotalRanks;
		if ( percent >= 100 ) return "stats-track-fill fill-100";
		if ( percent >= 80 ) return "stats-track-fill fill-80";
		if ( percent >= 60 ) return "stats-track-fill fill-60";
		if ( percent >= 40 ) return "stats-track-fill fill-40";
		if ( percent >= 20 ) return "stats-track-fill fill-20";
		if ( percent >= 8 ) return "stats-track-fill fill-08";
		return "stats-track-fill fill-04";
	}

	protected override int BuildHash()
	{
		if ( Model is not LpStatsVm model )
			return -1;

		var hash = new HashCode();
		hash.Add( model.IsFixture );
		hash.Add( model.Identity.Level );
		hash.Add( model.Identity.PlaytimeTitle );
		hash.Add( model.Identity.TitleHint );
		hash.Add( model.Identity.StatusLabel );
		hash.Add( model.Identity.StatusHint );

		foreach ( var plate in model.HeroPlates )
		{
			hash.Add( plate.Icon );
			hash.Add( plate.Label );
			hash.Add( plate.Value );
			hash.Add( plate.Hint );
		}

		foreach ( var track in model.Identity.Tracks )
		{
			hash.Add( track.Id );
			hash.Add( track.Label );
			hash.Add( track.RanksPurchased );
			hash.Add( track.TotalRanks );
		}

		foreach ( var highlight in model.Highlights )
		{
			hash.Add( highlight.Label );
			hash.Add( highlight.Value );
			hash.Add( highlight.Hint );
		}

		foreach ( var section in model.Sections )
		{
			hash.Add( section.Title );
			foreach ( var row in section.Rows )
			{
				hash.Add( row.Label );
				hash.Add( row.Value );
				hash.Add( row.Hint );
			}
		}

		return hash.ToHashCode();
	}
}
