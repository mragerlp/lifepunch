@namespace LifePunch.DXRP.Addons.HackerJob
@using LifePunch.DXRP.Addons
@using LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="hacker-terminal lp-cyber-terminal @TierClass">
    <div class="ops-backdrop" onclick=@OnClickClose></div>
    <div class="cyber-window">
        <header class="cyber-header">
            <span class="cyber-brand">@ScreenBrandTitle()</span>
            <div class="cyber-status-row">
                <span>STATUS: @StatusConnectedLabel()</span>
                <span>IP: @_fakeIp</span>
                <span>SECURITY: LEVEL @SecurityLevel()</span>
            </div>
            @if ( _screen != LifePunchCyberScreen.Home )
            {
                <button class="cyber-menu-btn" onclick=@GoHome>MAIN MENU</button>
            }
            <button class="cyber-close-btn" onclick=@OnClickClose>CLOSE</button>
        </header>

        <div class="cyber-body">
            @if ( _screen == LifePunchCyberScreen.Home )
            {
                <div class="cyber-home">
                    <div class="cyber-welcome">
                        <div class="cyber-welcome-title">@LifePunchCyberTerminalTheme.WelcomeLine( CyberBrandDisplay() )</div>
                        <div class="cyber-welcome-sub">@LifePunchCyberTerminalTheme.BootSubtitle( ProgramLabel )</div>
                    </div>
                    <div class="cyber-module-grid">
                        @foreach ( var card in HackerTerminalBrand.HomeModules( Tier ) )
                        {
                            <button class="cyber-module-card" onclick=@(() => EnterScreen( card.Screen ))>
                                <span class="card-title">@card.Title</span>
                                <span class="card-desc">@card.Description</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else if ( _screen == LifePunchCyberScreen.Terminal )
            {
                <div class="cyber-terminal-screen">
                    <div class="cyber-terminal-bar">@PromptLabel</div>
                    <div class="cyber-terminal-log" onclick=@FocusInput>
                        <div class="cyber-line ok">@LifePunchCyberTerminalTheme.WelcomeLine( CyberBrandDisplay() ) v0.2</div>
                        <div class="cyber-line dim">Type "help" for available commands.</div>
                        @foreach ( var line in _lines )
                        {
                            <div class="cyber-line @GetLineClass(line)">@line</div>
                        }
                    </div>
                    <div class="cyber-input-row" onclick=@FocusInput>
                        <span class="cyber-prompt">@PromptLabel</span>
                        <TextEntry class="cyber-input" @ref="InputBox" onsubmit=@OnSubmit />
                    </div>
                </div>
            }
            else if ( _screen == LifePunchCyberScreen.Network )
            {
                <div class="cyber-screen">
                    <div class="cyber-panel cyber-panel-fill">
                        <div class="cyber-panel-title">@( Tier == HackerTerminalTier.Advanced ? "NETWORK + GOVDB PROBE" : "WALLET ENDPOINT SCAN" )</div>
                        <div class="cyber-scroll">
                            @if ( _scanResults.Count == 0 && ( Tier != HackerTerminalTier.Advanced || ( _govdbResults.Count == 0 && _hashdResults.Count == 0 ) ) )
                            {
                                <div class="cyber-line dim">No targets — RUN SCAN or type <span class="cyber-line ok">scan</span></div>
                            }
                            @if ( _scanResults.Count > 0 )
                            {
                                <div class="cyber-line ok">WALLET ENDPOINTS (@_scanResults.Count)</div>
                                @foreach ( var target in _scanResults )
                                {
                                    <div class="cyber-data-row @(_selectedTargetId == target.SteamId ? "selected" : "")"
                                         onclick=@(() => SelectWalletTarget(target))>
                                        <span class="cyber-col-id">@target.SteamId</span>
                                        <span class="cyber-col-name">@target.DisplayName</span>
                                        <span class="cyber-col-value">$@target.WalletCash</span>
                                    </div>
                                }
                            }
                            @if ( Tier == HackerTerminalTier.Advanced && _hashdResults.Count > 0 )
                            {
                                <div class="cyber-line ok cyber-section-gap">HASHD MINERS (@_hashdResults.Count)</div>
                                @foreach ( var hub in _hashdResults )
                                {
                                    <div class="cyber-data-row @(_selectedHashdId == hub.ScanId ? "selected" : "")"
                                         onclick=@(() => SelectHashdTarget(hub))>
                                        <span class="cyber-col-id">@hub.ScanId</span>
                                        <span class="cyber-col-name">@hub.Label · @hub.DistanceMeters.ToString("F0")m</span>
                                        <span class="cyber-col-value warn">@hub.HubWalletBtc.ToString("F4") BTC</span>
                                    </div>
                                }
                            }
                            @if ( Tier == HackerTerminalTier.Advanced && _govdbResults.Count > 0 )
                            {
                                <div class="cyber-line ok cyber-section-gap">GOVDB NODES (@_govdbResults.Count)</div>
                                @foreach ( var node in _govdbResults )
                                {
                                    <div class="cyber-data-row @(_selectedGovNodeId == node.NodeId ? "selected" : "")"
                                         onclick=@(() => SelectGovNode(node))>
                                        <span class="cyber-col-id">@node.NodeId</span>
                                        <span class="cyber-col-name">@node.Label</span>
                                        <span class="cyber-col-value warn">[@node.SecurityTier]</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="cyber-action-row">
                            <button class="cyber-action-btn" onclick=@RunScanFromUi>RUN SCAN</button>
                            @if ( Tier == HackerTerminalTier.Advanced )
                            {
                                <button class="cyber-action-btn" onclick=@RunGovdbFromUi>RUN GOVDB</button>
                            }
                            @if ( !string.IsNullOrEmpty( _selectedTargetId ) )
                            {
                                <button class="cyber-action-btn" onclick=@StartHackFromUi>START HACK</button>
                            }
                            @if ( !string.IsNullOrEmpty( _selectedHashdId ) )
                            {
                                <button class="cyber-action-btn" onclick=@StartHashdHackFromUi>START HASHD HACK</button>
                            }
                            @if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
                            {
                                <button class="cyber-action-btn" onclick=@StartInfilFromUi>START INFIL</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else if ( _screen == LifePunchCyberScreen.Decrypt )
            {
                <div class="cyber-screen">
                    <div class="cyber-panel" style="flex: 1;">
                        <div class="cyber-panel-title">PASSWORD BYPASS / CRACK</div>
                        <div class="cyber-scroll">
                            @if ( _puzzle == null )
                            {
                                <div class="cyber-decrypt-stack">
                                    <div class="cyber-line dim">Password cracker initialized. Run NETWORK scan, select a target, then START HACK or START INFIL.</div>
                                </div>
                            }
                            else if ( _puzzle.IsExpired )
                            {
                                <div class="cyber-decrypt-stack">
                                    <div class="cyber-line warn">Puzzle window expired — trace risk increased.</div>
                                </div>
                            }
                            else
                            {
                                <div class="cyber-decrypt-stack">
                                    <div class="cyber-line warn">@GetTargetBanner()</div>
                                    <div class="cyber-line">@_puzzle.Prompt</div>
                                    <div class="cyber-line dim">Type answer at TERMINAL prompt — @MathF.Ceiling(_puzzle.SecondsRemaining)s remaining</div>
                                </div>
                            }
                        </div>
                        <div class="cyber-decrypt-actions">
                            <button class="cyber-action-btn" onclick=@(() => EnterScreen( LifePunchCyberScreen.Terminal ))>OPEN TERMINAL</button>
                        </div>
                    </div>
                </div>
            }
            else if ( _screen == LifePunchCyberScreen.Dashboard )
            {
                <div class="cyber-screen">
                    <div class="cyber-dash-grid">
                        <div class="cyber-dash-cell cyber-panel">
                            <div class="cyber-panel-title">SESSION STATUS</div>
                            <div class="cyber-stat-row">
                                <div class="cyber-stat">
                                    <div class="stat-label">LINK</div>
                                    <div class="stat-value">@(Terminal.IsValid() ? "STABLE" : "LOST")</div>
                                </div>
                                <div class="cyber-stat">
                                    <div class="stat-label">RACK PWR</div>
                                    <div class="stat-value">@(Terminal.IsValid() && Terminal.IsPowered ? "ONLINE" : "OFFLINE")</div>
                                </div>
                                <div class="cyber-stat">
                                    <div class="stat-label">WALLETS</div>
                                    <div class="stat-value">@_scanResults.Count</div>
                                </div>
                                <div class="cyber-stat">
                                    <div class="stat-label">ACTIVE OP</div>
                                    <div class="stat-value">@ActiveOpLabel</div>
                                </div>
                            </div>
                        </div>
                        <div class="cyber-dash-cell cyber-panel">
                            <div class="cyber-panel-title">QUICK ACCESS</div>
                            <div class="cyber-quick-grid">
                                <button class="cyber-quick-btn" onclick=@(() => EnterScreen( LifePunchCyberScreen.Terminal ))>TERMINAL</button>
                                <button class="cyber-quick-btn" onclick=@(() => EnterScreen( LifePunchCyberScreen.Network ))>NETWORK</button>
                                <button class="cyber-quick-btn" onclick=@(() => EnterScreen( LifePunchCyberScreen.Decrypt ))>DECRYPT</button>
                                <button class="cyber-quick-btn" onclick=@GoHome>HOME</button>
                            </div>
                        </div>
                        <div class="cyber-dash-cell cyber-panel cyber-panel-wide">
                            <div class="cyber-panel-title">ACTIVITY LOG</div>
                            <div class="cyber-scroll">
                                @foreach ( var line in _lines.TakeLast( 12 ) )
                                {
                                    <div class="cyber-line @GetLineClass(line)">@line</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="cyber-footer-log">
            @foreach ( var line in _footerLog )
            {
                <div class="cyber-footer-line">@line</div>
            }
        </div>

        <LifePunchUiFooter />
    </div>
</root>

@code {
    private enum OpsModule { Log, Scan, Govdb, Target, Help }

    public HackerTerminalEntity Terminal { get; set; }

    private TextEntry InputBox { get; set; }
    private readonly List<string> _lines = new();
    private readonly List<string> _footerLog = new();
    private const int MaxLines = 64;
    private int _lastTextLength = 0;
    private TimeSince _sinceSecondly = 0f;
    private OpsModule _activeModule = OpsModule.Log;
    private LifePunchCyberScreen _screen = LifePunchCyberScreen.Home;
    private string _fakeIp = "192.168.1.1";

    private IReadOnlyList<HackerScanService.ScanTarget> _scanResults = Array.Empty<HackerScanService.ScanTarget>();
    private IReadOnlyList<HackerScanService.GovDbTarget> _govdbResults = Array.Empty<HackerScanService.GovDbTarget>();
    private IReadOnlyList<HackerScanService.HashdTarget> _hashdResults = Array.Empty<HackerScanService.HashdTarget>();
    private string _selectedTargetId;
    private string _selectedGovNodeId;
    private string _selectedHashdId;
    private HackerPuzzleSession _puzzle;

    private HackerTerminalTier Tier =>
        Terminal.IsValid() && Terminal.IsAdvanced
            ? HackerTerminalTier.Advanced
            : HackerTerminalTier.Standard;

    private string TierClass => HackerTerminalBrand.CssTierClass( Tier );
    private string OpsTitle => HackerTerminalBrand.OpsConsoleTitle( Tier );
    private string OpsMark => HackerTerminalBrand.OpsConsoleMark( Tier );
    private string ProgramLabel => HackerTerminalBrand.ProgramName( Tier );
    private string PromptLabel => HackerTerminalBrand.PromptLabel( Tier );
    private string TierBadge => Tier == HackerTerminalTier.Advanced ? "VENGEANCE OPS" : "CORNERMAN OPS";
    private bool HasActiveOp => _puzzle != null && !_puzzle.IsExpired;
    private string ActiveOpLabel => HasActiveOp ? (_selectedGovNodeId ?? _selectedHashdId ?? _selectedTargetId ?? "active") : "none";

    private string CyberBrandDisplay() => HackerTerminalBrand.CyberBrandDisplay( Tier );

    private string ScreenBrandTitle() =>
        LifePunchCyberTerminalTheme.ScreenTitle( HackerTerminalBrand.CyberBrandSlug( Tier ), _screen );

    private string StatusConnectedLabel()
    {
        if ( !Terminal.IsValid() )
            return "LOST";

        return Terminal.IsPowered ? "CONNECTED" : "STANDBY";
    }

    private int SecurityLevel()
    {
        if ( Terminal.IsValid() && Terminal.ActiveRack.IsValid() )
            return Math.Max( 1, Terminal.ActiveRack.DetectionTier );

        return 1;
    }

    private void AppendFooterLog( string message )
    {
        var stamp = DateTime.Now.ToString( "h:mm:ss tt" ).ToLowerInvariant();
        _footerLog.Add( $"[{stamp}] {message}" );
        if ( _footerLog.Count > 24 )
            _footerLog.RemoveAt( 0 );
    }

    private void GoHome()
    {
        _screen = LifePunchCyberScreen.Home;
        AppendFooterLog( "Returned to main menu." );
    }

    private void EnterScreen( LifePunchCyberScreen screen )
    {
        _screen = screen;
        _activeModule = screen switch
        {
            LifePunchCyberScreen.Network => OpsModule.Scan,
            LifePunchCyberScreen.Decrypt => OpsModule.Target,
            LifePunchCyberScreen.Terminal => OpsModule.Log,
            _ => _activeModule
        };

        AppendFooterLog( screen switch
        {
            LifePunchCyberScreen.Terminal => "Terminal module loaded. Type help for commands.",
            LifePunchCyberScreen.Network => "Network module loaded. Run scan to probe targets.",
            LifePunchCyberScreen.Decrypt => "Decrypt module loaded. Select an operation to begin.",
            LifePunchCyberScreen.Dashboard => "Dashboard module loaded. System monitoring active.",
            _ => "Main menu ready."
        } );
    }

    private static string GetLineClass( string line )
    {
        if ( line.StartsWith( "cornerman@" ) || line.StartsWith( "vengeance@" ) )
            return "ok";
        if ( line.StartsWith( "---" ) )
            return "dim";
        if ( line.StartsWith( "  " ) )
            return "dim";
        if ( line.StartsWith( "ERROR" ) || line.StartsWith( "DENIED" ) )
            return "err";
        if ( line.StartsWith( "[ OK" ) || line.StartsWith( "BYPASS" ) )
            return "ok";
        if ( line.StartsWith( "WARNING" ) || line.StartsWith( "▶" ) )
            return "warn";
        return "";
    }

    private void TrimLines()
    {
        if ( _lines.Count > MaxLines )
            _lines.RemoveRange( 0, _lines.Count - MaxLines );
    }

    private float GetPuzzlePercent()
    {
        if ( _puzzle == null || _puzzle.TimeLimitSeconds <= 0f )
            return 0f;

        return Math.Clamp( _puzzle.SecondsRemaining / _puzzle.TimeLimitSeconds * 100f, 0f, 100f );
    }

    private string GetTargetBanner()
    {
        if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
            return $"INFILTRATING GOVDB NODE {_selectedGovNodeId}";

        if ( !string.IsNullOrEmpty( _selectedHashdId ) )
            return $"INFILTRATING HASHD NODE {_selectedHashdId}";

        if ( !string.IsNullOrEmpty( _selectedTargetId ) )
            return $"INFILTRATING WALLET {_selectedTargetId}";

        return "ACTIVE BYPASS";
    }

    public static bool Open( HackerTerminalEntity terminal )
    {
        var isDevStub = terminal.IsValid() && terminal.GameObject.Name.Contains( "DevStub" );
        if ( !isDevStub && terminal.IsValid() && !terminal.IsPowered )
        {
            Log.Info( "[cornerman] Terminal offline — power ON the Server Rack first." );
            return false;
        }

        var panel = HackerTerminalHost.Mount();
        if ( !panel.IsValid() )
            return false;

        panel.Terminal = terminal;
        panel.FocusInput();
        panel.Boot();

        var program = panel.Tier == HackerTerminalTier.Advanced ? "vengeance.exe" : "cornerman.exe";
        Log.Info( $"[{program}] logged in — type scan/hack at {HackerTerminalBrand.PromptLabel( panel.Tier )} in the ops console (not the developer console)." );
        return true;
    }

    public static void NotifyHackFailure( string alertLine )
    {
        var panel = Sandbox.Game.ActiveScene?.GetAllComponents<HackerTerminal>().FirstOrDefault();
        if ( !panel.IsValid() )
            return;

        panel._lines.Add( "WARNING: hack trace detected." );
        panel._lines.Add( alertLine );
        panel._activeModule = OpsModule.Log;
        panel._screen = LifePunchCyberScreen.Terminal;
        panel.TrimLines();
    }

    private float GetRackPuzzleSeconds()
    {
        if ( !Terminal.IsValid() )
            return HackerJob.DefaultPuzzleTimeLimitSeconds;

        var rack = Terminal.ActiveRack;
        return rack.IsValid()
            ? rack.PuzzleTimeLimitSeconds
            : HackerJob.DefaultPuzzleTimeLimitSeconds;
    }

    private void CloseTerminal() => HackerTerminalHost.Close( this );

    private void SwitchModule( OpsModule module )
    {
        if ( module == OpsModule.Govdb && Tier != HackerTerminalTier.Advanced )
            return;

        _activeModule = module;
        _screen = module switch
        {
            OpsModule.Scan => LifePunchCyberScreen.Network,
            OpsModule.Govdb => LifePunchCyberScreen.Network,
            OpsModule.Target => LifePunchCyberScreen.Decrypt,
            OpsModule.Help => LifePunchCyberScreen.Terminal,
            _ => LifePunchCyberScreen.Terminal
        };
    }

    private void Boot()
    {
        _lines.Clear();
        _footerLog.Clear();
        _scanResults = Array.Empty<HackerScanService.ScanTarget>();
        _govdbResults = Array.Empty<HackerScanService.GovDbTarget>();
        _hashdResults = Array.Empty<HackerScanService.HashdTarget>();
        _selectedTargetId = null;
        _selectedGovNodeId = null;
        _selectedHashdId = null;
        _puzzle = null;
        _activeModule = OpsModule.Log;
        _screen = LifePunchCyberScreen.Home;

        _fakeIp = LifePunchCyberTerminalTheme.FictionOpsHostIp;

        if ( Tier == HackerTerminalTier.Advanced )
        {
            _lines.Add( "LIFEPUNCH vengeance.exe v0.2 — ops console" );
            _lines.Add( "[ OK ] crt framebuffer 960x640" );
            _lines.Add( "[ OK ] enhanced intrusion toolkit" );
            _lines.Add( "[ OK ] govdb route table mounted" );
            _lines.Add( $"starting {HackerJob.AdvancedProgramName} ..." );
            _lines.Add( "WARNING: unauthorized govdb access is a felony." );
        }
        else
        {
            _lines.Add( "LIFEPUNCH cornerman.exe v0.2 — ops console" );
            _lines.Add( "[ OK ] crt framebuffer 960x640" );
            _lines.Add( "[ OK ] packet sniffer loaded" );
            _lines.Add( "[ OK ] wallet probe module (read-only)" );
            _lines.Add( $"starting {HackerJob.InGameProgramName} ..." );
        }

        _lines.Add( LifePunchSourceMark.PublishedByLine );
        _lines.Add( LifePunchSourceMark.UiFooterLegal );

        if ( Terminal.IsValid() && Terminal.ActiveRack.IsValid() )
        {
            var rack = Terminal.ActiveRack;
            _lines.Add( $"[ OK ] server rack linked — power {( rack.IsPowered ? "ON" : "OFF" )}" );
            _lines.Add( $"[ OK ] puzzle TTL {rack.PuzzleTimeLimitSeconds:0}s · reward {rack.RewardMultiplier:0.00}× · cooldown {rack.HackCooldownSeconds:0}s" );
        }
        else if ( !Terminal.IsValid() || Terminal.GameObject.Name.Contains( "DevStub" ) )
        {
            _lines.Add( "[ DEV ] no rack link — use lp_hacker_kit_preview for full kit." );
        }
        else
        {
            _lines.Add( "WARNING: no server rack in range — place rack within 8m and power ON." );
        }

        _lines.Add( "Fiction only — not the real Ops box. Select a module or open TERMINAL." );
        _lines.Add( "" );

        AppendFooterLog( "System initialized. Select a module to begin." );
        AppendFooterLog( "Establishing secure connection..." );
        AppendFooterLog( "Connection established" );
    }

    private void SecondlyUpdate()
    {
        if ( !Terminal.IsValid() )
        {
            CloseTerminal();
            return;
        }

        var isDevStub = Terminal.IsValid() && Terminal.GameObject.Name.Contains( "DevStub" );
        if ( !isDevStub )
        {
            var viewerPos = HackerTerminalHost.LocalViewerPosition( Scene );
            if ( viewerPos.HasValue && !HackerTerminalRange.IsInUiCloseRange( viewerPos.Value, Terminal.WorldPosition ) )
            {
                CloseTerminal();
                return;
            }
        }

        if ( _puzzle != null && _puzzle.IsExpired )
        {
            _lines.Add( "ERROR: puzzle window expired — trace risk increased." );
            Terminal?.RequestReportHackFailure();
            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
            _screen = LifePunchCyberScreen.Decrypt;
        }
    }

    protected override void OnEnabled()
    {
        LifePunchMenuInputBlock.NotifyMenuOpened();
        LifePunchUiScrollPolicy.Apply( Panel );
    }

    protected override void OnDisabled()
    {
        LifePunchMenuInputBlock.NotifyMenuClosed();
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();
        LifePunchUiScrollPolicy.Apply( Panel );

        if ( _sinceSecondly >= 1f )
        {
            _sinceSecondly = 0f;
            SecondlyUpdate();
        }

        if ( _screen == LifePunchCyberScreen.Terminal && InputBox.IsValid() && !InputBox.HasFocus )
            InputBox.Focus();

        LifePunchMenuInputBlock.Apply();

        if ( InputBox.IsValid() )
        {
            var currentLength = InputBox.Text?.Length ?? 0;
            if ( currentLength != _lastTextLength )
            {
                if ( !string.IsNullOrEmpty( HackerJob.KeyboardSoundPath ) )
                    Sound.Play( HackerJob.KeyboardSoundPath );
                _lastTextLength = currentLength;
            }
        }
    }

    public void FocusInput()
    {
        if ( InputBox.IsValid() )
            InputBox.Focus();
    }

    private void OnClickClose() => CloseTerminal();

    private void RunScanFromUi() => HandleCommand( "scan" );
    private void RunGovdbFromUi() => HandleCommand( "govdb" );

    private void SelectWalletTarget( HackerScanService.ScanTarget target )
    {
        _selectedTargetId = target.SteamId;
        _selectedGovNodeId = null;
        _selectedHashdId = null;
    }

    private void SelectGovNode( HackerScanService.GovDbTarget node )
    {
        _selectedGovNodeId = node.NodeId;
        _selectedTargetId = null;
        _selectedHashdId = null;
    }

    private void SelectHashdTarget( HackerScanService.HashdTarget target )
    {
        _selectedHashdId = target.ScanId;
        _selectedTargetId = null;
        _selectedGovNodeId = null;
    }

    private void StartHackFromUi()
    {
        if ( string.IsNullOrEmpty( _selectedTargetId ) )
            return;

        HandleCommand( $"hack {_selectedTargetId}" );
    }

    private void StartHashdHackFromUi()
    {
        if ( string.IsNullOrEmpty( _selectedHashdId ) )
            return;

        HandleCommand( $"hack {_selectedHashdId}" );
    }

    private void StartInfilFromUi()
    {
        if ( string.IsNullOrEmpty( _selectedGovNodeId ) )
            return;

        HandleCommand( $"infil {_selectedGovNodeId}" );
    }

    private void OnSubmit()
    {
        if ( !InputBox.IsValid() )
            return;

        if ( !string.IsNullOrEmpty( HackerJob.KeyboardSoundPath ) )
            Sound.Play( HackerJob.KeyboardSoundPath );

        var input = ( InputBox.Text ?? "" ).Trim();
        InputBox.Text = "";
        InputBox.Focus();

        if ( string.IsNullOrWhiteSpace( input ) )
            return;

        _lines.Add( $"{HackerTerminalBrand.PromptLabel( Tier )} {input}" );

        if ( _puzzle != null )
            HandlePuzzleInput( input );
        else
            HandleCommand( input.ToLower() );

        _lines.Add( "" );
        TrimLines();
    }

    private void HandlePuzzleInput( string input )
    {
        if ( _puzzle == null )
            return;

        var elapsed = _puzzle.TimeLimitSeconds - _puzzle.SecondsRemaining;
        var kind = (int)_puzzle.Kind;

        if ( !string.IsNullOrEmpty( _selectedGovNodeId ) && Terminal.IsValid() )
            Terminal.RequestSubmitGovdbInfil( _selectedGovNodeId, kind, input, elapsed, _puzzle.TimeLimitSeconds );
        else if ( !string.IsNullOrEmpty( _selectedTargetId ) && Terminal.IsValid() )
            Terminal.RequestSubmitWalletHack( _selectedTargetId, kind, input, elapsed, _puzzle.TimeLimitSeconds );

        if ( _puzzle.TrySubmit( input ) )
        {
            if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
            {
                _lines.Add( "BYPASS OK — host validated (Phase 1 stub; no records exfiltrated)." );
                _lines.Add( $"Node {_selectedGovNodeId} logged. Govdb economy = Phase 2 (Opus)." );
            }
            else
            {
                _lines.Add( "BYPASS OK — host validated (Phase 1 stub; no funds moved)." );
                _lines.Add( $"Target {_selectedTargetId} logged. Wallet transfer = Phase 2 (Opus)." );
            }

            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
            _screen = LifePunchCyberScreen.Terminal;
            return;
        }

        if ( _puzzle.IsExpired )
        {
            _lines.Add( "ERROR: too slow — connection dropped." );
            Terminal?.RequestReportHackFailure();
            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
            _screen = LifePunchCyberScreen.Decrypt;
            return;
        }

        _lines.Add( $"DENIED — {MathF.Ceiling( _puzzle.SecondsRemaining )}s remaining." );
        _activeModule = OpsModule.Target;
        _screen = LifePunchCyberScreen.Decrypt;
    }

    private void HandleCommand( string input )
    {
        if ( !HackerTerminalSession.CanRunOpsCommand( Terminal, out var deny ) )
        {
            _lines.Add( $"ERROR: {deny}" );
            return;
        }

        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";
        var arg = parts.Length > 1 ? string.Join( ' ', parts.Skip( 1 ) ) : "";

        switch ( cmd )
        {
            case "help":
                _activeModule = OpsModule.Help;
                _screen = LifePunchCyberScreen.Terminal;
                _lines.Add( "--------------------HELP--------------------" );
                _lines.Add( "  SCAN     - Probe live wallet signatures." );
                if ( Tier == HackerTerminalTier.Advanced )
                {
                    _lines.Add( "  GOVDB    - Scan government database nodes." );
                    _lines.Add( "  INFIL    - Breach a govdb node (advanced)." );
                }
                _lines.Add( "  HACK     - Start wallet bypass on a SteamID." );
                _lines.Add( "  INFO     - Terminal tier + session info." );
                _lines.Add( "  STATUS   - Session + target state." );
                _lines.Add( "  CLEAR    - Wipe scrollback." );
                _lines.Add( "  ABOUT    - LIFEPUNCH attribution." );
                _lines.Add( "  HOME     - Return to module home." );
                _lines.Add( "--------------------------------------------" );
                break;

            case "home":
            case "menu":
                GoHome();
                break;

            case "clear":
                _lines.Clear();
                break;

            case "about":
                foreach ( var line in HackerTerminalBrand.AboutLines( Tier ) )
                    _lines.Add( line );
                break;

            case "info":
                _lines.Add( "--------------------INFO--------------------" );
                _lines.Add( $"  Tier:        {( Tier == HackerTerminalTier.Advanced ? "Advanced (vengeance.exe)" : "Standard (cornerman.exe)" )}" );
                _lines.Add( $"  Job:         Hacker" );
                _lines.Add( $"  Program:     {HackerTerminalBrand.ProgramName( Tier )}" );
                _lines.Add( $"  Link:        {( Terminal.IsValid() ? "STABLE" : "LOST" )}" );
                _lines.Add( $"  Rack power:  {( Terminal.IsValid() && Terminal.IsPowered ? "ONLINE" : "OFFLINE" )}" );
                if ( Terminal.IsValid() && Terminal.ActiveRack.IsValid() )
                {
                    var rack = Terminal.ActiveRack;
                    _lines.Add( $"  Detection:   L{rack.DetectionTier}" );
                    _lines.Add( $"  Puzzle TTL:  {rack.PuzzleTimeLimitSeconds:0}s" );
                    _lines.Add( $"  Reward:      {rack.RewardMultiplier:0.00}×" );
                    _lines.Add( $"  Cooldown:    {rack.HackCooldownSeconds:0}s" );
                }
                _lines.Add( "--------------------------------------------" );
                break;

            case "status":
                _lines.Add( "--------------------STATUS------------------" );
                _lines.Add( $"  Terminal:    {( Terminal.IsValid() ? "LINKED" : "LOST" )}" );
                _lines.Add( $"  Wallet scan: {_scanResults.Count} target(s)" );
                if ( Tier == HackerTerminalTier.Advanced )
                    _lines.Add( $"  Govdb scan:  {_govdbResults.Count} node(s)" );
                _lines.Add( $"  Active op:   {( _puzzle != null ? (_selectedGovNodeId ?? _selectedTargetId) : "none" )}" );
                if ( _puzzle != null )
                    _lines.Add( $"  Puzzle TTL:  {MathF.Ceiling( _puzzle.SecondsRemaining )}s" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "govdb":
                if ( !HackerHackTargetPolicy.CanHack( Tier, HackerHackTarget.GovernmentDataCenter ) )
                {
                    _lines.Add( HackerHackTargetPolicy.DenyMessage( Tier, HackerHackTarget.GovernmentDataCenter ) );
                    break;
                }

                if ( !Terminal.IsValid() )
                {
                    _lines.Add( "ERROR: terminal link lost." );
                    break;
                }

                _lines.Add( "Scanning govdb mesh for treasury miners ..." );
                _govdbResults = HackerScanService.RequestGovDbScan( Terminal );
                _lines.Add( $"Found {_govdbResults.Count} node(s):" );
                foreach ( var node in _govdbResults )
                    _lines.Add( $"  {node.NodeId}  {node.Label}  [{node.SecurityTier}]" );
                _lines.Add( "Use: infil <nodeid> or NETWORK module + START INFIL" );
                _activeModule = OpsModule.Govdb;
                _screen = LifePunchCyberScreen.Network;
                AppendFooterLog( $"Govdb scan complete — {_govdbResults.Count} node(s)." );
                break;

            case "infil":
                if ( !HackerHackTargetPolicy.CanHack( Tier, HackerHackTarget.GovernmentDataCenter ) )
                {
                    _lines.Add( HackerHackTargetPolicy.DenyMessage( Tier, HackerHackTarget.GovernmentDataCenter ) );
                    break;
                }

                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    _lines.Add( "ERROR: infil requires a node id. Run govdb first." );
                    break;
                }

                if ( _govdbResults.Count == 0 )
                {
                    _lines.Add( "ERROR: run govdb before infil." );
                    break;
                }

                var nodeMatch = _govdbResults.FirstOrDefault( n =>
                    n.NodeId.Equals( arg, StringComparison.OrdinalIgnoreCase ) );

                if ( nodeMatch is null )
                {
                    _lines.Add( "ERROR: node not in govdb cache." );
                    break;
                }

                _selectedGovNodeId = nodeMatch.NodeId;
                _selectedTargetId = null;
                _puzzle = HackerPuzzleSession.CreateRandom( advancedTerminal: true, timeLimitSeconds: GetRackPuzzleSeconds() );
                _lines.Add( $"INFILTRATING {nodeMatch.Label} [{nodeMatch.SecurityTier}]" );
                _lines.Add( _puzzle.Prompt );
                _lines.Add( $"TIME LIMIT: {MathF.Ceiling( _puzzle.TimeLimitSeconds )}s — type answer at prompt." );
                _activeModule = OpsModule.Target;
                _screen = LifePunchCyberScreen.Decrypt;
                AppendFooterLog( $"Infiltration started on {nodeMatch.NodeId}." );
                break;

            case "scan":
                if ( !Terminal.IsValid() )
                {
                    _lines.Add( "ERROR: terminal link lost." );
                    break;
                }

                _lines.Add( "Scanning subnet for wallet endpoints ..." );
                _scanResults = HackerScanService.RequestScan( Terminal );
                _lines.Add( $"Found {_scanResults.Count} exploitable wallet(s):" );
                foreach ( var target in _scanResults )
                    _lines.Add( $"  {target.SteamId}  {target.DisplayName}  ${target.WalletCash}" );
                _lines.Add( "Use: hack <steamid> or NETWORK module + START HACK" );

                if ( Tier == HackerTerminalTier.Advanced )
                {
                    _hashdResults = HackerScanService.RequestHashdScan( Terminal );
                    _lines.Add( $"Found {_hashdResults.Count} HASHD miner hub(s):" );
                    foreach ( var hub in _hashdResults )
                        _lines.Add( $"  {hub.ScanId}  {hub.Label}  {hub.HubWalletBtc:F4} BTC  {hub.DistanceMeters:F0}m" );
                    _lines.Add( "Use: hack hashd-<guid> or NETWORK module + START HASHD HACK" );
                }

                _activeModule = OpsModule.Scan;
                _screen = LifePunchCyberScreen.Network;
                AppendFooterLog( $"Network scan complete — {_scanResults.Count} wallet(s)." );
                break;

            case "hack":
                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    _lines.Add( "ERROR: hack requires a target id. Run scan first." );
                    break;
                }

                if ( arg.StartsWith( LpBitcoinHubAlertBridge.ScanIdPrefix, StringComparison.OrdinalIgnoreCase ) )
                {
                    if ( Tier != HackerTerminalTier.Advanced )
                    {
                        _lines.Add( HackerHackTargetPolicy.DenyMessage( Tier, HackerHackTarget.BitcoinMiner ) );
                        break;
                    }

                    if ( _hashdResults.Count == 0 )
                    {
                        _lines.Add( "ERROR: run scan before hashd hack." );
                        break;
                    }

                    var hashdMatch = _hashdResults.FirstOrDefault( h =>
                        h.ScanId.Equals( arg, StringComparison.OrdinalIgnoreCase ) );

                    if ( hashdMatch is null )
                    {
                        _lines.Add( "ERROR: HASHD target not in scan cache." );
                        break;
                    }

                    _selectedHashdId = hashdMatch.ScanId;
                    _selectedTargetId = null;
                    _selectedGovNodeId = null;

                    var hub = LpBitcoinHubAlertBridge.ResolveFromScanId( hashdMatch.ScanId );
                    var attacker = Connection.Local?.DisplayName ?? "unknown operator";
                    if ( hub.IsValid() )
                        LpBitcoinHubAlertBridge.NotifyHubUnderAttack( hub, attacker );

                    _puzzle = HackerPuzzleSession.CreateRandom( advancedTerminal: true, timeLimitSeconds: GetRackPuzzleSeconds() );
                    _lines.Add( $"INFILTRATING {hashdMatch.Label} — hub wallet {hashdMatch.HubWalletBtc:F4} BTC" );
                    _lines.Add( _puzzle.Prompt );
                    _lines.Add( $"TIME LIMIT: {MathF.Ceiling( _puzzle.TimeLimitSeconds )}s — type answer at prompt." );
                    _activeModule = OpsModule.Target;
                    _screen = LifePunchCyberScreen.Decrypt;
                    AppendFooterLog( $"HASHD bypass started on {hashdMatch.ScanId}." );
                    break;
                }

                if ( _scanResults.Count == 0 )
                {
                    _lines.Add( "ERROR: run scan before hack." );
                    break;
                }

                var match = _scanResults.FirstOrDefault( t =>
                    t.SteamId.Equals( arg, StringComparison.OrdinalIgnoreCase ) );

                if ( match is null )
                {
                    _lines.Add( "ERROR: target not in scan cache." );
                    break;
                }

                _selectedTargetId = match.SteamId;
                _selectedGovNodeId = null;
                _selectedHashdId = null;
                _puzzle = HackerPuzzleSession.CreateRandom( advancedTerminal: false, timeLimitSeconds: GetRackPuzzleSeconds() );
                _lines.Add( $"INFILTRATING {match.DisplayName} — wallet ${match.WalletCash}" );
                _lines.Add( _puzzle.Prompt );
                _lines.Add( $"TIME LIMIT: {MathF.Ceiling( _puzzle.TimeLimitSeconds )}s — type answer at prompt." );
                _activeModule = OpsModule.Target;
                _screen = LifePunchCyberScreen.Decrypt;
                AppendFooterLog( $"Bypass started on wallet {match.SteamId}." );
                break;

            default:
                _lines.Add( $"ERROR: unknown command '{cmd}'. Type help." );
                break;
        }
    }
}
