		<Reference Include="D:/Steam/steamapps/common/sbox/bin/managed/Sandbox.Engine.dll"/> 
		<Reference Include="D:/Steam/steamapps/common/sbox/bin/managed/Sandbox.Filesystem.dll"/> 
		<Reference Include="D:/Steam/steamapps/common/sbox/bin/managed/Sandbox.Reflection.dll"/> 
		<Reference Include="D:/Steam/steamapps/common/sbox/bin/managed/Sandbox.Mounting.dll"/> 
		<Reference Include="D:/Steam/steamapps/common/sbox/bin/managed/Microsoft.AspNetCore.Components.dll"/> 
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="D:/Steam/steamapps/common/sbox/addons/base/code/Base Library.csproj" />
	</ItemGroup>

