{
  "schemaVersion": 1,
  "lastVerified": "2026-07-08",
  "notes": "Known-good stack pins + where to update. Re-verify after any bump. Full runbook: lifepunch/docs/CVL_FULL_CAPACITY_UPDATES.md",
  "components": [
    {
      "id": "lifepunch-monorepo",
      "role": "addons, scripts, docs",
      "verified": "git main",
      "updateVia": "git fetch && git pull --rebase origin main (clean tree only)"
    },
    {
      "id": "dxrp-gamemode",
      "role": "editor project + portal API",
      "path": "D:/Steam/steamapps/common/sbox/dxrp/game",
      "fork": "https://github.com/mragerlp/dxrp-public/tree/develop",
      "pin": "lifepunch/config/dxrp-upstream-pin.json",
      "gateScript": "lifepunch/scripts/Ensure-DxrpUpstreamCurrent.ps1",
      "updateVia": "Ensure-DxrpUpstreamCurrent.ps1 -Sync -UpdatePin -SyncSteam; then Sync-LifePunchAddonsToDxrp.ps1"
    },
    {
      "id": "sbox-engine",
      "role": "s&box dev + compile",
      "path": "D:/Steam/steamapps/common/sbox",
      "updateVia": "Steam → s&box; restart editor after SDK bump"
    },
    {
      "id": "claudebridge",
      "role": "runtime MCP — play, console_run, screenshots",
      "library": "sboxskinsgg.claudebridge",
      "verifiedVersion": "1.18.0",
      "updateVia": "s&box Library Manager → update; restart editor; get_bridge_status versionsAligned"
    },
    {
      "id": "cornerman-claude-bridge",
      "role": "Anthropic client -> Cornerman LM Studio (/v1/messages)",
      "script": "lifepunch/scripts/Start-ClaudeBridge.ps1",
      "doc": "lifepunch/docs/CORNERMAN_LM_STUDIO.md",
      "updateVia": "Sync Cornerman Tier-3; run Start-ClaudeBridge.ps1 before claude CLI sessions"
    },
    {
      "id": "chomnr_mcp",
      "role": "editor MCP — ModelDoc, prefabs, imported game tools",
      "library": "notpointless.chomnr_mcp",
      "endpoint": "http://127.0.0.1:9090/sbox-mcp",
      "updateVia": "s&box Library Manager → update; restart editor MCP server; Fix-SboxEditorMcpCursorToolNames.ps1 after import changes"
    },
    {
      "id": "sbox-mcp-server",
      "role": "Cursor npm bridge to Claude Bridge IPC",
      "package": "sbox-mcp-server",
      "updateVia": "npx -y sbox-mcp-server (on Cursor MCP start); Install-VengeanceSboxEditorMcp.ps1 refreshes mcp.json"
    },
    {
      "id": "cornerman-tier3",
      "role": "distill + embed + on-demand coder",
      "config": "lifepunch/config/cornerman-tier3-models.json",
      "updateVia": "LM Studio on Green; edit JSON; Fix-CornermanLmServe.ps1"
    },
    {
      "id": "xmovement",
      "role": "DXRP movement library (rp.csproj dependency)",
      "library": "xenthio.xmovement",
      "url": "https://sbox.game/xenthio/xmovement",
      "status": "installed-required-by-dxrp",
      "updateVia": "s&box Library Manager; keep in sync with DXRP upstream"
    },
    {
      "id": "simpleantitamper",
      "role": "optional client-local JSON save tamper hash (not anticheat, not bots)",
      "library": "quality.simpleantitamper",
      "url": "https://sbox.game/quality/simpleantitamper",
      "status": "installed-not-wired",
      "updateVia": "s&box Library Manager; see TECH_DEBT SEC-01"
    },
    {
      "id": "wackylib",
      "role": "optional dev utils (not entity framework; not ship dep)",
      "library": "wizards.wackylib",
      "url": "https://github.com/WackyWizards/WackyLib",
      "status": "installed-not-wired",
      "updateVia": "s&box Library Manager; see TECH_DEBT STACK-02"
    },
    {
      "id": "tailwand",
      "role": "Tailwind utilities for LifePunch Razor UI (HASHD chrome pilot)",
      "library": "tristan.tailwand",
      "url": "https://sbox.game/tristan/tailwand",
      "config": "lifepunch/config/tailwand.config.json",
      "status": "installed-active-pilot",
      "updateVia": "Editor > tailw& > Generate Now after Razor edits; see TAILWAND.md"
    },
    {
      "id": "sbox-ui-designer",
      "role": "visual .sui → Razor layout tool (scratch → port)",
      "library": "kikozl.sbox_ui_designer",
      "url": "https://sbox.game/kikozl/sbox_ui_designer",
      "status": "installed-optional",
      "updateVia": "s&box Library Manager; see SBOX_UI_DESIGNER.md"
    },
    {
      "id": "cursor-mcp-limit",
      "role": "tool name filter",
      "rule": "len(serverName + ':' + toolName) <= 60",
      "serverName": "sbox-editor",
      "guardScript": "lifepunch/scripts/Fix-SboxEditorMcpCursorToolNames.ps1"
    }
  ],
