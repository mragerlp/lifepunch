  "portalConfirmationNeeded": [
    "Exact edit modal fields",
    "Whether Add is enabled for non-owner roles",
    "Whether View/Search opens a detail page or logs",
    "Which fields are editable",
    "Whether server actions affect only one server or both hosted servers"
