{
  "schemaVersion": 1,
  "source": "DXRP portal Servers page",
  "purpose": "Track visible fields and actions so LifePunch can audit changes made by developers or admins.",
  "servers": [
    "lifepunchmainserver",
    "lifepunchdevelopment"
  ],
  "controls": [
    "Search by ID or Name",
    "Clear",
    "Refresh",
    "Add",
    "Pagination",
    "Rows per page"
  ],
  "tableColumns": [
    "Name",
    "Version",
    "Players",
    "Uptime",
    "Created",
    "Last Pulsed",
    "Actions"
