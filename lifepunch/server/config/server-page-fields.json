      "risk": "medium",
      "fields": [
        "server name",
        "server id",
        "description",
        "visibility",
        "region",
        "connection address"
      ]
    },
    {
      "name": "runtime",
      "risk": "medium",
      "fields": [
        "version",
        "players",
        "uptime",
        "online status",
        "player count",
        "current map",
        "current gamemode",
        "current ruleset",
        "last heartbeat"
      ]
    },
    {
      "name": "configuration",
      "risk": "high",
      "fields": [
        "assigned gamemode",
        "assigned ruleset",
        "assigned map",
        "max players",
        "server tags",
        "enabled features"
      ]
    },
    {
      "name": "release-state",
      "risk": "high",
      "fields": [
        "created",
        "last pulsed",
        "addon revision pins",
        "gamemode revision/import",
        "sync status",
        "last synced at",
        "last synced by"
      ]
    },
    {
      "name": "operations",
      "risk": "critical",
      "fields": [
        "add button",
        "edit action",
        "refresh button",
        "sync button",
        "restart button",
        "stop/start controls",
        "delete controls",
        "save button"
      ]
