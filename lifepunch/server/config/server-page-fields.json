  "ownerApprovalRequiredFor": [
    "add server",
    "edit server",
    "sync",
    "restart",
    "stop",
    "start",
    "delete",
    "save configuration",
    "gamemode assignment",
    "ruleset assignment",
    "map assignment",
    "addon revision pin change"
