// LIFEPUNCH lpbitcoin — HASHD terminal keyboard + mouse.

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/T_Keyboard_mause_BC.tga"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/T_Keyboard_mause_ORM.tga@channels=B"

	TextureNormal "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/T_Keyboard_mause_N.tga"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/T_Keyboard_mause_ORM.tga@channels=G"
}
