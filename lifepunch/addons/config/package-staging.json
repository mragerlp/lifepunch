{
  "schemaVersion": 1,
  "law": "Package folder (lp*) -> entity slot folder -> assets/ + code/. Staging mirrors future publish tree. Do not merge packages.",
  "stagingAssetsRoot": "Assets/addons/lifepunch",
  "devRoot": "_dev",
  "legacyDesktopFolderMap": {
    "lpbitcoinmining": "lpbitcoin",
    "lppolicehacker": "lppolice"
  },
