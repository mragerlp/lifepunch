@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="crt-frame">
			<div class="crt-header">
				<span>LIFEPUNCH HASHD TERMINAL</span>
				<div class="crt-status-row">
					<span class="@StatusPowerClass()">@StatusPowerLabel()</span>
					<span>@LinkedRackCount() racks</span>
					<span>sel #@_selectedIndex</span>
				</div>
				<div class="lp-ui-chrome-actions">
					<div class="lp-ui-scale-menu">
						<button class="lp-ui-chrome-btn cog" tooltip="UI scale" onclick="@ToggleScaleMenu">
							<i class="material-icons">settings</i>
						</button>
						@if ( _showScaleMenu )
						{
							<div class="lp-ui-scale-dropdown">
								<div class="lp-ui-scale-dropdown-title">UI Scale</div>
								@foreach ( var size in _uiScaleOptions )
								{
									<button class="lp-ui-scale-opt @( _uiScale == size ? "active" : "" )"
									        onclick="@(() => SetUiScale( size ))">
										<span>@ScaleLabel( size )</span>
										<span>@LpUiScale.ShortLabel( size )</span>
									</button>
								}
							</div>
						}
					</div>
					<button class="lp-ui-chrome-btn esc" tooltip="Close terminal" onclick="@Close">ESC</button>
				</div>
			</div>
			<div class="crt-body">
				<div class="sidebar">
					<div class="sidebar-title">COMMANDS</div>
					@foreach ( var cmd in _commandRefs )
					{
						<div class="cmd-ref @( IsCommandCopied( cmd ) ? "copied" : "" )"
						     onclick="@(() => CopySidebarCommand( cmd ))">
							@( IsCommandCopied( cmd ) ? ">copied" : cmd )
						</div>
					}
					<div class="sidebar-foot">sel #@_selectedIndex</div>
				</div>
				<div class="screen">
					@if ( _showBootSplash )
					{
						<div class="boot-splash" onclick="@SkipBoot">
							<div class="boot-mark"></div>
							<div class="boot-title">LIFEPUNCH HASHD</div>
							<div class="boot-status">@_bootStatus</div>
							<div class="boot-hint">click to skip boot</div>
						</div>
					}
					<div @ref="LogPanel" class="log">
						@foreach ( var line in _lines )
						{
							<div class="log-line @LineClass( line )">@line.Text</div>
						}
					</div>
					<div class="prompt-row" onclick="@FocusInput">
						<span class="prompt">rig@hub&gt;</span>
						<TextEntry class="cmd-input" @ref="InputBox" onsubmit="@Submit" Placeholder="type command..." />
					</div>
				</div>
			</div>
		</div>
		<div class="lp-window-watermark lp-window-watermark--boxed">
			<div class="lp-source-footer">
				<span class="lp-mark">@LifePunchSourceMark.UiFooterMark</span>
				<button class="lp-url-copy @(_urlCopied ? "copied" : "")"
				        tooltip="@($"Copy {LifePunchSourceMark.UiFooterUrl}")"
				        onclick="@CopySourceUrl">
					@(_urlCopied ? "Link copied!" : LifePunchSourceMark.UiFooterUrl)
				</button>
			</div>
		</div>
	</div>
</root>

@code
{
	private readonly record struct LogLine( string Kind, string Text );

	private LpBitcoinHubEntity _hub;
	private int _selectedIndex;
	private readonly List<LogLine> _lines = new();
	private bool _showBootSplash = true;
	private bool _bootComplete;
	private int _bootLineIndex;
	private float _bootElapsed;
	private string _bootStatus = "INITIALIZING RIG...";
	private bool _showScaleMenu;
	private LpUiScaleSize _uiScale = LpUiScale.Default;
	private TextEntry InputBox { get; set; }
	private Panel LogPanel { get; set; }

	private const int MaxLogLines = 36;

	private static readonly string[] _commandRefs =
	{
		"help",
		"racks",
		"select 0",
		"status",
		"info",
		"wallet",
		"mining start",
		"mining stop",
		"mining start all",
		"deposit",
		"deposit all",
		"send",
		"clear"
	};

	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};

	private bool _scrollLogNextFrame;
	private bool _urlCopied;
	private string _copiedCommandFlash;
	private RealTimeSince _copiedCommandFlashSince;

	private static readonly string[] BootLines =
	{
		"LIFEPUNCH HASHD rig — boot sequence",
		"loading hashd kernel ............... OK",
		"probe hashd hub bus ................ OK",
		"sync gpu-rack telemetry ............ OK",
		"rig console online ................. OK"
	};

	private const float BootLineIntervalSeconds = 0.35f;
	private const float BootSplashHoldSeconds = 0.4f;
	private static readonly string PromptLabel = "rig@hub>";
	private static readonly Color CmdSelectionTint = (Color.Parse( "#f0a500" ) ?? new Color( 0.941f, 0.647f, 0f )).WithAlpha( 0.35f );

	private string GetRootClass() =>
		$"lp-ops-crt lp-ops-crt--gray {LpUiScale.CssClass( _uiScale )}";

	private static string ScaleLabel( LpUiScaleSize size ) => size switch
	{
		LpUiScaleSize.Small => "Small",
		LpUiScaleSize.Medium => "Medium",
		LpUiScaleSize.Large => "Large",
		_ => "Extra Large"
	};

	private static string LineClass( LogLine line ) => line.Kind switch
	{
		"err" => "err",
		"ok" => "ok",
		"dim" => "dim",
		"cmd" => "cmd",
		_ => ""
	};

	private int LinkedRackCount() => _hub?.GetLinkedRacks().Count ?? 0;

	private string StatusPowerLabel() => _hub?.IsPowered == true ? "hub power on" : "hub power off";

	private string StatusPowerClass() => _hub?.IsPowered == true ? "status-ok" : "status-warn";

	private void ToggleScaleMenu() => _showScaleMenu = !_showScaleMenu;

	private void SetUiScale( LpUiScaleSize size )
	{
		_uiScale = size;
		_showScaleMenu = false;
		LifePunchUiScrollPolicy.Apply( Panel, resetOffset: true );
	}

	protected override void OnEnabled()
	{
		LpBitcoinHudBridge.SetMenuCursorMode( true );
		LifePunchUiScrollPolicy.Apply( Panel );
		ApplyCommandInputChrome();
	}

	public void Bind( LpBitcoinHubEntity hub, LpBitcoinRackEntity focusRack = null )
	{
		_hub = hub;
		_lines.Clear();
		_showBootSplash = true;
		_bootComplete = false;
		_bootLineIndex = 0;
		_bootElapsed = 0f;
		_bootStatus = "INITIALIZING RIG...";
		_pendingFocusRack = focusRack;
	}

	protected override void OnDisabled()
	{
		LpBitcoinHudBridge.SetMenuCursorMode( false );
	}

	private LpBitcoinRackEntity _pendingFocusRack;

	public void FocusInput()
	{
		if ( InputBox.IsValid() )
			InputBox.Focus();
	}

	private void CopySidebarCommand( string cmd )
	{
		if ( !_bootComplete )
			SkipBoot();

		Clipboard.SetText( cmd );
		_copiedCommandFlash = cmd;
		_copiedCommandFlashSince = 0;
	}

	private bool IsCommandCopied( string cmd ) =>
		!string.IsNullOrEmpty( _copiedCommandFlash )
		&& _copiedCommandFlash == cmd
		&& _copiedCommandFlashSince < 1.5f;

	private void SkipBoot()
	{
		if ( _bootComplete )
			return;

		while ( _bootLineIndex < BootLines.Length )
		{
			AppendLogLine( "dim", BootLines[_bootLineIndex] );
			_bootLineIndex++;
		}

		FinishBoot();
	}

	private void Submit()
	{
		if ( !InputBox.IsValid() )
			return;

		if ( !_bootComplete )
		{
			SkipBoot();
			if ( string.IsNullOrWhiteSpace( InputBox.Text ) )
				return;
		}

		var raw = InputBox.Text?.Trim() ?? string.Empty;
		if ( string.IsNullOrWhiteSpace( raw ) )
			return;

		AppendLogLine( "cmd", $"{PromptLabel} {raw}" );

		if ( raw.Equals( "clear", StringComparison.OrdinalIgnoreCase ) )
		{
			_lines.Clear();
			_hub?.RequestPushTerminalCommandAlert( raw, "log cleared" );
			InputBox.Text = string.Empty;
			InputBox.Focus();
			return;
		}

		var result = LpBitcoinTerminalCommands.Execute( _hub, ref _selectedIndex, raw );
		AppendCommandResult( result );
		_hub?.RequestPushTerminalCommandAlert( raw, SummarizeResult( result ) );

		InputBox.Text = string.Empty;
		InputBox.Focus();
		QueueScrollLogToBottom();
	}

	private void AppendCommandResult( LpBitcoinCommandResult result )
	{
		if ( string.IsNullOrWhiteSpace( result.Line ) )
			return;

		foreach ( var line in result.Line.Split( '\n' ) )
		{
			var trimmed = line.TrimEnd();
			if ( string.IsNullOrWhiteSpace( trimmed ) )
				continue;

			AppendLogLine( result.Ok ? "ok" : "err", trimmed );
		}
	}

	private static string SummarizeResult( LpBitcoinCommandResult result )
	{
		if ( string.IsNullOrWhiteSpace( result.Line ) )
			return string.Empty;

		var first = result.Line.Split( '\n' ).FirstOrDefault( l => !string.IsNullOrWhiteSpace( l ) );
		return first?.Trim() ?? string.Empty;
	}

	private void AppendLogLine( string kind, string text )
	{
		_lines.Add( new LogLine( kind, text ) );
		TrimLog();
	}

	private void TrimLog()
	{
		while ( _lines.Count > MaxLogLines )
			_lines.RemoveAt( 0 );
	}

	private void QueueScrollLogToBottom() => _scrollLogNextFrame = true;

	private void ScrollLogToBottom( bool force = false )
	{
		if ( !LogPanel.IsValid() )
			return;

		if ( !LogPanel.HasScrollY )
			return;

		var viewHeight = LogPanel.Box.Bottom - LogPanel.Box.Top;
		var maxY = Math.Max( 0f, LogPanel.ScrollSize.y - viewHeight );

		if ( !force )
		{
			var nearBottom = LogPanel.ScrollOffset.y >= maxY - 28f;
			if ( !nearBottom )
				return;
		}

		LogPanel.ScrollOffset = new Vector2( 0f, maxY );
	}

	private void Close() => LpBitcoinTerminalUiHost.CloseOpen();

	private void CopySourceUrl()
	{
		Clipboard.SetText( LifePunchSourceMark.UiFooterUrl );
		_urlCopied = true;
		_ = RevertCopyLabel();
	}

	private async System.Threading.Tasks.Task RevertCopyLabel()
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		_urlCopied = false;
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchUiScrollPolicy.Apply( Panel );
		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		if ( !_bootComplete )
			TickBoot();

		ApplyCommandInputChrome();

		if ( _scrollLogNextFrame )
		{
			_scrollLogNextFrame = false;
			ScrollLogToBottom( force: true );
		}
	}

	private void TickBoot()
	{
		_bootElapsed += Time.Delta;

		while ( _bootLineIndex < BootLines.Length
		        && _bootElapsed >= BootLineIntervalSeconds * ( _bootLineIndex + 1 ) )
		{
			AppendLogLine( "dim", BootLines[_bootLineIndex] );
			_bootStatus = _bootLineIndex < BootLines.Length - 1
				? $"{BootLines[_bootLineIndex + 1].Split( ' ' )[0].ToUpperInvariant()}..."
				: "READY";
			_bootLineIndex++;
			QueueScrollLogToBottom();
		}

		var bootEnd = BootLineIntervalSeconds * BootLines.Length + BootSplashHoldSeconds;
		if ( _bootLineIndex < BootLines.Length || _bootElapsed < bootEnd )
			return;

		FinishBoot();
	}

	private void FinishBoot()
	{
		_bootComplete = true;
		_showBootSplash = false;
		AppendLogLine( "ok", _hub?.IsPowered == true ? "hub power: ON" : "hub power: OFF" );
		AppendLogLine( "dim", $"type help for {PromptLabel} commands · drag-select log · ctrl+c copy" );

		if ( _pendingFocusRack.IsValid() )
		{
			var racks = _hub?.GetLinkedRacks() ?? Array.Empty<LpBitcoinRackEntity>();
			for ( var i = 0; i < racks.Count; i++ )
			{
				if ( racks[i].GameObject.Id != _pendingFocusRack.GameObject.Id )
					continue;

				_selectedIndex = i;
				AppendLogLine( "ok", $"focused rack #{i}" );
				break;
			}
		}

		_pendingFocusRack = null;
		QueueScrollLogToBottom();
		FocusInput();
	}

	private void ApplyCommandInputChrome()
	{
		if ( !InputBox.IsValid() )
			return;

		InputBox.SelectionColor = CmdSelectionTint;
		InputBox.AcceptsFocus = true;
	}

	protected override int BuildHash()
	{
		var lineHash = 0;
		foreach ( var line in _lines )
			lineHash = HashCode.Combine( lineHash, line.Kind, line.Text );

		return HashCode.Combine(
			HashCode.Combine(
				_selectedIndex,
				InputBox?.Text,
				_lines.Count,
				lineHash,
				_uiScale,
				_showScaleMenu,
				_showBootSplash,
				_bootStatus ),
			_bootLineIndex,
			_bootComplete,
			_hub?.IsPowered,
			_hub?.GetLinkedRacks().Sum( r => r.BitcoinAmount ),
			_urlCopied,
			CopiedCommandFlashHash() );
	}

	private int CopiedCommandFlashHash()
	{
		if ( string.IsNullOrEmpty( _copiedCommandFlash ) || _copiedCommandFlashSince >= 1.5f )
			return 0;

		return HashCode.Combine( _copiedCommandFlash, (int)( _copiedCommandFlashSince * 10f ) );
	}
}
