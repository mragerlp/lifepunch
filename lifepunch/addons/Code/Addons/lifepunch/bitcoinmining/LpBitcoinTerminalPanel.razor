@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="crt-frame">
			<div class="crt-header">
				<span>LIFEPUNCH HASHD TERMINAL</span>
				<div class="lp-ui-chrome-actions">
					<div class="lp-ui-scale-menu">
						<button class="lp-ui-chrome-btn cog" tooltip="UI scale" onclick="@ToggleScaleMenu">
							<i class="material-icons">settings</i>
						</button>
						@if ( _showScaleMenu )
						{
							<div class="lp-ui-scale-dropdown">
								<div class="lp-ui-scale-dropdown-title">UI Scale</div>
								@foreach ( var size in _uiScaleOptions )
								{
									<button class="lp-ui-scale-opt @( _uiScale == size ? "active" : "" )"
									        onclick="@(() => SetUiScale( size ))">
										<span>@ScaleLabel( size )</span>
										<span>@LpUiScale.ShortLabel( size )</span>
									</button>
								}
							</div>
						}
					</div>
					<button class="lp-ui-chrome-btn esc" tooltip="Close terminal" onclick="@Close">ESC</button>
				</div>
			</div>
			<div class="crt-body">
				<div class="sidebar">
					<div class="sidebar-title">COMMANDS</div>
					<div class="cmd-ref">help</div>
					<div class="cmd-ref">racks</div>
					<div class="cmd-ref">select &lt;n&gt;</div>
					<div class="cmd-ref">status</div>
					<div class="cmd-ref">mining start</div>
					<div class="cmd-ref">mining stop</div>
					<div class="cmd-ref">mining all-start</div>
					<div class="cmd-ref">mining all-stop</div>
					<div class="cmd-ref">sell</div>
					<div class="cmd-ref">sell all</div>
					<div class="sidebar-foot">Selected rack #@_selectedIndex</div>
				</div>
				<div class="screen">
					@if ( _showBootSplash )
					{
						<div class="boot-splash">
							<div class="boot-mark"></div>
							<div class="boot-title">LIFEPUNCH HASHD</div>
							<div class="boot-status">@_bootStatus</div>
						</div>
					}
					<div class="log">
						@foreach ( var line in _lines )
						{
							<div class="log-line @(line.Ok ? "" : "err")">@line.Text</div>
						}
					</div>
					<div class="prompt-row">
						<span class="prompt">rig0&gt;</span>
						<TextEntry class="cmd-input" Value:bind="@_input" onsubmit="@Submit" placeholder="type command..." />
					</div>
				</div>
			</div>
		</div>
	</div>
</root>

@code
{
	private readonly record struct LogLine( bool Ok, string Text );

	private LpBitcoinHubEntity _hub;
	private int _selectedIndex;
	private string _input = string.Empty;
	private readonly List<LogLine> _lines = new();
	private bool _showBootSplash = true;
	private bool _bootComplete;
	private int _bootLineIndex;
	private float _bootElapsed;
	private string _bootStatus = "INITIALIZING RIG0...";
	private bool _showScaleMenu;
	private LpUiScaleSize _uiScale = LpUiScale.Default;
	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};

	private static readonly string[] BootLines =
	{
		"LIFEPUNCH HASHD rig0 — boot sequence",
		"loading hashd kernel ............... OK",
		"probe ophion hub bus ............... OK",
		"sync gpu-rack telemetry ............ OK",
		"rig0 console online ................ OK"
	};

	private const float BootLineIntervalSeconds = 0.42f;
	private const float BootSplashHoldSeconds = 0.55f;

	private string GetRootClass() =>
		$"lp-ops-crt lp-ops-crt--gray {LpUiScale.CssClass( _uiScale )}";

	private static string ScaleLabel( LpUiScaleSize size ) => size switch
	{
		LpUiScaleSize.Small => "Small",
		LpUiScaleSize.Medium => "Medium",
		LpUiScaleSize.Large => "Large",
		_ => "Extra Large"
	};

	private void ToggleScaleMenu() => _showScaleMenu = !_showScaleMenu;

	private void SetUiScale( LpUiScaleSize size )
	{
		_uiScale = size;
		_showScaleMenu = false;
	}

	public void Bind( LpBitcoinHubEntity hub, LpBitcoinRackEntity focusRack = null )
	{
		_hub = hub;
		_lines.Clear();
		_showBootSplash = true;
		_bootComplete = false;
		_bootLineIndex = 0;
		_bootElapsed = 0f;
		_bootStatus = "INITIALIZING RIG0...";
		_pendingFocusRack = focusRack;
	}

	private LpBitcoinRackEntity _pendingFocusRack;

	private void Submit()
	{
		var raw = _input?.Trim() ?? string.Empty;
		if ( string.IsNullOrWhiteSpace( raw ) )
			return;

		_lines.Add( new LogLine( true, $"rig0&gt; {raw}" ) );

		var result = LpBitcoinTerminalCommands.Execute( _hub, ref _selectedIndex, raw );
		if ( !string.IsNullOrWhiteSpace( result.Line ) )
			_lines.Add( new LogLine( result.Ok, result.Line ) );

		while ( _lines.Count > 40 )
			_lines.RemoveAt( 0 );

		_input = string.Empty;
	}

	private void Close() => LpBitcoinTerminalUiHost.CloseOpen();

	protected override void OnUpdate()
	{
		base.OnUpdate();
		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		if ( !_bootComplete )
			TickBoot();
	}

	private void TickBoot()
	{
		_bootElapsed += Time.Delta;

		while ( _bootLineIndex < BootLines.Length
		        && _bootElapsed >= BootLineIntervalSeconds * ( _bootLineIndex + 1 ) )
		{
			_lines.Add( new LogLine( true, BootLines[_bootLineIndex] ) );
			_bootStatus = _bootLineIndex < BootLines.Length - 1
				? $"{BootLines[_bootLineIndex + 1].Split( ' ' )[0].ToUpperInvariant()}..."
				: "READY";
			_bootLineIndex++;
		}

		var bootEnd = BootLineIntervalSeconds * BootLines.Length + BootSplashHoldSeconds;
		if ( _bootLineIndex < BootLines.Length || _bootElapsed < bootEnd )
			return;

		FinishBoot();
	}

	private void FinishBoot()
	{
		_bootComplete = true;
		_showBootSplash = false;
		_lines.Add( new LogLine( true, _hub?.IsPowered == true ? "hub power: ON" : "hub power: OFF" ) );
		_lines.Add( new LogLine( true, "type help for rig0 commands" ) );

		if ( _pendingFocusRack.IsValid() )
		{
			var racks = _hub?.GetLinkedRacks() ?? Array.Empty<LpBitcoinRackEntity>();
			for ( var i = 0; i < racks.Count; i++ )
			{
				if ( racks[i].GameObject.Id != _pendingFocusRack.GameObject.Id )
					continue;

				_selectedIndex = i;
				_lines.Add( new LogLine( true, $"focused rack #{i}" ) );
				break;
			}
		}

		_pendingFocusRack = null;
	}

	protected override int BuildHash() => HashCode.Combine(
		HashCode.Combine(
			_selectedIndex,
			_input,
			_lines.Count,
			_uiScale,
			_showScaleMenu,
			_showBootSplash,
			_bootStatus,
			_bootLineIndex ),
		_bootComplete,
		_hub?.IsPowered,
		_hub?.GetLinkedRacks().Sum( r => r.BitcoinAmount ) );
}
