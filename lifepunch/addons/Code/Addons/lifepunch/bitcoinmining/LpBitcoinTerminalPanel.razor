@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="crt-frame">
			<div class="crt-header">
				<span class="crt-header-title hashd-prompt-accent">LIFEPUNCH HASHD TERMINAL</span>
				<div class="crt-status-row">
					<span class="@StatusPowerClass()">@StatusPowerLabel()</span>
					<span>@LinkedRackCount() racks</span>
					<span>sel @SelectedRackSlotLabel()</span>
				</div>
				<div class="lp-ui-chrome-actions">
					<div class="lp-ui-scale-menu">
						<button class="lp-ui-chrome-btn cog" tooltip="UI scale" onclick="@ToggleScaleMenu">
							<i class="material-icons">settings</i>
						</button>
						@if ( _showScaleMenu )
						{
							<div class="lp-ui-scale-dropdown">
								<div class="lp-ui-scale-dropdown-title">UI Scale</div>
								@foreach ( var size in _uiScaleOptions )
								{
									<button class="lp-ui-scale-opt @( _uiScale == size ? "active" : "" )"
									        onclick="@(() => SetUiScale( size ))">
										<span>@ScaleLabel( size )</span>
										<span>@LpUiScale.ShortLabel( size )</span>
									</button>
								}
							</div>
						}
					</div>
					<button class="lp-ui-chrome-btn esc" tooltip="Close terminal" onclick="@Close">ESC</button>
				</div>
			</div>
			<div class="crt-body">
				<div class="sidebar">
					<div class="sidebar-title">COMMANDS</div>
					<div class="sidebar-cmd-list lp-ui-scroll-region terminal-sidebar-scroll">
					@foreach ( var cmd in _commandRefs )
					{
						<div class="cmd-ref @( IsCommandCopied( cmd ) ? "copied" : "" )"
						     onclick="@(() => CopySidebarCommand( cmd ))">
							@( IsCommandCopied( cmd ) ? ">copied" : cmd )
						</div>
					}
					</div>
					<div class="sidebar-foot">sel @SelectedRackSlotLabel()</div>
				</div>
				<div class="screen">
					@if ( _showBootSplash )
					{
						<div class="boot-splash" onclick="@SkipBoot">
							<div class="boot-mark"></div>
							<div class="boot-title">LIFEPUNCH HASHD</div>
							<div class="boot-status">@_bootStatus</div>
							<div class="boot-hint">click to skip boot</div>
						</div>
					}
					<div class="log-shell">
						<div class="log lp-ui-scroll-region terminal-log-scroll" onclick="@FocusLog"></div>
					</div>
					<div class="prompt-row" onclick="@FocusInput">
						<span class="prompt hashd-prompt-accent">rig@hub&gt;</span>
						<TextEntry class="cmd-input" @ref="InputBox" onsubmit="@Submit" Placeholder="type command..." />
					</div>
				</div>
			</div>
		</div>
		<div class="lp-window-watermark lp-window-watermark--boxed">
			<div class="lp-source-footer">
				<span class="lp-mark hashd-prompt-accent">@LifePunchSourceMark.UiFooterMark</span>
				<button class="lp-url-copy @(_urlCopied ? "copied" : "")"
				        tooltip="@($"Copy {LifePunchSourceMark.UiFooterUrl}")"
				        onclick="@CopySourceUrl">
					@(_urlCopied ? "Link copied!" : LifePunchSourceMark.UiFooterUrl)
				</button>
			</div>
		</div>
	</div>
</root>

@code
{
	private readonly record struct LogLine( string Kind, string Text );

	private LpBitcoinHubEntity _hub;
	private int _selectedIndex;
	private readonly List<LogLine> _lines = new();
	private bool _showBootSplash = true;
	private bool _bootComplete;
	private int _bootLineIndex;
	private float _bootElapsed;
	private string _bootStatus = "INITIALIZING RIG...";
	private bool _showScaleMenu;
	private LpUiScaleSize _uiScale = LpUiScale.Default;
	private TextEntry InputBox { get; set; }

	private const int MaxLogLines = 200;

	private static readonly string[] _commandRefs =
	{
		"help",
		"racks",
		"link",
		"select 0",
		"status",
		"info",
		"wallet",
		"mining start",
		"mining stop",
		"mining start all",
		"deposit",
		"deposit all",
		"send",
		"clear"
	};

	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};

	private int _scrollLogPendingFrames;
	private bool _scrollLogForce;
	private int _scrollBootstrapWarmupFrames = 2;
	private int _scrollBootstrapRetriesLeft;
	private bool _scrollBootstrapComplete;
	private bool _urlCopied;
	private string _copiedCommandFlash;
	private RealTimeSince _copiedCommandFlashSince;
	private int _lastInputTextLength;

	private static readonly string[] BootLines =
	{
		"LIFEPUNCH HASHD rig — boot sequence",
		"loading hashd kernel ............... OK",
		"probe hashd hub bus ................ OK",
		"sync gpu-rack telemetry ............ OK",
		"rig console online ................. OK"
	};

	private const float BootLineIntervalSeconds = 0.35f;
	private const float BootSplashHoldSeconds = 0.4f;
	private static readonly string PromptLabel = "rig@hub>";
	private static readonly Color CmdSelectionTint = (Color.Parse( "#f0a500" ) ?? new Color( 0.941f, 0.647f, 0f )).WithAlpha( 0.35f );

	private string GetRootClass() =>
		$"lp-ops-crt lp-ops-crt--gray {LpUiScale.CssClass( _uiScale )}";

	private static string ScaleLabel( LpUiScaleSize size ) => size switch
	{
		LpUiScaleSize.Small => "Small",
		LpUiScaleSize.Medium => "Medium",
		LpUiScaleSize.Large => "Large",
		_ => "Extra Large"
	};

	private static string LineClass( LogLine line ) => line.Kind switch
	{
		"err" => "err",
		"ok" => "ok",
		"dim" => "dim",
		"cmd" => "cmd",
		_ => ""
	};

	private int LinkedRackCount() => _hub?.GetLinkedRacks().Count ?? 0;

	private string StatusPowerLabel() => _hub?.IsPowered == true ? "hub power on" : "hub power off";

	private string StatusPowerClass() => _hub?.IsPowered == true ? "status-ok" : "status-warn";

	private void ToggleScaleMenu() => _showScaleMenu = !_showScaleMenu;

	private static void EnsureScrollFactory()
	{
		// Re-register every open — hot reload can leave a stale lambda factory from a prior compile.
		LifePunchScrollRegionBootstrap.SetCustomFactory( CreateTerminalScrollPanel );
	}

	private static LifePunchScrollRegionPanel CreateTerminalScrollPanel( string slotClass )
		=> slotClass == "log" ? new LpBitcoinTerminalLogPanel() : null;

	private void SetUiScale( LpUiScaleSize size )
	{
		_uiScale = size;
		_showScaleMenu = false;
		LifePunchUiScrollPolicy.ResetOffsets( Panel );
		QueueScrollLogToBottom( force: true );
	}

	protected override void OnEnabled()
	{
		EnsureScrollFactory();
		LifePunchMenuInputBlock.NotifyMenuOpened();
		LpBitcoinHudBridge.SetMenuCursorMode( true );
		LifePunchUiScrollPolicy.Apply( Panel );
		ApplyCommandInputChrome();
		ResetScrollBootstrap();
		QueueScrollLogToBottom( force: true );
	}

	public void Bind( LpBitcoinHubEntity hub, LpBitcoinRackEntity focusRack = null )
	{
		_hub = hub;
		_lines.Clear();
		ClearLogStack();
		_showBootSplash = true;
		_bootComplete = false;
		_bootLineIndex = 0;
		_bootElapsed = 0f;
		_bootStatus = "INITIALIZING RIG...";
		_pendingFocusRack = focusRack;
		_lastInputTextLength = 0;
		ResetScrollBootstrap();
	}

	private void ResetScrollBootstrap()
	{
		_scrollBootstrapWarmupFrames = 2;
		_scrollBootstrapRetriesLeft = 6;
		_scrollBootstrapComplete = false;
	}

	protected override void OnDisabled()
	{
		LifePunchMenuInputBlock.NotifyMenuClosed();
		LpBitcoinHudBridge.SetMenuCursorMode( false );
	}

	private LpBitcoinRackEntity _pendingFocusRack;

	public void FocusInput()
	{
		if ( InputBox.IsValid() )
			InputBox.Focus();
	}

	private void FocusLog()
	{
		var log = GetLogScroll();
		if ( log.IsValid() )
			log.Focus();
	}

	private void CopySidebarCommand( string cmd )
	{
		if ( !_bootComplete )
			SkipBoot();

		Clipboard.SetText( cmd );
		_copiedCommandFlash = cmd;
		_copiedCommandFlashSince = 0;
	}

	private bool IsCommandCopied( string cmd ) =>
		!string.IsNullOrEmpty( _copiedCommandFlash ) && _copiedCommandFlash == cmd;

	private void TickCopiedCommandFlash()
	{
		if ( string.IsNullOrEmpty( _copiedCommandFlash ) || _copiedCommandFlashSince < 1.5f )
			return;

		_copiedCommandFlash = null;
		StateHasChanged();
	}

	private void SkipBoot()
	{
		if ( _bootComplete )
			return;

		while ( _bootLineIndex < BootLines.Length )
		{
			AppendLogLine( "dim", BootLines[_bootLineIndex] );
			_bootLineIndex++;
		}

		FinishBoot();
	}

	private void Submit()
	{
		if ( !InputBox.IsValid() )
			return;

		if ( !_bootComplete )
		{
			SkipBoot();
			if ( string.IsNullOrWhiteSpace( InputBox.Text ) )
				return;
		}

		var raw = InputBox.Text?.Trim() ?? string.Empty;
		if ( string.IsNullOrWhiteSpace( raw ) )
			return;

		AppendLogLine( "cmd", $"{PromptLabel} {raw}" );

		if ( raw.Equals( "clear", StringComparison.OrdinalIgnoreCase ) )
		{
			_lines.Clear();
			ClearLogStack();
			_hub?.RequestPushTerminalCommandAlert( raw, "log cleared" );
			InputBox.Text = string.Empty;
			InputBox.Focus();
			QueueScrollLogToBottom( force: true );
			return;
		}

		var result = LpBitcoinTerminalCommands.Execute( _hub, ref _selectedIndex, raw );
		AppendCommandResult( result );
		_hub?.RequestPushTerminalCommandAlert( raw, SummarizeResult( result ) );

		InputBox.Text = string.Empty;
		InputBox.Focus();
		QueueScrollLogToBottom();
	}

	private void AppendCommandResult( LpBitcoinCommandResult result )
	{
		if ( string.IsNullOrWhiteSpace( result.Line ) )
			return;

		foreach ( var line in result.Line.Split( '\n' ) )
		{
			var trimmed = line.TrimEnd();
			if ( string.IsNullOrWhiteSpace( trimmed ) )
				continue;

			AppendLogLine( result.Ok ? "ok" : "err", trimmed );
		}
	}

	private static string SummarizeResult( LpBitcoinCommandResult result )
	{
		if ( string.IsNullOrWhiteSpace( result.Line ) )
			return string.Empty;

		var first = result.Line.Split( '\n' ).FirstOrDefault( l => !string.IsNullOrWhiteSpace( l ) );
		return first?.Trim() ?? string.Empty;
	}

	private void AppendLogLine( string kind, string text )
	{
		var log = GetLogScroll();
		if ( log.IsValid() )
		{
			var maxY = log.GetMaxScrollY();
			var nearBottom = maxY <= 0f || log.ScrollOffset.y >= maxY - 32f;
			log.PreferScrollToBottom = nearBottom;
		}

		_lines.Add( new LogLine( kind, text ) );
		TrimLog();

		var stack = GetLogStack();
		if ( stack.IsValid() )
			AddLogLabel( stack, kind, text );
		else if ( !_scrollBootstrapComplete )
			_scrollBootstrapRetriesLeft = Math.Max( _scrollBootstrapRetriesLeft, 4 );

		ApplyLogScrollChrome();

		if ( log.IsValid() && log.PreferScrollToBottom )
			QueueScrollLogToBottom();
	}

	private void ClearLogStack()
	{
		var stack = GetLogStack();
		if ( !stack.IsValid() )
			return;

		foreach ( var child in stack.Children.ToList() )
			child.Delete();
	}

	private void RebuildLogStackIfNeeded()
	{
		var stack = GetLogStack();
		if ( !stack.IsValid() || stack.Children.Any() || _lines.Count == 0 )
			return;

		foreach ( var line in _lines )
			AddLogLabel( stack, line.Kind, line.Text );
	}

	private void AddLogLabel( Panel stack, string kind, string text )
	{
		var label = new Label
		{
			Text = text,
			Parent = stack,
			Selectable = true,
			ShouldDrawSelection = true,
			SelectionColor = CmdSelectionTint
		};

		label.AddClass( "log-line" );

		var cls = LineClass( new LogLine( kind, text ) );
		if ( !string.IsNullOrEmpty( cls ) )
			label.AddClass( cls );
	}

	private void TrimLog()
	{
		while ( _lines.Count > MaxLogLines )
		{
			_lines.RemoveAt( 0 );

			var stack = GetLogStack();
			if ( !stack.IsValid() || !stack.Children.Any() )
				continue;

			stack.Children.First().Delete();
		}
	}

	private void QueueScrollLogToBottom( bool force = false )
	{
		_scrollLogPendingFrames = Math.Max( _scrollLogPendingFrames, 4 );
		if ( force )
			_scrollLogForce = true;
	}

	private LifePunchScrollRegionPanel GetLogScroll()
		=> LifePunchScrollRegionBootstrap.FindFirstFromHost( this, "log" );

	private Panel GetLogShell()
	{
		if ( Panel is null || !Panel.IsValid )
			return null;

		foreach ( var panel in Panel.Descendants )
		{
			if ( panel.IsValid() && panel.HasClass( "terminal-log-scroll" ) )
				return panel;
		}

		return null;
	}

	private void EnsureLogStack()
	{
		if ( GetLogStack().IsValid() )
			return;

		var log = GetLogScroll() as Panel ?? GetLogShell();
		if ( !log.IsValid() )
			return;

		var stack = new Panel();
		stack.AddClass( "log-stack" );
		stack.Parent = log;
	}

	private Panel GetLogStack()
	{
		var log = GetLogScroll() as Panel ?? GetLogShell();
		if ( !log.IsValid() )
			return null;

		return log.Children.FirstOrDefault( child => child.HasClass( "log-stack" ) );
	}

	private void ApplyLogScrollChrome()
	{
		if ( GetLogScroll() is LpBitcoinTerminalLogPanel terminalLog )
		{
			terminalLog.CopyFallback = BuildLogClipboardText;
			terminalLog.ApplyLineSelectionChrome();
		}
	}

	private void TickScrollBootstrap()
	{
		if ( _scrollBootstrapComplete )
			return;

		if ( _scrollBootstrapWarmupFrames > 0 )
		{
			_scrollBootstrapWarmupFrames--;
			return;
		}

		EnsureLogStack();
		LifePunchScrollRegionBootstrap.UpgradeScrollRegionsFromHost( this );
		ApplyLogScrollChrome();
		RebuildLogStackIfNeeded();

		if ( GetLogScroll().IsValid() )
		{
			_scrollBootstrapComplete = true;
			ResetLogScrollPosition();
			QueueScrollLogToBottom( force: true );
			return;
		}

		if ( _scrollBootstrapRetriesLeft > 0 )
			_scrollBootstrapRetriesLeft--;
		else
			_scrollBootstrapComplete = true;
	}

	private void TickScrollLog()
	{
		TickScrollBootstrap();

		if ( _scrollLogPendingFrames <= 0 )
			return;

		_scrollLogPendingFrames--;
		var log = GetLogScroll();
		if ( !log.IsValid() )
			return;

		log.ScrollToBottom( _scrollLogForce );

		if ( _scrollLogPendingFrames <= 0 )
			_scrollLogForce = false;
	}

	private void ResetLogScrollPosition()
	{
		var log = GetLogScroll();
		if ( !log.IsValid() )
			return;

		if ( log.GetMaxScrollY() <= 0f )
			log.ScrollOffset = Vector2.Zero;
	}

	private void Close() => LpBitcoinTerminalUiHost.CloseOpen();

	private void CopySourceUrl()
	{
		Clipboard.SetText( LifePunchSourceMark.UiFooterUrl );
		_urlCopied = true;
		_ = RevertCopyLabel();
	}

	private async System.Threading.Tasks.Task RevertCopyLabel()
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		_urlCopied = false;
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchMenuInputBlock.Apply();
		LifePunchUiScrollPolicy.Apply( Panel );
		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		if ( !_bootComplete )
			TickBoot();

		TickCommandInputTypingSound();
		ApplyCommandInputChrome();
		TickCopiedCommandFlash();
		TickScrollLog();
		ApplyLogScrollChrome();
	}

	private void TickBoot()
	{
		_bootElapsed += Time.Delta;

		while ( _bootLineIndex < BootLines.Length
		        && _bootElapsed >= BootLineIntervalSeconds * ( _bootLineIndex + 1 ) )
		{
			AppendLogLine( "dim", BootLines[_bootLineIndex] );
			_bootStatus = _bootLineIndex < BootLines.Length - 1
				? $"{BootLines[_bootLineIndex + 1].Split( ' ' )[0].ToUpperInvariant()}..."
				: "READY";
			_bootLineIndex++;
			QueueScrollLogToBottom();
		}

		var bootEnd = BootLineIntervalSeconds * BootLines.Length + BootSplashHoldSeconds;
		if ( _bootLineIndex < BootLines.Length || _bootElapsed < bootEnd )
			return;

		FinishBoot();
	}

	private void FinishBoot()
	{
		_bootComplete = true;
		_showBootSplash = false;
		AppendLogLine( "ok", _hub?.IsPowered == true ? "hub power: ON" : "hub power: OFF" );
		AppendLogLine( "dim", $"type help for {PromptLabel} commands · ctrl+c copies selection or full scrollback" );

		if ( _pendingFocusRack.IsValid() )
		{
			var racks = _hub?.GetLinkedRacks() ?? Array.Empty<LpBitcoinRackEntity>();
			for ( var i = 0; i < racks.Count; i++ )
			{
				if ( racks[i].GameObject.Id != _pendingFocusRack.GameObject.Id )
					continue;

				_selectedIndex = i;
				AppendLogLine( "ok", $"focused {LpBitcoinIdent.FormatRackSlotTerminalToken( racks[i], racks )}" );
				break;
			}
		}

		_pendingFocusRack = null;
		QueueScrollLogToBottom();
		FocusInput();
	}

	private static string BuildLogClipboardText( IReadOnlyList<LogLine> lines )
	{
		if ( lines.Count == 0 )
			return string.Empty;

		return string.Join( "\n", lines.Select( l => l.Text ) );
	}

	private string BuildLogClipboardText() => BuildLogClipboardText( _lines );

	private void ApplyCommandInputChrome()
	{
		if ( !InputBox.IsValid() )
			return;

		InputBox.SelectionColor = CmdSelectionTint;
		InputBox.AcceptsFocus = true;
	}

	private void TickCommandInputTypingSound()
	{
		if ( !InputBox.IsValid() )
			return;

		var length = InputBox.Text?.Length ?? 0;
		if ( length == _lastInputTextLength )
			return;

		_lastInputTextLength = length;
		LpBitcoinUiSounds.PlayKeyboardClick();
	}

	private string SelectedRackSlotLabel()
	{
		var racks = _hub?.GetLinkedRacks();
		if ( racks is null || _selectedIndex < 0 || _selectedIndex >= racks.Count )
			return "—";

		return LpBitcoinIdent.FormatRackSlotTerminalToken( racks[_selectedIndex], racks );
	}

	protected override int BuildHash()
	{
		// Never hash InputBox.Text or log line count — log lines are imperative (no Razor foreach).
		return HashCode.Combine(
			HashCode.Combine(
				_selectedIndex,
				_hub?.IsPowered,
				LinkedRackCount(),
				_uiScale,
				_showScaleMenu,
				_showBootSplash,
				_bootStatus ),
			_bootComplete,
			_urlCopied,
			_copiedCommandFlash );
	}
}
