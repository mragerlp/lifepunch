@namespace LifePunch.BitcoinMining
@using System
@using System.Linq
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root>
    <div class="click-blocker" onclick=@FocusInput></div>

    @* ---- TITLE BAR ---- *@
    <div class="title-bar">
        <span class="title-text">BitOS 1.0 — root@bitminer</span>
        <button class="close-x" onclick=@OnClickClose>✕ CLOSE</button>
    </div>

    @* ---- SCREEN OUTPUT ---- *@
    <div class="screen flex flex-col">
            @foreach ( var line in _lines )
            {
                <div class="p-1">
                    <label class="screen-line @(line.StartsWith("root@") ? "prompt-line" : line.StartsWith("---") ? "divider-line" : line.StartsWith("  ") ? "help-line" : "output-line")">@line</label>
                </div>
            }
        </div>

        @* ---- INPUT ---- *@
        <div class="input-row">
            <span class="prompt-label">root@bitminer:~$</span>
            <TextEntry
                class="terminal-input"
                @ref="InputBox"
                onsubmit=@OnSubmit />
        </div>

</root>

@code {
    public BitminerEntity Miner { get; set; }

    private TextEntry InputBox { get; set; }
    private readonly List<string> _lines = new();
    private bool _liveStatus = false;
    private int _statusLineCount = 0;
    private const int MaxLines = 40;
    private float _smoothProgress = 0f;
    private float _lastKnownProgress = 0f;
    private int _lastTextLength = 0;
    private TimeSince _sinceSecondly = 0f;

    private void TrimLines()
    {
        var limit = _liveStatus ? MaxLines - _statusLineCount : MaxLines;
        if ( _lines.Count > limit )
            _lines.RemoveRange( 0, _lines.Count - limit );
    }

    public static void Open( BitminerEntity miner )
    {
        var terminal = BitminerTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal.Miner = miner;
        terminal.FocusInput();
        terminal.Boot();
    }

    private void CloseTerminal() => BitminerTerminalHost.Close( this );

    private void Boot()
    {
        _lines.Clear();
        _lines.Add( "Found memory (256mb)" );
        _lines.Add( "Found OS" );
        _lines.Add( "Finished loading OS" );
        _lines.Add( "Starting BitOS 1.0" );
        _lines.Add( "------------------------------------" );
        _lines.Add( "Welcome to BitOS! For help on how to operate the device please" );
        _lines.Add( "read the documents included with your hardware or type the" );
        _lines.Add( "command 'help' for a list of useful commands!" );
        _lines.Add( "" );
    }

    private void SecondlyUpdate()
    {
        if ( !Miner.IsValid() )
        {
            CloseTerminal();
            return;
        }

        // Auto-close when the viewer walks too far away.
        var viewerPos = BitminerTerminalHost.LocalViewerPosition( Scene );
        if ( viewerPos.HasValue && viewerPos.Value.Distance( Miner.WorldPosition ) > 150f )
        {
            CloseTerminal();
            return;
        }

        if ( _liveStatus )
            RefreshLiveStatus();
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();

        // Per-second checks (was IGameEvents.OnSecondlyUpdate).
        if ( _sinceSecondly >= 1f )
        {
            _sinceSecondly = 0f;
            SecondlyUpdate();
        }

        if ( !Miner.IsValid() )
            return;

        // Keep input focused every frame to block player movement
        if ( InputBox.IsValid() && !InputBox.HasFocus )
            InputBox.Focus();

        // Block right click while terminal is open
        if ( Input.Pressed( "Attack2" ) )
            Input.Clear( "Attack2" );

        // Block pocket action while terminal is open
        if ( Input.Pressed( "Pocket" ) )
            Input.Clear( "Pocket" );
        if ( Input.Down( "Pocket" ) )
            Input.Clear( "Pocket" );

        if ( InputBox.IsValid() )
        {
            var currentLength = InputBox.Text?.Length ?? 0;
            if ( currentLength != _lastTextLength )
            {
                Sound.Play( "addons/lifepunch/bitcoinmining/sounds/bitminer/keyboard.sound" );
                _lastTextLength = currentLength;
            }
        }

        if ( Miner.IsMining )
        {
            if ( Miner.MiningProgress < _lastKnownProgress - 0.1f )
                _smoothProgress = 0f;
            _lastKnownProgress = Miner.MiningProgress;
            _smoothProgress = MathF.Min( _smoothProgress + Time.Delta / 60f, 1f );
        }
        else
        {
            _smoothProgress = 0f;
        }
    }

    public void FocusInput()
    {
        if ( InputBox.IsValid() )
            InputBox.Focus();
    }

    private void OnClickClose() => CloseTerminal();

    private void OnSubmit()
    {
        if ( !InputBox.IsValid() ) return;

        Sound.Play( "addons/lifepunch/bitcoinmining/sounds/bitminer/keyboard.sound" );

        var input = ( InputBox.Text ?? "" ).Trim().ToLower();
        InputBox.Text = "";
        InputBox.Focus();

        if ( string.IsNullOrWhiteSpace( input ) ) return;

        _lines.Add( $"root@bitminer:~$ {input}" );

        if ( _liveStatus && _statusLineCount > 0 )
        {
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );
            _statusLineCount = 0;
            _liveStatus = false;
        }

        HandleCommand( input );

        _lines.Add( "" );
        TrimLines();
    }

    private void RefreshLiveStatus()
    {
        if ( !Miner.IsValid() ) return;

        int steps = (int)MathF.Floor( _smoothProgress * 10f );
        int pct = steps * 10;
        string bar = new string( '█', steps );

        var statusLines = new List<string>
        {
            "--------------------STATUS------------------",
            $"  Mining:      {( Miner.IsMining ? "● ACTIVE" : "○ STOPPED" )}",
            $"  Bitcoin:     {Miner.BitcoinAmount:0.00000000} BTC",
            $"  Value:       ${Miner.BitcoinAmount * BitminerEntity.BitcoinValue:N0}",
            $"  Clock Speed: {Miner.ClockSpeed:0.000} GHz (Lv {Miner.CpuUpgradeLevel})",
            $"  Cores:       {Miner.CoreCount} (Lv {Miner.CoreUpgradeLevel})",
            $"  Progress:    {pct}% {bar}",
            $"  Rate:        {Miner.ClockSpeed * 0.005f * Miner.CoreCount:0.00000} BTC/min",
            "--------------------------------------------",
        };

        if ( _statusLineCount > 0 )
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );

        _lines.AddRange( statusLines );
        _statusLineCount = statusLines.Count;
        TrimLines();
    }

    private void HandleCommand( string input )
    {
        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";
        var arg = parts.Length > 1 ? parts[1] : "";

        switch ( cmd )
        {
            case "help":
                _lines.Add( "--------------------HELP--------------------" );
                _lines.Add( "  BITCOIN  - Sell or view stored bitcoin balance." );
                _lines.Add( "  INFO     - Output device specifications." );
                _lines.Add( "  MINING   - Start or stop the miner." );
                _lines.Add( "  UPGRADE  - View and purchase upgrades." );
                _lines.Add( "  STATUS   - Show full device status." );
                _lines.Add( "  CLEAR    - Clear the screen." );
                _lines.Add( "  HELP     - Show this list." );
                _lines.Add( "--------------------------------------------" );
                break;

            case "clear":
                _lines.Clear();
                break;

            case "status":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                _liveStatus = true;
                RefreshLiveStatus();
                break;

            case "info":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                _lines.Add( "--------------------INFO--------------------" );
                _lines.Add( $"  Device:      Bitminer S1" );
                _lines.Add( $"  OS:          BitOS 1.0" );
                _lines.Add( $"  CPU Speed:   {Miner.ClockSpeed:0.000} GHz (Lv {Miner.CpuUpgradeLevel})" );
                _lines.Add( $"  CPU Cores:   {Miner.CoreCount} (Lv {Miner.CoreUpgradeLevel})" );
                _lines.Add( $"  Hash Rate:   {Miner.ClockSpeed * 0.05f * Miner.CoreCount:0.0000} BTC/s" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "bitcoin":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                if ( arg == "sell" )
                {
                    if ( Miner.BitcoinAmount <= 0 )
                    {
                        _lines.Add( "ERROR: No bitcoin to sell." );
                        break;
                    }
                    _lines.Add( $"Selling {Miner.BitcoinAmount:0.00000} BTC for ${Miner.BitcoinAmount * BitminerEntity.BitcoinValue:N0}..." );
                    Miner.RequestSellBitcoin();
                    _lines.Add( "Done." );
                }
                else
                {
                    _lines.Add( $"  Balance: {Miner.BitcoinAmount:0.00000} BTC (≈ ${Miner.BitcoinAmount * BitminerEntity.BitcoinValue:N0})" );
                    _lines.Add( "  Use 'bitcoin sell' to cash out." );
                }
                break;

            case "mining":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                if ( arg == "start" )
                {
                    Miner.SetMiningState( true );
                    _lines.Add( "Mining started." );
                }
                else if ( arg == "stop" )
                {
                    Miner.SetMiningState( false );
                    _lines.Add( "Mining stopped." );
                }
                else
                {
                    _lines.Add( $"  Status: {( Miner.IsMining ? "ACTIVE" : "STOPPED" )}" );
                    _lines.Add( "  Use 'mining start' or 'mining stop'." );
                }
                break;

            case "upgrade":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                if ( arg == "cpu" )
                {
                    if ( Miner.CpuUpgradeLevel >= BitminerEntity.CpuUpgradeCosts.Length )
                    {
                        _lines.Add( "CPU Clock is already at max level." );
                    }
                    else
                    {
                        _lines.Add( $"Purchasing CPU upgrade for ${BitminerEntity.CpuUpgradeCosts[Miner.CpuUpgradeLevel]:N0}..." );
                        Miner.RequestUpgrade( BitminerUpgradeType.Cpu );
                        _lines.Add( "Done. Check INFO for updated specs." );
                    }
                }
                else if ( arg == "cores" )
                {
                    if ( Miner.CoreUpgradeLevel >= BitminerEntity.CoreUpgradeCosts.Length )
                    {
                        _lines.Add( "CPU Cores are already at max level." );
                    }
                    else
                    {
                        _lines.Add( $"Purchasing Cores upgrade for ${BitminerEntity.CoreUpgradeCosts[Miner.CoreUpgradeLevel]:N0}..." );
                        Miner.RequestUpgrade( BitminerUpgradeType.Cores );
                        _lines.Add( "Done. Check INFO for updated specs." );
                    }
                }
                else
                {
                    _lines.Add( "--------------------UPGRADES----------------" );
                    _lines.Add( Miner.CpuUpgradeLevel >= BitminerEntity.CpuUpgradeCosts.Length
                        ? $"  CPU Clock: MAXED (Lv {Miner.CpuUpgradeLevel}/{BitminerEntity.CpuUpgradeCosts.Length})"
                        : $"  CPU Clock: Lv {Miner.CpuUpgradeLevel}/{BitminerEntity.CpuUpgradeCosts.Length} — next: ${BitminerEntity.CpuUpgradeCosts[Miner.CpuUpgradeLevel]:N0} — 'upgrade cpu'" );
                    _lines.Add( Miner.CoreUpgradeLevel >= BitminerEntity.CoreUpgradeCosts.Length
                        ? $"  CPU Cores: MAXED (Lv {Miner.CoreUpgradeLevel}/{BitminerEntity.CoreUpgradeCosts.Length})"
                        : $"  CPU Cores: Lv {Miner.CoreUpgradeLevel}/{BitminerEntity.CoreUpgradeCosts.Length} — next: ${BitminerEntity.CoreUpgradeCosts[Miner.CoreUpgradeLevel]:N0} — 'upgrade cores'" );
                    _lines.Add( "--------------------------------------------" );
                }
                break;

            case "credits":
                _lines.Add( "--------------------------------------------" );
                _lines.Add( "  BitOS 1.0 — Bitminer S1" );
                _lines.Add( "  Developed by:" );
                _lines.Add( "" );
                _lines.Add( "  ★  Spl Mute" );
                _lines.Add( "  ★  Null." );
                _lines.Add( "" );
                _lines.Add( "  Thank you for your hard work." );
                _lines.Add( "--------------------------------------------" );
                break;

            default:
                _lines.Add( $"Unknown command: '{cmd}'. Type 'help' for a list of commands." );
                break;
        }
    }

    protected override int BuildHash() =>
        Miner.IsValid()
            ? HashCode.Combine( Miner.BitcoinAmount, Miner.IsMining, Miner.CpuUpgradeLevel, Miner.CoreUpgradeLevel, _lines.Count, (int)( _smoothProgress * 10f ) )
            : _lines.Count;
}
