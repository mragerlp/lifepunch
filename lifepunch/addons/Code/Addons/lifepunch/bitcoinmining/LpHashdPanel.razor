	{
		var cap = LpBitcoinEconomy.RackBtcCapacity( rack.AdvancedRack );
		var state = rack.BitcoinAmount >= cap ? "full" : rack.IsMining ? "mining" : "idle";
		return $"{rack.BitcoinAmount:F6} / {cap:F6} BTC · ${rack.UsdValue:N0} · {state}";
	}

