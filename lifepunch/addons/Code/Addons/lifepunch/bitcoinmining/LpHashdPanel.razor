	private static string RackOverviewSubline( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() )
			return "—";

		var cap = LpBitcoinEconomy.RackBtcCapacity( rack.AdvancedRack );
		var fill = cap > 0f ? (int)Math.Round( 100f * rack.BitcoinAmount / cap ) : 0;
		var rate = rack.IsMining ? $"{rack.MiningRatePerMinute * 18.5f:F1} TH/s" : "idle";
		return $"{rate} · {rack.BitcoinAmount:F4}/{cap:F4} BTC ({fill}%)";
	}

