	private static string AlertTimeLabel( double timestamp )
	{
		var age = Math.Max( 0, Time.Now - timestamp );
		if ( age < 60 )
			return "just now";

		if ( age < 3600 )
			return $"{(int)(age / 60)}m ago";

		return $"{(int)(age / 3600)}h ago";
	}

