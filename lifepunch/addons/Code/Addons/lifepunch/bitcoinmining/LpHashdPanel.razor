   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Bitcoin Miner for DXRP" (s&box ident: lifepunch.bitcoin · addon ident: bitcoinmining)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent
#if !LIFEPUNCH_LOCAL
@using Dxura.RP.Game.UI
#endif

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		@if ( ShowPinGate() )
		{
			<div class="pin-gate">
				<header class="pin-header">
					<div class="pin-brand">
						<div class="brand-mark"></div>
						<div class="pin-brand-copy">
							<div class="pin-title">@( PinSetupMode() ? "SECURE BOOT SETUP" : "SECURE BOOT" )</div>
							<div class="pin-sub">@( PinSetupMode() ? "Create a 4–6 digit hub PIN" : "Enter hub PIN to continue" )</div>
						</div>
					</div>
					<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
						<i class="material-icons">close</i>
					</button>
				</header>

				<div class="pin-body">
					<div class="pin-dots">
						@for ( var i = 0; i < PinTargetLength(); i++ )
						{
							<span class="pin-dot @(i < _pinBuffer.Length ? "filled" : "")"></span>
						}
					</div>
					@if ( !string.IsNullOrWhiteSpace( _pinError ) )
					{
						<div class="pin-error">@_pinError</div>
					}
					@if ( PinSetupMode() && _pinSetupPass == 1 )
					{
						<div class="pin-hint">Confirm your PIN</div>
					}

					<div class="pin-pad">
						@foreach ( var key in _pinKeys )
						{
							<button class="pin-key @(key == "ok" ? "ok" : "") @(key == "clr" ? "clr" : "")"
							        onclick="@(() => PressPinKey(key))">
								@if ( key == "clr" )
								{
									<i class="material-icons">backspace</i>
								}
								else if ( key == "ok" )
								{
									<i class="material-icons">check</i>
								}
								else
								{
									<span>@key</span>
								}
							</button>
						}
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="hub-body">
				<div class="hub-main">
					<aside class="sidebar">
						<div class="sidebar-brand hex-mark" title="@LpBitcoinIdent.OpsTitle">
							<div class="brand-mark"></div>
						</div>

						<nav class="sidebar-nav">
							@foreach ( var tab in _tabs )
							{
								<button class="sidebar-btn @(tab == _active ? "active" : "")"
								        tooltip="@TabLabel(tab)"
								        onclick="@(() => SelectTab(tab))">
									<i class="material-icons">@TabIcon(tab)</i>
								</button>
							}
						</nav>

						<div class="sidebar-foot">
							<div class="sidebar-avatar" title="@GreetingName()">@AvatarInitial()</div>
						</div>
					</aside>

					<div class="workspace">
						<header class="page-header mock-header">
							<div class="mock-greeting">Hi, @GreetingName()!</div>

							<div class="header-widgets">
								<button class="header-chip wallet-chip" onclick="@SelectWalletTab">
									<i class="material-icons">account_balance_wallet</i>
									<span>@HeaderWalletBtc() BTC</span>
								</button>
								<div class="header-chip date-chip">
									<i class="material-icons">calendar_today</i>
									<span>@HeaderDateLabel()</span>
								</div>
								<button class="header-chip notif-chip" tooltip="Hub alerts">
									<i class="material-icons">notifications</i>
									<span class="notif-dot"></span>
								</button>
								<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
									<i class="material-icons">close</i>
								</button>
							</div>
						</header>

						<div class="workspace-body">
							<div class="main-panel">
								@if ( _active == OpsTab.Overview )
								{
									<div class="pane overview-mock">
										<div class="mock-layout">
											<div class="mock-main">
												<div class="hero-row">
													<div class="hero-btc-card">
														<div class="hero-btc-watermark"></div>
														<div class="hero-label">Total BTC mined</div>
														<div class="hero-btc-value">@TotalBtc().ToString("F6") BTC</div>
														<div class="hero-btc-sub">~ $@TotalUsd().ToString("N2")</div>
													</div>

													<div class="hero-hash-card">
														<div class="hero-hash-watermark">#</div>
														<div class="hero-label">Hash rate</div>
														<div class="hero-hash-value">@HashRateLabel()</div>
														<div class="hero-hash-delta @(MiningRackCount() > 0 ? "up" : "")">@HashRateDeltaLabel()</div>
													</div>
												</div>

												<div class="mid-row">
													<div class="perf-card">
														<div class="card-top">
															<span class="card-title">Mining performance</span>
															<div class="range-toggle">
																@foreach ( var range in _perfRanges )
																{
																	<button class="range-btn @( _perfRange == range ? "active" : "" )"
																	        onclick="@(() => SetPerfRange( range ))">@PerfRangeLabel( range )</button>
																}
															</div>
														</div>
														<div class="perf-chart">
															@for ( var i = 0; i < 7; i++ )
															{
																<div class="perf-col @(i == PerfHighlightIndex() ? "active" : "")">
																	<div class="perf-bar" style="height: @(PerfBarHeight(i))%"></div>
																	<div class="perf-day">@PerfDayLabel(i)</div>
																</div>
															}
														</div>
													</div>

													<div class="profit-card">
														<div class="card-top">
															<span class="card-title">Profit estimate</span>
															<div class="range-toggle">
																@foreach ( var range in _perfRanges )
																{
																	<button class="range-btn @( _profitRange == range ? "active" : "" )"
																	        onclick="@(() => SetProfitRange( range ))">@PerfRangeLabel( range )</button>
																}
															</div>
														</div>
														<div class="profit-value">$@ProfitEstimate().ToString("N2")</div>
														<button class="profit-calc" onclick="@SelectWalletTab">
															Calculate <i class="material-icons">open_in_new</i>
														</button>
													</div>
												</div>

												<div class="miners-table-card">
													<div class="card-top">
														<span class="card-title">Active miners</span>
														<button class="icon-link" onclick="@SelectRacksTab">
															<i class="material-icons">open_in_new</i>
														</button>
													</div>

													@if ( LinkedRackCount() == 0 )
													{
														<div class="miners-empty">
															<i class="material-icons">dns</i>
															<span>Place GPU racks near this hub — they auto-link on spawn.</span>
														</div>
													}
													else
													{
														<div class="miners-table-head">
															<span>Miner</span>
															<span>Status</span>
															<span>Hash rate</span>
															<span>Temp</span>
															<span>Uptime</span>
															<span></span>
														</div>
														<div class="miners-table-body">
															@for ( var i = 0; i < GetLinkedRacks().Count; i++ )
															{
																var rack = GetLinkedRacks()[i];
																<div class="miners-table-row">
																	<div class="col-miner">
																		<div class="miner-thumb">
																			<i class="material-icons">@(rack.AdvancedRack ? "view_module" : "storage")</i>
																		</div>
																		<span class="miner-name">@RackDisplayName( rack, i )</span>
																	</div>
																	<div class="col-status">
																		<span class="status-dot @(rack.IsMining ? "on" : "off")"></span>
																		<span>@(rack.IsMining ? "On" : "Off")</span>
																	</div>
																	<div class="col-hash">@RackHashRateLabel( rack )</div>
																	<div class="col-temp">@RackTempLabel( rack )</div>
																	<div class="col-uptime">@RackUptimeLabel( rack, i )</div>
																	<div class="col-actions">
																		<button class="kebab-btn" tooltip="Open terminal" onclick="@(() => OpenTerminal(rack))">
																			<i class="material-icons">more_vert</i>
																		</button>
																	</div>
																</div>
															}
														</div>
													}
												</div>
											</div>

											<aside class="server-status-rail">
												<div class="server-status-head">
													<div class="server-status-title">Mining server status</div>
													<div class="server-status-meta">
														<span class="server-temp">@HubTempLabel()</span>
														<span class="status-dot @(Hub?.IsPowered == true ? "on" : "off")"></span>
														<span>@(Hub?.IsPowered == true ? "On" : "Off")</span>
													</div>
												</div>

												<div class="server-visual">
													<div class="server-visual-mark"></div>
													<div class="server-visual-name">@HubDisplayName()</div>
												</div>

												<div class="server-stats-overlay">
													<div class="server-stat">
														<i class="material-icons">device_thermostat</i>
														<div class="server-stat-copy">
															<div class="server-stat-value">@HubPeakTempLabel()</div>
															<div class="server-stat-label">24h high</div>
														</div>
													</div>
													<div class="server-stat">
														<i class="material-icons">pie_chart</i>
														<div class="server-stat-copy">
															<div class="server-stat-value">@MiningLoadPercent()%</div>
															<div class="server-stat-label">CPU usage</div>
														</div>
													</div>
													<div class="server-stat">
														<i class="material-icons">local_fire_department</i>
														<div class="server-stat-copy">
															<div class="server-stat-value">@HubPowerDrawLabel()</div>
															<div class="server-stat-label">Power draw</div>
														</div>
													</div>
												</div>

												<button class="cta-pill server-cta" onclick="@SelectRacksTab">
													View all details <i class="material-icons">north_east</i>
												</button>
											</aside>
										</div>
									</div>
								}
					else if ( _active == OpsTab.Racks )
					{
						<div class="pane racks">
							<div class="pane-head">
								<div class="pane-title">GPU racks</div>
								<div class="pane-sub">@LinkedRackCount() linked · terminal index matches list order</div>
							</div>

							@if ( LinkedRackCount() == 0 )
							{
								<div class="empty-card">
									<i class="material-icons">dns</i>
									<div>Place GPU racks near this hub — they auto-link on spawn.</div>
								</div>
							}
							else
							{
								<div class="rack-list">
									@for ( var i = 0; i < GetLinkedRacks().Count; i++ )
									{
										var rack = GetLinkedRacks()[i];
										<div class="rack-card">
											<div class="rack-main">
												<div class="rack-icon">
													<i class="material-icons">@(rack.AdvancedRack ? "view_module" : "storage")</i>
												</div>
												<div class="rack-copy">
													<div class="rack-title">#@i @(rack.AdvancedRack ? LpBitcoinIdent.AdvancedRackDisplayName : LpBitcoinIdent.RackDisplayName)</div>
													<div class="rack-sub">@(rack.BitcoinAmount.ToString("F6")) BTC · $@(rack.UsdValue)</div>
													<div class="rack-sub">@(rack.ClockGhz.ToString("F2")) GHz · x@(rack.CoreCount) cores · yield x@(rack.YieldMultiplier.ToString("F1"))</div>
												</div>
												<span class="status-pill @(rack.IsMining ? "active" : "idle")">
													@(rack.IsMining ? "Mining" : "Idle")
												</span>
											</div>
											<div class="rack-actions">
												<button class="ghost small @(!CanUpgradeCpu(rack) ? "disabled" : "")" onclick="@(() => UpgradeCpu(rack))">CPU $@UpgradeCpuCost(rack)</button>
												<button class="ghost small @(!CanUpgradeCores(rack) ? "disabled" : "")" onclick="@(() => UpgradeCores(rack))">Core $@UpgradeCoreCost(rack)</button>
												<button class="ghost small accent" onclick="@(() => OpenTerminal(rack))">Terminal</button>
											</div>
										</div>
									}
								</div>
							}
						</div>
					}
					else if ( _active == OpsTab.Wallet )
					{
						<div class="pane wallet">
							<div class="pane-head">
								<div class="pane-title">Wallet payout</div>
								<div class="pane-sub">Cash out linked rack balances to your DXRP wallet</div>
							</div>

							<div class="dash-card wallet-card">
								<div class="card-head">
									<span class="card-label">Rack BTC total</span>
									<span class="tag-pill">@LpBitcoinIdent.BtcEmoji</span>
								</div>
								<div class="balance-value">@TotalBtc().ToString("F6")</div>
								<div class="balance-sub">$@TotalUsd() USD at $@LpBitcoinEconomy.BitcoinValueUsd / BTC</div>
								<div class="balance-sub">Your cash: $@LpHashdUiHost.GetLocalWalletCash()</div>
							</div>

							<div class="wallet-actions">
								<button class="cta-pill wide @(TotalBtc() <= 0f ? "disabled" : "")" onclick="@SellAllRacks">Sell all rack BTC</button>
								<button class="ghost" onclick="@(() => OpenTerminal( null ))">Open CRT terminal</button>
							</div>

							<div class="hint-card">
								<i class="material-icons">info</i>
								<span>Per-rack sell and mining control stay on the CRT terminal (`sell`, `mining start`).</span>
							</div>
						</div>
					}
					else if ( _active == OpsTab.Settings )
					{
						<div class="pane settings-pane">
							<div class="pane-head">
								<div class="pane-title">Settings</div>
								<div class="pane-sub">Hub power, UI scale, and security</div>
							</div>

							<div class="settings-group">
								<div class="settings-label">UI Scale</div>
								<div class="settings-hint">Resize the hub admin window.</div>
								<div class="panel-size-row">
									@foreach ( var size in _uiScaleOptions )
									{
										<button class="panel-size-opt @( _uiScale == size ? "active" : "" )"
										        onclick="@(() => SetUiScale( size ))">
											@LpUiScale.ShortLabel( size )
										</button>
									}
								</div>
							</div>

							<div class="settings-group">
								<div class="settings-label">Hub Power</div>
								<div class="settings-hint">Turn the HASHD hub on or off. Racks stop accruing when power is off.</div>
								<div class="split-actions">
									<button class="pill @(Hub?.IsPowered == true ? "active" : "")" onclick="@PowerOn">Power on</button>
									<button class="pill @(Hub?.IsPowered != true ? "active" : "")" onclick="@PowerOff">Power off</button>
								</div>
							</div>

							<div class="settings-group">
								<div class="settings-label">Security</div>
								<div class="settings-hint">@( Hub?.AccessPinIsSet == true ? "Hub PIN is active. PIN change ships in a later pass." : "Set your PIN on first hub USE via Secure Boot." )</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
		</div>
		<LifePunchUiFooter />
	</div>
		}
	</div>
</root>

@code
{
	private enum OpsTab { Overview, Wallet, Racks, Settings }
	private enum PerfRange { Day, Week, Month }

	private static readonly OpsTab[] _tabs = { OpsTab.Overview, OpsTab.Wallet, OpsTab.Racks, OpsTab.Settings };
	private static readonly PerfRange[] _perfRanges = { PerfRange.Day, PerfRange.Week, PerfRange.Month };

	private OpsTab _active = OpsTab.Overview;
	private PerfRange _perfRange = PerfRange.Week;
	private PerfRange _profitRange = PerfRange.Week;
	private bool _pinUnlocked;
	private string _pinBuffer = "";
	private string _pinConfirmDraft = "";
	private string _pinError = "";
	private int _pinSetupPass;
	private static readonly string[] _pinKeys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "clr", "0", "ok" };
	private LpUiScaleSize _uiScale = LpUiScaleSize.Large;
	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};
	private LpBitcoinHubEntity _hub;

	public LpBitcoinHubEntity Hub => _hub;

	public void BindHub( LpBitcoinHubEntity hub )
	{
		_hub = hub;
		_pinUnlocked = hub is null;
		_pinBuffer = "";
		_pinConfirmDraft = "";
		_pinError = "";
		_pinSetupPass = 0;
	}

	/// <summary>Dev preview ConCmds — skip secure-boot gate so the dashboard is visible immediately.</summary>
	public void DevBypassPinGate() => _pinUnlocked = true;

	protected override void OnEnabled()
	{
#if !LIFEPUNCH_LOCAL
		HUD.SetCursorUnlockRequest( this, true );
#endif
	}

	protected override void OnDisabled()
	{
#if !LIFEPUNCH_LOCAL
		HUD.SetCursorUnlockRequest( this, false );
#endif
	}

	private string StatusLabel() => Hub?.IsPowered == true ? "POWER ON" : "POWER OFF";

	private string AvatarInitial()
	{
		var name = GreetingName();
		return string.IsNullOrWhiteSpace( name ) ? "O" : name.Substring( 0, 1 ).ToUpperInvariant();
	}

	private string HeaderWalletBtc() => TotalBtc().ToString( "F4" );

	private static string HeaderDateLabel() => DateTime.Now.ToString( "MMMM, yyyy" );

	private string HashRateLabel()
	{
		var th = TotalMiningRate() * 18.5f;
		return th <= 0.01f ? "0.0 TH/s" : $"{th:F1} TH/s";
	}

	private string HashRateDeltaLabel()
	{
		if ( MiningRackCount() == 0 )
			return "Idle";

		var delta = 1.5f + MiningLoadPercent() * 0.02f;
		return $"+{delta:F1}%";
	}

	private static string PerfRangeLabel( PerfRange range ) => range switch
	{
		PerfRange.Day => "D",
		PerfRange.Week => "W",
		PerfRange.Month => "M",
		_ => "W"
	};

	private void SetPerfRange( PerfRange range ) => _perfRange = range;
	private void SetProfitRange( PerfRange range ) => _profitRange = range;

	private static string PerfDayLabel( int index )
	{
		var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
		return days[Math.Clamp( index, 0, days.Length - 1 )];
	}

	private int PerfHighlightIndex() => ((int)DateTime.Now.DayOfWeek + 6) % 7;

	private int PerfBarHeight( int index )
	{
		var seed = (int)(TotalMiningRate() * 1000f) + index * 17 + MiningLoadPercent() * 3;
		return 24 + Math.Abs( seed % 62 );
	}

	private float ProfitEstimate()
	{
		var hourlyBtc = TotalMiningRate() * 60f;
		var multiplier = _profitRange switch
		{
			PerfRange.Day => 24f,
			PerfRange.Month => 24f * 30f,
			_ => 24f * 7f
		};

		return hourlyBtc * multiplier * LpBitcoinEconomy.BitcoinValueUsd;
	}

	private static string RackDisplayName( LpBitcoinRackEntity rack, int index )
	{
		if ( !rack.IsValid() )
			return $"Rack {index}";

		return rack.AdvancedRack ? $"Adv-{index + 12}" : $"GPU-{index + 35}";
	}

	private static string RackHashRateLabel( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() || !rack.IsMining )
			return "--";

		return $"{rack.MiningRatePerMinute * 18.5f:F1} TH/s";
	}

	private static string RackTempLabel( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() || !rack.IsMining )
			return "--";

		var seed = rack.GameObject.Id.GetHashCode();
		return $"{58 + Math.Abs( seed % 11 )}°C";
	}

	private static string RackUptimeLabel( LpBitcoinRackEntity rack, int index )
	{
		if ( !rack.IsValid() || !rack.IsMining )
			return "--";

		var days = 1 + index * 2;
		var hours = 3 + index * 4;
		return $"{days}d {hours}h 12m";
	}

	private string HubDisplayName() => "HASHD Hub";

	private string HubTempLabel()
	{
		if ( Hub?.IsPowered != true )
			return "--°C";

		return $"{56 + MiningLoadPercent() / 4}°C";
	}

	private string HubPeakTempLabel()
	{
		if ( Hub?.IsPowered != true )
			return "--°C";

		return $"{62 + MiningLoadPercent() / 5}°C";
	}

	private string HubPowerDrawLabel()
	{
		if ( Hub?.IsPowered != true )
			return "0W";

		var baseDraw = 420;
		var rackDraw = MiningRackCount() * 260;
		return $"{baseDraw + rackDraw}W";
	}

	private static string TabIcon( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "home",
		OpsTab.Wallet => "account_balance_wallet",
		OpsTab.Racks => "dns",
		OpsTab.Settings => "settings",
		_ => "home"
	};

	private static string TabLabel( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "Overview",
		OpsTab.Wallet => "Wallet",
		OpsTab.Racks => "Servers",
		OpsTab.Settings => "Settings",
		_ => "Overview"
	};

	private void SelectTab( OpsTab tab ) => _active = tab;
	private void SelectWalletTab() => SelectTab( OpsTab.Wallet );
	private void SelectRacksTab() => SelectTab( OpsTab.Racks );
	private void OpenSettings() => SelectTab( OpsTab.Settings );
	private string GetRootClass() => $"lp-bitcoin-ops {LpUiScale.CssClass( _uiScale )}";
	private void SetUiScale( LpUiScaleSize size ) => _uiScale = size;
	private void Close() => LpHashdUiHost.CloseOpen();
	private void PowerOn() => Hub?.SetPowered( true );
	private void PowerOff() => Hub?.SetPowered( false );

	private bool ShowPinGate() => Hub is not null && !_pinUnlocked;
	private bool PinSetupMode() => Hub is not null && !Hub.AccessPinIsSet;
	private int PinTargetLength() => LpBitcoinHubPin.MaxDigits;

	private void PressPinKey( string key )
	{
		if ( Hub is null )
			return;

		if ( key == "clr" )
		{
			_pinBuffer = "";
			_pinError = "";
			if ( PinSetupMode() && _pinSetupPass == 1 )
			{
				_pinSetupPass = 0;
				_pinConfirmDraft = "";
			}

			return;
		}

		if ( key == "ok" )
		{
			if ( _pinBuffer.Length < LpBitcoinHubPin.MinDigits )
				return;

			if ( PinSetupMode() )
			{
				if ( _pinSetupPass == 0 )
				{
					_pinConfirmDraft = _pinBuffer;
					_pinBuffer = "";
					_pinSetupPass = 1;
					_pinError = "";
					return;
				}

				Hub.RequestSetAccessPin( _pinConfirmDraft, _pinBuffer );
				return;
			}

			Hub.RequestUnlockAccessPin( _pinBuffer );
			return;
		}

		if ( _pinBuffer.Length >= LpBitcoinHubPin.MaxDigits )
			return;

		_pinBuffer += key;
	}

	public void OnPinGateResult( bool success, string message )
	{
		if ( success )
		{
			_pinUnlocked = true;
			_pinBuffer = "";
			_pinConfirmDraft = "";
			_pinError = "";
			_pinSetupPass = 0;
			return;
		}

		_pinBuffer = "";
		_pinError = string.IsNullOrWhiteSpace( message ) ? "Access denied." : message;
		if ( PinSetupMode() )
		{
			_pinSetupPass = 0;
			_pinConfirmDraft = "";
		}
	}

	private void SellAllRacks()
	{
		if ( TotalBtc() <= 0f )
			return;

		Hub?.RequestSellAllRacks();
	}

	private string GreetingName()
	{
		var name = Connection.Local?.DisplayName;
		if ( string.IsNullOrWhiteSpace( name ) )
			return "Operator";

		var first = name.Split( ' ', StringSplitOptions.RemoveEmptyEntries ).FirstOrDefault();
		return string.IsNullOrWhiteSpace( first ) ? "Operator" : first;
	}

	private int LinkedRackCount() => GetLinkedRacks().Count;

	private List<LpBitcoinRackEntity> GetLinkedRacks()
		=> Hub.IsValid() ? Hub.GetLinkedRacks().ToList() : new List<LpBitcoinRackEntity>();

	private float TotalBtc() => GetLinkedRacks().Sum( r => r.BitcoinAmount );

	private int TotalUsd() => GetLinkedRacks().Sum( r => r.UsdValue );

	private int MiningRackCount() => GetLinkedRacks().Count( r => r.IsMining );

	private float TotalMiningRate()
	{
		if ( Hub?.IsPowered != true )
			return 0f;

		return GetLinkedRacks()
			.Where( r => r.IsMining )
			.Sum( r => r.MiningRatePerMinute );
	}

	private int MiningLoadPercent()
	{
		var total = LinkedRackCount();
		if ( total == 0 )
			return 0;

		return (int)Math.Round( 100f * MiningRackCount() / total );
	}

	private bool CanUpgradeCpu( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CpuUpgradeLevel < LpBitcoinEconomy.CpuUpgradeCosts.Length;

	private bool CanUpgradeCores( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CoreUpgradeLevel < LpBitcoinEconomy.CoreUpgradeCosts.Length;

	private string UpgradeCpuCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCpu( rack ) ? $"{LpBitcoinEconomy.CpuUpgradeCosts[rack.CpuUpgradeLevel]:N0}" : "MAX";

	private string UpgradeCoreCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCores( rack ) ? $"{LpBitcoinEconomy.CoreUpgradeCosts[rack.CoreUpgradeLevel]:N0}" : "MAX";

	private void UpgradeCpu( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCpu( rack ) )
			return;

		_hub?.RequestUpgradeCpu( rack.GameObject.Id );
	}

	private void UpgradeCores( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCores( rack ) )
			return;

		_hub?.RequestUpgradeCores( rack.GameObject.Id );
	}

	private void OpenTerminal( LpBitcoinRackEntity rack )
	{
		if ( Hub is null )
			return;

		var target = rack;
		if ( target is null )
			target = GetLinkedRacks().FirstOrDefault();

		if ( target is null )
			return;

		Close();
		LpBitcoinTerminalUiHost.Open( _hub, target );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		if ( !_hub.IsValid() )
			Close();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( _active );
		hash.Add( _uiScale );
		hash.Add( _pinUnlocked );
		hash.Add( _pinBuffer );
		hash.Add( _pinSetupPass );
		hash.Add( _pinError );
		hash.Add( _hub?.IsPowered );
		hash.Add( _hub?.AccessPinIsSet );
		hash.Add( _perfRange );
		hash.Add( _profitRange );
		hash.Add( LinkedRackCount() );
		hash.Add( TotalBtc() );
		hash.Add( MiningRackCount() );
		hash.Add( TotalMiningRate() );
		return hash.ToHashCode();
	}
}
