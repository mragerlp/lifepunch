	private int PerfBarHeight( int index )
	{
		var seed = (int)(TotalMiningRate() * 1000f) + index * 17 + MiningLoadPercent() * 3;
		return 24 + Math.Abs( seed % 62 );
	}

	private float ProfitEstimate()
	{
		var hourlyBtc = TotalMiningRate() * 60f;
		var multiplier = _profitRange switch
		{
			PerfRange.Day => 24f,
			PerfRange.Month => 24f * 30f,
			_ => 24f * 7f
		};

		return hourlyBtc * multiplier * LpBitcoinEconomy.BitcoinValueUsd;
	}

