	private string PinEntryLabel()
	{
		if ( PinSetupMode() )
			return _pinSetupPass == 1 ? "CONFIRM PIN" : "ENTER PIN";

		return "PIN";
	}

	private void PressPinKey( string key )
	{
		if ( Hub is null )
			return;

		if ( key == "clr" )
		{
			_pinBuffer = "";
			_pinError = "";
			if ( PinSetupMode() && _pinSetupPass == 1 )
			{
				_pinSetupPass = 0;
				_pinConfirmDraft = "";
			}

			return;
		}

		if ( key == "ok" )
		{
			if ( _pinBuffer.Length < LpBitcoinHubPin.MinDigits )
				return;

			if ( PinSetupMode() )
			{
				if ( _pinSetupPass == 0 )
				{
					_pinConfirmDraft = _pinBuffer;
					_pinBuffer = "";
					_pinSetupPass = 1;
					_pinError = "";
					return;
				}

				Hub.RequestSetAccessPin( _pinConfirmDraft, _pinBuffer );
				return;
			}

			Hub.RequestUnlockAccessPin( _pinBuffer );
			return;
		}

		if ( _pinBuffer.Length >= LpBitcoinHubPin.MaxDigits )
			return;

		_pinBuffer += key;
	}

	public void OnPinGateResult( bool success, string message )
	{
		if ( success )
		{
			_pinUnlocked = true;
			_pinBuffer = "";
			_pinConfirmDraft = "";
			_pinError = "";
			_pinSetupPass = 0;
			return;
		}

		_pinBuffer = "";
		_pinError = string.IsNullOrWhiteSpace( message ) ? "Access denied." : message;
		if ( PinSetupMode() )
		{
			_pinSetupPass = 0;
			_pinConfirmDraft = "";
		}
	}

