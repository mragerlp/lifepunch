@* ─────────────────────────────────────────────────────────────────────────────
   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Bitcoin Miner for DXRP" (s&box ident: lifepunch.bitcoin · addon ident: bitcoinmining)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		@if ( ShowPinGate() )
		{
			<div class="pin-gate">
				<header class="pin-header">
					<div class="pin-brand">
						<div class="brand-mark"></div>
						<div class="pin-brand-copy">
							<div class="pin-title">@( PinSetupMode() ? "SECURE BOOT SETUP" : "SECURE BOOT" )</div>
							<div class="pin-sub">@( PinSetupMode() ? "Create a 4-digit hub PIN" : "Enter your 4-digit hub PIN" )</div>
						</div>
					</div>
					<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
						<i class="material-icons">close</i>
					</button>
				</header>

				<div class="pin-body">
					<div class="pin-entry">
						<div class="pin-label">@PinEntryLabel()</div>
						<div class="pin-dots">
							@for ( var i = 0; i < PinTargetLength(); i++ )
							{
								<span class="pin-dot @(i < _pinBuffer.Length ? "filled" : "")"></span>
							}
						</div>
					</div>
					@if ( !string.IsNullOrWhiteSpace( _pinError ) )
					{
						<div class="pin-error">@_pinError</div>
					}

					<div class="pin-pad">
						@foreach ( var key in _pinKeys )
						{
							<button class="pin-key @(key == "ok" ? "ok" : "") @(key == "clr" ? "clr" : "")"
							        onclick="@(() => PressPinKey(key))">
								@if ( key == "clr" )
								{
									<i class="material-icons">backspace</i>
								}
								else if ( key == "ok" )
								{
									<i class="material-icons">check</i>
								}
								else
								{
									<span>@key</span>
								}
							</button>
						}
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="hub-body">
				<div class="hub-main">
					<aside class="sidebar">
						<div class="sidebar-brand hex-mark" title="@LpBitcoinIdent.OpsTitle">
							<div class="brand-mark"></div>
						</div>

						<nav class="sidebar-nav">
							@foreach ( var tab in _tabs )
							{
								<button class="sidebar-btn @(tab == _active ? "active" : "")"
								        tooltip="@TabLabel(tab)"
								        onclick="@(() => SelectTab(tab))">
									<i class="material-icons">@TabIcon(tab)</i>
								</button>
							}
						</nav>

						<div class="sidebar-foot">
							<div class="sidebar-avatar" title="@GreetingName()">
								@if ( LocalSteamId() > 0 )
								{
									<img class="sidebar-avatar-img" src="avatar:@LocalSteamId()"/>
								}
								else
								{
									<span class="sidebar-avatar-fallback">@AvatarInitial()</span>
								}
							</div>
						</div>
					</aside>

					<div class="workspace">
						<header class="page-header hub-header">
							<div class="lp-ui-panel-title hub-title">
								<i class="material-icons">memory</i>
								<span>@LpBitcoinIdent.OpsTitle</span>
							</div>

							<div class="header-widgets">
								<button class="header-chip wallet-chip" onclick="@SelectWalletTab">
									<i class="material-icons">account_balance_wallet</i>
									<span>@HeaderWalletBtc() BTC</span>
								</button>
								<div class="header-chip date-chip">
									<i class="material-icons">calendar_today</i>
									<span>@HeaderDateLabel()</span>
								</div>
								<button class="header-chip notif-chip @(HasUnreadAlerts() ? "has-unread" : "")"
								        tooltip="Hub logs"
								        onclick="@SelectLogsTab">
									<i class="material-icons">notifications</i>
									@if ( HasUnreadAlerts() )
									{
										<span class="notif-dot"></span>
									}
								</button>
								<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
									<i class="material-icons">close</i>
								</button>
							</div>
						</header>

						<div class="workspace-body">
							<div class="main-panel">
								@if ( _active == OpsTab.Overview )
								{
									<div class="pane overview">
										<div class="lp-ui-intro">
											Manage linked GPU racks, wallet payout, and hub power from this panel. Place racks near the hub and they auto-link on spawn.
										</div>

										<div class="lp-ui-split">
											<div class="lp-ui-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">dns</i>
													<span>Active miners</span>
												</div>

												@if ( LinkedRackCount() == 0 )
												{
													<div class="lp-ui-empty">
														<i class="material-icons">dns</i>
														<span>Place GPU racks near this hub — they auto-link on spawn.</span>
													</div>
												}
												else
												{
													<div class="lp-ui-scroll lp-ui-scroll-region">
														<div class="lp-ui-list">
															@for ( var i = 0; i < GetLinkedRacks().Count; i++ )
															{
																var rack = GetLinkedRacks()[i];
																<div class="lp-ui-list-row">
																	<div class="lp-ui-list-main">
																		<div class="lp-ui-list-title">@RackSlotLabel( rack )</div>
																		<div class="lp-ui-list-sub rack-stats">@RackOverviewSubline( rack )</div>
																	</div>
																	<div class="lp-ui-list-meta">
																		<div class="lp-ui-list-value">@(rack.IsMining ? "Mining" : "Idle")</div>
																		<div class="lp-ui-list-tag">
																			<span class="lp-ui-status-dot @(rack.IsMining ? "on" : "off")"></span>
																		</div>
																	</div>
																</div>
															}
														</div>
													</div>
												}
											</div>

											<div class="lp-ui-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">analytics</i>
													<span>Hub status</span>
												</div>

												<div class="lp-ui-info">
													<div class="lp-ui-info-row">
														<span class="lp-ui-info-label">Total mined</span>
														<span class="lp-ui-info-value">@CombinedBtc().ToString("F6") BTC</span>
													</div>
													<div class="lp-ui-info-row">
														<span class="lp-ui-info-label">USD value</span>
														<span class="lp-ui-info-value">$@CombinedUsd().ToString("N2")</span>
													</div>
													<div class="lp-ui-info-row">
														<span class="lp-ui-info-label">Hash rate</span>
														<span class="lp-ui-info-value">@HashRateLabel()</span>
													</div>
													<div class="lp-ui-info-row">
														<span class="lp-ui-info-label">Hub power</span>
														<span class="lp-ui-info-value">
															<span class="lp-ui-status-dot @(Hub?.IsPowered == true ? "on" : "off")"></span>
															<span>@HubPowerStatusLabel()</span>
														</span>
													</div>
													<div class="lp-ui-info-row">
														<span class="lp-ui-info-label">Load / draw</span>
														<span class="lp-ui-info-value">@LoadDrawLabel()</span>
													</div>
												</div>

												<div class="lp-ui-perks">
													<div class="lp-ui-perk">@LinkedRackCount() linked rack@(LinkedRackCount() == 1 ? "" : "s")</div>
													<div class="lp-ui-perk">@MiningRackCount() mining now</div>
													<div class="lp-ui-perk">Hub wallet @HubWalletBtc().ToString("F4") BTC · @RackPendingBtc().ToString("F4") BTC on racks</div>
												</div>

												<div class="lp-ui-btn-row">
													<button class="lp-ui-btn-primary" onclick="@SelectRacksTab">Manage racks</button>
													<button class="lp-ui-btn-ghost" onclick="@SelectWalletTab">Wallet</button>
													<button class="lp-ui-btn-ghost" onclick="@SelectTransfersTab">Transfers</button>
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Racks )
								{
									<div class="pane racks">
										<div class="lp-ui-panel racks-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">dns</i>
												<span>GPU racks</span>
											</div>

											@if ( LinkedRackCount() > 0 )
											{
												<div class="lp-ui-intro">
													Rack IDs (<strong>GPURack-1</strong>, <strong>AdvancedGPURack-1</strong>, …) match rig0 slots at the terminal. Upgrade CPU and cores here — start/stop mining on the CRT.
												</div>
											}

											@if ( LinkedRackCount() == 0 )
											{
												<div class="lp-ui-empty">
													<i class="material-icons">dns</i>
													<span>Place GPU racks near this hub — they auto-link on spawn.</span>
												</div>
											}
											else
											{
												<div class="lp-ui-scroll lp-ui-scroll-region racks-scroll">
													<div class="rack-grid">
														@for ( var i = 0; i < GetLinkedRacks().Count; i++ )
														{
															var rack = GetLinkedRacks()[i];
															<div class="rack-card">
																<div class="rack-card-head">
																	<div class="rack-card-title">@RackSlotLabel( rack )</div>
																	<div class="rack-card-badges">
																		<span class="rack-badge @(rack.IsMining ? "on" : "")">@(rack.IsMining ? "Mining" : "Idle")</span>
																		<span class="rack-badge dim">@RackYieldLabel( rack )</span>
																	</div>
																</div>
																<div class="rack-card-stats">
																	<div class="rack-stat-line">@RackBtcLine( rack )</div>
																	<div class="rack-stat-line">@RackHardwareLine( rack )</div>
																	<div class="rack-stat-line">@RackUpgradeLine( rack )</div>
																</div>
																<div class="rack-card-actions">
																	<button class="lp-ui-btn-ghost @(!CanUpgradeCpu( rack ) ? "disabled" : "")" onclick="@(() => UpgradeCpu( rack ))">CPU $@UpgradeCpuCost( rack )</button>
																	<button class="lp-ui-btn-ghost @(!CanUpgradeCores( rack ) ? "disabled" : "")" onclick="@(() => UpgradeCores( rack ))">Core $@UpgradeCoreCost( rack )</button>
																</div>
															</div>
														}
													</div>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Wallet )
								{
									<div class="pane wallet">
										<div class="lp-ui-panel wallet-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">account_balance_wallet</i>
												<span>Hub wallet</span>
											</div>

											<div class="lp-ui-intro">
												Your secured hub balance. Deposit rack earnings at the linked terminal, then cash out to your in-game bank here.
											</div>

											<div class="lp-ui-info">
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Hub wallet</span>
													<span class="lp-ui-info-value accent">@HubWalletBtc().ToString("F6") BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Still on racks</span>
													<span class="lp-ui-info-value">@RackPendingBtc().ToString("F6") BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Terminal linked</span>
													<span class="lp-ui-info-value">@(HasLinkedTerminal() ? "Yes" : "No — place terminal near hub")</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">USD value (hub)</span>
													<span class="lp-ui-info-value">$@HubWalletUsd().ToString("N2")</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Exchange rate</span>
													<span class="lp-ui-info-value">$@LpBitcoinEconomy.BitcoinValueUsd / BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Your cash</span>
													<span class="lp-ui-info-value">$@LpHashdUiHost.GetLocalWalletCash()</span>
												</div>
											</div>

											<div class="wallet-cashout-bar">
												<i class="material-icons">payments</i>
												<TextEntry class="wallet-cashout-input" Placeholder="BTC amount (e.g. 0.025)" Value:bind="@CashOutAmount"/>
												<button class="lp-ui-btn-primary wallet-cashout-btn @GetPartialCashOutButtonClass()" onclick="@CashOutPartial">@PartialCashOutButtonLabel()</button>
											</div>

											<div class="wallet-cashout-row">
												<button class="lp-ui-btn-primary wallet-cashout-all @(HubWalletBtc() <= 0f ? "disabled" : "")" onclick="@CashOutAll">@CashOutAllButtonLabel()</button>
											</div>

											@if ( _cashOutErrorActive )
											{
												<div class="wallet-cashout-error @(_cashOutErrorVisible ? "visible" : "")">
													<i class="material-icons">error_outline</i>
													<span>@_cashOutErrorMessage</span>
												</div>
											}

											@if ( _cashOutSuccessActive )
											{
												<div class="wallet-cashout-success @(_cashOutSuccessVisible ? "visible" : "")">
													<i class="material-icons">check_circle</i>
													<span>@_cashOutSuccessMessage</span>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Transfers )
								{
									<div class="pane transfers">
										<div class="lp-ui-panel transfers-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">swap_horiz</i>
												<span>Hub transfers</span>
											</div>

											<div class="lp-ui-intro">
												Move BTC between operators. Share your Steam ID to receive; send from the linked terminal using <strong>send</strong>.
											</div>

											<div class="transfer-columns">
												<div class="transfer-column receive">
													<div class="transfer-column-head">
														<i class="material-icons">south_west</i>
														<span>Receive BTC</span>
													</div>
													<p class="transfer-column-copy">Share your hub receive address so other operators can send BTC to this wallet.</p>
													<div class="transfer-address-card">
														<div class="transfer-address-label">Your receive ID</div>
														<div class="transfer-address-value">@ReceiveSteamIdLabel()</div>
													</div>
													<div class="lp-ui-info transfer-column-stats">
														<div class="lp-ui-info-row">
															<span class="lp-ui-info-label">Hub wallet</span>
															<span class="lp-ui-info-value accent">@HubWalletBtc().ToString("F6") BTC</span>
														</div>
													</div>
													<div class="lp-ui-btn-row transfer-btn-row">
														<button class="lp-ui-btn-ghost transfer-copy-btn" onclick="@CopyReceiveAddress">
															<i class="material-icons">content_copy</i>
															<span>@ReceiveCopyLabel()</span>
														</button>
													</div>
												</div>

												<div class="transfer-column send">
													<div class="transfer-column-head">
														<i class="material-icons">north_east</i>
														<span>Send BTC</span>
													</div>
													<p class="transfer-column-copy">Use the linked bitcoin terminal to move BTC from this hub to another operator.</p>
													<div class="lp-ui-info transfer-column-stats">
														<div class="lp-ui-info-row">
															<span class="lp-ui-info-label">Terminal linked</span>
															<span class="lp-ui-info-value">@(HasLinkedTerminal() ? "Yes — ready to send" : "No — place terminal near hub")</span>
														</div>
													</div>
													<div class="transfer-command-card">
														<div class="transfer-command-label">Command</div>
														<div class="transfer-command-text">send &lt;steamid&gt; &lt;amount|all&gt;</div>
													</div>
													<div class="transfer-command-card">
														<div class="transfer-command-label">Example</div>
														<div class="transfer-command-text">send 76561198012345678 0.05</div>
													</div>
													<div class="lp-ui-btn-row transfer-btn-row">
														<button class="lp-ui-btn-ghost transfer-copy-btn" onclick="@CopySendExample">
															<i class="material-icons">content_copy</i>
															<span>@SendExampleCopyLabel()</span>
														</button>
													</div>
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Logs )
								{
									<div class="pane logs-pane">
										<div class="lp-ui-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">notifications</i>
												<span>Hub logs</span>
											</div>

											<div class="lp-ui-intro">
												Terminal commands, rack capacity warnings, intrusion attempts, and hub transfers appear here.
											</div>

											@if ( GetHubAlerts().Count == 0 )
											{
												<div class="lp-ui-empty">
													<i class="material-icons">notifications_none</i>
													<span>No alerts yet.</span>
												</div>
											}
											else
											{
												<div class="lp-ui-scroll lp-ui-scroll-region">
													<div class="notif-list">
														@foreach ( var alert in GetHubAlerts() )
														{
															<div class="notif-row">
																<i class="material-icons">@AlertIcon(alert.Kind)</i>
																<div class="notif-copy">
																	<div class="notif-kind">@AlertKindLabel(alert.Kind)</div>
																	<div class="notif-message">@alert.Message</div>
																	<div class="notif-time">@AlertTimeLabel(alert.Timestamp)</div>
																</div>
															</div>
														}
													</div>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Settings )
								{
									<div class="pane settings-pane">
										<div class="lp-ui-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">settings</i>
												<span>Settings</span>
											</div>

											<div class="settings-group">
												<div class="settings-label">Hub Power</div>
												<div class="settings-hint">Turn the HASHD hub on or off. Racks stop accruing when power is off.</div>
												<div class="split-actions">
													<button class="pill @(Hub?.IsPowered == true ? "active" : "")" onclick="@PowerOn">Power on</button>
													<button class="pill @(Hub?.IsPowered != true ? "active" : "")" onclick="@PowerOff">Power off</button>
												</div>
											</div>

											<div class="settings-group">
												<div class="settings-label">Security</div>
												<div class="settings-hint">@( Hub?.AccessPinIsSet == true ? "Hub PIN is active. PIN change ships in a later pass." : "Set your PIN on first hub USE via Secure Boot." )</div>
											</div>
										</div>
									</div>
								}
				</div>
			</div>
		</div>
		</div>
		<div class="lp-window-watermark lp-window-watermark--rounded">
			<LifePunchUiFooter />
		</div>
	</div>
		}
	</div>
</root>

@code
{
	private enum OpsTab { Overview, Wallet, Transfers, Racks, Logs, Settings }
	private enum PerfRange { Day, Week, Month }

	private static readonly OpsTab[] _tabs = { OpsTab.Overview, OpsTab.Wallet, OpsTab.Transfers, OpsTab.Racks, OpsTab.Logs, OpsTab.Settings };
	private static readonly PerfRange[] _perfRanges = { PerfRange.Day, PerfRange.Week, PerfRange.Month };

	private OpsTab _active = OpsTab.Overview;
	private bool _receiveCopyAck;
	private bool _sendExampleCopyAck;
	private PerfRange _perfRange = PerfRange.Week;
	private PerfRange _profitRange = PerfRange.Week;
	private bool _pinUnlocked;
	private string _pinBuffer = "";
	private string _pinConfirmDraft = "";
	private string _pinError = "";
	private int _pinSetupPass;
	private static readonly string[] _pinKeys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "clr", "0", "ok" };
	private string _cashOutAmount = "";
	private bool _cashOutSuccessActive;
	private bool _cashOutSuccessVisible;
	private string _cashOutSuccessMessage = "";
	private bool _cashOutErrorActive;
	private bool _cashOutErrorVisible;
	private string _cashOutErrorMessage = "";

	private string CashOutAmount
	{
		get => _cashOutAmount;
		set
		{
			_cashOutAmount = value ?? string.Empty;
			ClearCashOutError();
		}
	}
	private LpBitcoinHubEntity _hub;

	public LpBitcoinHubEntity Hub => _hub;

	public void BindHub( LpBitcoinHubEntity hub )
	{
		_hub = hub;
		_pinUnlocked = hub is null;
		_pinBuffer = "";
		_pinConfirmDraft = "";
		_pinError = "";
		_pinSetupPass = 0;
	}

	/// <summary>Dev preview ConCmds — skip secure-boot gate so the dashboard is visible immediately.</summary>
	public void DevBypassPinGate()
	{
		_pinUnlocked = true;
		StateHasChanged();
	}

	protected override void OnEnabled()
	{
		LpBitcoinHudBridge.SetMenuCursorMode( true );
		LifePunchUiScrollPolicy.Apply( Panel );
	}

	protected override void OnDisabled()
	{
		LpBitcoinHudBridge.SetMenuCursorMode( false );
	}

	private string StatusLabel() => Hub?.IsPowered == true ? "POWER ON" : "POWER OFF";

	private string AvatarInitial()
	{
		var name = GreetingName();
		return string.IsNullOrWhiteSpace( name ) ? "O" : name.Substring( 0, 1 ).ToUpperInvariant();
	}

	private string HeaderWalletBtc() => HubWalletBtc().ToString( "F4" );

	private static string HeaderDateLabel() => DateTime.Now.ToString( "MMMM, yyyy" );

	private bool HasUnreadAlerts() => Hub?.UnreadAlertCount > 0;

	private IReadOnlyList<LpBitcoinHubAlert> GetHubAlerts() => Hub?.GetAlerts() ?? Array.Empty<LpBitcoinHubAlert>();

	private void SelectLogsTab()
	{
		SelectTab( OpsTab.Logs );
		Hub?.RequestMarkAlertsRead();
	}

	private static long LocalSteamId() => Game.SteamId;

	private static string AlertIcon( LpBitcoinHubAlertKind kind ) => kind switch
	{
