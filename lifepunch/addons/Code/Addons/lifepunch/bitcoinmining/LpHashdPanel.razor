@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="topbar">
			<div class="brand">
				<i class="material-icons brand-icon">memory</i>
				<div class="brand-text">
					<span class="brand-title">@LpBitcoinIdent.OpsTitle</span>
					<span class="brand-sub">Ophion hub admin</span>
				</div>
			</div>
			<div class="status-chip @(Hub?.IsPowered == true ? "live" : "off")">
				<span class="dot"></span>
				<span>@StatusLabel()</span>
			</div>
			<div class="topbar-actions lp-ui-chrome-actions">
				<button class="lp-ui-chrome-btn cog" tooltip="Settings" onclick="@OpenSettings">
					<i class="material-icons">settings</i>
				</button>
				<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
					<i class="material-icons">close</i>
				</button>
			</div>
		</div>

		<div class="nav">
			@foreach ( var tab in _tabs )
			{
				<button class="nav-tab @(tab == _active ? "active" : "")" onclick="@(() => SelectTab(tab))">
					<i class="material-icons">@TabIcon(tab)</i>
					<span>@TabLabel(tab)</span>
				</button>
			}
		</div>

		<div class="content">
			@if ( _active == OpsTab.Overview )
			{
				<div class="pane overview">
					<div class="hero-card @(Hub?.IsPowered == true ? "mining" : "")">
						<div class="hero-copy">
							<div class="hero-label">Hub power</div>
							<div class="hero-value">@(Hub?.IsPowered == true ? "Online" : "Offline")</div>
							<div class="hero-sub">@LinkedRackCount() linked GPU rack(s)</div>
						</div>
					</div>

					<div class="metric-grid">
						<div class="metric">
							<div class="metric-label">Total rack BTC</div>
							<div class="metric-value">@TotalBtc().ToString("F6")</div>
						</div>
						<div class="metric">
							<div class="metric-label">Total USD</div>
							<div class="metric-value">$@TotalUsd()</div>
						</div>
						<div class="metric">
							<div class="metric-label">Mining racks</div>
							<div class="metric-value">@MiningRackCount()</div>
						</div>
						<div class="metric">
							<div class="metric-label">Cash on hand</div>
							<div class="metric-value">$@LpHashdUiHost.GetLocalWalletCash()</div>
						</div>
					</div>

					<div class="payout-card">
						<div class="payout-head">
							<span>Operations</span>
						</div>
						<div class="payout-foot">USE a CRT terminal or GPU rack for typed mine/stop/sell commands. Purchase upgrades here on each rack card.</div>
					</div>
				</div>
			}
			else if ( _active == OpsTab.Racks )
			{
				<div class="pane racks">
					<div class="rack-summary">
						<span>@LinkedRackCount() linked rack(s)</span>
						<span class="yield">Terminal index matches list order</span>
					</div>
					@if ( LinkedRackCount() == 0 )
					{
						<div class="empty-card">
							<i class="material-icons">dns</i>
							<div>Place GPU racks near this hub — they auto-link on spawn.</div>
						</div>
					}
					else
					{
						@for ( var i = 0; i < GetLinkedRacks().Count; i++ )
						{
							var rack = GetLinkedRacks()[i];
							<div class="rack-card">
								<div class="rack-icon">
									<i class="material-icons">@(rack.LargeRack ? "view_module" : "storage")</i>
								</div>
								<div class="rack-copy">
									<div class="rack-title">#@i @(rack.LargeRack ? "Advanced" : "Standard") rack</div>
									<div class="rack-sub">@(rack.BitcoinAmount.ToString("F6")) BTC · $@(rack.UsdValue) · @(rack.IsMining ? "MINING" : "IDLE")</div>
									<div class="rack-sub">@(rack.ClockGhz.ToString("F2")) GHz · x@(rack.CoreCount) cores · yield x@(rack.YieldMultiplier.ToString("F1"))</div>
								</div>
								<div class="rack-actions">
									<button class="ghost small" disabled="@(!CanUpgradeCpu(rack))" onclick="@(() => UpgradeCpu(rack))">CPU $@UpgradeCpuCost(rack)</button>
									<button class="ghost small" disabled="@(!CanUpgradeCores(rack))" onclick="@(() => UpgradeCores(rack))">Core $@UpgradeCoreCost(rack)</button>
									<button class="ghost small" onclick="@(() => OpenTerminal(rack))">Terminal</button>
								</div>
							</div>
						}
					}
				</div>
			}
			else if ( _active == OpsTab.About )
			{
				<div class="pane about">
					<div class="about-title">@LpBitcoinIdent.ProductTitle</div>
					<div class="about-line">Hub admin — power, linking, rack info, and paid upgrades. Mining and payout require the CRT terminal.</div>
					<div class="about-line">@LpBitcoinIdent.UiFooter</div>
					<div class="about-legal">Proprietary & confidential — lifepunch.co</div>
				</div>
			}
			else if ( _active == OpsTab.Settings )
			{
				<div class="pane settings-pane">
					<div class="settings-head">
						<i class="material-icons">settings</i>
						<span>Settings</span>
					</div>

					<div class="settings-group">
						<div class="settings-label">UI Scale</div>
						<div class="settings-hint">Resize the hub admin window.</div>
						<div class="panel-size-row">
							@foreach ( var size in _uiScaleOptions )
							{
								<button class="panel-size-opt @( _uiScale == size ? "active" : "" )"
								        onclick="@(() => SetUiScale( size ))">
									@LpUiScale.ShortLabel( size )
								</button>
							}
						</div>
					</div>

					<div class="settings-group">
						<div class="settings-label">Hub Power</div>
						<div class="settings-hint">Turn the Ophion hub on or off. Racks stop accruing when power is off.</div>
						<div class="settings-row">
							<div class="split-actions">
								<button class="pill @(Hub?.IsPowered == true ? "active" : "")" onclick="@PowerOn">Power on</button>
								<button class="pill @(Hub?.IsPowered != true ? "active" : "")" onclick="@PowerOff">Power off</button>
							</div>
						</div>
					</div>

					<div class="settings-group">
						<div class="settings-label">Security</div>
						<div class="settings-hint">Access PIN and placement limits ship in a later pass.</div>
					</div>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	private enum OpsTab { Overview, Racks, About, Settings }

	private static readonly OpsTab[] _tabs = { OpsTab.Overview, OpsTab.Racks, OpsTab.About };

	private OpsTab _active = OpsTab.Overview;
	private LpUiScaleSize _uiScale = LpUiScale.Default;
	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};
	private LpBitcoinHubEntity _hub;

	public LpBitcoinHubEntity Hub => _hub;

	public void BindHub( LpBitcoinHubEntity hub ) => _hub = hub;

	private string StatusLabel() => Hub?.IsPowered == true ? "POWER ON" : "POWER OFF";

	private static string TabIcon( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "dashboard",
		OpsTab.Racks => "dns",
		_ => "info"
	};

	private static string TabLabel( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "Overview",
		OpsTab.Racks => "Racks",
		_ => "About"
	};

	private void SelectTab( OpsTab tab ) => _active = tab;
	private void OpenSettings() => SelectTab( OpsTab.Settings );
	private string GetRootClass() => $"lp-bitcoin-ops {LpUiScale.CssClass( _uiScale )}";
	private void SetUiScale( LpUiScaleSize size ) => _uiScale = size;
	private void Close() => LpHashdUiHost.CloseOpen();
	private void PowerOn() => Hub?.SetPowered( true );
	private void PowerOff() => Hub?.SetPowered( false );

	private int LinkedRackCount() => GetLinkedRacks().Count;

	private List<LpBitcoinRackEntity> GetLinkedRacks()
		=> Hub.IsValid() ? Hub.GetLinkedRacks().ToList() : new List<LpBitcoinRackEntity>();

	private float TotalBtc() => GetLinkedRacks().Sum( r => r.BitcoinAmount );

	private int TotalUsd() => GetLinkedRacks().Sum( r => r.UsdValue );

	private int MiningRackCount() => GetLinkedRacks().Count( r => r.IsMining );

	private bool CanUpgradeCpu( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CpuUpgradeLevel < LpBitcoinEconomy.CpuUpgradeCosts.Length;

	private bool CanUpgradeCores( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CoreUpgradeLevel < LpBitcoinEconomy.CoreUpgradeCosts.Length;

	private string UpgradeCpuCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCpu( rack ) ? $"{LpBitcoinEconomy.CpuUpgradeCosts[rack.CpuUpgradeLevel]:N0}" : "MAX";

	private string UpgradeCoreCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCores( rack ) ? $"{LpBitcoinEconomy.CoreUpgradeCosts[rack.CoreUpgradeLevel]:N0}" : "MAX";

	private void UpgradeCpu( LpBitcoinRackEntity rack )
		=> _hub?.RequestUpgradeCpu( rack.GameObject.Id );

	private void UpgradeCores( LpBitcoinRackEntity rack )
		=> _hub?.RequestUpgradeCores( rack.GameObject.Id );

	private void OpenTerminal( LpBitcoinRackEntity rack )
	{
		Close();
		LpBitcoinTerminalUiHost.Open( _hub, rack );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		if ( !_hub.IsValid() )
			Close();
	}

	protected override int BuildHash() => HashCode.Combine(
		_active,
		_uiScale,
		_hub?.IsPowered,
		LinkedRackCount(),
		TotalBtc(),
		MiningRackCount() );
}
