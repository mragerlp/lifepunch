	public void OnCashOutSuccess( float btcAmount, uint usdPayout, bool soldAll )
	{
		ClearCashOutError();
		_cashOutSuccessMessage = soldAll
			? "Sold all"
			: $"Sold {btcAmount:F6} BTC for ${usdPayout:N2}";

		_cashOutSuccessActive = true;
		_cashOutSuccessVisible = false;
		_cashOutAmount = string.Empty;
		_ = PlayCashOutSuccessAsync();
	}

	private void ClearCashOutError()
	{
		_cashOutErrorActive = false;
		_cashOutErrorVisible = false;
		_cashOutErrorMessage = string.Empty;
	}

	private void ShowCashOutError( string message )
	{
		ClearCashOutSuccess();
		_cashOutErrorMessage = message;
		_cashOutErrorActive = true;
		_cashOutErrorVisible = false;
		_ = PlayCashOutErrorAsync();
	}

	private void ClearCashOutSuccess()
	{
		_cashOutSuccessActive = false;
		_cashOutSuccessVisible = false;
		_cashOutSuccessMessage = string.Empty;
	}

	private async System.Threading.Tasks.Task PlayCashOutErrorAsync()
	{
		await GameTask.DelayRealtimeSeconds( 0.05f );
		_cashOutErrorVisible = true;
		StateHasChanged();

		await GameTask.DelayRealtimeSeconds( 2.8f );
		_cashOutErrorVisible = false;
		StateHasChanged();

		await GameTask.DelayRealtimeSeconds( 0.25f );
		_cashOutErrorActive = false;
		StateHasChanged();
	}

	private async System.Threading.Tasks.Task PlayCashOutSuccessAsync()
	{
		await GameTask.DelayRealtimeSeconds( 0.05f );
		_cashOutSuccessVisible = true;
		StateHasChanged();

		await GameTask.DelayRealtimeSeconds( 2.8f );
		_cashOutSuccessVisible = false;
		StateHasChanged();

		await GameTask.DelayRealtimeSeconds( 0.25f );
		_cashOutSuccessActive = false;
		StateHasChanged();
	}

	private string PartialCashOutButtonLabel()
	{
		if ( !TryParseCashOutAmount( out var amount ) || amount <= 0f )
			return "Cash out";

		var usd = amount * LpBitcoinEconomy.BitcoinValueUsd;
		return $"Cash out ${usd:N2}";
	}

	private string CashOutAllButtonLabel()
	{
		if ( HubWalletBtc() <= 0f )
			return "Cash out all";

		return $"Cash out all (${(HubWalletBtc() * LpBitcoinEconomy.BitcoinValueUsd):N2})";
	}

	private string GetPartialCashOutButtonClass()
		=> CanAttemptPartialCashOut() ? string.Empty : "disabled";

	private bool CanAttemptPartialCashOut()
		=> TryParseCashOutAmount( out var amount ) && amount > 0f;

	private bool TryParseCashOutAmount( out float amount )
	{
		amount = 0f;
		return float.TryParse( _cashOutAmount.Trim(), out amount );
	}

	private void CashOutPartial()
	{
		if ( !TryParseCashOutAmount( out var amount ) || amount <= 0f )
			return;

		if ( amount > HubWalletBtc() )
		{
			ShowCashOutError( "Insufficient funds" );
			return;
		}

		Hub?.RequestCashOutHub( amount );
	}

	private void CashOutAll()
	{
		if ( HubWalletBtc() <= 0f )
		{
			ShowCashOutError( "Insufficient funds" );
			return;
		}

		Hub?.RequestCashOutAllHub();
	}

	private string GreetingName()
	{
		var name = Connection.Local?.DisplayName;
		if ( string.IsNullOrWhiteSpace( name ) )
			return "Operator";

		var first = name.Split( ' ', StringSplitOptions.RemoveEmptyEntries ).FirstOrDefault();
		return string.IsNullOrWhiteSpace( first ) ? "Operator" : first;
	}

	private int LinkedRackCount() => GetLinkedRacks().Count;

	private List<LpBitcoinRackEntity> GetLinkedRacks()
		=> Hub.IsValid() ? Hub.GetLinkedRacks().ToList() : new List<LpBitcoinRackEntity>();

	private float TotalBtc() => GetLinkedRacks().Sum( r => r.BitcoinAmount );

	private float CombinedBtc() => HubWalletBtc() + RackPendingBtc();

	private int CombinedUsd() => (int)(CombinedBtc() * LpBitcoinEconomy.BitcoinValueUsd);

	private int TotalUsd() => GetLinkedRacks().Sum( r => r.UsdValue );

	private int MiningRackCount() => GetLinkedRacks().Count( r => r.IsMining );

	private float TotalMiningRate()
	{
		if ( Hub?.IsPowered != true )
			return 0f;

		return GetLinkedRacks()
			.Where( r => r.IsMining )
			.Sum( r => r.MiningRatePerMinute );
	}

	private int MiningLoadPercent()
	{
		var total = LinkedRackCount();
		if ( total == 0 )
			return 0;

		return (int)Math.Round( 100f * MiningRackCount() / total );
	}

	private bool CanUpgradeCpu( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CpuUpgradeLevel < LpBitcoinEconomy.CpuUpgradeCosts.Length;

	private bool CanUpgradeCores( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CoreUpgradeLevel < LpBitcoinEconomy.CoreUpgradeCosts.Length;

	private string UpgradeCpuCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCpu( rack ) ? $"{LpBitcoinEconomy.CpuUpgradeCosts[rack.CpuUpgradeLevel]:N0}" : "MAX";

	private string UpgradeCoreCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCores( rack ) ? $"{LpBitcoinEconomy.CoreUpgradeCosts[rack.CoreUpgradeLevel]:N0}" : "MAX";

	private void UpgradeCpu( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCpu( rack ) )
			return;

		_hub?.RequestUpgradeCpu( rack.GameObject.Id );
	}

	private void UpgradeCores( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCores( rack ) )
			return;

		_hub?.RequestUpgradeCores( rack.GameObject.Id );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchUiScrollPolicy.Apply( Panel );
		if ( !_hub.IsValid() )
			Close();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( _active );
		hash.Add( _receiveCopyAck );
		hash.Add( _sendExampleCopyAck );
		hash.Add( _pinUnlocked );
		hash.Add( _pinBuffer );
		hash.Add( _pinSetupPass );
		hash.Add( _pinError );
		hash.Add( _hub?.IsPowered );
		hash.Add( _hub?.AccessPinIsSet );
		hash.Add( _perfRange );
		hash.Add( _profitRange );
		hash.Add( LinkedRackCount() );
		hash.Add( HubWalletBtc() );
		hash.Add( RackPendingBtc() );
		hash.Add( _cashOutAmount );
		hash.Add( MiningRackCount() );
		hash.Add( TotalMiningRate() );
		hash.Add( Hub?.UnreadAlertCount ?? 0 );
		hash.Add( Hub?.AlertFeed );
		hash.Add( Hub?.Owner ?? 0 );
		return hash.ToHashCode();
	}
