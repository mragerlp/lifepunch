    private void OnPinEntryBack()
    {
        if ( !IsHubPinSetup || !_pinConfirming )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinConfirming = false;
        _pinFirstEntry = "";
        ResetPinDigits();
        _pinError = "";
    }

    private void CompletePinEntry()
    {
        if ( !Hub.IsValid() )
        {
            _pinError = "Hub session lost.";
            ResetPinDigits();
            return;
        }

        if ( IsHubPinSetup )
        {
            if ( !_pinConfirming )
            {
                _pinFirstEntry = _pinDigits;
                _pinConfirming = true;
                ResetPinDigits();
                return;
            }

            if ( _pinDigits != _pinFirstEntry )
            {
                _pinError = "PINs did not match — try again.";
                _pinConfirming = false;
                _pinFirstEntry = "";
                ResetPinDigits();
                return;
            }

            Hub.RequestSetAccessPin( _pinDigits, _pinDigits );
            return;
        }

        if ( IsHubPinUnlock )
            Hub.RequestUnlockAccessPin( _pinDigits );
    }

    private static bool IsHubOnlyCommand( string cmd ) =>
        cmd is "link" or "unlink" or "upgrade" or "menu" or "control" or "power" or "modules" or "back";

    private void HandleCommand( string input )
    {
        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";
        var arg = parts.Length > 1 ? parts[1] : "";

        if ( IsHubOnlyCommand( cmd ) )
        {
            AppendLine( $"  {cmd.ToUpper()} — USE the hub body panel (POWER · CONTROL · UPGRADES · LOG)." );
            return;
        }

        switch ( cmd )
        {
            case "help":
                AppendLine( "--------------------HELP--------------------" );
                AppendLine( "  MINING   - start | stop | start all | stop all | start <id>" );
                AppendLine( "  BITCOIN  - sell or view hub wallet balance" );
                AppendLine( "  RIGS     - List linked GPU racks" );
                AppendLine( "  SELECT   - select <id> — pick active rig" );
                AppendLine( "  STATUS   - Dump live mining status" );
                AppendLine( "  INFO     - Selected rig hardware specs" );
                AppendLine( "  CLEAR    - Clear command output" );
                AppendLine( "  ABOUT    - Package version and copyright" );
                AppendLine( "  Hub panel: POWER · link racks · UPGRADES · audit LOG" );
                AppendLine( "--------------------------------------------" );
                break;

            case "clear":
                _lines.Clear();
                break;

            case "status":
                if ( !Hub.IsValid() ) { AppendLine( "ERROR: Hub connection lost." ); break; }
                _headModule = HeadOpsModule.Log;
                _liveStatus = true;
                RefreshLiveStatus();
                break;

            case "info":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                _lines.Add( "--------------------INFO--------------------" );
                _lines.Add( $"  Device:      {GpuRackRegistry.GetRigTypeLabel( Miner )}" );
                _lines.Add( $"  Interface:   HASHD RIG CONTROL v1" );
                _lines.Add( $"  CPU Speed:   {Miner.ClockSpeed:0.000} GHz (Lv {Miner.CpuUpgradeLevel})" );
                _lines.Add( $"  CPU Cores:   {Miner.CoreCount} (Lv {Miner.CoreUpgradeLevel})" );
                _lines.Add( $"  Hash Rate:   {Miner.MiningRatePerMinute:0.00000} BTC/min" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "bitcoin":
                if ( !Hub.IsValid() ) { _lines.Add( "ERROR: Hub connection lost." ); break; }
                if ( arg == "sell" )
                {
                    if ( GetHubBtcBalance() <= 0 )
                    {
                        _lines.Add( "ERROR: No bitcoin to sell." );
                        break;
                    }
                    _lines.Add( $"Selling {GetHubBtcBalance():0.00000} BTC for ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0}..." );
                    Hub.RequestSellBitcoin();
                    _lines.Add( "Done." );
                }
                else
                {
                    _lines.Add( $"  Hub balance: {GetHubBtcBalance():0.00000} BTC (≈ ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0})" );
                    _lines.Add( "  Use 'bitcoin sell' to cash out." );
                }
                break;

            case "racks":
            case "rigs":
                AppendRacksList();
                break;

            case "link":
                if ( !Hub.IsValid() ) { _lines.Add( "ERROR: Hub connection lost." ); break; }
                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    AppendLinkScan();
                    break;
                }
                if ( !int.TryParse( arg, out var linkIndex ) )
                {
                    _lines.Add( "ERROR: Usage — link <n>  (run 'link' to list)." );
                    break;
                }
                Hub.RequestLinkRig( linkIndex );
                break;

            case "unlink":
                if ( !Hub.IsValid() ) { _lines.Add( "ERROR: Hub connection lost." ); break; }
                if ( arg.Equals( "all", StringComparison.OrdinalIgnoreCase ) )
                {
                    Hub.RequestUnlinkAllRigs();
                    GpuRackRegistry.RefreshFromHub( Hub );
                    _lines.Add( "UNLINK: clearing all rack links…" );
                    break;
                }
                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    AppendUnlinkList();
                    break;
                }
                if ( !int.TryParse( arg, out var unlinkIndex ) )
                {
                    _lines.Add( "ERROR: Usage — unlink <n> | unlink all" );
                    break;
                }
                Hub.RequestUnlinkRig( unlinkIndex );
                break;

            case "select":
                if ( !int.TryParse( arg, out var selectId ) )
                {
                    _lines.Add( "ERROR: Usage — select <id>  (see 'rigs')." );
                    break;
                }
                if ( !GpuRackRegistry.TrySelect( selectId ) )
                {
                    _lines.Add( $"ERROR: No rig id {selectId}." );
                    break;
                }
                _lines.Add( $"Selected rig-{selectId} ({GpuRackRegistry.GetRigTypeLabel( Miner )})." );
                break;

            case "mining":
                if ( arg == "start" )
                {
                    var startTarget = parts.Length > 2 ? parts[2] : "";
                    if ( startTarget == "all" )
                    {
                        var started = SetMiningOnAll( true );
                        _lines.Add( started > 0 ? $"Mining started on {started} rig(s)." : "ERROR: No rigs in range." );
                    }
                    else if ( int.TryParse( startTarget, out var startId ) && GpuRackRegistry.TrySelect( startId ) )
                    {
                        Miner.RequestSetMiningState( true );
                        _lines.Add( $"Rig-{startId} mining started." );
                    }
                    else if ( Miner.IsValid() )
                    {
                        Miner.RequestSetMiningState( true );
                        _lines.Add( "Mining started." );
                    }
                    else
                    {
                        _lines.Add( "ERROR: No GPU Rack selected — use 'rigs' or 'select <id>'." );
                    }
                }
                else if ( arg == "stop" )
                {
                    var stopTarget = parts.Length > 2 ? parts[2] : "";
                    if ( stopTarget == "all" )
                    {
                        var stopped = SetMiningOnAll( false );
                        _lines.Add( stopped > 0 ? $"Mining stopped on {stopped} rig(s)." : "ERROR: No rigs in range." );
                    }
                    else if ( int.TryParse( stopTarget, out var stopId ) && GpuRackRegistry.TrySelect( stopId ) )
                    {
                        Miner.RequestSetMiningState( false );
                        _lines.Add( $"Rig-{stopId} mining stopped." );
                    }
                    else if ( Miner.IsValid() )
                    {
                        Miner.RequestSetMiningState( false );
                        _lines.Add( "Mining stopped." );
                    }
                    else
                    {
                        _lines.Add( "ERROR: No rig selected." );
                    }
                }
                else if ( Miner.IsValid() )
                {
                    _lines.Add( $"  Status: {( Miner.IsMining ? "ACTIVE" : "STOPPED" )}" );
                    _lines.Add( "  Use 'mining start' | 'stop' | 'start all' | 'start <id>'." );
                }
                else
                {
                    _lines.Add( "ERROR: No rigs linked." );
                }
                break;

            case "upgrade":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                if ( arg == "cpu" )
                {
                    OnBuyCpu();
                }
                else if ( arg == "cores" )
                {
                    OnBuyCores();
                }
                else
                {
                    OpenUpgradeMenu();
                }
                break;

            case "menu":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                OpenUpgradeMenu();
                break;

            case "control":
                _module = HashdModule.Control;
                _lines.Add( "Switched to CONTROL module — link GPU racks from the rail." );
                break;

            case "power":
                if ( !Hub.IsValid() )
                {
                    _lines.Add( "ERROR: No hub session — open from a Bitcoin Miner hub." );
                    break;
                }

                var hubState = Hub.IsPowered ? "ONLINE" : "OFFLINE";
                _lines.Add( $"  Hub power: {hubState}" );
                _lines.Add( "  Use the POWER ON / POWER OFF button on the rail." );
                break;

            case "about":
                _lines.Add( "--------------------------------------------" );
                _lines.Add( $"  {BitcoinMiningAddon.UiVersionFooter}" );
                _lines.Add( $"  {LifePunchSourceMark.CopyrightLine}" );
                _lines.Add( $"  {LifePunchSourceMark.UseRestrictionShort}" );
                _lines.Add( "--------------------------------------------" );
                break;

            default:
                _lines.Add( $"Unknown command: '{cmd}'. Type 'help' for a list of commands." );
                break;
        }
    }

    private void AppendRacksList()
    {
        var rigs = GpuRackRegistry.RegisteredRigs;
        if ( rigs.Count == 0 )
        {
            _lines.Add( "No GPU Racks linked — place racks, then type LINK at rig0>." );
            _lines.Add( $"  Cap: {BitcoinMiningCombatStats.MaxSmallRacksPerHub}× {BitcoinMiningAddon.DisplayName} · {BitcoinMiningCombatStats.MaxLargeRacksPerHub}× {BitcoinMiningAddon.AdvancedDisplayName}" );
            return;
        }

        _lines.Add( "--------------------LINKED GPU RIGS--------------------" );
        for ( var i = 0; i < rigs.Count; i++ )
        {
            var rig = rigs[i];
            if ( !rig.IsValid() )
                continue;

            var marker = i == GpuRackRegistry.SelectedIndex ? "*" : " ";
            var type = GpuRackRegistry.GetRigTypeLabel( rig );
            var status = GpuRackRegistry.GetRigStatusLabel( rig );
            _lines.Add( $" {marker} rig-{i}  {type,-9}  {status,-7}  {rig.ClockSpeed:0.00} GHz" );
        }
        _lines.Add( "--------------------------------------------" );
    }

    private void AppendLinkScan()
    {
        if ( !Hub.IsValid() )
        {
            _lines.Add( "ERROR: Hub connection lost." );
            return;
        }

        var candidates = BitcoinMinerHubRegistry.ScanUnlinkedRigs( Hub );
        if ( candidates.Count == 0 )
        {
            _lines.Add( "LINK: no unlinked GPU Racks in scene." );
            return;
        }

        _lines.Add( "--------------------LINKABLE RACKS--------------------" );
        for ( var i = 0; i < candidates.Count; i++ )
            _lines.Add( $"  {i}  {BitcoinMinerHubRegistry.GetRigLabel( candidates[i] )}" );
        _lines.Add( "  Type: link <n>" );
        _lines.Add( "--------------------------------------------" );
    }

    private void AppendUnlinkList()
    {
        if ( !Hub.IsValid() )
        {
            _lines.Add( "ERROR: Hub connection lost." );
            return;
        }

        var linked = BitcoinMinerHubRegistry.ResolveLinkedRigsInOrder( Hub );
        if ( linked.Count == 0 )
        {
            _lines.Add( "UNLINK: no linked racks." );
            return;
        }

        _lines.Add( "--------------------LINKED (UNLINK)--------------------" );
        for ( var i = 0; i < linked.Count; i++ )
            _lines.Add( $"  {i}  {BitcoinMinerHubRegistry.GetRigLabel( linked[i] )}" );
        _lines.Add( "  Type: unlink <n> | unlink all" );
        _lines.Add( "--------------------------------------------" );
    }

    private static int SetMiningOnAll( bool enabled )
    {
        var count = 0;
        foreach ( var rig in GpuRackRegistry.RegisteredRigs )
        {
            if ( !rig.IsValid() )
                continue;

            rig.RequestSetMiningState( enabled );
            count++;
        }
        return count;
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( (int)_surface );
        hash.Add( (int)_pinGate );
        hash.Add( _pinEntryOpen );
        hash.Add( _pinDigits?.Length ?? 0 );
        hash.Add( _pinConfirming );
        hash.Add( _pinError ?? "" );
        hash.Add( (int)_module );
        hash.Add( (int)_headModule );
        hash.Add( _showSettings );
        hash.Add( _panelSize );
        hash.Add( _lines.Count );
        hash.Add( Hub?.IsPowered ?? false );
        hash.Add( Hub?.AccessPinIsSet ?? false );
        hash.Add( Hub.IsValid() ? Hub.Owner : 0L );
        hash.Add( GetHubBtcBalance() );
        hash.Add( HashdTerminalHost.GetLocalWalletCash() );
        hash.Add( GpuRackRegistry.SelectedIndex );
        hash.Add( GpuRackRegistry.RegisteredRigs.Count );
        hash.Add( Hub.IsValid() ? BitcoinMinerHubRegistry.GetLinkedRacks( Hub ).Count : 0 );

        if ( Miner.IsValid() )
        {
            hash.Add( Miner.IsMining );
            hash.Add( Miner.CpuUpgradeLevel );
            hash.Add( Miner.CoreUpgradeLevel );
            hash.Add( (int)( _smoothProgress * 10f ) );
        }

        return hash.ToHashCode();
    }
}
