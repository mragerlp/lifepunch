    private void OnSubmit()
    {
        if ( !IsHeadConsole || !InputBox.IsValid() )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );

        var input = ( InputBox.Text ?? "" ).Trim().ToLower();
        InputBox.Text = "";
        InputBox.Focus();

        if ( string.IsNullOrWhiteSpace( input ) )
            return;

        var prompt = GetPromptLabel();
        AppendLine( $"{prompt} {input}" );

        if ( _liveStatus && _statusLineCount > 0 )
        {
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );
            _statusLineCount = 0;
            _liveStatus = false;
        }

        HandleCommand( input );

        AppendLine( "" );
    }

    private void RefreshLiveStatus()
    {
        if ( !Hub.IsValid() ) return;

        int steps = (int)MathF.Floor( _smoothProgress * 10f );
        int pct = steps * 10;
        string bar = new string( '█', steps );
        var anyMining = GpuRackRegistry.RegisteredRigs.Any( r => r.IsValid() && r.IsMining );
        var rig = Miner.IsValid() ? Miner : GpuRackRegistry.RegisteredRigs.FirstOrDefault( r => r.IsValid() );

        var statusLines = new List<string>
        {
            "--------------------STATUS------------------",
            $"  Mining:      {( anyMining ? "● ACTIVE" : "○ STOPPED" )}",
            $"  Hub wallet:  {GetHubBtcBalance():0.00000000} BTC",
            $"  Value:       ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0}",
        };

        if ( rig.IsValid() )
        {
            statusLines.Add( $"  Selected:    {GpuRackRegistry.GetRigTypeLabel( rig )}" );
            statusLines.Add( $"  Clock Speed: {rig.ClockSpeed:0.000} GHz (Lv {rig.CpuUpgradeLevel})" );
            statusLines.Add( $"  Cores:       {rig.CoreCount} (Lv {rig.CoreUpgradeLevel})" );
            statusLines.Add( $"  Rate:        {rig.MiningRatePerMinute:0.00000} BTC/min" );
        }

        statusLines.Add( $"  Progress:    {pct}% {bar}" );
        statusLines.Add( "--------------------------------------------" );

        if ( _statusLineCount > 0 )
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );

        _lines.AddRange( statusLines );
        _statusLineCount = statusLines.Count;
        TrimLines();
    }

