@namespace LifePunch.DXRP.Addons.BitcoinMining
@using LifePunch.DXRP.Addons
@using System
@using System.Linq
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
    <div class="scanlines"></div>

    <div class="title-bar">
        <span class="title-mark">◆</span>
        <span class="title-text">@GetTitleLabel()</span>
        <span class="title-ver">v1</span>
        <span class="title-spacer"></span>
        <div class="title-actions">
            @if ( !IsPinGateActive )
            {
                <button class="icon-btn cog @(_showSettings ? "active" : "")" tooltip="Settings" onclick=@OnToggleSettings>
                    <i class="material-icons">settings</i>
                </button>
            }
            <button class="icon-btn close" tooltip="Close" onclick=@OnClickClose>
                <i class="material-icons">close</i>
            </button>
        </div>
    </div>

    @if ( _showSettings )
    {
        <div class="hashd-settings">
            <div class="hashd-settings-head">PANEL SIZE</div>
            <button class="hashd-settings-opt @( _panelSize == 0 ? "active" : "" )" onclick=@(() => SetPanelSize( 0 ))>COMPACT</button>
            <button class="hashd-settings-opt @( _panelSize == 1 ? "active" : "" )" onclick=@(() => SetPanelSize( 1 ))>STANDARD</button>
            <button class="hashd-settings-opt @( _panelSize == 2 ? "active" : "" )" onclick=@(() => SetPanelSize( 2 ))>EXPANDED</button>
        </div>
    }

    <div class="terminal-body">
        @if ( !_showUpgradeMenu )
        {
            @if ( IsPinGateActive )
            {
                <div class="pin-ghost">
                    <div class="pin-ghost-rail">
                        <div class="pin-ghost-rail-header">LIVE TELEMETRY</div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">STATUS</span>
                            <span class="pin-ghost-value active">MINING</span>
                        </div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">BALANCE</span>
                            <span class="pin-ghost-value">████.████████ BTC</span>
                        </div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">VALUE</span>
                            <span class="pin-ghost-value">$██████</span>
                        </div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">HASH</span>
                            <span class="pin-ghost-value">█.██ GHz</span>
                        </div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">CORES</span>
                            <span class="pin-ghost-value">██</span>
                        </div>
                        <div class="pin-ghost-block">
                            <span class="pin-ghost-label">TICK</span>
                            <div class="pin-ghost-bar"><div class="pin-ghost-bar-fill"></div></div>
                        </div>
                        <div class="pin-ghost-actions">
                            <span class="pin-ghost-btn">START</span>
                            <span class="pin-ghost-btn">STOP</span>
                        </div>
                    </div>
                    <div class="pin-ghost-console">
                        <div class="pin-ghost-line dim">&gt;&gt; hashd init — bitcoin rig control ... OK</div>
                        <div class="pin-ghost-line dim">&gt;&gt; linking gpu-rack telemetry bus ... OK</div>
                        <div class="pin-ghost-line">&gt;&gt; syncing payout ledger (30s tick) ... OK</div>
                        <div class="pin-ghost-line">&gt;&gt; rig interface ready — telemetry rail active</div>
                        <div class="pin-ghost-line dim">--------------------STATUS------------------</div>
                        <div class="pin-ghost-line">  Mining:      ● ACTIVE</div>
                        <div class="pin-ghost-line">  Hub wallet:  ████.████████ BTC</div>
                        <div class="pin-ghost-line">  Value:       $██████</div>
                        <div class="pin-ghost-line dim">  Clock Speed: █.██ GHz (Lv █)</div>
                        <div class="pin-ghost-line dim">  Rate:        █.█████ BTC/min</div>
                        <div class="pin-ghost-line accent">rig0&gt; mining start</div>
                        <div class="pin-ghost-line accent">rig0&gt; bitcoin sell</div>
                        <div class="pin-ghost-line accent">rig0&gt; upgrade</div>
                    </div>
                    <div class="pin-ghost-veil"></div>
                </div>
                <div class="pin-lock-stage">
                    @if ( IsHubPinBlocked )
                    {
                        <div class="pin-lock-badge pin-lock-static">
                            <span class="pin-lock-mark">◆</span>
                            <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                        </div>
                    }
                    else if ( !_pinEntryOpen )
                    {
                        <button class="pin-lock-cta" onclick=@OnPinCtaClick>
                            <span class="pin-lock-mark">◆</span>
                            <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                            <span class="pin-lock-hint">CLICK TO CONTINUE</span>
                        </button>
                    }
                    else
                    {
                        <div class="pin-entry-panel">
                            <div class="pin-entry-header">
                                <span class="pin-entry-mark">◆</span>
                                <span class="pin-entry-title">@GetPinEntryTitle()</span>
                            </div>
                            <div class="pin-entry-sub">@GetPinEntrySubtitle()</div>
                            <div class="pin-entry-dots">
                                @for ( var i = 0; i < BitcoinMinerHubAccessPin.PinLength; i++ )
                                {
                                    <span class="pin-dot @( i < _pinDigits.Length ? "filled" : "" )"></span>
                                }
                            </div>
                            @if ( !string.IsNullOrEmpty( _pinError ) )
                            {
                                <div class="pin-entry-error">@_pinError</div>
                            }
                            <div class="pin-numpad">
                                @for ( var digit = 1; digit <= 9; digit++ )
                                {
                                    var key = digit;
                                    <button class="pin-key" onclick=@(() => OnPinDigit( key ))>@key</button>
                                }
                                <button class="pin-key pin-key-fn" onclick=@OnPinClear>CLEAR</button>
                                <button class="pin-key" onclick=@(() => OnPinDigit( 0 ))>0</button>
                                <button class="pin-key pin-key-fn" onclick=@OnPinBackspace>⌫</button>
                            </div>
                            @if ( _pinConfirming )
                            {
                                <button class="pin-entry-back" onclick=@OnPinEntryBack>← RE-ENTER PIN</button>
                            }
                        </div>
                    }
                </div>
            }

            @if ( !IsPinUiFlow )
            {
            <div class="telemetry-rail">
                @if ( Hub.IsValid() )
                {
                    <div class="rail-header">HUB POWER</div>
                    <div class="rail-block">
                        <span class="rail-label">HUB</span>
                        <span class="rail-value">@BitcoinMiningAddon.HubDisplayName</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">STATUS</span>
                        <span class="rail-value @(Hub.IsPowered ? "active" : "")">@(Hub.IsPowered ? "ONLINE" : "OFFLINE")</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">LINKED</span>
                        <span class="rail-value">@GetLinkedRigsSummary()</span>
                    </div>
                    <div class="rail-actions">
                        <button class="rail-btn @(Hub.IsPowered ? "power-off" : "power-on")" onclick=@OnRailPowerToggle>@(Hub.IsPowered ? "POWER OFF" : "POWER ON")</button>
                    </div>
                }

                @if ( !IsHubPowerGate )
                {
                    <div class="rail-header">LIVE TELEMETRY</div>
                    <div class="rail-block">
                        <span class="rail-label">MINING</span>
                        <span class="rail-value @(Miner.IsValid() && Miner.IsMining ? "active" : "")">@GetMiningStatusLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">BALANCE</span>
                        <span class="rail-value">@GetBtcBalanceLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">VALUE</span>
                        <span class="rail-value">@GetUsdValueLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">HASH</span>
                        <span class="rail-value">@GetHashRateLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">CORES</span>
                        <span class="rail-value">@GetCoreLabel()</span>
                    </div>
                    <div class="rail-block rail-progress">
                        <span class="rail-label">TICK</span>
                        <div class="tick-bar">
                            <div class="tick-fill" style="width: @(GetTickPercent())%"></div>
                        </div>
                        <span class="rail-sub">@GetTickPercent()% / @((int)BitcoinMiningAddon.MiningPayoutIntervalSeconds)s</span>
                    </div>
                    <div class="rail-actions">
                        <button class="rail-btn start @(Miner.IsValid() && Miner.IsMining ? "active" : "")" onclick=@OnRailStart>START</button>
                        <button class="rail-btn stop" onclick=@OnRailStop>STOP</button>
                    </div>
                    <div class="rail-hint">Command log →</div>
                }
                else
                {
                    <div class="rail-hint">Click POWER ON to boot the hub</div>
                }
            </div>

            <div class="console-pane @( IsPinGateActive ? "pin-gate-console" : "" )">
                <div class="screen-scroll" @ref="ScreenScroll">
                    <div class="screen flex flex-col">
                        @foreach ( var line in _lines )
                        {
                            <div class="line-row">
                                <label class="screen-line @(GetLineClass( line ))">@line</label>
                            </div>
                        }
                    </div>
                </div>

                @if ( !IsPinGateActive )
                {
                    <div class="input-row" onclick=@FocusInput>
                        <span class="prompt-label">@GetPromptLabel()</span>
                        <TextEntry
                            class="terminal-input"
                            @ref="InputBox"
                            onsubmit=@OnSubmit />
                    </div>
                }
            </div>
            }
        }
        else
        {
            <div class="upgrade-panel">
                <div class="upgrade-header">HARDWARE UPGRADES</div>
                <div class="upgrade-balance">Wallet: $@HashdTerminalHost.GetLocalWalletCash().ToString("N0")</div>

                <div class="upgrade-row">
                    <div class="upgrade-info">
                        <span class="upgrade-name">CPU CLOCK</span>
                        <span class="upgrade-detail">@GetCpuUpgradeDetail()</span>
                    </div>
                    <button class="upgrade-btn @(CanAffordCpu() ? "" : "disabled")" onclick=@OnBuyCpu>INSTALL</button>
                </div>

                <div class="upgrade-row">
                    <div class="upgrade-info">
                        <span class="upgrade-name">CPU CORES</span>
                        <span class="upgrade-detail">@GetCoreUpgradeDetail()</span>
                    </div>
                    <button class="upgrade-btn @(CanAffordCores() ? "" : "disabled")" onclick=@OnBuyCores>INSTALL</button>
                </div>

                <div class="upgrade-hint">Type BACK or click below to return to rig control.</div>
                <button class="upgrade-back" onclick=@CloseUpgradeMenu>← BACK TO CONSOLE</button>
            </div>
        }
    </div>

    <div class="lp-source-footer">
        <span class="lp-mark">@LifePunchSourceMark.UiFooterMark</span>
        <span class="lp-legal">@BitcoinMiningAddon.UiVersionFooter</span>
    </div>
</root>

@code {
    private enum PinGateKind { None, Setup, Unlock, Blocked }

    private GpuRackEntity Miner => GpuRackRegistry.SelectedRig;
    private BitcoinMinerHubEntity Hub => GpuRackRegistry.ActiveHub;
    private bool IsHubPowerGate => Hub.IsValid() && !Hub.IsPowered && _pinGate == PinGateKind.None;
    private bool IsHubPinSetup => _pinGate == PinGateKind.Setup;
    private bool IsHubPinUnlock => _pinGate == PinGateKind.Unlock;
    private bool IsHubPinBlocked => _pinGate == PinGateKind.Blocked;
    private bool IsPinGateActive => _pinGate != PinGateKind.None;
    private bool IsPinUiFlow => IsHubPinSetup || IsHubPinUnlock;

    private TextEntry InputBox { get; set; }
    private Panel ScreenScroll { get; set; }
    private readonly List<string> _lines = new();
    private bool _liveStatus = false;
    private bool _showUpgradeMenu = false;
    private int _statusLineCount = 0;
    private const int MaxLines = 200;
    private const string PromptPrefix = "rig0>";
    private const string AuthPromptPrefix = "auth>";
    private PinGateKind _pinGate = PinGateKind.None;
    private float _smoothProgress = 0f;
    private float _lastKnownProgress = 0f;
    private int _lastTextLength = 0;
    private TimeSince _sinceSecondly = 0f;
    private bool _showSettings;
    private int _panelSize = 1;
    private bool _pinEntryOpen;
    private bool _pinConfirming;
    private string _pinDigits = "";
    private string _pinFirstEntry = "";
    private string _pinError = "";

    private string GetRootClass()
    {
        var classes = new List<string>();
        if ( _showUpgradeMenu )
            classes.Add( "upgrade-mode" );
        if ( _pinGate != PinGateKind.None )
            classes.Add( "pin-gate" );
        if ( IsHubPinBlocked )
            classes.Add( "pin-blocked" );
        if ( IsHubPinUnlock )
            classes.Add( "pin-unlock" );
        if ( _pinEntryOpen )
            classes.Add( "pin-entry-open" );
        if ( _panelSize == 0 )
            classes.Add( "compact" );
        else if ( _panelSize == 2 )
            classes.Add( "expanded" );
        return string.Join( " ", classes );
    }

    private void OnToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    private void SetPanelSize( int size )
    {
        _panelSize = Math.Clamp( size, 0, 2 );
        _showSettings = false;
    }

    private static string GetLineClass( string line )
    {
        if ( line.StartsWith( "rig0>" ) ) return "prompt-line";
        if ( line.StartsWith( ">>" ) ) return "boot-line";
        if ( line.StartsWith( "---" ) || line.StartsWith( "----" ) ) return "divider-line";
        if ( line.StartsWith( "  " ) ) return "help-line";
        if ( line.StartsWith( "ERROR" ) ) return "error-line";
        return "output-line";
    }

    private void TrimLines()
    {
        var limit = _liveStatus ? MaxLines - _statusLineCount : MaxLines;
        if ( _lines.Count > limit )
            _lines.RemoveRange( 0, _lines.Count - limit );
    }

    public static void Open( GpuRackEntity miner )
    {
        var scene = Sandbox.Game.ActiveScene;
        if ( miner.IsValid() )
            GpuRackRegistry.Refresh( scene, miner.WorldPosition );
        else if ( HashdTerminalHost.LocalViewerPosition( scene ) is { } viewerPos )
            GpuRackRegistry.Refresh( scene, viewerPos );

        OpenMounted( miner );
    }

    public static void OpenFromHub( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var first = GpuRackRegistry.RegisteredRigs.FirstOrDefault();
        OpenMounted( first );
    }

    public static void OpenHubPowerGate( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal.FocusInput();
        terminal.BootHubPowerGate();
    }

    public static void OpenHubPinSetup( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal.FocusInput();
        terminal.BootHubPinSetup();
    }

    public static void OpenHubPinUnlock( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal.FocusInput();
        terminal.BootHubPinUnlock();
    }

    public static void OpenHubPinBlocked( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal.FocusInput();
        terminal.BootHubPinBlocked();
    }

    public static void NotifyPinDenied( string message )
    {
        var terminal = Sandbox.Game.ActiveScene?.GetAllComponents<HashdTerminal>().FirstOrDefault();
        if ( !terminal.IsValid() )
            return;

        terminal.AppendAuthLine( $"ERROR: {message}" );
    }

    private static void OpenMounted( GpuRackEntity miner )
    {
        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        if ( miner.IsValid() )
            GpuRackRegistry.TrySelect( miner );

        terminal.FocusInput();
        terminal.Boot();
    }

    private void CloseTerminal()
    {
        if ( Hub.IsValid() )
            Hub.RequestEndAccessSession();

        HashdTerminalHost.Close( this );
    }

    private string GetPinLockBadgeLabel()
    {
        if ( IsHubPinSetup )
            return "SECURE BOOT — SET PIN";
        if ( IsHubPinBlocked )
            return "LOCKED — SPAWN ACCESS ONLY";
        if ( IsHubPinUnlock )
            return "ENCRYPTED — PIN REQUIRED";
        return "LOCKED";
    }

    private string GetTitleLabel()
    {
        if ( IsHubPinSetup )
            return "GATEKEEPER — SET PIN";
        if ( IsHubPinBlocked )
            return "GATEKEEPER — LOCKED";
        if ( IsHubPinUnlock )
            return "GATEKEEPER — ENTER PIN";
        if ( IsHubPowerGate )
            return "HUB POWER GATE";
        return "HASHD RIG CONTROL";
    }

    private string GetPromptLabel() =>
        _pinGate != PinGateKind.None ? AuthPromptPrefix : PromptPrefix;

    private void BootHubPinSetup()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _showUpgradeMenu = false;
        _pinGate = PinGateKind.Setup;
    }

    private void BootHubPinBlocked()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _showUpgradeMenu = false;
        _pinGate = PinGateKind.Blocked;
        _lines.Add( ">> gatekeeper — spawner wake required" );
        _lines.Add( $">> registered spawner: {Hub.GetOwnerLabel()}" );
        _lines.Add( $">> your identity: {HashdTerminalHost.GetLocalOperatorLabel()}" );
        _lines.Add( ">> your Steam ID does not match the spawner — cannot set PIN" );
        _lines.Add( ">> wait for the spawner to wake this hub, then enter their PIN" );
        _lines.Add( "" );
    }

    private void BootHubPinUnlock()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _showUpgradeMenu = false;
        _pinGate = PinGateKind.Unlock;
    }

    private void BootHubPowerGate()
    {
        _lines.Clear();
        _showUpgradeMenu = false;
        _pinGate = PinGateKind.None;
        _lines.Add( $">> {BitcoinMiningAddon.HubDisplayName} — power gate" );
        _lines.Add( ">> hub offline — linked racks disabled" );
        _lines.Add( ">> click POWER ON on the rail to boot" );
        _lines.Add( $">> linked: {GetLinkedRigsSummary()}" );
        _lines.Add( "Commands: power · help" );
        _lines.Add( "" );
    }

    private void Boot()
    {
        _lines.Clear();
        _showUpgradeMenu = false;
        _pinGate = PinGateKind.None;
        _lines.Add( ">> hashd init — bitcoin rig control ... OK" );
        _lines.Add( ">> linking gpu-rack telemetry bus ... OK" );
        _lines.Add( $">> syncing payout ledger ({(int)BitcoinMiningAddon.MiningPayoutIntervalSeconds}s tick) ... OK" );
        _lines.Add( ">> rig interface ready — telemetry rail active (left)" );
        _lines.Add( $">> linked: {GetLinkedRigsSummary()}" );
        if ( GpuRackRegistry.RegisteredRigs.Count > 1 )
            _lines.Add( ">> multi-rig — use 'rigs' · 'select <id>' · 'mining start all'" );
        _lines.Add( "Commands: help · rigs · mining · bitcoin · upgrade · status" );
        _lines.Add( "" );
    }

    private string GetMiningStatusLabel() =>
        GpuRackRegistry.RegisteredRigs.Any( r => r.IsValid() && r.IsMining ) ? "MINING" : "IDLE";

    private string GetLinkedRigsSummary() =>
        BitcoinMinerHubRegistry.DescribeLinkedRacks( GpuRackRegistry.RegisteredRigs );

    private float GetHubBtcBalance() =>
        Hub.IsValid() ? Hub.BitcoinAmount : 0f;

    private string GetBtcBalanceLabel() =>
        Hub.IsValid() ? $"{GetHubBtcBalance():0.00000000} BTC" : "—";

    private string GetUsdValueLabel() =>
        Hub.IsValid() ? $"${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0}" : "—";

    private string GetHashRateLabel() =>
        Miner.IsValid() ? $"{Miner.ClockSpeed:0.00} GHz" : "—";

    private string GetCoreLabel() =>
        Miner.IsValid() ? $"{Miner.CoreCount}" : "—";

    private int GetTickPercent() =>
        Miner.IsValid() && Miner.IsMining ? (int)MathF.Floor( _smoothProgress * 100f ) : 0;

    private void OnRailStart()
    {
        if ( !Miner.IsValid() ) return;
        Miner.RequestSetMiningState( true );
    }

    private void OnRailStop()
    {
        if ( !Miner.IsValid() ) return;
        Miner.RequestSetMiningState( false );
    }

    private void OnRailPowerToggle()
    {
        if ( !Hub.IsValid() )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );

        if ( Hub.IsPowered )
        {
            Hub.RequestSetPowered( false );
            _lines.Add( ">> hub shutdown — linked racks stopping" );
            _lines.Add( "" );
        }
        else
        {
            Hub.RequestSetPowered( true );
            _lines.Add( ">> hub power on — booting ophion ..." );
            _lines.Add( ">> startup sequence ... OK" );
            _lines.Add( ">> hashd bus online — rig telemetry enabled" );
            _lines.Add( "" );
            Boot();
        }

        TrimLines();
    }

    private void SecondlyUpdate()
    {
        var viewerPos = HashdTerminalHost.LocalViewerPosition( Scene );

        if ( IsHubPowerGate || IsHubPinSetup || IsHubPinUnlock )
        {
            if ( !Hub.IsValid() )
            {
                CloseTerminal();
                return;
            }

            if ( viewerPos.HasValue && viewerPos.Value.Distance( Hub.WorldPosition ) > 150f )
            {
                CloseTerminal();
                return;
            }

            return;
        }

        if ( !Hub.IsValid() )
        {
            CloseTerminal();
            return;
        }

        if ( viewerPos.HasValue && viewerPos.Value.Distance( Hub.WorldPosition ) > 150f )
        {
            CloseTerminal();
            return;
        }

        if ( _liveStatus )
            RefreshLiveStatus();
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();

        if ( _sinceSecondly >= 1f )
        {
            _sinceSecondly = 0f;
            SecondlyUpdate();
        }

        if ( !IsHubPowerGate && !IsHubPinSetup && !IsHubPinUnlock && !IsHubPinBlocked && !Hub.IsValid() )
            return;

        if ( InputBox.IsValid() && !InputBox.HasFocus && !_showUpgradeMenu && !IsPinUiFlow )
            InputBox.Focus();

        if ( Input.Pressed( "Attack2" ) )
            Input.Clear( "Attack2" );

        if ( Input.Pressed( "Pocket" ) )
            Input.Clear( "Pocket" );
        if ( Input.Down( "Pocket" ) )
            Input.Clear( "Pocket" );

        if ( InputBox.IsValid() )
        {
            var currentLength = InputBox.Text?.Length ?? 0;
            if ( currentLength != _lastTextLength )
            {
                Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
                _lastTextLength = currentLength;
            }
        }

        var progressRig = Miner.IsValid() ? Miner : GpuRackRegistry.RegisteredRigs.FirstOrDefault( r => r.IsValid() && r.IsMining );
        if ( progressRig.IsValid() && progressRig.IsMining )
        {
            if ( progressRig.MiningProgress < _lastKnownProgress - 0.1f )
                _smoothProgress = 0f;
            _lastKnownProgress = progressRig.MiningProgress;
            _smoothProgress = MathF.Min( _smoothProgress + Time.Delta / BitcoinMiningAddon.MiningPayoutIntervalSeconds, 1f );
        }
        else
        {
            _smoothProgress = 0f;
        }
    }

    public void FocusInput()
    {
        if ( InputBox.IsValid() )
            InputBox.Focus();
    }

    private void OnClickClose() => CloseTerminal();

    private void OnSubmit()
    {
        if ( !InputBox.IsValid() ) return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );

        var input = ( InputBox.Text ?? "" ).Trim().ToLower();
        InputBox.Text = "";
        InputBox.Focus();

        if ( string.IsNullOrWhiteSpace( input ) ) return;

        if ( _showUpgradeMenu && ( input is "back" or "exit" or "close" ) )
        {
            _lines.Add( $"{PromptPrefix} {input}" );
            CloseUpgradeMenu();
            _lines.Add( "Returned to rig console." );
            _lines.Add( "" );
            TrimLines();
            return;
        }

        var prompt = GetPromptLabel();
        _lines.Add( $"{prompt} {input}" );

        if ( _pinGate != PinGateKind.None )
        {
            HandlePinGateInput( input );
            _lines.Add( "" );
            TrimLines();
            return;
        }

        if ( _liveStatus && _statusLineCount > 0 )
        {
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );
            _statusLineCount = 0;
            _liveStatus = false;
        }

        HandleCommand( input );

        _lines.Add( "" );
        TrimLines();
    }

    private void RefreshLiveStatus()
    {
        if ( !Hub.IsValid() ) return;

        int steps = (int)MathF.Floor( _smoothProgress * 10f );
        int pct = steps * 10;
        string bar = new string( '█', steps );
        var anyMining = GpuRackRegistry.RegisteredRigs.Any( r => r.IsValid() && r.IsMining );
        var rig = Miner.IsValid() ? Miner : GpuRackRegistry.RegisteredRigs.FirstOrDefault( r => r.IsValid() );

        var statusLines = new List<string>
        {
            "--------------------STATUS------------------",
            $"  Mining:      {( anyMining ? "● ACTIVE" : "○ STOPPED" )}",
            $"  Hub wallet:  {GetHubBtcBalance():0.00000000} BTC",
            $"  Value:       ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0}",
        };

        if ( rig.IsValid() )
        {
            statusLines.Add( $"  Selected:    {GpuRackRegistry.GetRigTypeLabel( rig )}" );
            statusLines.Add( $"  Clock Speed: {rig.ClockSpeed:0.000} GHz (Lv {rig.CpuUpgradeLevel})" );
            statusLines.Add( $"  Cores:       {rig.CoreCount} (Lv {rig.CoreUpgradeLevel})" );
            statusLines.Add( $"  Rate:        {rig.MiningRatePerMinute:0.00000} BTC/min" );
        }

        statusLines.Add( $"  Progress:    {pct}% {bar}" );
        statusLines.Add( "--------------------------------------------" );

        if ( _statusLineCount > 0 )
            _lines.RemoveRange( _lines.Count - _statusLineCount, _statusLineCount );

        _lines.AddRange( statusLines );
        _statusLineCount = statusLines.Count;
        TrimLines();
    }

    private void OpenUpgradeMenu()
    {
        if ( !Miner.IsValid() )
        {
            _lines.Add( "ERROR: Miner connection lost." );
            return;
        }

        _showUpgradeMenu = true;
        _liveStatus = false;
        _statusLineCount = 0;
        _lines.Add( "Opening hardware upgrade panel ..." );
    }

    private void CloseUpgradeMenu()
    {
        _showUpgradeMenu = false;
        FocusInput();
    }

    private bool CanBuyCpu() =>
        Miner.IsValid() && Miner.CpuUpgradeLevel < GpuRackEntity.CpuUpgradeCosts.Length;

    private bool CanBuyCores() =>
        Miner.IsValid() && Miner.CoreUpgradeLevel < GpuRackEntity.CoreUpgradeCosts.Length;

    private bool CanAffordCpu()
    {
        if ( !CanBuyCpu() ) return false;
        return HashdTerminalHost.GetLocalWalletCash() >= GpuRackEntity.CpuUpgradeCosts[Miner.CpuUpgradeLevel];
    }

    private bool CanAffordCores()
    {
        if ( !CanBuyCores() ) return false;
        return HashdTerminalHost.GetLocalWalletCash() >= GpuRackEntity.CoreUpgradeCosts[Miner.CoreUpgradeLevel];
    }

    private string GetCpuUpgradeDetail()
    {
        if ( !Miner.IsValid() ) return "offline";
        if ( !CanBuyCpu() ) return $"MAXED — Lv {Miner.CpuUpgradeLevel}/{GpuRackEntity.CpuUpgradeCosts.Length}";
        return $"Lv {Miner.CpuUpgradeLevel}/{GpuRackEntity.CpuUpgradeCosts.Length} — ${GpuRackEntity.CpuUpgradeCosts[Miner.CpuUpgradeLevel]:N0}";
    }

    private string GetCoreUpgradeDetail()
    {
        if ( !Miner.IsValid() ) return "offline";
        if ( !CanBuyCores() ) return $"MAXED — Lv {Miner.CoreUpgradeLevel}/{GpuRackEntity.CoreUpgradeCosts.Length}";
        return $"Lv {Miner.CoreUpgradeLevel}/{GpuRackEntity.CoreUpgradeCosts.Length} — ${GpuRackEntity.CoreUpgradeCosts[Miner.CoreUpgradeLevel]:N0}";
    }

    private void OnBuyCpu()
    {
        if ( !CanBuyCpu() ) return;
        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        var cost = GpuRackEntity.CpuUpgradeCosts[Miner.CpuUpgradeLevel];
        if ( !CanAffordCpu() )
        {
            _lines.Add( $"ERROR: CPU Clock costs ${cost:N0} — wallet ${HashdTerminalHost.GetLocalWalletCash():N0}." );
            TrimLines();
            return;
        }

        _lines.Add( $"Installing CPU Clock (${cost:N0}) ..." );
        Miner.RequestUpgrade( GpuRackUpgradeType.Cpu );
        _lines.Add( "Upgrade queued — host will charge wallet if funds allow." );
        TrimLines();
    }

    private void OnBuyCores()
    {
        if ( !CanBuyCores() ) return;
        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        var cost = GpuRackEntity.CoreUpgradeCosts[Miner.CoreUpgradeLevel];
        if ( !CanAffordCores() )
        {
            _lines.Add( $"ERROR: CPU Cores cost ${cost:N0} — wallet ${HashdTerminalHost.GetLocalWalletCash():N0}." );
            TrimLines();
            return;
        }

        _lines.Add( $"Installing CPU Cores (${cost:N0}) ..." );
        Miner.RequestUpgrade( GpuRackUpgradeType.Cores );
        _lines.Add( "Upgrade queued — host will charge wallet if funds allow." );
        TrimLines();
    }

    private void HandlePinGateInput( string input )
    {
        if ( !Hub.IsValid() )
        {
            _lines.Add( "ERROR: Hub session lost." );
            return;
        }

        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";

        if ( _pinGate == PinGateKind.Setup )
        {
            if ( cmd == "pin" && parts.Length >= 4 && parts[1] == "set" )
            {
                Hub.RequestSetAccessPin( parts[2], parts[3] );
                _lines.Add( ">> configuring operator PIN ..." );
                return;
            }

            _lines.Add( "ERROR: Use pin set 1234 1234  (four digits, twice)." );
            return;
        }

        if ( _pinGate == PinGateKind.Unlock )
        {
            if ( BitcoinMinerHubAccessPin.IsValidFormat( input ) )
            {
                _lines.Add( ">> verifying PIN ..." );
                Hub.RequestUnlockAccessPin( input );
                return;
            }

            if ( cmd == "pin" && parts.Length >= 2 && BitcoinMinerHubAccessPin.IsValidFormat( parts[1] ) )
            {
                _lines.Add( ">> verifying PIN ..." );
                Hub.RequestUnlockAccessPin( parts[1] );
                return;
            }

            _lines.Add( "ERROR: Enter a 4-digit PIN." );
            return;
        }

        if ( _pinGate == PinGateKind.Blocked )
            _lines.Add( "ERROR: Hub locked — owner must set the initial PIN first." );
    }

    public void AppendAuthLine( string line )
    {
        if ( IsPinUiFlow && _pinEntryOpen )
        {
            _pinError = line.StartsWith( "ERROR:", StringComparison.OrdinalIgnoreCase )
                ? line["ERROR:".Length..].Trim()
                : line;
            ResetPinDigits();
            return;
        }

        _lines.Add( line );
        TrimLines();
    }

    private void ResetPinEntryUi()
    {
        _pinEntryOpen = false;
        _pinConfirming = false;
        _pinDigits = "";
        _pinFirstEntry = "";
        _pinError = "";
    }

    private void ResetPinDigits()
    {
        _pinDigits = "";
    }

    private string GetPinEntryTitle()
    {
        if ( IsHubPinSetup )
            return _pinConfirming ? "CONFIRM PIN" : "SET PIN";

        return "ENTER PIN";
    }

    private string GetPinEntrySubtitle()
    {
        if ( IsHubPinSetup )
        {
            if ( _pinConfirming )
                return "Enter the same 4-digit PIN again to confirm.";

            return $"Operator: {HashdTerminalHost.GetLocalOperatorLabel()} — choose your hub lock.";
        }

        var owner = Hub.IsValid() && !string.IsNullOrWhiteSpace( Hub.OperatorDisplayName )
            ? Hub.OperatorDisplayName
            : "registered operator";

        return $"Encrypted hub — registered by {owner}.";
    }

    private void OnPinCtaClick()
    {
        if ( IsHubPinBlocked )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinEntryOpen = true;
        _pinError = "";
        ResetPinDigits();
    }

    private void OnPinDigit( int digit )
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length >= BitcoinMinerHubAccessPin.PinLength )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinDigits += digit.ToString();
        _pinError = "";

        if ( _pinDigits.Length >= BitcoinMinerHubAccessPin.PinLength )
            CompletePinEntry();
    }

    private void OnPinBackspace()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length == 0 )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinDigits = _pinDigits[..^1];
        _pinError = "";
    }

    private void OnPinClear()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        ResetPinDigits();
        _pinError = "";
    }

    private void OnPinEntryBack()
    {
        if ( !IsHubPinSetup || !_pinConfirming )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinConfirming = false;
        _pinFirstEntry = "";
        ResetPinDigits();
        _pinError = "";
    }

    private void CompletePinEntry()
    {
        if ( !Hub.IsValid() )
        {
            _pinError = "Hub session lost.";
            ResetPinDigits();
            return;
        }

        if ( IsHubPinSetup )
        {
            if ( !_pinConfirming )
            {
                _pinFirstEntry = _pinDigits;
                _pinConfirming = true;
                ResetPinDigits();
                return;
            }

            if ( _pinDigits != _pinFirstEntry )
            {
                _pinError = "PINs did not match — try again.";
                _pinConfirming = false;
                _pinFirstEntry = "";
                ResetPinDigits();
                return;
            }

            Hub.RequestSetAccessPin( _pinDigits, _pinDigits );
            return;
        }

        if ( IsHubPinUnlock )
            Hub.RequestUnlockAccessPin( _pinDigits );
    }

    private void HandleCommand( string input )
    {
        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";
        var arg = parts.Length > 1 ? parts[1] : "";

        switch ( cmd )
        {
            case "help":
                _lines.Add( "--------------------HELP--------------------" );
                if ( Hub.IsValid() )
                {
                    _lines.Add( "  POWER    - on | off — hub boot/shutdown (confirm on rail)." );
                    if ( !Hub.AccessPinIsSet )
                        _lines.Add( "  PIN      - owner sets hub lock at first USE (graphical gatekeeper)." );
                    else
                        _lines.Add( "  PIN      - gatekeeper unlocks on hub USE (session ~15 min)." );
                }
                _lines.Add( "  BITCOIN  - Sell or view stored bitcoin balance." );
                _lines.Add( "  INFO     - Output device specifications." );
                _lines.Add( "  RIGS     - List linked GPU Racks (Market → place within 8m)." );
                _lines.Add( "  SELECT   - select <id> — pick active rig for commands." );
                _lines.Add( "  MINING   - start | stop | start all | stop all | start <id>" );
                _lines.Add( "  UPGRADE  - Open hardware upgrade panel." );
                _lines.Add( "  STATUS   - Dump full status to command log." );
                _lines.Add( "  MENU     - Same as UPGRADE." );
                _lines.Add( "  BACK     - Close upgrade panel (when open)." );
                _lines.Add( "  ABOUT    - Package version and copyright." );
                _lines.Add( "  CLEAR    - Clear the command log." );
                _lines.Add( "  HELP     - Show this list." );
                _lines.Add( "--------------------------------------------" );
                break;

            case "clear":
                _lines.Clear();
                _showUpgradeMenu = false;
                break;

            case "status":
                if ( !Hub.IsValid() ) { _lines.Add( "ERROR: Hub connection lost." ); break; }
                _showUpgradeMenu = false;
                _liveStatus = true;
                RefreshLiveStatus();
                break;

            case "info":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                _lines.Add( "--------------------INFO--------------------" );
                _lines.Add( $"  Device:      {GpuRackRegistry.GetRigTypeLabel( Miner )}" );
                _lines.Add( $"  Interface:   HASHD RIG CONTROL v1" );
                _lines.Add( $"  CPU Speed:   {Miner.ClockSpeed:0.000} GHz (Lv {Miner.CpuUpgradeLevel})" );
                _lines.Add( $"  CPU Cores:   {Miner.CoreCount} (Lv {Miner.CoreUpgradeLevel})" );
                _lines.Add( $"  Hash Rate:   {Miner.MiningRatePerMinute:0.00000} BTC/min" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "bitcoin":
                if ( !Hub.IsValid() ) { _lines.Add( "ERROR: Hub connection lost." ); break; }
                if ( arg == "sell" )
                {
                    if ( GetHubBtcBalance() <= 0 )
                    {
                        _lines.Add( "ERROR: No bitcoin to sell." );
                        break;
                    }
                    _lines.Add( $"Selling {GetHubBtcBalance():0.00000} BTC for ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0}..." );
                    Hub.RequestSellBitcoin();
                    _lines.Add( "Done." );
                }
                else
                {
                    _lines.Add( $"  Hub balance: {GetHubBtcBalance():0.00000} BTC (≈ ${GetHubBtcBalance() * GpuRackEntity.BitcoinValue:N0})" );
                    _lines.Add( "  Use 'bitcoin sell' to cash out." );
                }
                break;

            case "racks":
            case "rigs":
                AppendRacksList();
                break;

            case "select":
                if ( !int.TryParse( arg, out var selectId ) )
                {
                    _lines.Add( "ERROR: Usage — select <id>  (see 'rigs')." );
                    break;
                }
                if ( !GpuRackRegistry.TrySelect( selectId ) )
                {
                    _lines.Add( $"ERROR: No rig id {selectId}." );
                    break;
                }
                _lines.Add( $"Selected rig-{selectId} ({GpuRackRegistry.GetRigTypeLabel( Miner )})." );
                break;

            case "mining":
                if ( arg == "start" )
                {
                    var startTarget = parts.Length > 2 ? parts[2] : "";
                    if ( startTarget == "all" )
                    {
                        var started = SetMiningOnAll( true );
                        _lines.Add( started > 0 ? $"Mining started on {started} rig(s)." : "ERROR: No rigs in range." );
                    }
                    else if ( int.TryParse( startTarget, out var startId ) && GpuRackRegistry.TrySelect( startId ) )
                    {
                        Miner.RequestSetMiningState( true );
                        _lines.Add( $"Rig-{startId} mining started." );
                    }
                    else if ( Miner.IsValid() )
                    {
                        Miner.RequestSetMiningState( true );
                        _lines.Add( "Mining started." );
                    }
                    else
                    {
                        _lines.Add( "ERROR: No GPU Rack selected — use 'rigs' or 'select <id>'." );
                    }
                }
                else if ( arg == "stop" )
                {
                    var stopTarget = parts.Length > 2 ? parts[2] : "";
                    if ( stopTarget == "all" )
                    {
                        var stopped = SetMiningOnAll( false );
                        _lines.Add( stopped > 0 ? $"Mining stopped on {stopped} rig(s)." : "ERROR: No rigs in range." );
                    }
                    else if ( int.TryParse( stopTarget, out var stopId ) && GpuRackRegistry.TrySelect( stopId ) )
                    {
                        Miner.RequestSetMiningState( false );
                        _lines.Add( $"Rig-{stopId} mining stopped." );
                    }
                    else if ( Miner.IsValid() )
                    {
                        Miner.RequestSetMiningState( false );
                        _lines.Add( "Mining stopped." );
                    }
                    else
                    {
                        _lines.Add( "ERROR: No rig selected." );
                    }
                }
                else if ( Miner.IsValid() )
                {
                    _lines.Add( $"  Status: {( Miner.IsMining ? "ACTIVE" : "STOPPED" )}" );
                    _lines.Add( "  Use 'mining start' | 'stop' | 'start all' | 'start <id>'." );
                }
                else
                {
                    _lines.Add( "ERROR: No rigs linked." );
                }
                break;

            case "upgrade":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                if ( arg == "cpu" )
                {
                    OnBuyCpu();
                }
                else if ( arg == "cores" )
                {
                    OnBuyCores();
                }
                else
                {
                    OpenUpgradeMenu();
                }
                break;

            case "menu":
                if ( !Miner.IsValid() ) { _lines.Add( "ERROR: Miner connection lost." ); break; }
                OpenUpgradeMenu();
                break;

            case "power":
                if ( !Hub.IsValid() )
                {
                    _lines.Add( "ERROR: No hub session — open from a Bitcoin Miner hub." );
                    break;
                }

                var hubState = Hub.IsPowered ? "ONLINE" : "OFFLINE";
                _lines.Add( $"  Hub power: {hubState}" );
                _lines.Add( "  Use the POWER ON / POWER OFF button on the rail." );
                break;

            case "about":
                _lines.Add( "--------------------------------------------" );
                _lines.Add( $"  {BitcoinMiningAddon.UiVersionFooter}" );
                _lines.Add( $"  {LifePunchSourceMark.CopyrightLine}" );
                _lines.Add( $"  {LifePunchSourceMark.UseRestrictionShort}" );
                _lines.Add( "--------------------------------------------" );
                break;

            default:
                _lines.Add( $"Unknown command: '{cmd}'. Type 'help' for a list of commands." );
                break;
        }
    }

    private void AppendRacksList()
    {
        var rigs = GpuRackRegistry.RegisteredRigs;
        if ( rigs.Count == 0 )
        {
            _lines.Add( "No GPU Racks linked — buy from Market, place within 8m of this hub." );
            _lines.Add( $"  Cap: {BitcoinMiningCombatStats.MaxSmallRacksPerHub}× {BitcoinMiningAddon.DisplayName} · {BitcoinMiningCombatStats.MaxLargeRacksPerHub}× {BitcoinMiningAddon.AdvancedDisplayName}" );
            return;
        }

        _lines.Add( "--------------------LINKED GPU RIGS--------------------" );
        for ( var i = 0; i < rigs.Count; i++ )
        {
            var rig = rigs[i];
            if ( !rig.IsValid() )
                continue;

            var marker = i == GpuRackRegistry.SelectedIndex ? "*" : " ";
            var type = GpuRackRegistry.GetRigTypeLabel( rig );
            var status = GpuRackRegistry.GetRigStatusLabel( rig );
            _lines.Add( $" {marker} rig-{i}  {type,-9}  {status,-7}  {rig.ClockSpeed:0.00} GHz" );
        }
        _lines.Add( "--------------------------------------------" );
    }

    private static int SetMiningOnAll( bool enabled )
    {
        var count = 0;
        foreach ( var rig in GpuRackRegistry.RegisteredRigs )
        {
            if ( !rig.IsValid() )
                continue;

            rig.RequestSetMiningState( enabled );
            count++;
        }
        return count;
    }

    protected override int BuildHash()
    {
        if ( IsHubPowerGate || IsHubPinSetup || IsHubPinUnlock )
        {
            return HashCode.Combine(
                Hub?.IsPowered ?? false,
                Hub?.AccessPinIsSet ?? false,
                (int)_pinGate,
                _lines.Count,
                GpuRackRegistry.RegisteredRigs.Count );
        }

        if ( !Miner.IsValid() )
        {
            return HashCode.Combine(
                GetHubBtcBalance(),
                _lines.Count,
                _showUpgradeMenu,
                HashdTerminalHost.GetLocalWalletCash(),
                GpuRackRegistry.RegisteredRigs.Count );
        }

        var hash = new HashCode();
        hash.Add( GetHubBtcBalance() );
        hash.Add( Miner.IsMining );
        hash.Add( Miner.CpuUpgradeLevel );
        hash.Add( Miner.CoreUpgradeLevel );
        hash.Add( _lines.Count );
        hash.Add( _showUpgradeMenu );
        hash.Add( HashdTerminalHost.GetLocalWalletCash() );
        hash.Add( (int)( _smoothProgress * 10f ) );
        hash.Add( GpuRackRegistry.SelectedIndex );
        hash.Add( GpuRackRegistry.RegisteredRigs.Count );
        hash.Add( Hub?.IsPowered ?? false );
        return hash.ToHashCode();
    }
