    private void OnPinDigit( int digit )
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length >= BitcoinMinerHubAccessPin.PinLength )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinDigits += digit.ToString();
        _pinError = "";

        if ( _pinDigits.Length >= BitcoinMinerHubAccessPin.PinLength )
            CompletePinEntry();
    }

    private void OnPinBackspace()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length == 0 )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        _pinDigits = _pinDigits[..^1];
        _pinError = "";
    }

    private void OnPinClear()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen )
            return;

        Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
        ResetPinDigits();
        _pinError = "";
