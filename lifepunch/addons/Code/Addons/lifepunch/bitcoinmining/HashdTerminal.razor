@namespace LifePunch.DXRP.Addons.BitcoinMining
@using LifePunch.DXRP.Addons
@using System
@using System.Linq
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
    @if ( IsAtComputer )
    {
        <div class="ops-backdrop" onclick=@OnClickClose></div>
    }
    <div class="@(IsAtComputer ? "crt-frame" : "")">
    <div class="scanlines"></div>

    <div class="title-bar">
        <span class="title-mark">◆</span>
        <span class="title-text">@GetTitleLabel()</span>
        @if ( IsHeadConsole && !IsPinGateActive )
        {
            <span class="title-sub">HASHD / rig0</span>
        }
        <span class="title-ver">v1</span>
        <span class="title-spacer"></span>
        @if ( IsHeadConsole && !IsPinGateActive )
        {
            <span class="title-publisher">@LifePunchSourceMark.UiFooterMark</span>
        }
        @if ( IsHeadConsole && !IsPinGateActive )
        {
            <button class="icon-btn cog @(_showSettings ? "active" : "")" tooltip="Settings" onclick=@OnToggleSettings>
                <i class="material-icons">settings</i>
            </button>
        }
        @if ( IsHubPanel && !IsPinGateActive )
        {
            <button class="icon-btn cog @(_showSettings ? "active" : "")" tooltip="Settings" onclick=@OnToggleSettings>
                <i class="material-icons">settings</i>
            </button>
        }
        <button class="@(IsHubPanel && !IsPinGateActive ? "close-x" : "icon-btn close")" tooltip="Close" onclick=@OnClickClose>
            @if ( IsHubPanel && !IsPinGateActive )
            {
                <text>CLOSE</text>
            }
            else
            {
                <i class="material-icons">close</i>
            }
        </button>
    </div>

    @if ( _showSettings && ( IsHubPanel || IsHeadConsole ) && !IsPinGateActive )
    {
        <div class="hashd-settings">
            <div class="hashd-settings-head">PANEL SIZE</div>
            <button class="hashd-settings-opt @( _panelSize == 0 ? "active" : "" )" onclick=@(() => SetPanelSize( 0 ))>COMPACT</button>
            <button class="hashd-settings-opt @( _panelSize == 1 ? "active" : "" )" onclick=@(() => SetPanelSize( 1 ))>STANDARD</button>
            <button class="hashd-settings-opt @( _panelSize == 2 ? "active" : "" )" onclick=@(() => SetPanelSize( 2 ))>EXPANDED</button>
        </div>
    }

    <div class="terminal-body">
        @if ( IsPinGateActive )
        {
            <div class="pin-stage">
                @if ( IsHubPinBlocked )
                {
                    <div class="pin-lock-badge pin-lock-static">
                        <span class="pin-lock-mark">◆</span>
                        <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                    </div>
                }
                else if ( !_pinEntryOpen )
                {
                    <button class="pin-lock-cta" onclick=@OnPinCtaClick>
                        <span class="pin-lock-mark">◆</span>
                        <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                        <span class="pin-lock-hint">CLICK TO CONTINUE</span>
                    </button>
                }
                else
                {
                    <div class="pin-entry-panel">
                        <div class="pin-entry-header">
                            <span class="pin-entry-mark">◆</span>
                            <span class="pin-entry-title">@GetPinEntryTitle()</span>
                        </div>
                        <div class="pin-entry-sub">@GetPinEntrySubtitle()</div>
                        <div class="pin-entry-dots">
                            @for ( var i = 0; i < BitcoinMinerHubAccessPin.PinLength; i++ )
                            {
                                <span class="pin-dot @( i < _pinDigits.Length ? "filled" : "" )"></span>
                            }
                        </div>
                        @if ( !string.IsNullOrEmpty( _pinError ) )
                        {
                            <div class="pin-entry-error">@_pinError</div>
                        }
                        <div class="pin-numpad">
                            @for ( var digit = 1; digit <= 9; digit++ )
                            {
                                var key = digit;
                                <button class="pin-key" onclick=@(() => OnPinDigit( key ))>@key</button>
                            }
                            <button class="pin-key pin-key-fn" onclick=@OnPinClear>CLEAR</button>
                            <button class="pin-key" onclick=@(() => OnPinDigit( 0 ))>0</button>
                            <button class="pin-key pin-key-fn" onclick=@OnPinBackspace>⌫</button>
                        </div>
                        @if ( _pinConfirming )
                        {
                            <button class="pin-entry-back" onclick=@OnPinEntryBack>← RE-ENTER PIN</button>
                        }
                    </div>
                }
            </div>
        }

        @if ( !IsPinUiFlow && !IsPinGateActive && IsHubPanel )
        {
            <div class="telemetry-rail">
                <div class="rail-header">IDENTIFICATION</div>
                <div class="rail-block">
                    <span class="rail-label">OPERATOR</span>
                    <span class="rail-value">@HashdTerminalHost.GetLocalOperatorLabel()</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">OWNER</span>
                    <span class="rail-value">@(Hub.IsValid() ? Hub.GetOwnerLabel() : "—")</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">GATE</span>
                    <span class="rail-value active">@(Hub.IsValid() && Hub.AccessPinIsSet ? "SECURED" : "DORMANT")</span>
                </div>
                <div class="rail-header">HUB STATUS</div>
                <div class="rail-block">
                    <span class="rail-label">POWER</span>
                    <span class="rail-value @(Hub.IsValid() && Hub.IsPowered ? "active" : "")">@(Hub.IsValid() && Hub.IsPowered ? "ONLINE" : "OFFLINE")</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">LINKED</span>
                    <span class="rail-value">@GetLinkedRigsSummary()</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">MINING</span>
                    <span class="rail-value @(Miner.IsValid() && Miner.IsMining ? "active" : "")">@GetMiningStatusLabel()</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">BALANCE</span>
                    <span class="rail-value">@GetBtcBalanceLabel()</span>
                </div>
                <div class="rail-block">
                    <span class="rail-label">HASH</span>
                    <span class="rail-value">@GetHashRateLabel()</span>
                </div>
                <div class="rail-actions">
                    <button class="rail-btn power-on @(Hub.IsValid() && Hub.IsPowered ? "active" : "")" onclick=@OnPowerOn>POWER ON</button>
                    <button class="rail-btn power-off" onclick=@OnPowerOff>POWER OFF</button>
                </div>
                <div class="rail-nav">
                    <div class="rail-nav-header">MODULES</div>
                    <button class="nav-btn @(_module == HashdModule.Control ? "active" : "")" onclick=@(() => _module = HashdModule.Control)>CONTROL</button>
                    <button class="nav-btn @(_module == HashdModule.Upgrades ? "active" : "")" onclick=@(() => _module = HashdModule.Upgrades)>UPGRADES</button>
                    <button class="nav-btn @(_module == HashdModule.Log ? "active" : "")" onclick=@(() => _module = HashdModule.Log)>LOG</button>
                </div>
            </div>

            <div class="main-pane">
                @if ( _module == HashdModule.Control )
                {
                    <div class="module-header">CONTROL — GPU RACK LINK</div>
                    <div class="control-body">
                        <p class="control-line">Link GPU racks to this hub. Linked rigs credit the hub wallet while mining.</p>
                        <div class="control-section">LINKED</div>
                        @{
                            var linkedRigs = GetLinkedRigsForControl();
                        }
                        @if ( linkedRigs.Count == 0 )
                        {
                            <p class="control-line dim">No GPU racks linked.</p>
                        }
                        else
                        {
                            @for ( var i = 0; i < linkedRigs.Count; i++ )
                            {
                                var linkIndex = i;
                                var rig = linkedRigs[i];
                                <div class="link-row">
                                    <span class="link-label">@BitcoinMinerHubRegistry.GetRigLabel( rig )</span>
                                    <button class="link-btn unlink" onclick=@(() => OnUnlinkRig( linkIndex ))>UNLINK</button>
                                </div>
                            }
                            <button class="link-btn unlink-all" onclick=@OnUnlinkAllRigs>UNLINK ALL</button>
                        }
                        <div class="control-section">AVAILABLE</div>
                        @{
                            var rigCandidates = GetUnlinkedRigCandidates();
                        }
                        @if ( rigCandidates.Count == 0 )
                        {
                            <p class="control-line dim">No unlinked GPU racks in scene.</p>
                        }
                        else
                        {
                            @for ( var i = 0; i < rigCandidates.Count; i++ )
                            {
                                var scanIndex = i;
                                var rig = rigCandidates[i];
                                <div class="link-row">
                                    <span class="link-label">@BitcoinMinerHubRegistry.GetRigLabel( rig )</span>
                                    <button class="link-btn" onclick=@(() => OnLinkRig( scanIndex ))>LINK</button>
                                </div>
                            }
                        }
                        <p class="control-line warn">Power OFF stops linked racks. Run rig0 commands on the HASHD monitor.</p>
                    </div>
                }
                else if ( _module == HashdModule.Upgrades )
                {
                    <div class="module-header">UPGRADES — HARDWARE</div>
                    <div class="upgrade-balance">Wallet: $@HashdTerminalHost.GetLocalWalletCash().ToString("N0")</div>
                    <div class="upgrade-list">
                        <div class="upgrade-row">
                            <div class="upgrade-info">
                                <span class="upgrade-name">CPU CLOCK</span>
                                <span class="upgrade-detail">@GetCpuUpgradeDetail()</span>
                            </div>
                            <button class="upgrade-btn @(CanAffordCpu() ? "" : "disabled")" onclick=@OnBuyCpu>INSTALL</button>
                        </div>
                        <div class="upgrade-row">
                            <div class="upgrade-info">
                                <span class="upgrade-name">CPU CORES</span>
                                <span class="upgrade-detail">@GetCoreUpgradeDetail()</span>
                            </div>
                            <button class="upgrade-btn @(CanAffordCores() ? "" : "disabled")" onclick=@OnBuyCores>INSTALL</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="module-header">LOG</div>
                    <div class="log-scroll">
                        @foreach ( var line in _lines )
                        {
                            <label class="log-line @(GetLineClass( line ))">@line</label>
                        }
                    </div>
                }
            </div>
        }
        else if ( !IsPinUiFlow && !IsPinGateActive && IsHeadConsole )
        {
            <div class="terminal-body head-body">
                <div class="ops-rail">
                    <div class="rail-header">SESSION</div>
                    <div class="rail-block">
                        <span class="rail-label">OPERATOR</span>
                        <span class="rail-value">@HashdTerminalHost.GetLocalOperatorLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">PROGRAM</span>
                        <span class="rail-value active">HASHD rig0</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">HUB LINK</span>
                        <span class="rail-value @(Hub.IsValid() ? "active" : "")">@(Hub.IsValid() ? "STABLE" : "LOST")</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">HUB PWR</span>
                        <span class="rail-value @(Hub.IsValid() && Hub.IsPowered ? "active" : "")">@(Hub.IsValid() && Hub.IsPowered ? "ONLINE" : "OFFLINE")</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">MINING</span>
                        <span class="rail-value @(GetMiningStatusLabel() == "MINING" ? "active" : "")">@GetMiningStatusLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">BALANCE</span>
                        <span class="rail-value">@GetBtcBalanceLabel()</span>
                    </div>
                    <div class="rail-block">
                        <span class="rail-label">SELECTED</span>
                        <span class="rail-value">@(Miner.IsValid() ? BitcoinMinerHubRegistry.GetRigLabel( Miner ) : "—")</span>
                    </div>
                    <div class="rail-nav">
                        <div class="rail-nav-header">MODULES</div>
                        <button class="nav-btn @(_headModule == HeadOpsModule.Log ? "active" : "")" onclick=@(() => _headModule = HeadOpsModule.Log)>LOG</button>
                        <button class="nav-btn @(_headModule == HeadOpsModule.Help ? "active" : "")" onclick=@(() => _headModule = HeadOpsModule.Help)>HELP</button>
                    </div>
                    <div class="rail-hint">Command line ↓</div>
                </div>

                <div class="main-pane head-main">
                    <div class="module-header">@GetHeadModuleTitle()</div>
                    <div class="module-body" onclick=@FocusInput>
                        @if ( _headModule == HeadOpsModule.Log )
                        {
                            <div class="log-scroll head-log">
                                @foreach ( var line in _lines )
                                {
                                    <div class="line-row">
                                        <label class="screen-line @(GetLineClass( line ))">@line</label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="module-help">
                                <div class="help-block">
                                    <span class="help-cmd">mining start | stop</span>
                                    <span class="help-desc">Start or stop mining on selected rig</span>
                                </div>
                                <div class="help-block">
                                    <span class="help-cmd">bitcoin sell</span>
                                    <span class="help-desc">Cash out hub wallet balance</span>
                                </div>
                                <div class="help-block">
                                    <span class="help-cmd">rigs · select &lt;id&gt;</span>
                                    <span class="help-desc">List linked racks and pick active rig</span>
                                </div>
                                <div class="help-block">
                                    <span class="help-cmd">status · info · clear · about</span>
                                    <span class="help-desc">Session utilities</span>
                                </div>
                                <div class="help-note">Hub body: POWER · link racks · hardware UPGRADES · audit LOG.</div>
                                <div class="help-note">Power on the hub before mining. Linked racks credit the hub wallet.</div>
                            </div>
                        }
                    </div>
                    <div class="input-row" onclick=@FocusInput>
                        <span class="prompt-label">@GetPromptLabel()</span>
                        <TextEntry
                            class="terminal-input"
                            @ref="InputBox"
                            onsubmit=@OnSubmit />
                    </div>
                </div>
            </div>
        }
    </div>

    <LifePunchUiFooter />
    </div>
</root>

@code {
    private enum PinGateKind { None, Setup, Unlock, Blocked }
    private enum HashdModule { Control, Upgrades, Log }
    private enum HeadOpsModule { Log, Help }

    private HashdSurface _surface = HashdSurface.HubPanel;
    private Vector3? _uiAnchor;
    private HeadOpsModule _headModule = HeadOpsModule.Log;
    private bool IsHubPanel => _surface == HashdSurface.HubPanel;
    private bool IsHeadConsole => _surface == HashdSurface.HeadConsole;
    private bool IsAtComputer => IsHeadConsole || IsPinGateActive;

    private GpuRackEntity Miner => GpuRackRegistry.SelectedRig;
    private BitcoinMinerHubEntity Hub => GpuRackRegistry.ActiveHub;
    private bool IsHubPowerGate => Hub.IsValid() && !Hub.IsPowered && _pinGate == PinGateKind.None;
    private bool IsHubPinSetup => _pinGate == PinGateKind.Setup;
    private bool IsHubPinUnlock => _pinGate == PinGateKind.Unlock;
    private bool IsHubPinBlocked => _pinGate == PinGateKind.Blocked;
    private bool IsPinGateActive => _pinGate != PinGateKind.None;
    private bool IsPinUiFlow => IsHubPinSetup || IsHubPinUnlock;

    private TextEntry InputBox { get; set; }
    private Panel ScreenScroll { get; set; }
    private readonly List<string> _lines = new();
    private bool _liveStatus = false;
    private HashdModule _module = HashdModule.Control;
    private int _statusLineCount = 0;
    private const int MaxLines = 200;
    private const string PromptPrefix = "rig0>";
    private const string AuthPromptPrefix = "auth>";
    private PinGateKind _pinGate = PinGateKind.None;
    private float _smoothProgress = 0f;
    private float _lastKnownProgress = 0f;
    private int _lastTextLength = 0;
    private TimeSince _sinceSecondly = 0f;
    private bool _showSettings;
    private int _panelSize = 1;
    private bool _pinEntryOpen;
    private bool _pinConfirming;
    private string _pinDigits = "";
    private string _pinFirstEntry = "";
    private string _pinError = "";

    private string GetRootClass()
    {
        var classes = new List<string> { "hashd-terminal" };
        if ( _pinGate != PinGateKind.None )
            classes.Add( "pin-gate" );
        if ( IsHubPinBlocked )
            classes.Add( "pin-blocked" );
        if ( IsHubPinUnlock )
            classes.Add( "pin-unlock" );
        if ( _pinEntryOpen )
            classes.Add( "pin-entry-open" );
        if ( IsHeadConsole )
            classes.Add( "head-console-shell" );
        if ( IsAtComputer )
            classes.Add( "at-computer" );
        if ( IsHubPanel && !IsPinGateActive )
            classes.Add( "hub-panel-shell" );
        if ( _panelSize == 0 )
            classes.Add( "compact" );
        else if ( _panelSize == 2 )
            classes.Add( "expanded" );
        return string.Join( " ", classes );
    }

    private string GetHeadModuleTitle() =>
        _headModule == HeadOpsModule.Help ? "HELP — RIG0 COMMANDS" : "LOG — COMMAND OUTPUT";

    private Vector3 GetUiAnchorPosition() =>
        _uiAnchor ?? ( Hub.IsValid() ? Hub.WorldPosition : Vector3.Zero );

    private void OnToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    private void SetPanelSize( int size )
    {
        _panelSize = Math.Clamp( size, 0, 2 );
        _showSettings = false;
    }

    private static string GetLineClass( string line )
    {
        if ( line.StartsWith( "rig0>" ) ) return "prompt-line";
        if ( line.StartsWith( ">>" ) ) return "boot-line";
        if ( line.StartsWith( "---" ) || line.StartsWith( "----" ) ) return "divider-line";
        if ( line.StartsWith( "  " ) ) return "help-line";
        if ( line.StartsWith( "ERROR" ) ) return "error-line";
        return "output-line";
    }

    private void TrimLines()
    {
        var limit = _liveStatus ? MaxLines - _statusLineCount : MaxLines;
        if ( _lines.Count > limit )
            _lines.RemoveRange( 0, _lines.Count - limit );
    }

    public static void Open( GpuRackEntity miner )
    {
        var scene = Sandbox.Game.ActiveScene;
        if ( miner.IsValid() )
            GpuRackRegistry.Refresh( scene, miner.WorldPosition );
        else if ( HashdTerminalHost.LocalViewerPosition( scene ) is { } viewerPos )
            GpuRackRegistry.Refresh( scene, viewerPos );

        OpenMounted( miner );
    }

    public static void OpenHubPanel( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var first = GpuRackRegistry.RegisteredRigs.FirstOrDefault();
        OpenMounted( first, HashdSurface.HubPanel, hub.WorldPosition );
    }

    public static void OpenHeadConsole( BitcoinMinerHubEntity hub, GameObject headSource )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var anchor = headSource.IsValid() ? headSource.WorldPosition : hub.WorldPosition;
        var first = GpuRackRegistry.RegisteredRigs.FirstOrDefault();
        OpenMounted( first, HashdSurface.HeadConsole, anchor );
    }

    [Obsolete( "Use OpenHubPanel or OpenHeadConsole." )]
    public static void OpenFromHub( BitcoinMinerHubEntity hub ) => OpenHubPanel( hub );

    public static void OpenHubPowerGate( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal._surface = HashdSurface.HubPanel;
        terminal._uiAnchor = hub.WorldPosition;
        terminal.BootHubPowerGate();
    }

    public static void OpenHubPinSetup( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal._surface = HashdSurface.HubPanel;
        terminal._uiAnchor = hub.WorldPosition;
        terminal.BootHubPinSetup();
    }

    public static void OpenHubPinUnlock( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal._surface = HashdSurface.HubPanel;
        terminal._uiAnchor = hub.WorldPosition;
        terminal.BootHubPinUnlock();
    }

    public static void OpenHubPinBlocked( BitcoinMinerHubEntity hub )
    {
        if ( !hub.IsValid() )
            return;

        var scene = Sandbox.Game.ActiveScene;
        GpuRackRegistry.RefreshFromHub( scene, hub );

        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal._surface = HashdSurface.HubPanel;
        terminal._uiAnchor = hub.WorldPosition;
        terminal.BootHubPinBlocked();
    }

    public static void NotifyPinDenied( string message )
    {
        var terminal = Sandbox.Game.ActiveScene?.GetAllComponents<HashdTerminal>().FirstOrDefault();
        if ( !terminal.IsValid() )
            return;

        terminal.AppendAuthLine( $"ERROR: {message}" );
    }

    public static void NotifyLinkMessage( string message )
    {
        var terminal = Sandbox.Game.ActiveScene?.GetAllComponents<HashdTerminal>().FirstOrDefault();
        if ( !terminal.IsValid() )
            return;

        terminal.AppendLine( message );
        if ( terminal.Hub.IsValid() )
            GpuRackRegistry.RefreshFromHub( terminal.Hub );
    }

    private static void OpenMounted( GpuRackEntity miner, HashdSurface surface, Vector3 uiAnchor )
    {
        var terminal = HashdTerminalHost.Mount();
        if ( terminal == null )
            return;

        terminal._surface = surface;
        terminal._uiAnchor = uiAnchor;

        if ( miner.IsValid() )
            GpuRackRegistry.TrySelect( miner );

        if ( surface == HashdSurface.HeadConsole )
        {
            terminal.FocusInput();
            terminal.BootHeadConsole();
        }
        else
        {
            terminal.BootHubPanel();
        }
    }

    private static void OpenMounted( GpuRackEntity miner ) =>
        OpenMounted( miner, HashdSurface.HeadConsole, miner.IsValid() ? miner.WorldPosition : Vector3.Zero );

    private void CloseTerminal()
    {
        if ( Hub.IsValid() )
            Hub.RequestEndAccessSession();

        HashdTerminalHost.Close( this );
    }

    private string GetPinLockBadgeLabel()
    {
        if ( IsHubPinSetup )
            return "SECURE BOOT — SET PIN";
        if ( IsHubPinBlocked )
            return "LOCKED — SPAWN ACCESS ONLY";
        if ( IsHubPinUnlock )
            return "ENCRYPTED — PIN REQUIRED";
        return "LOCKED";
    }

    private string GetTitleLabel()
    {
        if ( IsHubPinSetup )
            return "GATEKEEPER — SET PIN";
        if ( IsHubPinBlocked )
            return "GATEKEEPER — LOCKED";
        if ( IsHubPinUnlock )
            return "GATEKEEPER — ENTER PIN";
        if ( IsHubPowerGate )
            return "HUB POWER GATE";
        if ( IsHeadConsole )
            return "HASHD OPS TERMINAL";
        return "HASHD HUB CONTROL";
    }

    private string GetPromptLabel() =>
        _pinGate != PinGateKind.None ? AuthPromptPrefix : PromptPrefix;

    private void BootHubPinSetup()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _module = HashdModule.Control;
        _pinGate = PinGateKind.Setup;
    }

    private void BootHubPinBlocked()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _module = HashdModule.Control;
        _pinGate = PinGateKind.Blocked;
        _lines.Add( ">> gatekeeper — spawner wake required" );
        _lines.Add( $">> registered spawner: {Hub.GetOwnerLabel()}" );
        _lines.Add( $">> your identity: {HashdTerminalHost.GetLocalOperatorLabel()}" );
        _lines.Add( ">> your Steam ID does not match the spawner — cannot set PIN" );
