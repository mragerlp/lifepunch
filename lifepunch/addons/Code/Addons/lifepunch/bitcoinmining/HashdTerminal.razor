    private void SecondlyUpdate()
    {
        var viewerPos = HashdTerminalHost.LocalViewerPosition( Scene );

        if ( IsPinGateActive || IsHubPowerGate )
        {
            if ( !Hub.IsValid() )
            {
                CloseTerminal();
                return;
            }

            if ( viewerPos.HasValue && !LifePunchMenuInteractRange.IsInUiCloseRange( viewerPos.Value, GetUiAnchorPosition() ) )
            {
                CloseTerminal();
                return;
            }

            return;
        }

        if ( !Hub.IsValid() )
        {
            CloseTerminal();
            return;
        }

        if ( viewerPos.HasValue && !LifePunchMenuInteractRange.IsInUiCloseRange( viewerPos.Value, GetUiAnchorPosition() ) )
        {
            CloseTerminal();
            return;
        }

        if ( _liveStatus )
            RefreshLiveStatus();
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();

        if ( _sinceSecondly >= 1f )
        {
            _sinceSecondly = 0f;
            SecondlyUpdate();
        }

        if ( !IsHubPowerGate && !IsHubPinSetup && !IsHubPinUnlock && !IsHubPinBlocked && !Hub.IsValid() )
            return;

        if ( IsHeadConsole && InputBox.IsValid() && !InputBox.HasFocus && !IsPinUiFlow )
            InputBox.Focus();

        if ( Input.Pressed( "Attack2" ) )
            Input.Clear( "Attack2" );

        if ( Input.Pressed( "Pocket" ) )
            Input.Clear( "Pocket" );
        if ( Input.Down( "Pocket" ) )
            Input.Clear( "Pocket" );

        if ( InputBox.IsValid() )
        {
            var currentLength = InputBox.Text?.Length ?? 0;
            if ( currentLength != _lastTextLength )
            {
                Sound.Play( BitcoinMiningAddon.KeyboardSoundPath );
                _lastTextLength = currentLength;
            }
        }

        var progressRig = Miner.IsValid() ? Miner : GpuRackRegistry.RegisteredRigs.FirstOrDefault( r => r.IsValid() && r.IsMining );
        if ( progressRig.IsValid() && progressRig.IsMining )
        {
            if ( progressRig.MiningProgress < _lastKnownProgress - 0.1f )
                _smoothProgress = 0f;
            _lastKnownProgress = progressRig.MiningProgress;
            _smoothProgress = MathF.Min( _smoothProgress + Time.Delta / BitcoinMiningAddon.MiningPayoutIntervalSeconds, 1f );
        }
        else
        {
            _smoothProgress = 0f;
        }
    }

