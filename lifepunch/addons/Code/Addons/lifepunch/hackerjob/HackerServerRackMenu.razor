@namespace LifePunch.DXRP.Addons.HackerJob
@using System
@using System.Linq
@using LifePunch.DXRP.Addons
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
    <div class="scanlines"></div>

    <div class="title-bar">
        <span class="title-mark">▣</span>
        <span class="title-text">@GetTitleLabel()</span>
        <span class="title-ver">v1</span>
        <span class="title-spacer"></span>
        @if ( !IsPinGateActive )
        {
            <button class="icon-btn cog @(_showSettings ? "active" : "")" tooltip="Settings" onclick=@OnToggleSettings>
                <i class="material-icons">settings</i>
            </button>
        }
        <button class="@(!IsPinGateActive ? "close-x" : "icon-btn close")" tooltip="Close" onclick=@OnClickClose>
            @if ( !IsPinGateActive )
            {
                <text>CLOSE</text>
            }
            else
            {
                <i class="material-icons">close</i>
            }
        </button>
    </div>

    @if ( _showSettings && !IsPinGateActive )
    {
        <div class="rack-settings">
            <div class="rack-settings-head">PANEL SIZE</div>
            <button class="rack-settings-opt @( _panelSize == 0 ? "active" : "" )" onclick=@(() => SetPanelSize( 0 ))>COMPACT</button>
            <button class="rack-settings-opt @( _panelSize == 1 ? "active" : "" )" onclick=@(() => SetPanelSize( 1 ))>STANDARD</button>
            <button class="rack-settings-opt @( _panelSize == 2 ? "active" : "" )" onclick=@(() => SetPanelSize( 2 ))>EXPANDED</button>
        </div>
    }

    <div class="terminal-body">
        @if ( IsPinGateActive )
        {
            <div class="pin-stage">
                @if ( IsRackPinBlocked )
                {
                    <div class="pin-lock-badge pin-lock-static">
                        <span class="pin-lock-mark">▣</span>
                        <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                    </div>
                }
                else if ( !_pinEntryOpen )
                {
                    <button class="pin-lock-cta" onclick=@OnPinCtaClick>
                        <span class="pin-lock-mark">▣</span>
                        <span class="pin-lock-text">@GetPinLockBadgeLabel()</span>
                        <span class="pin-lock-hint">CLICK TO CONTINUE</span>
                    </button>
                }
                else
                {
                    <div class="pin-entry-panel">
                        <div class="pin-entry-header">
                            <span class="pin-entry-mark">▣</span>
                            <span class="pin-entry-title">@GetPinEntryTitle()</span>
                        </div>
                        <div class="pin-entry-sub">@GetPinEntrySubtitle()</div>
                        <div class="pin-entry-dots">
                            @for ( var i = 0; i < HackerServerRackAccessPin.PinLength; i++ )
                            {
                                <span class="pin-dot @( i < _pinDigits.Length ? "filled" : "" )"></span>
                            }
                        </div>
                        @if ( !string.IsNullOrEmpty( _pinError ) )
                        {
                            <div class="pin-entry-error">@_pinError</div>
                        }
                        <div class="pin-numpad">
                            @foreach ( var key in new[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 } )
                            {
                                <button class="pin-key" onclick=@(() => OnPinDigit( key ))>@key</button>
                            }
                            <button class="pin-key pin-key-fn" onclick=@OnPinClear>CLEAR</button>
                            <button class="pin-key" onclick=@(() => OnPinDigit( 0 ))>0</button>
                            <button class="pin-key pin-key-fn" onclick=@OnPinBackspace>⌫</button>
                        </div>
                        @if ( _pinConfirming )
                        {
                            <button class="pin-entry-back" onclick=@OnPinEntryBack>← RE-ENTER PIN</button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
        <div class="telemetry-rail">
            <div class="rail-header">IDENTIFICATION</div>
            <div class="rail-block">
                <span class="rail-label">OPERATOR</span>
                <span class="rail-value">@HackerServerRackMenuHost.GetLocalOperatorLabel()</span>
            </div>
            <div class="rail-header">RACK STATUS</div>
            <div class="rail-block">
                <span class="rail-label">POWER</span>
                <span class="rail-value @(Rack.IsValid() && Rack.IsPowered ? "active" : "")">@(Rack.IsValid() && Rack.IsPowered ? "ONLINE" : "OFFLINE")</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">ACCESS</span>
                <span class="rail-value active">@(Rack.IsValid() && Rack.AccessPinIsSet ? "SECURED" : "DORMANT")</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">TERMINALS</span>
                <span class="rail-value">@_linkedCount</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">PUZZLE TTL</span>
                <span class="rail-value">@(Rack.IsValid() ? $"{Rack.PuzzleTimeLimitSeconds:0}s" : "—")</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">REWARD</span>
                <span class="rail-value">@(Rack.IsValid() ? $"{Rack.RewardMultiplier:0.00}×" : "—")</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">COOLDOWN</span>
                <span class="rail-value">@(Rack.IsValid() ? $"{Rack.HackCooldownSeconds:0}s" : "—")</span>
            </div>
            <div class="rail-actions">
                <button class="rail-btn power-on @(Rack.IsValid() && Rack.IsPowered ? "active" : "")" onclick=@OnPowerOn>POWER ON</button>
                <button class="rail-btn power-off" onclick=@OnPowerOff>POWER OFF</button>
            </div>
            <div class="rail-nav">
                <div class="rail-nav-header">MODULES</div>
                <button class="nav-btn @(_module == RackModule.Control ? "active" : "")" onclick=@(() => _module = RackModule.Control)>CONTROL</button>
                <button class="nav-btn @(_module == RackModule.Upgrades ? "active" : "")" onclick=@(() => _module = RackModule.Upgrades)>UPGRADES</button>
                <button class="nav-btn @(_module == RackModule.Log ? "active" : "")" onclick=@(() => _module = RackModule.Log)>LOG</button>
            </div>
        </div>

        <div class="main-pane">
            @if ( _module == RackModule.Control )
            {
                <div class="module-header">CONTROL — TERMINAL LINK</div>
                <div class="control-body">
                    <p class="control-line">Link cornerman / vengeance terminals to this rack. Linked CRTs receive rack power and upgrades.</p>
                    <div class="control-section">LINKED</div>
                    @{
                        var linkedTerminals = Rack.IsValid()
                            ? HackerServerRackRegistry.GetLinkedTerminals( Rack )
                            : Array.Empty<HackerTerminalEntity>();
                    }
                    @if ( linkedTerminals.Count == 0 )
                    {
                        <p class="control-line dim">No terminals linked.</p>
                    }
                    else
                    {
                        @for ( var i = 0; i < linkedTerminals.Count; i++ )
                        {
                            var linkIndex = i;
                            var terminal = linkedTerminals[i];
                            <div class="link-row">
                                <span class="link-label">@HackerServerRackRegistry.GetTerminalLabel( terminal )</span>
                                <button class="link-btn unlink" onclick=@(() => OnUnlinkTerminal( linkIndex ))>UNLINK</button>
                            </div>
                        }
                        <button class="link-btn unlink-all" onclick=@OnUnlinkAllTerminals>UNLINK ALL</button>
                    }
                    <div class="control-section">AVAILABLE</div>
                    @{
                        var terminalCandidates = Rack.IsValid()
                            ? HackerServerRackRegistry.ScanUnlinkedTerminals( Rack )
                            : Array.Empty<HackerTerminalEntity>();
                    }
                    @if ( terminalCandidates.Count == 0 )
                    {
                        <p class="control-line dim">No unlinked terminals in scene.</p>
                    }
                    else
                    {
                        @for ( var i = 0; i < terminalCandidates.Count; i++ )
                        {
                            var scanIndex = i;
                            var terminal = terminalCandidates[i];
                            <div class="link-row">
                                <span class="link-label">@HackerServerRackRegistry.GetTerminalLabel( terminal )</span>
                                <button class="link-btn" onclick=@(() => OnLinkTerminal( scanIndex ))>LINK</button>
                            </div>
                        }
                    }
                    <p class="control-line warn">Power OFF blocks all terminal sessions until restored.</p>
                </div>
            }
            else if ( _module == RackModule.Upgrades )
            {
                <div class="module-header">UPGRADES — HACKING SYSTEMS</div>
                <div class="upgrade-list">
                    <div class="upgrade-row">
                        <div class="upgrade-info">
                            <span class="upgrade-name">Detection (L@GetTier(HackerUpgradeKind.Detection)/@GetMax(HackerUpgradeKind.Detection))</span>
                            <span class="upgrade-detail">Lowers 911/Wanted chance on failed hacks</span>
                            <span class="upgrade-detail dim">@GetNextLabel(HackerUpgradeKind.Detection)</span>
                        </div>
                        <button class="upgrade-btn @GetUpgradeBtnClass(HackerUpgradeKind.Detection)" onclick=@(() => TryUpgrade(HackerUpgradeKind.Detection, "Detection"))>@GetUpgradeBtnText(HackerUpgradeKind.Detection)</button>
                    </div>
                    <div class="upgrade-row">
                        <div class="upgrade-info">
                            <span class="upgrade-name">Puzzle Time (L@GetTier(HackerUpgradeKind.PuzzleTime)/@GetMax(HackerUpgradeKind.PuzzleTime))</span>
                            <span class="upgrade-detail">More seconds to complete crack puzzles</span>
                            <span class="upgrade-detail dim">@GetNextLabel(HackerUpgradeKind.PuzzleTime)</span>
                        </div>
                        <button class="upgrade-btn @GetUpgradeBtnClass(HackerUpgradeKind.PuzzleTime)" onclick=@(() => TryUpgrade(HackerUpgradeKind.PuzzleTime, "Puzzle Time"))>@GetUpgradeBtnText(HackerUpgradeKind.PuzzleTime)</button>
                    </div>
                    <div class="upgrade-row">
                        <div class="upgrade-info">
                            <span class="upgrade-name">Reward Yield (L@GetTier(HackerUpgradeKind.Reward)/@GetMax(HackerUpgradeKind.Reward))</span>
                            <span class="upgrade-detail">Higher payout on successful hacks</span>
                            <span class="upgrade-detail dim">@GetNextLabel(HackerUpgradeKind.Reward)</span>
                        </div>
                        <button class="upgrade-btn @GetUpgradeBtnClass(HackerUpgradeKind.Reward)" onclick=@(() => TryUpgrade(HackerUpgradeKind.Reward, "Reward Yield"))>@GetUpgradeBtnText(HackerUpgradeKind.Reward)</button>
                    </div>
                    <div class="upgrade-row">
                        <div class="upgrade-info">
                            <span class="upgrade-name">Cooldown (L@GetTier(HackerUpgradeKind.Cooldown)/@GetMax(HackerUpgradeKind.Cooldown))</span>
                            <span class="upgrade-detail">Shorter wait between hack attempts</span>
                            <span class="upgrade-detail dim">@GetNextLabel(HackerUpgradeKind.Cooldown)</span>
                        </div>
                        <button class="upgrade-btn @GetUpgradeBtnClass(HackerUpgradeKind.Cooldown)" onclick=@(() => TryUpgrade(HackerUpgradeKind.Cooldown, "Cooldown"))>@GetUpgradeBtnText(HackerUpgradeKind.Cooldown)</button>
                    </div>
                </div>
                <div class="wallet-line">Wallet: $@HackerServerRackMenuHost.GetLocalWalletCash().ToString("N0")</div>
            }
            else
            {
                <div class="module-header">LOG</div>
                <div class="log-scroll">
                    @foreach ( var line in _lines )
                    {
                        <label class="log-line">@line</label>
                    }
                </div>
            }
        </div>
        }
    </div>

    <LifePunchUiFooter />
</root>

@code {
    private enum RackModule { Control, Upgrades, Log }
    private enum PinGateKind { None, Setup, Unlock, Blocked }

    private HackerServerRackEntity Rack { get; set; }
    private RackModule _module = RackModule.Control;
    private int _linkedCount;
    private readonly List<string> _lines = new();

    private PinGateKind _pinGate = PinGateKind.None;
    private bool _pinEntryOpen;
    private bool _pinConfirming;
    private string _pinDigits = "";
    private string _pinFirstEntry = "";
    private string _pinError = "";
    private bool _showSettings;
    private int _panelSize = 1;

    private bool IsRackPinSetup => _pinGate == PinGateKind.Setup;
    private bool IsRackPinUnlock => _pinGate == PinGateKind.Unlock;
    private bool IsRackPinBlocked => _pinGate == PinGateKind.Blocked;
    private bool IsPinGateActive => _pinGate != PinGateKind.None;
    private bool IsPinUiFlow => IsRackPinSetup || IsRackPinUnlock;

    private string GetRootClass()
    {
        var classes = new List<string>();
        if ( IsPinGateActive )
            classes.Add( "pin-gate" );
        if ( IsRackPinBlocked )
            classes.Add( "pin-blocked" );
        if ( _pinEntryOpen )
            classes.Add( "pin-entry-open" );
        if ( _panelSize == 0 )
            classes.Add( "compact" );
        else if ( _panelSize == 2 )
            classes.Add( "expanded" );
        return string.Join( " ", classes );
    }

    private string GetTitleLabel()
    {
        if ( IsRackPinSetup )
            return "GATEKEEPER — SET PIN";
        if ( IsRackPinBlocked )
            return "GATEKEEPER — LOCKED";
        if ( IsRackPinUnlock )
            return "GATEKEEPER — ENTER PIN";
        return "SERVER RACK CONTROL";
    }

    private string GetPinLockBadgeLabel()
    {
        if ( IsRackPinSetup )
            return "SECURE BOOT — SET PIN";
        if ( IsRackPinBlocked )
            return "LOCKED — SPAWN ACCESS ONLY";
        if ( IsRackPinUnlock )
            return "ENCRYPTED — PIN REQUIRED";
        return "LOCKED";
    }

    private string GetPinEntryTitle()
    {
        if ( IsRackPinSetup )
            return _pinConfirming ? "CONFIRM PIN" : "SET PIN";
        return "ENTER PIN";
    }

    private string GetPinEntrySubtitle()
    {
        if ( IsRackPinSetup )
        {
            if ( _pinConfirming )
                return "Enter the same 4-digit PIN again to confirm.";
            return $"Operator: {HackerServerRackMenuHost.GetLocalOperatorLabel()} — choose your rack lock.";
        }

        var owner = Rack.IsValid() && !string.IsNullOrWhiteSpace( Rack.OperatorDisplayName )
            ? Rack.OperatorDisplayName
            : "registered operator";

        return $"Encrypted rack — registered by {owner}.";
    }

    public static void Open( HackerServerRackEntity rack )
    {
        var menu = HackerServerRackMenuHost.Mount();
        if ( menu == null )
            return;

        menu.Rack = rack;
        menu._pinGate = PinGateKind.None;
        menu.ResetPinEntryUi();
        menu._showSettings = false;
        menu._module = RackModule.Control;
        menu.RefreshLinkedCount();
        menu._lines.Clear();
        menu._lines.Add( $">> server rack control — {HackerJob.ProductTitle}" );
        menu._lines.Add( $">> {HackerJob.UiVersionFooter}" );
        menu._lines.Add( $">> {LifePunchSourceMark.CopyrightLine}" );
        menu._lines.Add( $">> {LifePunchSourceMark.UseRestrictionShort}" );
        menu._lines.Add( $">> power: {( rack.IsValid() && rack.IsPowered ? "ONLINE" : "OFFLINE" )}" );
        menu._lines.Add( ">> use POWER ON before opening cornerman / vengeance terminals." );
    }

    public static void OpenPinSetup( HackerServerRackEntity rack )
    {
        var menu = HackerServerRackMenuHost.Mount();
        if ( menu == null )
            return;

        menu.Rack = rack;
        menu.BootPinSetup();
    }

    public static void OpenPinUnlock( HackerServerRackEntity rack )
    {
        var menu = HackerServerRackMenuHost.Mount();
        if ( menu == null )
            return;

        menu.Rack = rack;
        menu.BootPinUnlock();
    }

    public static void OpenPinBlocked( HackerServerRackEntity rack )
    {
        var menu = HackerServerRackMenuHost.Mount();
        if ( menu == null )
            return;

        menu.Rack = rack;
        menu.BootPinBlocked();
    }

    public static void NotifyPinDenied( string message )
    {
        var menu = Sandbox.Game.ActiveScene?.GetAllComponents<HackerServerRackMenu>().FirstOrDefault();
        if ( !menu.IsValid() )
            return;

        if ( menu.IsPinUiFlow && menu._pinEntryOpen )
        {
            menu._pinError = message;
            menu.ResetPinDigits();
        }
    }

    private void BootPinSetup()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _pinGate = PinGateKind.Setup;
    }

    private void BootPinUnlock()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _pinGate = PinGateKind.Unlock;
    }

    private void BootPinBlocked()
    {
        ResetPinEntryUi();
        _lines.Clear();
        _pinGate = PinGateKind.Blocked;
    }

    private void ResetPinEntryUi()
    {
        _pinEntryOpen = false;
        _pinConfirming = false;
        _pinDigits = "";
        _pinFirstEntry = "";
        _pinError = "";
    }

    private void ResetPinDigits() => _pinDigits = "";

    private void RefreshLinkedCount()
    {
        _linkedCount = Rack.IsValid()
            ? HackerServerRackRegistry.GetLinkedTerminals( Rack ).Count
            : 0;
    }

    public static void NotifyLinkMessage( string message )
    {
        var menu = Sandbox.Game.ActiveScene?.GetAllComponents<HackerServerRackMenu>().FirstOrDefault();
        if ( !menu.IsValid() )
            return;

        menu._lines.Add( message );
        menu.RefreshLinkedCount();
    }

    private void OnToggleSettings() => _showSettings = !_showSettings;

    private void SetPanelSize( int size )
    {
        _panelSize = Math.Clamp( size, 0, 2 );
        _showSettings = false;
    }

    private void OnPinCtaClick()
    {
        if ( IsRackPinBlocked )
            return;

        _pinEntryOpen = true;
        _pinError = "";
        ResetPinDigits();
    }

    private void OnPinDigit( int digit )
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length >= HackerServerRackAccessPin.PinLength )
            return;

        _pinDigits += digit.ToString();
        _pinError = "";

        if ( _pinDigits.Length >= HackerServerRackAccessPin.PinLength )
            CompletePinEntry();
    }

    private void OnPinBackspace()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen || _pinDigits.Length == 0 )
            return;

        _pinDigits = _pinDigits[..^1];
        _pinError = "";
    }

    private void OnPinClear()
    {
        if ( !IsPinUiFlow || !_pinEntryOpen )
            return;

        ResetPinDigits();
        _pinError = "";
    }

    private void OnPinEntryBack()
    {
        if ( !IsRackPinSetup || !_pinConfirming )
            return;

        _pinConfirming = false;
        _pinFirstEntry = "";
        ResetPinDigits();
        _pinError = "";
    }

    private void CompletePinEntry()
    {
        if ( !Rack.IsValid() )
        {
            _pinError = "Rack session lost.";
            ResetPinDigits();
            return;
        }

        if ( IsRackPinSetup )
        {
            if ( !_pinConfirming )
            {
                _pinFirstEntry = _pinDigits;
                _pinConfirming = true;
                ResetPinDigits();
                return;
            }

            if ( _pinDigits != _pinFirstEntry )
            {
                _pinError = "PINs did not match — try again.";
                _pinConfirming = false;
                _pinFirstEntry = "";
                ResetPinDigits();
                return;
            }

            Rack.RequestSetAccessPin( _pinDigits, _pinDigits );
            return;
        }

        if ( IsRackPinUnlock )
            Rack.RequestUnlockAccessPin( _pinDigits );
    }

    private void OnLinkTerminal( int scanIndex )
    {
        if ( !Rack.IsValid() )
            return;

        Rack.RequestLinkTerminal( scanIndex );
    }

    private void OnUnlinkTerminal( int linkIndex )
    {
        if ( !Rack.IsValid() )
            return;

        Rack.RequestUnlinkTerminal( linkIndex );
    }

    private void OnUnlinkAllTerminals()
    {
        if ( !Rack.IsValid() )
            return;

        Rack.RequestUnlinkAllTerminals();
    }

    private void OnClickClose()
    {
        if ( Rack.IsValid() )
            Rack.RequestEndAccessSession();

        HackerServerRackMenuHost.Close( this );
    }

    private void OnPowerOn()
    {
        if ( !Rack.IsValid() ) return;
        Rack.RequestSetPowered( true );
        _lines.Add( "POWER ON — terminals energized." );
        RefreshLinkedCount();
    }

    private void OnPowerOff()
    {
        if ( !Rack.IsValid() ) return;
        Rack.RequestSetPowered( false );
        _lines.Add( "POWER OFF — terminals offline." );
    }

    private int GetTier( HackerUpgradeKind kind ) =>
        Rack.IsValid() ? Rack.GetTier( kind ) : 0;

    private int GetMax( HackerUpgradeKind kind ) =>
        Rack.IsValid() ? Rack.GetMaxTierForRack( kind ) : 0;

    private string GetNextLabel( HackerUpgradeKind kind )
    {
        if ( !Rack.IsValid() )
            return "—";

        var tier = Rack.GetTier( kind );
        var max = GetMax( kind );
        return tier >= max
            ? "MAX"
            : HackerUpgradeCatalog.GetUpgradeLabel( kind, tier + 1 );
    }

    private string GetUpgradeBtnClass( HackerUpgradeKind kind )
    {
        if ( !Rack.IsValid() || Rack.GetTier( kind ) >= GetMax( kind ) )
            return "disabled";

        var cost = HackerUpgradeCatalog.GetUpgradeCost( kind, Rack.GetTier( kind ) + 1 );
        return HackerServerRackMenuHost.GetLocalWalletCash() >= cost ? "" : "disabled";
    }

    private string GetUpgradeBtnText( HackerUpgradeKind kind )
    {
        if ( !Rack.IsValid() )
            return "—";

        var tier = Rack.GetTier( kind );
        if ( tier >= GetMax( kind ) )
            return "MAX";

        var cost = HackerUpgradeCatalog.GetUpgradeCost( kind, tier + 1 );
        return $"INSTALL ${cost:N0}";
    }

    private void TryUpgrade( HackerUpgradeKind kind, string title )
    {
        if ( !Rack.IsValid() )
            return;

        if ( Rack.GetTier( kind ) >= Rack.GetMaxTierForRack( kind ) )
        {
            _lines.Add( $"ERROR: {title} already at max tier." );
            return;
        }

        var cost = HackerUpgradeCatalog.GetUpgradeCost( kind, Rack.GetTier( kind ) + 1 );
        if ( HackerServerRackMenuHost.GetLocalWalletCash() < cost )
        {
            _lines.Add( $"ERROR: {title} costs ${cost:N0} — insufficient wallet." );
            return;
        }

        Rack.RequestUpgrade( kind );
        _lines.Add( $"INSTALLED: {title} → L{Rack.GetTier( kind )}" );
    }
}
