@namespace LifePunch.DXRP.Addons.HackerJob
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@TierClass">
    <div class="scanlines"></div>

    <div class="title-bar">
        <span class="title-mark">@OpsMark</span>
        <span class="title-text">@OpsTitle</span>
        <span class="title-sub">@ProgramLabel</span>
        <span class="title-spacer"></span>
        <span class="tier-badge">@TierBadge</span>
        <button class="close-x" onclick=@OnClickClose>CLOSE</button>
    </div>

    <div class="terminal-body">
        <div class="ops-rail">
            <div class="rail-header">SESSION</div>
            <div class="rail-block">
                <span class="rail-label">PROGRAM</span>
                <span class="rail-value">@ProgramLabel</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">LINK</span>
                <span class="rail-value @(Terminal.IsValid() ? "active" : "")">@(Terminal.IsValid() ? "STABLE" : "LOST")</span>
            </div>
            <div class="rail-block">
                <span class="rail-label">WALLETS</span>
                <span class="rail-value">@_scanResults.Count</span>
            </div>
            @if ( Tier == HackerTerminalTier.Advanced )
            {
                <div class="rail-block">
                    <span class="rail-label">GOVDB</span>
                    <span class="rail-value">@_govdbResults.Count</span>
                </div>
            }
            <div class="rail-block">
                <span class="rail-label">ACTIVE OP</span>
                <span class="rail-value @(HasActiveOp ? "active" : "")">@ActiveOpLabel</span>
            </div>
            @if ( _puzzle != null && !_puzzle.IsExpired )
            {
                <div class="rail-block rail-progress">
                    <span class="rail-label">PUZZLE TTL</span>
                    <div class="ttl-bar">
                        <div class="ttl-fill" style="width: @(GetPuzzlePercent())%"></div>
                    </div>
                    <span class="rail-sub">@MathF.Ceiling(_puzzle.SecondsRemaining)s</span>
                </div>
            }

            <div class="rail-nav">
                <div class="rail-nav-header">MODULES</div>
                <button class="nav-btn @(_activeModule == OpsModule.Log ? "active" : "")" onclick=@(() => SwitchModule(OpsModule.Log))>LOG</button>
                <button class="nav-btn @(_activeModule == OpsModule.Scan ? "active" : "")" onclick=@(() => SwitchModule(OpsModule.Scan))>SCAN</button>
                @if ( Tier == HackerTerminalTier.Advanced )
                {
                    <button class="nav-btn @(_activeModule == OpsModule.Govdb ? "active" : "")" onclick=@(() => SwitchModule(OpsModule.Govdb))>GOVDB</button>
                }
                <button class="nav-btn @(_activeModule == OpsModule.Target ? "active" : "")" onclick=@(() => SwitchModule(OpsModule.Target))>TARGET</button>
                <button class="nav-btn @(_activeModule == OpsModule.Help ? "active" : "")" onclick=@(() => SwitchModule(OpsModule.Help))>HELP</button>
            </div>

            <div class="rail-actions">
                <button class="rail-btn" onclick=@RunScanFromUi>RUN SCAN</button>
                @if ( Tier == HackerTerminalTier.Advanced )
                {
                    <button class="rail-btn" onclick=@RunGovdbFromUi>RUN GOVDB</button>
                }
            </div>
            <div class="rail-hint">Command line ↓</div>
        </div>

        <div class="main-pane">
            <div class="module-header">@ModuleTitle</div>

            <div class="module-body" onclick=@FocusInput>
                @if ( _activeModule == OpsModule.Log )
                {
                    <div class="log-scroll">
                        @foreach ( var line in _lines )
                        {
                            <div class="line-row">
                                <label class="screen-line @GetLineClass(line)">@line</label>
                            </div>
                        }
                    </div>
                }
                else if ( _activeModule == OpsModule.Scan )
                {
                    <div class="module-scan">
                        <div class="module-toolbar">
                            <span class="toolbar-label">WALLET ENDPOINTS</span>
                            <span class="toolbar-meta">@_scanResults.Count cached</span>
                        </div>
                        @if ( _scanResults.Count == 0 )
                        {
                            <div class="empty-state">No targets — RUN SCAN or type <span class="cmd">scan</span></div>
                        }
                        else
                        {
                            @foreach ( var target in _scanResults )
                            {
                                <div class="data-row @(_selectedTargetId == target.SteamId ? "selected" : "")"
                                     onclick=@(() => SelectWalletTarget(target))>
                                    <span class="data-id">@target.SteamId</span>
                                    <span class="data-name">@target.DisplayName</span>
                                    <span class="data-meta">$@target.WalletCash</span>
                                </div>
                            }
                        }
                        @if ( !string.IsNullOrEmpty( _selectedTargetId ) )
                        {
                            <button class="module-action" onclick=@StartHackFromUi>START HACK</button>
                        }
                    </div>
                }
                else if ( _activeModule == OpsModule.Govdb && Tier == HackerTerminalTier.Advanced )
                {
                    <div class="module-govdb">
                        <div class="module-toolbar">
                            <span class="toolbar-label">TREASURY NODES</span>
                            <span class="toolbar-meta">@_govdbResults.Count cached</span>
                        </div>
                        @if ( _govdbResults.Count == 0 )
                        {
                            <div class="empty-state">No nodes — RUN GOVDB or type <span class="cmd">govdb</span></div>
                        }
                        else
                        {
                            @foreach ( var node in _govdbResults )
                            {
                                <div class="data-row @(_selectedGovNodeId == node.NodeId ? "selected" : "")"
                                     onclick=@(() => SelectGovNode(node))>
                                    <span class="data-id">@node.NodeId</span>
                                    <span class="data-name">@node.Label</span>
                                    <span class="data-meta">[@node.SecurityTier]</span>
                                </div>
                            }
                        }
                        @if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
                        {
                            <button class="module-action" onclick=@StartInfilFromUi>START INFIL</button>
                        }
                    </div>
                }
                else if ( _activeModule == OpsModule.Target )
                {
                    <div class="module-target">
                        @if ( _puzzle == null )
                        {
                            <div class="empty-state">No active operation — select a target in SCAN or GOVDB</div>
                        }
                        else if ( _puzzle.IsExpired )
                        {
                            <div class="empty-state warn">Puzzle window expired — trace risk increased.</div>
                        }
                        else
                        {
                            <div class="target-banner">@GetTargetBanner()</div>
                            <div class="puzzle-prompt">@_puzzle.Prompt</div>
                            <div class="puzzle-hint">Type answer at command prompt — @MathF.Ceiling(_puzzle.SecondsRemaining)s remaining</div>
                        }
                    </div>
                }
                else if ( _activeModule == OpsModule.Help )
                {
                    <div class="module-help">
                        <div class="help-block">
                            <span class="help-cmd">scan</span>
                            <span class="help-desc">Probe live wallet signatures</span>
                        </div>
                        <div class="help-block">
                            <span class="help-cmd">hack &lt;steamid&gt;</span>
                            <span class="help-desc">Start wallet bypass puzzle</span>
                        </div>
                        @if ( Tier == HackerTerminalTier.Advanced )
                        {
                            <div class="help-block">
                                <span class="help-cmd">govdb</span>
                                <span class="help-desc">Scan government database nodes</span>
                            </div>
                            <div class="help-block">
                                <span class="help-cmd">infil &lt;nodeid&gt;</span>
                                <span class="help-desc">Breach a treasury node</span>
                            </div>
                        }
                        <div class="help-block">
                            <span class="help-cmd">status / info / clear / about</span>
                            <span class="help-desc">Session utilities</span>
                        </div>
                        <div class="help-note">Counterplay: lifepunchnet police terminals (cyan) — separate addon.</div>
                    </div>
                }
            </div>

            <div class="input-row" onclick=@FocusInput>
                <span class="prompt-label">@PromptLabel</span>
                <TextEntry
                    class="terminal-input"
                    @ref="InputBox"
                    onsubmit=@OnSubmit />
            </div>
        </div>
    </div>
</root>

@code {
    private enum OpsModule { Log, Scan, Govdb, Target, Help }

    public HackerTerminalEntity Terminal { get; set; }

    private TextEntry InputBox { get; set; }
    private readonly List<string> _lines = new();
    private const int MaxLines = 64;
    private int _lastTextLength = 0;
    private TimeSince _sinceSecondly = 0f;
    private OpsModule _activeModule = OpsModule.Log;

    private IReadOnlyList<HackerScanService.ScanTarget> _scanResults = Array.Empty<HackerScanService.ScanTarget>();
    private IReadOnlyList<HackerScanService.GovDbTarget> _govdbResults = Array.Empty<HackerScanService.GovDbTarget>();
    private string _selectedTargetId;
    private string _selectedGovNodeId;
    private HackerPuzzleSession _puzzle;

    private HackerTerminalTier Tier =>
        Terminal.IsValid() && Terminal.IsAdvanced
            ? HackerTerminalTier.Advanced
            : HackerTerminalTier.Standard;

    private string TierClass => HackerTerminalBrand.CssTierClass( Tier );
    private string OpsTitle => HackerTerminalBrand.OpsConsoleTitle( Tier );
    private string OpsMark => HackerTerminalBrand.OpsConsoleMark( Tier );
    private string ProgramLabel => HackerTerminalBrand.ProgramName( Tier );
    private string PromptLabel => HackerTerminalBrand.PromptLabel( Tier );
    private string TierBadge => Tier == HackerTerminalTier.Advanced ? "VENGEANCE OPS" : "CORNERMAN OPS";
    private bool HasActiveOp => _puzzle != null && !_puzzle.IsExpired;
    private string ActiveOpLabel => HasActiveOp ? (_selectedGovNodeId ?? _selectedTargetId ?? "active") : "none";

    private string ModuleTitle => _activeModule switch
    {
        OpsModule.Scan => "SCAN — WALLET PROBE",
        OpsModule.Govdb => "GOVDB — TREASURY MESH",
        OpsModule.Target => "TARGET — BYPASS",
        OpsModule.Help => "HELP — COMMAND REF",
        _ => "LOG — COMMAND OUTPUT"
    };

    private static string GetLineClass( string line )
    {
        if ( line.StartsWith( "cornerman@" ) || line.StartsWith( "vengeance@" ) )
            return "prompt-line";
        if ( line.StartsWith( "---" ) )
            return "divider-line";
        if ( line.StartsWith( "  " ) )
            return "help-line";
        if ( line.StartsWith( "ERROR" ) || line.StartsWith( "DENIED" ) )
            return "error-line";
        if ( line.StartsWith( "[ OK" ) || line.StartsWith( "BYPASS" ) )
            return "ok-line";
        if ( line.StartsWith( "WARNING" ) || line.StartsWith( "▶" ) )
            return "warn-line";
        return "output-line";
    }

    private void TrimLines()
    {
        if ( _lines.Count > MaxLines )
            _lines.RemoveRange( 0, _lines.Count - MaxLines );
    }

    private float GetPuzzlePercent()
    {
        if ( _puzzle == null || _puzzle.TimeLimitSeconds <= 0f )
            return 0f;

        return Math.Clamp( _puzzle.SecondsRemaining / _puzzle.TimeLimitSeconds * 100f, 0f, 100f );
    }

    private string GetTargetBanner()
    {
        if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
            return $"INFILTRATING GOVDB NODE {_selectedGovNodeId}";

        if ( !string.IsNullOrEmpty( _selectedTargetId ) )
            return $"INFILTRATING WALLET {_selectedTargetId}";

        return "ACTIVE BYPASS";
    }

    public static void Open( HackerTerminalEntity terminal )
    {
        var panel = HackerTerminalHost.Mount();
        if ( panel == null )
            return;

        panel.Terminal = terminal;
        panel.FocusInput();
        panel.Boot();
    }

    private void CloseTerminal() => HackerTerminalHost.Close( this );

    private void SwitchModule( OpsModule module )
    {
        if ( module == OpsModule.Govdb && Tier != HackerTerminalTier.Advanced )
            return;

        _activeModule = module;
    }

    private void Boot()
    {
        _lines.Clear();
        _scanResults = Array.Empty<HackerScanService.ScanTarget>();
        _govdbResults = Array.Empty<HackerScanService.GovDbTarget>();
        _selectedTargetId = null;
        _selectedGovNodeId = null;
        _puzzle = null;
        _activeModule = OpsModule.Log;

        if ( Tier == HackerTerminalTier.Advanced )
        {
            _lines.Add( "LIFEPUNCH vengeance.exe v0.2 — ops console" );
            _lines.Add( "[ OK ] crt framebuffer 960x640" );
            _lines.Add( "[ OK ] enhanced intrusion toolkit" );
            _lines.Add( "[ OK ] govdb route table mounted" );
            _lines.Add( $"starting {HackerJob.AdvancedProgramName} ..." );
            _lines.Add( "WARNING: unauthorized govdb access is a felony." );
            _lines.Add( "Modules: LOG | SCAN | GOVDB | TARGET | HELP" );
        }
        else
        {
            _lines.Add( "LIFEPUNCH cornerman.exe v0.2 — ops console" );
            _lines.Add( "[ OK ] crt framebuffer 960x640" );
            _lines.Add( "[ OK ] packet sniffer loaded" );
            _lines.Add( "[ OK ] wallet probe module (read-only)" );
            _lines.Add( $"starting {HackerJob.InGameProgramName} ..." );
            _lines.Add( "Modules: LOG | SCAN | TARGET | HELP" );
        }

        _lines.Add( "Fiction only — not the real Ops box. Type help or open HELP module." );
        _lines.Add( "" );
    }

    private void SecondlyUpdate()
    {
        if ( !Terminal.IsValid() )
        {
            CloseTerminal();
            return;
        }

        var viewerPos = HackerTerminalHost.LocalViewerPosition( Scene );
        if ( viewerPos.HasValue && viewerPos.Value.Distance( Terminal.WorldPosition ) > 150f )
        {
            CloseTerminal();
            return;
        }

        if ( _puzzle != null && _puzzle.IsExpired )
        {
            _lines.Add( "ERROR: puzzle window expired — trace risk increased." );
            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
        }
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();

        if ( _sinceSecondly >= 1f )
        {
            _sinceSecondly = 0f;
            SecondlyUpdate();
        }

        if ( InputBox.IsValid() && !InputBox.HasFocus )
            InputBox.Focus();

        if ( Input.Pressed( "Attack2" ) )
            Input.Clear( "Attack2" );

        if ( Input.Pressed( "Pocket" ) )
            Input.Clear( "Pocket" );
        if ( Input.Down( "Pocket" ) )
            Input.Clear( "Pocket" );

        if ( InputBox.IsValid() )
        {
            var currentLength = InputBox.Text?.Length ?? 0;
            if ( currentLength != _lastTextLength )
            {
                if ( !string.IsNullOrEmpty( HackerJob.KeyboardSoundPath ) )
                    Sound.Play( HackerJob.KeyboardSoundPath );
                _lastTextLength = currentLength;
            }
        }
    }

    public void FocusInput()
    {
        if ( InputBox.IsValid() )
            InputBox.Focus();
    }

    private void OnClickClose() => CloseTerminal();

    private void RunScanFromUi() => HandleCommand( "scan" );
    private void RunGovdbFromUi() => HandleCommand( "govdb" );

    private void SelectWalletTarget( HackerScanService.ScanTarget target )
    {
        _selectedTargetId = target.SteamId;
        _selectedGovNodeId = null;
    }

    private void SelectGovNode( HackerScanService.GovDbTarget node )
    {
        _selectedGovNodeId = node.NodeId;
        _selectedTargetId = null;
    }

    private void StartHackFromUi()
    {
        if ( string.IsNullOrEmpty( _selectedTargetId ) )
            return;

        HandleCommand( $"hack {_selectedTargetId}" );
    }

    private void StartInfilFromUi()
    {
        if ( string.IsNullOrEmpty( _selectedGovNodeId ) )
            return;

        HandleCommand( $"infil {_selectedGovNodeId}" );
    }

    private void OnSubmit()
    {
        if ( !InputBox.IsValid() )
            return;

        if ( !string.IsNullOrEmpty( HackerJob.KeyboardSoundPath ) )
            Sound.Play( HackerJob.KeyboardSoundPath );

        var input = ( InputBox.Text ?? "" ).Trim();
        InputBox.Text = "";
        InputBox.Focus();

        if ( string.IsNullOrWhiteSpace( input ) )
            return;

        _lines.Add( $"{HackerTerminalBrand.PromptLabel( Tier )} {input}" );

        if ( _puzzle != null )
            HandlePuzzleInput( input );
        else
            HandleCommand( input.ToLower() );

        _lines.Add( "" );
        TrimLines();
    }

    private void HandlePuzzleInput( string input )
    {
        if ( _puzzle.TrySubmit( input ) )
        {
            if ( !string.IsNullOrEmpty( _selectedGovNodeId ) )
            {
                _lines.Add( "BYPASS OK — govdb shard accessed (Phase 1 stub; no records exfiltrated)." );
                _lines.Add( $"Node {_selectedGovNodeId} flagged. Server validation = Phase 2 (Opus)." );
            }
            else
            {
                _lines.Add( "BYPASS OK — wallet probe succeeded (Phase 1 stub; no funds moved)." );
                _lines.Add( $"Target {_selectedTargetId} flagged. Economy transfer = Phase 2 (Opus)." );
            }

            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
            return;
        }

        if ( _puzzle.IsExpired )
        {
            _lines.Add( "ERROR: too slow — connection dropped." );
            _puzzle = null;
            _selectedTargetId = null;
            _selectedGovNodeId = null;
            _activeModule = OpsModule.Log;
            return;
        }

        _lines.Add( $"DENIED — {MathF.Ceiling( _puzzle.SecondsRemaining )}s remaining." );
        _activeModule = OpsModule.Target;
    }

    private void HandleCommand( string input )
    {
        var parts = input.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
        var cmd = parts.Length > 0 ? parts[0] : "";
        var arg = parts.Length > 1 ? string.Join( ' ', parts.Skip( 1 ) ) : "";

        switch ( cmd )
        {
            case "help":
                _activeModule = OpsModule.Help;
                _lines.Add( "--------------------HELP--------------------" );
                _lines.Add( "  SCAN     - Probe live wallet signatures." );
                if ( Tier == HackerTerminalTier.Advanced )
                {
                    _lines.Add( "  GOVDB    - Scan government database nodes." );
                    _lines.Add( "  INFIL    - Breach a govdb node (advanced)." );
                }
                _lines.Add( "  HACK     - Start wallet bypass on a SteamID." );
                _lines.Add( "  INFO     - Terminal tier + session info." );
                _lines.Add( "  STATUS   - Session + target state." );
                _lines.Add( "  CLEAR    - Wipe scrollback." );
                _lines.Add( "  ABOUT    - LIFEPUNCH attribution." );
                _lines.Add( "--------------------------------------------" );
                break;

            case "clear":
                _lines.Clear();
                break;

            case "about":
                _lines.Add( "LIFEPUNCH™ Hacker Job — ops console is in-world fiction." );
                _lines.Add( "Wallet hacks: server-validated Phase 2. Bank accounts untouchable." );
                if ( Tier == HackerTerminalTier.Advanced )
                    _lines.Add( "Govdb breaches countered by Police terminals (lifepunchnet cyan)." );
                break;

            case "info":
                _lines.Add( "--------------------INFO--------------------" );
                _lines.Add( $"  Tier:        {( Tier == HackerTerminalTier.Advanced ? "Advanced (vengeance.exe)" : "Standard (cornerman.exe)" )}" );
                _lines.Add( $"  Job:         Hacker" );
                _lines.Add( $"  Program:     {HackerTerminalBrand.ProgramName( Tier )}" );
                _lines.Add( $"  Link:        {( Terminal.IsValid() ? "STABLE" : "LOST" )}" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "status":
                _lines.Add( "--------------------STATUS------------------" );
                _lines.Add( $"  Terminal:    {( Terminal.IsValid() ? "LINKED" : "LOST" )}" );
                _lines.Add( $"  Wallet scan: {_scanResults.Count} target(s)" );
                if ( Tier == HackerTerminalTier.Advanced )
                    _lines.Add( $"  Govdb scan:  {_govdbResults.Count} node(s)" );
                _lines.Add( $"  Active op:   {( _puzzle != null ? (_selectedGovNodeId ?? _selectedTargetId) : "none" )}" );
                if ( _puzzle != null )
                    _lines.Add( $"  Puzzle TTL:  {MathF.Ceiling( _puzzle.SecondsRemaining )}s" );
                _lines.Add( "--------------------------------------------" );
                break;

            case "govdb":
                if ( Tier != HackerTerminalTier.Advanced )
                {
                    _lines.Add( "ERROR: govdb module requires Advanced Hacking Terminal." );
                    break;
                }

                if ( !Terminal.IsValid() )
                {
                    _lines.Add( "ERROR: terminal link lost." );
                    break;
                }

                _lines.Add( "Scanning govdb mesh for treasury miners ..." );
                _govdbResults = HackerScanService.RequestGovDbScan( Terminal );
                _lines.Add( $"Found {_govdbResults.Count} node(s):" );
                foreach ( var node in _govdbResults )
                    _lines.Add( $"  {node.NodeId}  {node.Label}  [{node.SecurityTier}]" );
                _lines.Add( "Use: infil <nodeid> or GOVDB module + START INFIL" );
                _activeModule = OpsModule.Govdb;
                break;

            case "infil":
                if ( Tier != HackerTerminalTier.Advanced )
                {
                    _lines.Add( "ERROR: infil requires Advanced Hacking Terminal." );
                    break;
                }

                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    _lines.Add( "ERROR: infil requires a node id. Run govdb first." );
                    break;
                }

                if ( _govdbResults.Count == 0 )
                {
                    _lines.Add( "ERROR: run govdb before infil." );
                    break;
                }

                var nodeMatch = _govdbResults.FirstOrDefault( n =>
                    n.NodeId.Equals( arg, StringComparison.OrdinalIgnoreCase ) );

                if ( nodeMatch is null )
                {
                    _lines.Add( "ERROR: node not in govdb cache." );
                    break;
                }

                _selectedGovNodeId = nodeMatch.NodeId;
                _selectedTargetId = null;
                _puzzle = HackerPuzzleSession.CreateRandom( advancedTerminal: true );
                _lines.Add( $"INFILTRATING {nodeMatch.Label} [{nodeMatch.SecurityTier}]" );
                _lines.Add( _puzzle.Prompt );
                _lines.Add( $"TIME LIMIT: {MathF.Ceiling( _puzzle.TimeLimitSeconds )}s — type answer at prompt." );
                _activeModule = OpsModule.Target;
                break;

            case "scan":
                if ( !Terminal.IsValid() )
                {
                    _lines.Add( "ERROR: terminal link lost." );
                    break;
                }

                _lines.Add( "Scanning subnet for wallet endpoints ..." );
                _scanResults = HackerScanService.RequestScan( Terminal );
                _lines.Add( $"Found {_scanResults.Count} exploitable wallet(s):" );
                foreach ( var target in _scanResults )
                    _lines.Add( $"  {target.SteamId}  {target.DisplayName}  ${target.WalletCash}" );
                _lines.Add( "Use: hack <steamid> or SCAN module + START HACK" );
                _activeModule = OpsModule.Scan;
                break;

            case "hack":
                if ( string.IsNullOrWhiteSpace( arg ) )
                {
                    _lines.Add( "ERROR: hack requires a SteamID. Run scan first." );
                    break;
                }

                if ( _scanResults.Count == 0 )
                {
                    _lines.Add( "ERROR: run scan before hack." );
                    break;
                }

                var match = _scanResults.FirstOrDefault( t =>
                    t.SteamId.Equals( arg, StringComparison.OrdinalIgnoreCase ) );

                if ( match is null )
                {
                    _lines.Add( "ERROR: target not in scan cache." );
                    break;
                }

                _selectedTargetId = match.SteamId;
                _selectedGovNodeId = null;
                _puzzle = HackerPuzzleSession.CreateRandom( advancedTerminal: false );
                _lines.Add( $"INFILTRATING {match.DisplayName} — wallet ${match.WalletCash}" );
                _lines.Add( _puzzle.Prompt );
                _lines.Add( $"TIME LIMIT: {MathF.Ceiling( _puzzle.TimeLimitSeconds )}s — type answer at prompt." );
                _activeModule = OpsModule.Target;
                break;

            default:
                _lines.Add( $"ERROR: unknown command '{cmd}'. Type help." );
                break;
        }
    }
}
