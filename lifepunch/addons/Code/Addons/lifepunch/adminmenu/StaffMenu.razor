	/// <summary>
	/// Return the player whose SteamID64 was typed in, to where they were brought from. Routes through
	/// the SAME re-validated host dispatch as the Ability-tab "Return" (the <c>return</c> action /
	/// <c>/return</c>, gated by ability.teleport), so the Waypoints tab carries no extra authority and
	/// the host re-checks permission + CanTarget regardless of what's typed here.
	/// </summary>
	private void ReturnTypedPlayer()
	{
		if ( !long.TryParse( _returnSteamId?.Trim(), out var steamId ) || steamId == 0 )
		{
			return;
		}

		var action = StaffMenuActions.All.FirstOrDefault( a => a.Key == "return" );
		if ( action is null )
		{
			return;
		}

		StaffMenuHost.Dispatch( action, steamId, new Dictionary<string, string>() );
		_returnSteamId = "";
		StateHasChanged();
	}

	/// <summary>
	/// Profile-pane quick teleport (Goto/Bring/Return) on the previewed player, routed through the
	/// same re-validated <see cref="Dispatch"/> as the Ability tab (ability.teleport) — no extra
	/// authority. The buttons are disabled in-UI for non-targetable/self; Dispatch re-checks anyway.
	/// </summary>
	private void QuickTeleport( string key, StaffMenuPlayer target )
	{
		if ( target.SteamId == 0 || !target.CanTarget )
		{
			return;
		}

		var action = StaffMenuActions.All.FirstOrDefault( a => a.Key == key );
		if ( action is null )
		{
			return;
		}

		Dispatch( action, target );
		StateHasChanged();
	}

