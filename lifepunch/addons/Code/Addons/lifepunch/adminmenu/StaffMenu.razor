@namespace LifePunch.DXRP.Addons.StaffMenu
@inherits PanelComponent
@attribute [StyleSheet]

@using System
@using System.Collections.Generic
@using System.Linq

<root class="staffmenu">
	<div class="window">
		<div class="header">
			<div class="title">
				<i class="material-icons">shield</i>
				<span>Staff Menu</span>
			</div>
			<div class="header-actions">
				<button class="icon-btn cog" tooltip="Settings" onclick="@OpenSettings">
					<i class="material-icons">settings</i>
				</button>
				<button class="icon-btn close" tooltip="Close Menu" onclick="@CloseMenu">
					<i class="material-icons">close</i>
				</button>
			</div>
		</div>

		<div class="tabs">
			@foreach ( var category in StaffMenuActions.Categories )
			{
				<button class="@TabClass( category )"
				        onclick="@(() => SelectTab( category ))">
					@category
				</button>
			}
			@if ( StaffMenuHost.CanUseWaypoints() )
			{
				<button class="@TabClass( TabWaypoints )"
				        onclick="@(() => SelectTab( TabWaypoints ))">
					Waypoints
				</button>
			}
			@if ( StaffMenuHost.CanViewAudit() )
			{
				<button class="@TabClass( TabAudit )"
				        onclick="@(() => SelectTab( TabAudit ))">
					Audit
				</button>
			}
			<button class="network-block @( StaffMenuHost.HasWebsite ? "network-block-link" : "" ) @( _websiteCopied ? "network-block-copied" : "" )"
			        tooltip="@( StaffMenuHost.HasWebsite ? $"Copy link: {StaffMenuHost.WebsiteUrl}" : "" )"
			        onclick="@CopyWebsite">
				<span class="network-block-label">Network</span>
				<span class="network-block-value">@( _websiteCopied ? "Link copied!" : NetworkIdentifier )</span>
			</button>
		</div>

		@if ( _activeTab == TabAudit )
		{
			<div class="audit">
				<div class="audit-head">
					<i class="material-icons">history</i>
					<span>Audit Log</span>
				</div>

				<div class="audit-filters">
					<div class="audit-filter">
						<i class="material-icons">person_search</i>
						<TextEntry class="audit-input" Placeholder="Player ID or name" Value:bind="@_auditPlayerId"/>
						@if ( !string.IsNullOrEmpty( _auditPlayerId ) )
						{
							<button class="icon-btn" tooltip="Clear" onclick="@ClearAuditPlayer"><i class="material-icons">close</i></button>
						}
					</div>
					<div class="audit-filter">
						<i class="material-icons">category</i>
						<TextEntry class="audit-input" Placeholder="Entity ID" Value:bind="@_auditEntity"/>
						@if ( !string.IsNullOrEmpty( _auditEntity ) )
						{
							<button class="icon-btn" tooltip="Clear" onclick="@ClearAuditEntity"><i class="material-icons">close</i></button>
						}
					</div>
				</div>

				@{
					var entries = StaffMenuHost.GetAuditEntries( _auditPlayerId, _auditEntity );
				}

				<div class="audit-table">
					<div class="audit-row audit-row-head">
						<span class="c-when">When</span>
						<span class="c-action">Action</span>
						<span class="c-player">Player</span>
						<span class="c-entity">Entity</span>
						<span class="c-desc">Description</span>
					</div>

					<div class="audit-scroll">
						@foreach ( var entry in entries )
						{
							<div class="audit-row">
								<span class="c-when">@entry.When</span>
								<span class="c-action"><span class="action-pill">@entry.Action</span></span>
								<span class="c-player @( entry.PlayerSteamId == 0 ? "system" : "" )">@entry.Player</span>
								<span class="c-entity">@entry.Entity</span>
								<span class="c-desc">@entry.Description</span>
							</div>
						}

						@if ( entries.Count == 0 )
						{
							<div class="audit-empty">No audit entries match these filters.</div>
						}
					</div>
				</div>
			</div>
		}
		else if ( _activeTab == TabWaypoints )
		{
			<div class="waypoints">
				<div class="wp-head">
					<i class="material-icons">place</i>
					<span>Waypoints</span>
				</div>

				<div class="wp-bar">
					<i class="material-icons">place</i>
					<TextEntry class="wp-input" Placeholder="Waypoint name" Value:bind="@_waypointName"/>
					<button class="wp-btn go @( string.IsNullOrWhiteSpace( _waypointName ) ? "disabled" : "" )"
					        tooltip="Teleport to this waypoint"
					        onclick="@GoToTypedWaypoint">
						<i class="material-icons">my_location</i> Go
					</button>
					@if ( StaffMenuHost.CanEditWaypoints() )
					{
						<button class="wp-btn set @( string.IsNullOrWhiteSpace( _waypointName ) ? "disabled" : "" )"
						        tooltip="Save a waypoint at your current position + view angle"
						        onclick="@SetWaypointFromInput">
							<i class="material-icons">push_pin</i> Set here
						</button>
					}
				</div>

				@{
					var waypoints = StaffMenuHost.GetWaypoints();
				}

				<div class="wp-list">
					@foreach ( var name in waypoints )
					{
						<div class="wp-row">
							<i class="material-icons">place</i>
							<span class="wp-name">@name</span>
							<button class="wp-go-row" tooltip="Teleport here" onclick="@(() => GoToWaypoint( name ))">
								<i class="material-icons">my_location</i> Go
							</button>
							@if ( StaffMenuHost.CanEditWaypoints() )
							{
								<button class="wp-clear" tooltip="Delete waypoint" onclick="@(() => ClearWaypoint( name ))">
									<i class="material-icons">delete</i>
								</button>
							}
						</div>
					}

					@if ( waypoints.Count == 0 )
					{
						<div class="wp-empty">
							Saved waypoints aren't listed in-menu yet — type a name above to Go or Set.
						</div>
					}
				</div>

				@if ( StaffMenuHost.CanView( "ability.teleport" ) )
				{
					<div class="wp-return-section">
						<div class="wp-head">
							<i class="material-icons">undo</i>
							<span>Return a player</span>
						</div>

						<div class="wp-sit-hint">
							Return a player back to where they were brought from.
						</div>

						<div class="wp-bar wp-return-bar">
							<i class="material-icons">person</i>
							<TextEntry class="wp-input" Placeholder="SteamID64" Value:bind="@_returnSteamId"/>
							<button class="wp-btn go @( string.IsNullOrWhiteSpace( _returnSteamId ) ? "disabled" : "" )"
							        tooltip="Return this player to their previous position"
							        onclick="@ReturnTypedPlayer">
								<i class="material-icons">undo</i> Return
							</button>
						</div>
					</div>
				}
			</div>
		}
		else if ( _activeTab == TabSettings )
		{
			<div class="settings">
				<div class="settings-head">
					<i class="material-icons">settings</i>
					<span>Settings</span>
				</div>

				<div class="settings-group">
					<div class="settings-label">Network Management</div>
					<div class="settings-hint">
						@($"Linked from the “{NetworkIdentifier}” tag in the tab bar — staff click it to copy your link.")
					</div>

					@if ( StaffMenuHost.CanEditSettings() )
					{
						<div class="settings-bar">
							<i class="material-icons">link</i>
							<TextEntry class="settings-input" Placeholder="https://your-network.com" Value:bind="@_websiteDraft"/>
							<button class="settings-btn save @( _websiteSaved ? "saved" : "" )"
							        tooltip="Save the network website link"
							        onclick="@SaveWebsiteFromInput">
								<i class="material-icons">@( _websiteSaved ? "check" : "save" )</i> @( _websiteSaved ? "Saved!" : "Save" )
							</button>
						</div>

						<div class="settings-current">
							@if ( StaffMenuHost.HasWebsite )
							{
								<span class="settings-current-text">@( $"Current: {StaffMenuHost.WebsiteUrl}" )</span>
								<button class="copy-btn"
								        tooltip="@( _currentCopied ? "Copied!" : "Copy link" )"
								        onclick="@CopyCurrentWebsite">
									<i class="material-icons">@( _currentCopied ? "check" : "content_copy" )</i>
								</button>
							}
							else
							{
								<span class="settings-current-text">No website set yet — leave the field empty and Save to clear it.</span>
							}
						</div>
					}
					else
					{
						<div class="settings-readonly">
							@( StaffMenuHost.HasWebsite ? StaffMenuHost.WebsiteUrl : "No website set." )
						</div>
					}
				</div>
			</div>
		}
		else if ( _activeTab == TabPlayerMgmt )
		{
			<div class="settings">
				<div class="settings-head">
					<i class="material-icons">groups</i>
					<span>Player &amp; Staff Management</span>
				</div>

				<div class="coming-soon">
					<i class="material-icons">construction</i>
					<span class="coming-soon-title">Coming Soon</span>
					<span class="coming-soon-hint">Tools for managing players and staff will live here.</span>
				</div>
			</div>
		}
		else
		{
		<div class="body">
			<div class="players @( _playersCollapsed ? "collapsed" : "" )">
				@if ( _playersCollapsed )
				{
					<div class="players-rail">
						<button class="expand-btn" tooltip="Open sidebar — players & settings" onclick="@TogglePlayers">
							<i class="material-icons">chevron_right</i>
						</button>
						<div class="rail-stat">
							<i class="material-icons">group</i>
							<span class="count">@_players.Count</span>
						</div>
						<div class="rail-stat">
							<i class="material-icons">shield</i>
							<span class="count">@( StaffTierGroups().Sum( g => g.Players.Count ) )</span>
						</div>
					</div>
				}

				@if ( !_playersCollapsed )
				{
					var staffGroups = StaffTierGroups();
					var staffCount = staffGroups.Sum( g => g.Players.Count );
					// "Players" lists ONLY non-staff. Staff already appear in the tiered Staff section above,
					// so re-listing them here produced a duplicate row that highlighted in both places on
					// select. The full live head-count (everyone) still shows in the "Online Players (N)"
					// header and the collapsed rail's group count, so nothing is lost.
					var nonStaff = FilteredPlayers()
						.Where( p => p.GroupName == StaffMenuHost.NonStaffGroup )
						.OrderBy( p => p.Name )
						.ToList();

					<div class="pane-label">
						<span class="pane-title">Online Players (@_players.Count)</span>
						<button class="collapse-btn" tooltip="Hide sidebar" onclick="@TogglePlayers">
							<i class="material-icons">chevron_left</i>
						</button>
					</div>

					<div class="search-row">
						<i class="material-icons">search</i>
						<TextEntry class="search-input" Placeholder="Steam ID (ex. 765XXXXXXXXXXXXXX)" Value:bind="@_searchText"/>
						@if ( !string.IsNullOrEmpty( _searchText ) )
						{
							<button class="icon-btn" onclick="@ClearSearch"><i class="material-icons">close</i></button>
						}
					</div>

					@if ( IsSteamId( _searchText ) )
					{
						<button class="steamid-pick" onclick="@SelectTypedSteamId">
							<i class="material-icons">person_search</i>
							<span>Select SteamID @_searchText.Trim()</span>
						</button>
					}

					<div class="player-scroll">
						<div class="parent-label">Staff (@staffCount)</div>
						@foreach ( var group in staffGroups )
						{
							<div class="group-label">@group.Name (@group.Players.Count)</div>
							@foreach ( var player in group.Players )
							{
								<button class="player-row @( ( _showProfile ? _profileSteamId : _selectedSteamId ) == player.SteamId ? "selected" : "" )"
								        tooltip="View player profile"
								        onclick="@(() => Select( player.SteamId ))">
									<i class="material-icons avatar">person</i>
									<span class="name">@player.Name</span>
									@if ( !player.CanTarget )
									{
										<i class="material-icons lock" tooltip="Equal or higher rank — cannot target">lock</i>
									}
								</button>
							}
						}

						<div class="parent-label">Players (@nonStaff.Count)</div>
						@foreach ( var player in nonStaff )
						{
							<button class="player-row @( ( _showProfile ? _profileSteamId : _selectedSteamId ) == player.SteamId ? "selected" : "" )"
							        tooltip="View player profile"
							        onclick="@(() => Select( player.SteamId ))">
								<i class="material-icons avatar">person</i>
								<span class="name">@player.Name</span>
								@if ( !player.CanTarget )
								{
									<i class="material-icons lock" tooltip="Equal or higher rank — cannot target">lock</i>
								}
							</button>
						}
					</div>
				}

				<div class="players-footer">
					<button class="settings-entry @( _activeTab == TabPlayerMgmt ? "settings-entry-on" : "" )"
					        tooltip="@( _playersCollapsed ? "Player & Staff Management" : "" )"
					        onclick="@OpenPlayerMgmt">
						<i class="material-icons">settings</i>
						@if ( !_playersCollapsed )
						{
							<span class="settings-entry-label">@("Player & Staff Management")</span>
						}
					</button>
				</div>
			</div>

			<div class="main">
			<div class="actions">
				@{
					var selected = _players.FirstOrDefault( p => p.SteamId == _selectedSteamId );
					var hasTarget = selected.SteamId != 0;
					// The profile pane previews whoever was clicked (_profileSteamId); it does NOT
					// imply selection — only "Actions for this player" commits a command target.
					var profileSteamId = _profileSteamId ?? 0;
				}

				@if ( _showProfile && profileSteamId != 0 )
				{
					var detail = StaffMenuHost.GetPlayerDetail( profileSteamId );
					<div class="profile">
						<div class="profile-head">
							<button class="icon-btn" onclick="@CloseProfile"><i class="material-icons">arrow_back</i></button>
							<span>Player Profile</span>
						</div>

						<div class="profile-card">
							@if ( StaffMenuHost.CanView( "ability.teleport" ) )
							{
								var tpTarget = _players.FirstOrDefault( p => p.SteamId == profileSteamId );
								var canTp = tpTarget.SteamId != 0 && tpTarget.CanTarget && profileSteamId != StaffMenuHost.LocalSteamId;
								<div class="profile-tp">
									<button class="tp-btn @( canTp ? "" : "disabled" )"
									        tooltip="Go to Player"
									        onclick="@(() => QuickTeleport( "goto", tpTarget ))">
										<i class="material-icons">my_location</i>
									</button>
									<button class="tp-btn @( canTp ? "" : "disabled" )"
									        tooltip="Bring Player"
									        onclick="@(() => QuickTeleport( "bring", tpTarget ))">
										<i class="material-icons">pan_tool</i>
									</button>
									<button class="tp-btn @( canTp ? "" : "disabled" )"
									        tooltip="Return Player"
									        onclick="@(() => QuickTeleport( "return", tpTarget ))">
										<i class="material-icons">undo</i>
									</button>
								</div>
							}

							<img class="profile-avatar" src="avatar:@profileSteamId"/>
							<div class="profile-name">@( detail.Found ? detail.Name : "Off-roster target" )</div>

							<div class="profile-fields">
								<div class="field">
									<span class="k">Steam ID</span>
									<span class="v v-copy">
										<span class="@( _steamIdCopied ? "copied-text" : "" )">@( _steamIdCopied ? "Copied!" : profileSteamId.ToString() )</span>
										<button class="copy-btn"
										        tooltip="@( _steamIdCopied ? "Copied!" : "Copy Steam ID" )"
										        onclick="@(() => CopySteamId( profileSteamId ))">
											<i class="material-icons">@( _steamIdCopied ? "check" : "content_copy" )</i>
										</button>
									</span>
								</div>
								<div class="field">
									<span class="k">Role</span>
									<span class="v" style="color: @( string.IsNullOrEmpty( detail.RankColorHex ) ? "#ffffff" : detail.RankColorHex )">@detail.Role</span>
								</div>
								<div class="field">
									<span class="k">Time played</span>
									<span class="v">@( detail.Found ? $"{detail.PlayTimeMinutes / 60}h" : "—" )</span>
								</div>

								@if ( detail.Found )
								{
									<div class="field">
										<span class="k">Job</span>
										<span class="v" style="color: @( string.IsNullOrEmpty( detail.JobColorHex ) ? "#ffffff" : detail.JobColorHex )">@detail.Job</span>
									</div>
									<div class="field">
										<span class="k">Health</span>
										<span class="v" style="color: #f87171">@detail.Health / @detail.MaxHealth</span>
									</div>
									<div class="field">
										<span class="k">Armor</span>
										<span class="v" style="color: #08B2E3">@detail.Armor</span>
									</div>
									<div class="field">
										<span class="k">Cash</span>
										<span class="v" style="color: #199c3b">$@( detail.Wallet.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) )</span>
									</div>
									<div class="field">
										<span class="k">Bank</span>
										<span class="v" style="color: #199c3b">$@( detail.Bank.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) )</span>
									</div>
									<div class="field">
										<span class="k">Kills</span>
										<span class="v">@detail.Kills</span>
									</div>
									<div class="field">
										<span class="k">Deaths</span>
										<span class="v">@detail.Deaths</span>
									</div>
								}
							</div>

							<button class="confirm-btn" onclick="@(() => ConfirmTarget( profileSteamId ))">
								<i class="material-icons">bolt</i> Actions for this player
							</button>

							@if ( StaffMenuHost.CanViewAudit() )
							{
								<button class="confirm-btn secondary" onclick="@(() => OpenAuditForPlayer( profileSteamId ))">
									<i class="material-icons">history</i> View audit log
								</button>
							}
						</div>
					</div>
				}
				else
				{
				<div class="target-banner @( _selectedSteamId != null ? "active" : "" )">
					<i class="material-icons">@( _selectedSteamId != null ? "person" : "public" )</i>
					<span class="target-name">@( hasTarget ? selected.Name : ( _selectedSteamId != null ? $"SteamID {_selectedSteamId}" : "No player selected — self & server actions only" ) )</span>
					@if ( _selectedSteamId != null )
					{
						<button class="icon-btn clear-target" tooltip="Deselect player" onclick="@Deselect">
							<i class="material-icons">close</i>
						</button>
					}
				</div>

				@{
					var visible = StaffMenuActions.All
						.Where( a => a.Category == _activeTab && StaffMenuHost.CanView( a.PermissionId ) )
						.ToList();
				}

				@if ( _pendingAction is { } pending )
				{
					<div class="arg-form">
						<div class="arg-form-head">
							<span>@pending.Label@( hasTarget && pending.TargetMode == StaffActionTarget.OtherPlayer ? $" — {selected.Name}" : "" )</span>
							<button class="icon-btn" onclick="@CancelArgs"><i class="material-icons">close</i></button>
						</div>

						@foreach ( var arg in pending.Args )
						{
							<div class="arg-row">
								<label>@arg.Label@( arg.Required ? "" : " (optional)" )</label>

								@if ( arg.Kind == StaffArgKind.Duration )
								{
									<div class="chips">
										@foreach ( var preset in StaffMenuConfig.BanDurations )
										{
											var allowed = pending.Key != "ban"
												|| StaffMenuConfig.IsBanDurationAllowed( StaffMenuHost.LocalRankOrder, preset.Hours );
											<button class="chip @( _duration == preset.Token ? "active" : "" ) @( allowed ? "" : "disabled" )"
											        onclick="@(() => SetDuration( preset.Token, allowed ))">
												@preset.Label
											</button>
										}
									</div>
									<TextEntry class="arg-input" Placeholder="@arg.Placeholder" Value:bind="@_duration"/>
								}
								else if ( arg.Kind == StaffArgKind.Number )
								{
									<TextEntry class="arg-input" Numeric="@true" Placeholder="@arg.Placeholder" Value:bind="@_amount"/>
								}
								else if ( arg.Name == "name" )
								{
									<TextEntry class="arg-input" Placeholder="@arg.Placeholder" Value:bind="@_name"/>
								}
								else
								{
									<TextEntry class="arg-input" Placeholder="@arg.Placeholder" Value:bind="@_reason"/>
								}
							</div>
						}

						<button class="confirm-btn" onclick="@(() => ConfirmArgs( selected ))">
							<i class="material-icons">check</i> Confirm @pending.Label
						</button>
					</div>
				}

				<div class="action-grid">
					@foreach ( var action in visible )
					{
						var enabled = IsEnabled( action, selected, hasTarget );
						<button class="action-btn @( enabled ? "" : "disabled" )"
						        tooltip="@( string.IsNullOrEmpty( action.Tooltip ) ? action.Label : action.Tooltip )"
						        onclick="@(() => OnActionClick( action, selected, enabled ))">
							<i class="material-icons">@action.Icon</i>
							<span>@action.Label</span>
						</button>
					}

					@* Invisible spacers pad the final row to a multiple of 4 so real boxes keep their
					   1/4 width (uniform) instead of flex-growing to fill the leftover space. *@
					@for ( var i = 0; i < (4 - visible.Count % 4) % 4; i++ )
					{
						<div class="action-spacer"></div>
					}
				</div>

				@if ( visible.Count == 0 )
				{
					<div class="empty">No @_activeTab.ToLower() actions available to your rank.</div>
				}
				}
			</div>

			<button class="signature @( _linkCopied ? "copied" : "" )"
			        tooltip="Copy the public addon-page link"
			        onclick="@CopyAddonLink">
				@( _linkCopied ? "Addon link copied!" : "lifepunch.ulx v2.0.0 — lifepunch.co" )
			</button>
			</div>
		</div>
		}
	</div>
</root>

@code {
	private IReadOnlyList<StaffMenuPlayer> _players = Array.Empty<StaffMenuPlayer>();
	private long? _selectedSteamId;
	// A Steam ID typed into the search box (may not be on the roster); kept selected so commands can
	// still target it, and exempt from the roster-presence auto-clear in RefreshRoster.
	private long? _manualSteamId;
	// The player whose profile is currently being PREVIEWED (clicking a roster row / typed id). This
	// is independent of _selectedSteamId — previewing never targets; only "Actions for this player"
	// commits a target via ConfirmTarget.
	private long? _profileSteamId;
	private bool _showProfile;
	private string _searchText = "";

	// Collapsed = the Online Players sidebar shrinks to a slim rail, handing its width to the action
	// area. Pure view state (no backend), folded into BuildHash so the toggle re-renders.
	private bool _playersCollapsed;

	// Rebuild throttle. The menu used to re-sample the roster AND fold live player stats into
	// BuildHash every single frame, so any volatile value (e.g. the periodic salary bumping Bank)
	// rebuilt the WHOLE menu — including the sidebar/cog — which replayed their hover state and read
	// as a flicker. We now refresh on a fixed cadence and cache the volatile stat hash, so the menu
	// only rebuilds when something actually changed at most a few times a second.
	private TimeSince _sinceRefresh;
	private int _detailHash;
	private const float RefreshInterval = 0.2f;

	// The public addon page. The footer signature copies this to the clipboard on click (no in-game
	// text selection), flashing a "copied" confirmation via _linkCopied.
	private const string SignatureUrl = "https://dxrp.net/addons/019e9cfa-3141-723c-a430-1a0e256472eb";
	private bool _linkCopied;

	// Network/brand identifier shown centered in the header. Mirrors the portal's "Network Identifier"
	// (Settings → Network). It is server-AGNOSTIC: the stable, lowercase brand key that is identical
	// across every server in the network — NOT the per-server Networking.ServerName. The portal value
	// isn't plumbed into the game's server-config API, so this one line is the single rebrand point.
	private const string NetworkIdentifier = "lifepunch";

	// Non-category tab ids. The tab strip is Moderation / Commands / Ability (action catalog
	// categories) plus these two full-window views, all driven by a single _activeTab.
	private const string TabWaypoints = "Waypoints";
	private const string TabAudit = "Audit";
	// Opened by the sidebar cog (not a strip tab): the owner-customization view.
	private const string TabSettings = "Settings";
	private const string TabPlayerMgmt = "PlayerMgmt";

	// The selected top-level tab: a StaffMenuActions category, TabWaypoints, or TabAudit.
	private string _activeTab = StaffMenuActions.CategoryModeration;

	// Active-tab highlight uses a STANDALONE class (`tab-sel`), styled in the SCSS. Why not the
	// obvious approaches:
	//  - `.tab.active` (compound class+class) — s&box's CSS subset doesn't match it, so it never applied.
	//  - inline style — s&box doesn't clear an inline `style` on re-render (every clicked tab stayed
	//    lit) and inline outranks `.tab:hover`, which killed hover feedback.
	// A method (not an inline `@( ... ? "x" : "" )` with nested quotes) keeps the class binding clean,
	// and toggling a class reliably applies AND clears while `.tab:hover` keeps working on the rest.
	private string TabClass( string tab ) => _activeTab == tab ? "tab tab-sel" : "tab";

	// Audit viewer state: a full-window tab mirroring the portal Audit page — its two live filters
	// (player id/name, entity id) are applied host-side.
	private string _auditPlayerId = "";
	private string _auditEntity = "";

	// Waypoints tab state: a full-window view over DXRP's /waypoint command. The list is live in the
	// editor stub; on the server it's name-driven until a client-readable list lands.
	private string _waypointName = "";

	// Waypoints-tab "Return a player": a SteamID64 typed straight in — no roster carry-over — so staff
	// can return anyone they just brought (the id is the ultimate player handle, one-click copyable).
	private string _returnSteamId = "";

	// Settings tab (opened by the sidebar cog): owner-configurable network website. _websiteDraft backs
	// the editable input (seeded from the saved value on open); _websiteCopied flashes the network-tag
	// "Link copied!" confirmation after a click-to-copy.
	private string _websiteDraft = "";
	private bool _websiteCopied;
	private bool _websiteSaved;
	private bool _steamIdCopied;
	private bool _currentCopied;

	private StaffAction? _pendingAction;
	private string _reason = "";
	private string _duration = "";
	private string _amount = "";
	private string _name = "";

	protected override void OnStart()
	{
		RefreshRoster();

		// Fetch owner settings on open so the network tag is click-to-copy immediately (not only after
		// the Settings view is visited).
		StaffMenuHost.RefreshSettings();
	}

	protected override void OnUpdate()
	{
		// Throttle: re-sampling every frame churned BuildHash and rebuilt the whole menu (sidebar/cog
		// hover would flicker). A few refreshes a second is plenty for a staff roster + live stats.
		if ( _sinceRefresh < RefreshInterval )
		{
			return;
		}

		_sinceRefresh = 0;
		RefreshRoster();
		RecomputeDetailHash();
	}

	private void RefreshRoster()
	{
		_players = StaffMenuHost.OnlinePlayers();

		// Drop a selection whose player left — unless it was a manually typed Steam ID (off-roster target).
		if ( _selectedSteamId.HasValue
		     && _selectedSteamId != _manualSteamId
		     && _players.All( p => p.SteamId != _selectedSteamId.Value ) )
		{
			_selectedSteamId = null;
			_showProfile = false;
		}
	}

	// Snapshot the open profile's volatile stats into a single hash on the refresh cadence (not every
	// frame), so BuildHash only flips the menu when a value really changed — keeping the surrounding
	// chrome (sidebar, cog) stable between updates.
	private void RecomputeDetailHash()
	{
		if ( _showProfile && _profileSteamId is { } sid && sid != 0 )
		{
			var d = StaffMenuHost.GetPlayerDetail( sid );
			_detailHash = HashCode.Combine( d.Health, d.Armor, d.Wallet, d.Bank, d.Kills, d.Deaths, d.Job );
		}
		else
		{
			_detailHash = 0;
		}
	}

	/// <summary>The roster filtered by the search box (by name); unfiltered when empty or a Steam ID.</summary>
	private IEnumerable<StaffMenuPlayer> FilteredPlayers()
	{
		var query = _searchText?.Trim() ?? "";
		if ( query.Length == 0 || IsSteamId( query ) )
		{
			return _players;
		}

		return _players.Where( p => p.Name.Contains( query, StringComparison.OrdinalIgnoreCase ) );
	}

	/// <summary>A typed value looks like a SteamID64 (17 digits; accept 16–20 to be lenient).</summary>
	private static bool IsSteamId( string? text )
	{
		text = text?.Trim() ?? "";
		return text.Length is >= 16 and <= 20 && text.All( char.IsDigit );
	}

	/// <summary>
	/// Ordered staff sub-groups under the "Staff" parent. The configurable reference ladder
	/// (<see cref="StaffMenuConfig.ReferenceTiers"/>) is always shown — even empty, as "(0)" — for at-a-
	/// glance context. Online staff are merged into the matching tier by their real portal rank name
	/// (case/whitespace-insensitive); any online staff whose rank doesn't match a reference tier (another
	/// server's custom ranks) is appended afterwards, highest rank order first.
	/// </summary>
	private List<(string Name, List<StaffMenuPlayer> Players)> StaffTierGroups()
	{
		var staff = FilteredPlayers().Where( p => p.GroupName != StaffMenuHost.NonStaffGroup ).ToList();
		var groups = new List<(string Name, List<StaffMenuPlayer> Players)>();

		foreach ( var tier in StaffMenuConfig.ReferenceTiers )
		{
			groups.Add( ( tier.Name, staff
				.Where( p => string.Equals( p.GroupName.Trim(), tier.Name.Trim(), StringComparison.OrdinalIgnoreCase ) )
				.OrderBy( p => p.Name )
				.ToList() ) );
		}

		foreach ( var extra in staff
			.Where( p => !StaffMenuConfig.ReferenceTiers.Any( t => string.Equals( t.Name.Trim(), p.GroupName.Trim(), StringComparison.OrdinalIgnoreCase ) ) )
			.GroupBy( p => p.GroupName )
			.OrderByDescending( g => g.Max( p => p.GroupOrder ) )
			.ThenBy( g => g.Key ) )
		{
			groups.Add( ( extra.Key, extra.OrderBy( p => p.Name ).ToList() ) );
		}

		return groups;
	}

	/// <summary>
	/// Clicking a roster row PREVIEWS that player's profile — it does not target them. Re-clicking the
	/// open preview closes it. Targeting only happens via <see cref="ConfirmTarget"/> ("Actions for
	/// this player"), so a click never silently arms a command.
	/// </summary>
	private void Select( long steamId )
	{
		// Re-clicking the player whose profile is already open closes the preview.
		if ( _showProfile && _profileSteamId == steamId )
		{
			_profileSteamId = null;
			_showProfile = false;
			CancelArgs();
			return;
		}

		_profileSteamId = steamId;
		_showProfile = true;
		CancelArgs();
	}

	/// <summary>Preview the profile for a Steam ID typed into the search box (off-roster allowed).</summary>
	private void SelectTypedSteamId()
	{
		var text = _searchText?.Trim() ?? "";
		if ( !IsSteamId( text ) || !long.TryParse( text, out var steamId ) )
		{
			return;
		}

		_profileSteamId = steamId;
		_showProfile = true;
		CancelArgs();
	}

	/// <summary>
	/// Commit the previewed player as the active command target ("Actions for this player"), close the
	/// profile, and land on the action grid. Off-roster (typed) ids are flagged manual so the
	/// roster-presence auto-clear leaves them alone.
	/// </summary>
	private void ConfirmTarget( long steamId )
	{
		if ( steamId == 0 )
		{
			return;
		}

		_selectedSteamId = steamId;
		_manualSteamId = _players.All( p => p.SteamId != steamId ) ? steamId : null;
		_showProfile = false;
		_profileSteamId = null;
		CancelArgs();
	}

	/// <summary>Clear the active target from the banner (the "X"); drops both roster and typed selections.</summary>
	private void Deselect()
	{
		_selectedSteamId = null;
		_manualSteamId = null;
		_showProfile = false;
		_profileSteamId = null;
		CancelArgs();
	}

	private void CloseProfile()
	{
		_showProfile = false;
		_profileSteamId = null;
		StateHasChanged();
	}

	private void ClearSearch()
	{
		_searchText = "";
		StateHasChanged();
	}

	private void SelectTab( string tab )
	{
		_activeTab = tab;
		CancelArgs();

		// Leaving the profile via a tab just drops the preview — it never targets. Any already-confirmed
		// target (_selectedSteamId) is untouched, so tabs never feel "stuck" behind the back arrow.
		_showProfile = false;
		_profileSteamId = null;

		if ( tab == TabWaypoints )
		{
			StaffMenuHost.RefreshWaypoints();
		}
		else if ( tab == TabSettings )
		{
			StaffMenuHost.RefreshSettings();
		}
	}

	private static bool IsEnabled( StaffAction action, StaffMenuPlayer selected, bool hasTarget )
	{
		if ( action.TargetMode != StaffActionTarget.OtherPlayer )
		{
			return true;
		}

		return hasTarget && selected.CanTarget;
	}

	private void OnActionClick( StaffAction action, StaffMenuPlayer selected, bool enabled )
	{
		if ( !enabled )
		{
			return;
		}

		if ( action.Args.Count > 0 )
		{
			BeginArgs( action );
			return;
		}

		Dispatch( action, selected );
	}

	private void BeginArgs( StaffAction action )
	{
		_pendingAction = action;
		_reason = "";
		_duration = "";
		_amount = "";
		_name = "";
		StateHasChanged();
	}

	private void CancelArgs()
	{
		_pendingAction = null;
		StateHasChanged();
	}

	private void SetDuration( string token, bool allowed )
	{
		if ( !allowed )
		{
			return;
		}

		_duration = token;
		StateHasChanged();
	}

	private void ConfirmArgs( StaffMenuPlayer selected )
	{
		if ( _pendingAction is not { } action )
		{
			return;
		}

		var args = new Dictionary<string, string>();
		foreach ( var arg in action.Args )
		{
			var value = ValueFor( arg.Name );
			if ( arg.Required && string.IsNullOrWhiteSpace( value ) )
			{
				return; // missing required input — keep the form open
			}

			args[arg.Name] = value;
		}

		Dispatch( action, selected, args );
		CancelArgs();
	}

	private string ValueFor( string argName ) => argName switch
	{
		"reason" => _reason,
		"duration" => _duration,
		"amount" => _amount,
		"name" => _name,
		_ => ""
	};

	private void Dispatch( StaffAction action, StaffMenuPlayer selected, IReadOnlyDictionary<string, string>? args = null )
	{
		args ??= new Dictionary<string, string>();

		if ( action.TargetMode != StaffActionTarget.OtherPlayer )
		{
			StaffMenuHost.Dispatch( action, StaffMenuHost.LocalSteamId, args );
			return;
		}

		if ( selected.SteamId == 0 || !selected.CanTarget )
		{
			return;
		}

		StaffMenuHost.Dispatch( action, selected.SteamId, args );
	}

