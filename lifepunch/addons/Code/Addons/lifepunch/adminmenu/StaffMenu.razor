	protected override int BuildHash()
	{
		// _detailHash is refreshed on the throttled cadence (RecomputeDetailHash), NOT recomputed here
		// every frame — otherwise a live stat change would rebuild the whole menu continuously and the
		// sidebar/cog hover would flicker.
		return HashCode.Combine(
			HashCode.Combine( _selectedSteamId, _profileSteamId, _showProfile, _searchText ),
			HashCode.Combine( _players.Count, _playersCollapsed, _linkCopied ),
			_activeTab,
			_pendingAction?.Key,
			HashCode.Combine( _reason, _duration, _amount, _name ),
			HashCode.Combine( _auditPlayerId, _auditEntity, _websiteDraft, _websiteCopied, _websiteSaved, _steamIdCopied, _currentCopied, StaffMenuHost.SettingsVersion ),
			HashCode.Combine( _waypointName, StaffMenuHost.WaypointVersion, _returnSteamId ),
			_detailHash );
	}
