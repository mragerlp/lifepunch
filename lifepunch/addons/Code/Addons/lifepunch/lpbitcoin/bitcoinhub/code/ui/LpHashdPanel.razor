@* ─────────────────────────────────────────────────────────────────────────────
   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Bitcoin Miner for DXRP" (s&box ident: lifepunch.bitcoin · addon ident: bitcoinmining)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="shell-body">
		@if ( ShowPinGate() )
		{
			<div class="pin-gate">
				<header class="pin-header">
					<div class="pin-brand">
						<div class="brand-mark"></div>
						<div class="pin-brand-copy">
							<div class="pin-title">@PinGateTitle()</div>
							<div class="pin-sub">@PinGateSubtitle()</div>
						</div>
					</div>
					@if ( PinChangeGateMode() )
					{
						<button class="lp-ui-chrome-btn close" tooltip="Cancel" onclick="@CancelPinChangeGate">
							<i class="material-icons">close</i>
						</button>
					}
					else
					{
						<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
							<i class="material-icons">close</i>
						</button>
					}
				</header>

				<div class="pin-body">
					<div class="pin-entry">
						<div class="pin-label">@PinEntryLabel()</div>
						<div class="pin-dots">
							@for ( var i = 0; i < PinTargetLength(); i++ )
							{
								<span class="pin-dot @(i < _pinBuffer.Length ? "filled" : "")"></span>
							}
						</div>
					</div>
					@if ( !string.IsNullOrWhiteSpace( _pinError ) )
					{
						<div class="pin-error">@_pinError</div>
					}

					<div class="pin-pad">
						@foreach ( var key in _pinKeys )
						{
							<button class="pin-key @(key == "ok" ? "ok" : "") @(key == "clr" ? "clr" : "")"
							        onclick="@(() => PressPinKey(key))">
								@if ( key == "clr" )
								{
									<i class="material-icons">backspace</i>
								}
								else if ( key == "ok" )
								{
									<i class="material-icons">check</i>
								}
								else
								{
									<span>@key</span>
								}
							</button>
						}
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="hub-body">
				<div class="hub-main">
					<aside class="sidebar">
						<div class="sidebar-brand hex-mark" title="@LpBitcoinIdent.OpsTitle">
							<div class="brand-mark"></div>
						</div>

						<nav class="sidebar-nav">
							@foreach ( var tab in _tabs )
							{
								<button class="sidebar-btn @(IsSidebarTabActive( tab ) ? "sidebar-btn-sel" : "")"
								        tooltip="@TabLabel(tab)"
								        onclick="@(() => SelectTab(tab))">
									<i class="material-icons">@TabIcon(tab)</i>
								</button>
							}
						</nav>

						<div class="sidebar-foot">
							<div class="sidebar-avatar" title="@GreetingName()">
								@if ( LocalSteamId() > 0 )
								{
									<img class="sidebar-avatar-img" src="avatar:@LocalSteamId()"/>
								}
								else
								{
									<span class="sidebar-avatar-fallback">@AvatarInitial()</span>
								}
							</div>
						</div>
					</aside>

					<div class="workspace">
						<header class="page-header hub-header">
							<div class="lp-ui-panel-title hub-title">
								<i class="material-icons">memory</i>
								<span>@LpBitcoinIdent.OpsTitle</span>
							</div>

							<div class="header-widgets">
								<button class="header-power-switch @(Hub?.IsPowered == true ? "on" : "off")"
								        tooltip="@(Hub?.IsPowered == true ? "Power off hub" : "Power on hub")"
								        onclick="@ToggleHubPower">
									<span class="power-switch-track">
										<span class="power-switch-knob"></span>
									</span>
									<span class="power-switch-label">@(Hub?.IsPowered == true ? "POWER ON" : "POWER OFF")</span>
								</button>
								<button class="header-chip wallet-chip" onclick="@SelectWalletTab">
									<i class="material-icons">account_balance_wallet</i>
									<span>@HeaderWalletBtc() BTC</span>
								</button>
								<div class="header-chip date-chip">
									<i class="material-icons">calendar_today</i>
									<span>@HeaderDateLabel()</span>
								</div>
								<button class="header-chip notif-chip @(HasUnreadAlerts() ? "has-unread" : "")"
								        tooltip="Hub logs"
								        onclick="@SelectLogsTab">
									<i class="material-icons">notifications</i>
									@if ( HasUnreadAlerts() )
									{
										<span class="notif-dot"></span>
									}
								</button>
								<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
									<i class="material-icons">close</i>
								</button>
							</div>
						</header>

						<div class="workspace-body">
							<div class="main-panel">
								@if ( _active == OpsTab.Overview )
								{
									<div class="pane overview">
										<div class="overview-intro-shell">
											<div class="overview-intro">
												<div class="overview-intro-copy-text">@OverviewIntroCopyLine()</div>
												<div class="overview-intro-terminal">
													<div class="overview-intro-terminal-row">
														<div class="overview-intro-terminal-status">
															<span class="lp-ui-status-dot @(HasLinkedTerminal() ? "on" : HasNearbyUnlinkedTerminal() ? "warn" : "off")"></span>
															<span class="overview-intro-terminal-label">@TerminalLinkStatusLabel()</span>
														</div>
														<div class="overview-intro-terminal-actions">
														@if ( HasLinkedTerminal() )
														{
															<button class="lp-ui-btn-ghost" onclick="@UnlinkTerminal">Unlink terminal</button>
														}
														else if ( HasNearbyUnlinkedTerminal() )
														{
															@if ( HubIsPowered() )
															{
																<button class="lp-ui-btn-primary" onclick="@LinkNearbyTerminal">Link terminal</button>
															}
															else
															{
																<button class="lp-ui-btn-ghost overview-intro-terminal-disabled" disabled>Power on to link</button>
															}
														}
														else
														{
															<button class="lp-ui-btn-ghost overview-intro-terminal-disabled" disabled>No terminal in range</button>
														}
														</div>
													</div>
												</div>
											</div>
										</div>

										<div class="lp-ui-split">
											<div class="lp-ui-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">dns</i>
													<span>Active miners</span>
												</div>

												@if ( LinkedRackCount() == 0 )
												{
													<div class="lp-ui-empty lp-ui-empty-callout racks-empty-callout">
														<div class="lp-ui-empty-callout-badge">Action required</div>
														<div class="lp-ui-empty-callout-icon">
															<i class="material-icons">link_off</i>
														</div>
														<div class="lp-ui-empty-callout-title">No racks linked</div>
														<div class="lp-ui-empty-callout-body">
															<div class="lp-ui-empty-callout-step">Power on the hub (header switch).</div>
															<div class="lp-ui-empty-callout-step">Link the terminal above.</div>
															<div class="lp-ui-empty-callout-step">At rig0 on the CRT, type:</div>
															<div class="lp-ui-empty-callout-cmd">link</div>
														</div>
													</div>
												}
												else
												{
													<div class="lp-ui-scroll-region overview-miners-scroll">
														@foreach ( var rack in GetLinkedRacks() )
														{
															<div class="overview-miner-card">
																<div class="overview-miner-head">
																	<div class="overview-miner-title">@RackSlotDisplayLabel( rack )</div>
																	<div class="overview-miner-status @( rack.IsMining ? "on" : "off" )">
																		<span class="lp-ui-status-dot @(rack.IsMining ? "on" : "off")"></span>
																		<span>@(rack.IsMining ? "Mining" : "Idle")</span>
																	</div>
																</div>
																<div class="overview-miner-stats">@RackOverviewSubline( rack )</div>
																<button class="rack-slot-id-copy overview-miner-copy" onclick="@(() => CopyRackTerminalId( rack ))">
																	<span class="rack-slot-id-token">@RackSlotTerminalToken( rack )</span>
																	<i class="material-icons">content_copy</i>
																	<span class="rack-slot-id-hint">@RackSlotCopyHint( rack )</span>
																</button>
															</div>
														}
													</div>
												}
											</div>

											<div class="lp-ui-panel overview-status-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">analytics</i>
													<span>Hub status</span>
												</div>

												<div class="overview-status-stack">
													<div class="overview-status-body">
														<div class="lp-ui-info overview-status-info">
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Total mined</span>
																<span class="lp-ui-info-value">@CombinedBtc().ToString("F6") BTC</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">USD value</span>
																<span class="lp-ui-info-value">$@CombinedUsd().ToString("N2")</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Hash rate</span>
																<span class="lp-ui-info-value">@HashRateLabel()</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Hub power</span>
																<span class="lp-ui-info-value">
																	<span class="lp-ui-status-dot @(Hub?.IsPowered == true ? "on" : "off")"></span>
																	<span>@HubPowerStatusLabel()</span>
																</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Load / draw</span>
																<span class="lp-ui-info-value">@LoadDrawLabel()</span>
															</div>
														</div>

														<div class="overview-status-perks">
															<div class="overview-status-perk">@LinkedRackCount() linked rack@(LinkedRackCount() == 1 ? "" : "s")</div>
															<div class="overview-status-perk">@MiningRackCount() mining now</div>
															<div class="overview-status-perk">Hub wallet @HubWalletBtc().ToString("F4") BTC</div>
															<div class="overview-status-perk">@RackPendingBtc().ToString("F4") BTC pending on racks</div>
														</div>
													</div>

													<div class="overview-status-footer">
														<div class="lp-ui-btn-row overview-status-actions">
															<button class="lp-ui-btn-primary" onclick="@SelectRacksTab">Manage racks</button>
															<button class="lp-ui-btn-ghost" onclick="@SelectWalletTab">Wallet</button>
															<button class="lp-ui-btn-ghost" onclick="@SelectTransfersTab">Transfers</button>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Racks )
								{
									<div class="pane racks">
										<div class="lp-ui-panel racks-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">dns</i>
												<span>GPU racks</span>
											</div>

											@if ( LinkedRackCount() > 0 )
											{
												<div class="lp-ui-intro">
													Rack slots (<strong>GPURack-1</strong> … <strong>GPURack-@LpBitcoinIdent.PortalMaxRacksPerHub</strong>) match rig0 at the terminal. Open <strong>Upgrade</strong> for CPU and core paths — start/stop mining on the CRT.
												</div>
											}

											@if ( LinkedRackCount() == 0 )
											{
												<div class="lp-ui-empty lp-ui-empty-callout racks-empty-callout">
													<div class="lp-ui-empty-callout-badge">Action required</div>
													<div class="lp-ui-empty-callout-icon">
														<i class="material-icons">link_off</i>
													</div>
													<div class="lp-ui-empty-callout-title">No racks linked</div>
													<div class="lp-ui-empty-callout-body">
														<div class="lp-ui-empty-callout-step">Link the terminal in hub admin.</div>
														<div class="lp-ui-empty-callout-step">At rig0 on the CRT, type:</div>
														<div class="lp-ui-empty-callout-cmd">link</div>
													</div>
												</div>
											}
											else
											{
												<div class="lp-ui-scroll-region racks-scroll">
													<div class="rack-grid">
														@foreach ( var rack in GetLinkedRacks() )
														{
															<div class="rack-card">
																<div class="rack-card-head">
																	<div class="rack-card-head-main">
																		<div class="rack-card-title">@RackSlotDisplayLabel( rack )</div>
																		<button class="rack-slot-id-copy" onclick="@(() => CopyRackTerminalId( rack ))">
																			<span class="rack-slot-id-token">@RackSlotTerminalToken( rack )</span>
																			<i class="material-icons">content_copy</i>
																			<span class="rack-slot-id-hint">@RackSlotCopyHint( rack )</span>
																		</button>
																	</div>
																	<div class="rack-card-badges">
																		<span class="rack-badge @(rack.IsMining ? "on" : "")">@(rack.IsMining ? "Mining" : "Idle")</span>
																		<span class="rack-badge dim">@RackYieldLabel( rack )</span>
																	</div>
																</div>
																<div class="rack-card-stats">
																	<div class="rack-stat-line">@RackBtcLine( rack )</div>
																	<div class="rack-stat-line">@RackHardwareLine( rack )</div>
																	<div class="rack-stat-line">@RackUpgradeSummaryLine( rack )</div>
																</div>
																<div class="rack-card-actions">
																	<button class="lp-ui-btn-primary rack-upgrade-btn" onclick="@(() => OpenRackUpgrades( rack ))">Upgrade</button>
																</div>
															</div>
														}
													</div>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Upgrades )
								{
									var upgradeRack = GetUpgradeRack();
									<div class="pane upgrades">
										<div class="lp-ui-panel upgrades-panel">
											<div class="upgrades-toolbar">
												<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@CloseRackUpgrades">
													<i class="material-icons">arrow_back</i>
													<span>Servers</span>
												</button>
												<div class="lp-ui-panel-title upgrades-title">
													<i class="material-icons">upgrade</i>
													<span>@(upgradeRack.IsValid() ? $"{RackSlotDisplayLabel( upgradeRack )} upgrades" : "Rack upgrades")</span>
												</div>
											</div>

											@if ( !upgradeRack.IsValid() )
											{
												<div class="lp-ui-empty">
													<i class="material-icons">dns</i>
													<span>Rack unavailable — return to Servers and pick a linked rack.</span>
												</div>
											}
											else
											{
												<div class="lp-ui-intro upgrades-intro">
													<strong>@RackSlotDisplayLabel( upgradeRack )</strong> · @RackYieldLabel( upgradeRack ) · @RackHardwareLine( upgradeRack ) — Purchases debit your in-game cash. Mining start/stop stays on the CRT. rig0 slot: <strong>@RackSlotTerminalToken( upgradeRack )</strong>
												</div>

												<div class="lp-ui-scroll-region upgrades-scroll">
													<div class="upgrade-tracks">
														<div class="upgrade-track lp-hashd-surface">
															<div class="upgrade-track-head">
																<i class="material-icons">memory</i>
																<span>CPU clock path</span>
															</div>
															@if ( IsCpuPathMaxed( upgradeRack ) )
															{
																<div class="upgrade-tier-row maxed">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">All tiers owned</div>
																		<div class="upgrade-tier-detail">@($"{upgradeRack.ClockGhz:F2} GHz clock")</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<span class="upgrade-tier-badge">Maxed</span>
																	</div>
																</div>
															}
															else
															{
																var cpuTier = upgradeRack.CpuUpgradeLevel;
																<div class="upgrade-tier-row next">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">@CpuTierLabel( cpuTier )</div>
																		<div class="upgrade-tier-detail">@CpuTierDetail( cpuTier )</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<button class="lp-ui-btn-primary upgrade-tier-buy" onclick="@(() => UpgradeCpu( upgradeRack ))">Buy $@LpBitcoinEconomy.CpuUpgradeCosts[cpuTier].ToString("N0")</button>
																	</div>
																</div>
															}
														</div>

														<div class="upgrade-track lp-hashd-surface">
															<div class="upgrade-track-head">
																<i class="material-icons">developer_board</i>
																<span>Core count path</span>
															</div>
															@if ( IsCorePathMaxed( upgradeRack ) )
															{
																<div class="upgrade-tier-row maxed">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">All tiers owned</div>
																		<div class="upgrade-tier-detail">@($"{upgradeRack.CoreCount} cores")</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<span class="upgrade-tier-badge">Maxed</span>
																	</div>
																</div>
															}
															else
															{
																var coreTier = upgradeRack.CoreUpgradeLevel;
																<div class="upgrade-tier-row next">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">@CoreTierLabel( coreTier )</div>
																		<div class="upgrade-tier-detail">@CoreTierDetail( coreTier )</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<button class="lp-ui-btn-primary upgrade-tier-buy" onclick="@(() => UpgradeCores( upgradeRack ))">Buy $@LpBitcoinEconomy.CoreUpgradeCosts[coreTier].ToString("N0")</button>
																	</div>
																</div>
															}
														</div>
													</div>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Wallet )
								{
									<div class="pane wallet">
										<div class="lp-ui-panel wallet-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">account_balance_wallet</i>
												<span>Hub wallet</span>
											</div>

											<div class="lp-ui-intro">
												Your secured hub balance. Deposit rack earnings at the linked terminal, then cash out to your in-game bank here.
											</div>

											<div class="lp-ui-info">
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Hub wallet</span>
													<span class="lp-ui-info-value accent">@HubWalletBtc().ToString("F6") BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Still on racks</span>
													<span class="lp-ui-info-value">@RackPendingBtc().ToString("F6") BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Terminal linked</span>
													<span class="lp-ui-info-value">@(HasLinkedTerminal() ? "Yes" : "No — link on Overview")</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">USD value (hub)</span>
													<span class="lp-ui-info-value">$@HubWalletUsd().ToString("N2")</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Exchange rate</span>
													<span class="lp-ui-info-value">$@LpBitcoinEconomy.BitcoinValueUsd / BTC</span>
												</div>
												<div class="lp-ui-info-row">
													<span class="lp-ui-info-label">Your cash</span>
													<span class="lp-ui-info-value">$@LpHashdUiHost.GetLocalWalletCash()</span>
												</div>
											</div>

											<div class="wallet-cashout-bar">
												<i class="material-icons">payments</i>
												<TextEntry class="wallet-cashout-input" Placeholder="BTC amount (e.g. 0.025)" Value:bind="@CashOutAmount"/>
												<button class="lp-ui-btn-primary wallet-cashout-btn @GetPartialCashOutButtonClass()" onclick="@CashOutPartial">@PartialCashOutButtonLabel()</button>
											</div>

											<div class="wallet-cashout-row">
												<button class="lp-ui-btn-primary wallet-cashout-all @(HubWalletBtc() <= 0f ? "disabled" : "")" onclick="@CashOutAll">@CashOutAllButtonLabel()</button>
											</div>

											@if ( _cashOutErrorActive )
											{
												<div class="wallet-cashout-error @(_cashOutErrorVisible ? "visible" : "")">
													<i class="material-icons">error_outline</i>
													<span>@_cashOutErrorMessage</span>
												</div>
											}

											@if ( _cashOutSuccessActive )
											{
												<div class="wallet-cashout-success @(_cashOutSuccessVisible ? "visible" : "")">
													<i class="material-icons">check_circle</i>
													<span>@_cashOutSuccessMessage</span>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Transfers )
								{
									<div class="pane transfers">
										<div class="lp-ui-panel transfers-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">swap_horiz</i>
												<span>Hub transfers</span>
											</div>

											<div class="lp-ui-intro">
												Move BTC between operators. Share your Steam ID to receive; send from the linked terminal using <strong>send</strong>.
											</div>

											<div class="transfer-columns">
												<div class="transfer-column receive">
													<div class="transfer-column-head">
														<i class="material-icons">south_west</i>
														<span>Receive BTC</span>
													</div>
													<p class="transfer-column-copy">Share your hub receive address so other operators can send BTC to this wallet.</p>
													<div class="transfer-address-card">
														<div class="transfer-address-label">Your receive ID</div>
														<div class="transfer-address-value">@ReceiveSteamIdLabel()</div>
													</div>
													<div class="lp-ui-info transfer-column-stats">
														<div class="lp-ui-info-row">
															<span class="lp-ui-info-label">Hub wallet</span>
															<span class="lp-ui-info-value accent">@HubWalletBtc().ToString("F6") BTC</span>
														</div>
													</div>
													<div class="lp-ui-btn-row transfer-btn-row">
														<button class="lp-ui-btn-ghost transfer-copy-btn @(_receiveCopyAck ? "is-copied" : "")" onclick="@CopyReceiveAddress">
															<i class="material-icons">content_copy</i>
															<span>@ReceiveCopyLabel()</span>
														</button>
													</div>
												</div>

												<div class="transfer-column send">
													<div class="transfer-column-head">
														<i class="material-icons">north_east</i>
														<span>Send BTC</span>
													</div>
													<p class="transfer-column-copy">Use the linked bitcoin terminal to move BTC from this hub to another operator.</p>
													<div class="lp-ui-info transfer-column-stats">
														<div class="lp-ui-info-row">
															<span class="lp-ui-info-label">Terminal linked</span>
															<span class="lp-ui-info-value">@(HasLinkedTerminal() ? "Yes — ready to send" : "No — link on Overview")</span>
														</div>
													</div>
													<div class="transfer-command-card">
														<div class="transfer-command-label">Command</div>
														<div class="transfer-command-text">send &lt;steamid&gt; &lt;amount|all&gt;</div>
													</div>
													<div class="transfer-command-card">
														<div class="transfer-command-label">Example</div>
														<div class="transfer-command-text">send 76561198012345678 0.05</div>
													</div>
													<div class="lp-ui-btn-row transfer-btn-row">
														<button class="lp-ui-btn-ghost transfer-copy-btn @(_sendExampleCopyAck ? "is-copied" : "")" onclick="@CopySendExample">
															<i class="material-icons">content_copy</i>
															<span>@SendExampleCopyLabel()</span>
														</button>
													</div>
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Logs )
								{
									<div class="pane logs-pane">
										<div class="lp-ui-panel logs-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">notifications</i>
												<span>Hub logs</span>
											</div>

											<div class="lp-ui-intro">
												Terminal commands, rack capacity warnings, intrusion attempts, and hub transfers appear here.
											</div>

											@if ( GetHubAlerts().Count == 0 )
											{
												<div class="lp-ui-empty">
													<i class="material-icons">notifications_none</i>
													<span>No alerts yet.</span>
												</div>
											}
											else
											{
												<div class="lp-ui-scroll-region logs-scroll">
													<div class="notif-list">
														@foreach ( var alert in GetHubAlerts() )
														{
															<div class="notif-row">
																<i class="material-icons">@AlertIcon(alert.Kind)</i>
																<div class="notif-copy">
																	<div class="notif-kind">@AlertKindLabel(alert.Kind)</div>
																	<div class="notif-message">@alert.Message</div>
																	<div class="notif-time">@AlertTimeLabel(alert.Timestamp)</div>
																</div>
															</div>
														}
													</div>
												</div>
											}
										</div>
									</div>
								}
								else if ( _active == OpsTab.Settings )
								{
									<div class="pane settings-pane">
										<div class="lp-ui-panel settings-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">settings</i>
												<span>Settings</span>
											</div>

											<div class="lp-ui-scroll-region settings-scroll">
												<div class="lp-ui-intro">
													Hub power, PIN security, and terminal linking. Changes apply immediately on this hub.
												</div>

												<div class="settings-sections">
												<div class="settings-section lp-hashd-surface">
													<div class="settings-label">UI Scale</div>
													<div class="settings-hint">Resize the hub console window.</div>
													<div class="panel-size-row">
														@foreach ( var size in _uiScaleOptions )
														{
															<button class="panel-size-opt @( _uiScale == size ? "active" : "" )"
															        onclick="@(() => SetUiScale( size ))">
																@LpUiScale.ShortLabel( size )
															</button>
														}
													</div>
												</div>

												<div class="settings-section lp-hashd-surface">
													<div class="settings-label">Hub power</div>
													<div class="settings-hint">Turn the HASHD hub on or off. Matches the header switch — racks stop accruing when power is off; nothing links while off.</div>
													<div class="settings-actions">
														<button class="@(Hub?.IsPowered == true ? "lp-ui-btn-primary" : "lp-ui-btn-ghost")" onclick="@PowerOn">Power on</button>
														<button class="@(Hub?.IsPowered != true ? "lp-ui-btn-primary" : "lp-ui-btn-ghost")" onclick="@PowerOff">Power off</button>
													</div>
												</div>

												<div class="settings-section lp-hashd-surface">
													<div class="settings-label">Security</div>
													<div class="settings-hint @( !string.IsNullOrWhiteSpace( _pinChangeNotice ) ? "settings-hint-ok" : "" )">
														@( !string.IsNullOrWhiteSpace( _pinChangeNotice )
															? _pinChangeNotice
															: Hub?.AccessPinIsSet == true
																? "Hub PIN protects wallet and settings. Change PIN opens Secure Boot — same flow as first hub USE."
																: "Set your PIN on first hub USE via Secure Boot." )
													</div>
													@if ( Hub?.AccessPinIsSet == true )
													{
														<div class="settings-actions lp-hashd-action-row">
															<button class="lp-ui-btn-primary" onclick="@StartPinChange">Change PIN</button>
														</div>
													}
												</div>

												<div class="settings-section lp-hashd-surface">
													<div class="settings-label">Bitcoin terminal</div>
													<div class="settings-hint">
														@( HasLinkedTerminal()
															? "Linked terminal opens rig0 when hub power is on."
															: !HubIsPowered()
																? "Power on the hub before linking a terminal."
																: HasNearbyUnlinkedTerminal()
																	? "Unlinked terminal in range — register it to enable rig0 ops."
																	: "Place a bitcoin terminal within link range, then register it here." )
													</div>
													<div class="settings-meta">
														<div class="settings-meta-row">
															<span class="settings-meta-label">Status</span>
															<span class="settings-meta-value">@(HasLinkedTerminal() ? "Linked" : "Not linked")</span>
														</div>
														@if ( !HasLinkedTerminal() && HasNearbyUnlinkedTerminal() )
														{
															<div class="settings-meta-row">
																<span class="settings-meta-label">Nearby</span>
																<span class="settings-meta-value">Unlinked terminal ready</span>
															</div>
														}
													</div>
													<div class="settings-actions">
														<button class="@(HasLinkedTerminal() ? "lp-ui-btn-ghost" : "lp-ui-btn-primary")" disabled="@(HasLinkedTerminal() || !HubIsPowered())" onclick="@LinkNearbyTerminal">Link terminal</button>
														<button class="@(HasLinkedTerminal() ? "lp-ui-btn-primary" : "lp-ui-btn-ghost")" disabled="@(!HasLinkedTerminal())" onclick="@UnlinkTerminal">Unlink terminal</button>
													</div>
												</div>
												</div>
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		}

		</div>

		<div class="lp-window-watermark lp-window-watermark--rounded">
			<LifePunchUiFooter />
		</div>
	</div>
</root>

@code
{
	private enum OpsTab { Overview, Wallet, Transfers, Racks, Upgrades, Logs, Settings }
	private enum PerfRange { Day, Week, Month }
	private enum PinGatePurpose { Unlock, ChangePin }

	private static readonly OpsTab[] _tabs = { OpsTab.Overview, OpsTab.Wallet, OpsTab.Transfers, OpsTab.Racks, OpsTab.Logs, OpsTab.Settings };
	private static readonly PerfRange[] _perfRanges = { PerfRange.Day, PerfRange.Week, PerfRange.Month };

	private OpsTab _active = OpsTab.Overview;
	private LpUiScaleSize _uiScale = LpUiScale.Default;
	private static readonly LpUiScaleSize[] _uiScaleOptions =
	{
		LpUiScaleSize.Small,
		LpUiScaleSize.Medium,
		LpUiScaleSize.Large,
		LpUiScaleSize.ExtraLarge
	};
	private Guid _upgradeRackId = Guid.Empty;
	private Guid _rackSlotCopyAckId = Guid.Empty;
	private bool _receiveCopyAck;
	private bool _sendExampleCopyAck;
	private PerfRange _perfRange = PerfRange.Week;
	private PerfRange _profitRange = PerfRange.Week;
	private bool _pinUnlocked;
	private string _pinBuffer = "";
	private string _pinConfirmDraft = "";
	private string _pinError = "";
	private int _pinSetupPass;
	private PinGatePurpose _pinGatePurpose = PinGatePurpose.Unlock;
	private OpsTab _returnTabAfterPinGate = OpsTab.Overview;
	private string _pinChangeCurrent = "";
	private string _pinChangeNewDraft = "";
	private string _pinChangeNotice = "";
	private int _pinChangePass;
	private static readonly string[] _pinKeys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "clr", "0", "ok" };
	private string _cashOutAmount = "";
	private bool _cashOutSuccessActive;
	private bool _cashOutSuccessVisible;
	private string _cashOutSuccessMessage = "";
	private bool _cashOutErrorActive;
	private bool _cashOutErrorVisible;
	private string _cashOutErrorMessage = "";

	// Structure hash (racks linked, power, alerts, wallet display) — never hash TextEntry bind values.
	private TimeSince _sinceTelemetryRefresh;
	private TimeSince _sinceLogTimeRefresh;
	private int _telemetryHash;
	private int _logTimeBucket;
	private const float TelemetryRefreshInterval = 0.5f;
	private const float LogTimeRefreshInterval = 30f;

	private string CashOutAmount
	{
		get => _cashOutAmount;
		set
		{
			_cashOutAmount = value ?? string.Empty;
			ClearCashOutError();
		}
	}
	private LpBitcoinHubEntity _hub;

	public LpBitcoinHubEntity Hub => _hub;

	public void BindHub( LpBitcoinHubEntity hub )
	{
		_hub = hub;
		_pinUnlocked = hub is null;
		_pinBuffer = "";
		_pinConfirmDraft = "";
		_pinError = "";
		_pinSetupPass = 0;
		_pinGatePurpose = PinGatePurpose.Unlock;
		_returnTabAfterPinGate = OpsTab.Overview;
		ResetPinChangeState( keepNotice: false );
		_sinceTelemetryRefresh = TelemetryRefreshInterval;
		_sinceLogTimeRefresh = LogTimeRefreshInterval;
		_logTimeBucket = (int)(Time.Now / LogTimeRefreshInterval);
		RecomputeTelemetryHash();
	}
	public void DevBypassPinGate()
	{
		_pinUnlocked = true;
		StateHasChanged();
	}

	/// <summary>Dev preview — jump to first linked rack's upgrade tracks (buy buttons + intro).</summary>
	public void DevOpenUpgradesForFirstLinkedRack()
	{
		var rack = GetLinkedRacks().FirstOrDefault( r => r.IsValid() );
		if ( !rack.IsValid() )
			return;

		OpenRackUpgrades( rack );
	}

	protected override void OnEnabled()
	{
		LifePunchMenuInputBlock.NotifyMenuOpened();
		LpBitcoinHudBridge.SetMenuCursorMode( true );
		LifePunchUiScrollPolicy.Apply( Panel );
		_sinceTelemetryRefresh = TelemetryRefreshInterval;
		_sinceLogTimeRefresh = LogTimeRefreshInterval;
		_logTimeBucket = (int)(Time.Now / LogTimeRefreshInterval);
		RecomputeTelemetryHash();
	}

	protected override void OnDisabled()
	{
		LifePunchMenuInputBlock.NotifyMenuClosed();
		LpBitcoinHudBridge.SetMenuCursorMode( false );
	}

	private string StatusLabel() => Hub?.IsPowered == true ? "POWER ON" : "POWER OFF";

	private string AvatarInitial()
	{
		var name = GreetingName();
		return string.IsNullOrWhiteSpace( name ) ? "O" : name.Substring( 0, 1 ).ToUpperInvariant();
	}

	private string HeaderWalletBtc() => HubWalletBtc().ToString( "F4" );

	private static string HeaderDateLabel() => DateTime.Now.ToString( "MMMM, yyyy" );

	private bool HasUnreadAlerts() => Hub?.UnreadAlertCount > 0;

	private IReadOnlyList<LpBitcoinHubAlert> GetHubAlerts() => Hub?.GetAlerts() ?? Array.Empty<LpBitcoinHubAlert>();

	private void SelectLogsTab()
	{
		SelectTab( OpsTab.Logs );
		Hub?.RequestMarkAlertsRead();
		_logTimeBucket = (int)(Time.Now / LogTimeRefreshInterval);
		_sinceLogTimeRefresh = 0;
		StateHasChanged();
	}

	private static long LocalSteamId() => Game.SteamId;

	private static string AlertIcon( LpBitcoinHubAlertKind kind ) => kind switch
	{
		LpBitcoinHubAlertKind.TerminalCommand => "terminal",
		LpBitcoinHubAlertKind.RackCapacity => "storage",
		LpBitcoinHubAlertKind.HackAttack => "gpp_bad",
		LpBitcoinHubAlertKind.HubTransfer => "swap_horiz",
		_ => "notifications"
	};

	private static string AlertKindLabel( LpBitcoinHubAlertKind kind ) => kind switch
	{
		LpBitcoinHubAlertKind.TerminalCommand => "Terminal",
		LpBitcoinHubAlertKind.RackCapacity => "Rack capacity",
		LpBitcoinHubAlertKind.HackAttack => "Intrusion",
		LpBitcoinHubAlertKind.HubTransfer => "Hub transfer",
		_ => "Alert"
	};

	private static string AlertTimeLabel( double timestamp )
	{
		var age = Math.Max( 0, Time.Now - timestamp );
		if ( age < 60 )
			return "just now";

		if ( age < 3600 )
			return $"{(int)(age / 60)}m ago";

		return $"{(int)(age / 3600)}h ago";
	}

	private string HashRateLabel()
	{
		var th = TotalMiningRate() * 18.5f;
		return th <= 0.01f ? "0.0 TH/s" : $"{th:F1} TH/s";
	}

	private string HashRateDeltaLabel()
	{
		if ( MiningRackCount() == 0 )
			return "Idle";

		var delta = 1.5f + MiningLoadPercent() * 0.02f;
		return $"+{delta:F1}%";
	}

	private static string PerfRangeLabel( PerfRange range ) => range switch
	{
		PerfRange.Day => "D",
		PerfRange.Week => "W",
		PerfRange.Month => "M",
		_ => "W"
	};

	private void SetPerfRange( PerfRange range ) => _perfRange = range;
	private void SetProfitRange( PerfRange range ) => _profitRange = range;

	private static string PerfDayLabel( int index )
	{
		var days = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
		return days[Math.Clamp( index, 0, days.Length - 1 )];
	}

	private int PerfHighlightIndex() => ((int)DateTime.Now.DayOfWeek + 6) % 7;

	private int PerfBarHeight( int index )
	{
		var seed = (int)(TotalMiningRate() * 1000f) + index * 17 + MiningLoadPercent() * 3;
		return 24 + Math.Abs( seed % 62 );
	}

	private float ProfitEstimate()
	{
		var hourlyBtc = TotalMiningRate() * 60f;
		var multiplier = _profitRange switch
		{
			PerfRange.Day => 24f,
			PerfRange.Month => 24f * 30f,
			_ => 24f * 7f
		};

		return hourlyBtc * multiplier * LpBitcoinEconomy.BitcoinValueUsd;
	}

	private string RackSlotLabel( LpBitcoinRackEntity rack )
		=> LpBitcoinIdent.FormatRackSlotId( rack, GetLinkedRacks() );

	private string RackSlotDisplayLabel( LpBitcoinRackEntity rack )
		=> LpBitcoinIdent.FormatRackSlotDisplayName( rack, GetLinkedRacks() );

	private string RackSlotTerminalToken( LpBitcoinRackEntity rack )
		=> LpBitcoinIdent.FormatRackSlotTerminalToken( rack, GetLinkedRacks() );

	private string RackSlotCopyHint( LpBitcoinRackEntity rack )
		=> _rackSlotCopyAckId == rack.GameObject.Id ? "Copied!" : "Copy";

	private static string OverviewIntroCopyLine()
		=> $"Buy from DXRP Market → place hub → set PIN → power on (header switch) → link terminal → register up to {LpBitcoinIdent.PortalMaxRacksPerHub} GPU racks at rig0 on the CRT.";

	private static string RackYieldLabel( LpBitcoinRackEntity rack )
		=> !rack.IsValid()
			? "—"
			: $"{rack.ClockGhz:F2} GHz · {rack.CoreCount} core(s)";

	private static string RackOverviewSubline( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() )
			return "—";

		var cap = LpBitcoinEconomy.RackBtcCapacity;
		var fill = cap > 0f ? (int)Math.Round( 100f * rack.BitcoinAmount / cap ) : 0;
		var rate = rack.IsMining ? $"{rack.MiningRatePerMinute * 18.5f:F1} TH/s" : "idle";
		return $"{rate} · {rack.BitcoinAmount:F4}/{cap:F4} BTC ({fill}%)";
	}

	private static string RackBtcLine( LpBitcoinRackEntity rack )
	{
		var cap = LpBitcoinEconomy.RackBtcCapacity;
		var state = rack.BitcoinAmount >= cap ? "full" : rack.IsMining ? "mining" : "idle";
		return $"{rack.BitcoinAmount:F6} / {cap:F6} BTC · ${rack.UsdValue:N0} · {state}";
	}

	private static string RackHardwareLine( LpBitcoinRackEntity rack )
		=> $"{rack.ClockGhz:F2} GHz · {rack.CoreCount} cores · CPU L{rack.CpuUpgradeLevel} · Core L{rack.CoreUpgradeLevel}";

	private static string RackUpgradeSummaryLine( LpBitcoinRackEntity rack )
	{
		var cpuTier = rack.CpuUpgradeLevel >= LpBitcoinEconomy.CpuUpgradeCosts.Length
			? "CPU maxed"
			: $"CPU L{rack.CpuUpgradeLevel + 1} next";
		var coreTier = rack.CoreUpgradeLevel >= LpBitcoinEconomy.CoreUpgradeCosts.Length
			? "Core maxed"
			: $"Core L{rack.CoreUpgradeLevel + 1} next";
		return $"{cpuTier} · {coreTier}";
	}

	private static string CpuTierLabel( int tier ) => $"Tier {tier + 1}";

	private static string CpuTierDetail( int tier )
		=> $"{CpuGhzAfterTier( tier ):0.00} GHz clock";

	private static string CoreTierLabel( int tier ) => $"Tier {tier + 1}";

	private static string CoreTierDetail( int tier )
		=> $"{CoresAfterTier( tier )} cores";

	private static float CpuGhzAfterTier( int tier )
		=> LpBitcoinEconomy.StartClockGhz + (tier + 1) * LpBitcoinEconomy.CpuGhzPerLevel;

	private static int CoresAfterTier( int tier )
		=> LpBitcoinEconomy.StartCores + (tier + 1) * LpBitcoinEconomy.CoresPerLevel;

	private static bool IsCpuPathMaxed( LpBitcoinRackEntity rack )
		=> rack.CpuUpgradeLevel >= LpBitcoinEconomy.CpuUpgradeCosts.Length;

	private static bool IsCorePathMaxed( LpBitcoinRackEntity rack )
		=> rack.CoreUpgradeLevel >= LpBitcoinEconomy.CoreUpgradeCosts.Length;

	private string HubDisplayName() => "HASHD Hub";

	private string HubPowerStatusLabel()
	{
		var powered = Hub?.IsPowered == true;
		return $"{(powered ? "On" : "Off")} · {HubTempLabel()}";
	}

	private string LoadDrawLabel() => $"{MiningLoadPercent()}% · {HubPowerDrawLabel()}";

	private string HubTempLabel()
	{
		if ( Hub?.IsPowered != true )
			return "--°C";

		return $"{56 + MiningLoadPercent() / 4}°C";
	}

	private string HubPeakTempLabel()
	{
		if ( Hub?.IsPowered != true )
			return "--°C";

		return $"{62 + MiningLoadPercent() / 5}°C";
	}

	private string HubPowerDrawLabel()
	{
		if ( Hub?.IsPowered != true )
			return "0W";

		var baseDraw = 420;
		var rackDraw = MiningRackCount() * 260;
		return $"{baseDraw + rackDraw}W";
	}

	private static string TabIcon( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "home",
		OpsTab.Wallet => "account_balance_wallet",
		OpsTab.Transfers => "swap_horiz",
		OpsTab.Racks => "dns",
		OpsTab.Logs => "notifications",
		OpsTab.Settings => "settings",
		_ => "home"
	};

	private static string TabLabel( OpsTab tab ) => tab switch
	{
		OpsTab.Overview => "Overview",
		OpsTab.Wallet => "Wallet",
		OpsTab.Transfers => "Transfers",
		OpsTab.Racks => "Servers",
		OpsTab.Logs => "Logs",
		OpsTab.Settings => "Settings",
		_ => "Overview"
	};

	private void SelectTab( OpsTab tab )
	{
		if ( tab != OpsTab.Upgrades )
			_upgradeRackId = Guid.Empty;

		_active = tab;
		LifePunchUiScrollPolicy.ResetOffsets( Panel );
	}

	// Upgrades is a sub-view of Servers — keep the rack icon selected (Staff Menu tab-sel pattern).
	private bool IsSidebarTabActive( OpsTab tab )
		=> _active == tab || ( tab == OpsTab.Racks && _active == OpsTab.Upgrades );

	private void OpenRackUpgrades( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() )
			return;

		_upgradeRackId = rack.GameObject.Id;
		_active = OpsTab.Upgrades;
		LifePunchUiScrollPolicy.ResetOffsets( Panel );
	}

	private void CloseRackUpgrades() => SelectTab( OpsTab.Racks );

	private LpBitcoinRackEntity GetUpgradeRack()
	{
		if ( _upgradeRackId == Guid.Empty )
			return null;

		return GetLinkedRacks().FirstOrDefault( r => r.IsValid() && r.GameObject.Id == _upgradeRackId );
	}

	private long ReceiveSteamId()
	{
		if ( Hub is { Owner: > 0 } )
			return Hub.Owner;

		return LocalSteamId();
	}

	private string ReceiveSteamIdLabel()
	{
		var steamId = ReceiveSteamId();
		return steamId > 0 ? steamId.ToString() : "Unavailable — bind hub owner first";
	}

	private string ReceiveCopyLabel() => _receiveCopyAck ? "Copied!" : "Copy Steam ID";

	private string SendExampleCopyLabel() => _sendExampleCopyAck ? "Copied!" : "Copy example command";

	private void CopyReceiveAddress()
	{
		var steamId = ReceiveSteamId();
		if ( steamId <= 0 )
			return;

		Clipboard.SetText( steamId.ToString() );
		_receiveCopyAck = true;
		_ = ClearReceiveCopyAckAsync();
	}

	private void CopySendExample()
	{
		Clipboard.SetText( "send 76561198012345678 0.05" );
		_sendExampleCopyAck = true;
		_ = ClearSendExampleCopyAckAsync();
	}

	private void CopyRackTerminalId( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() )
			return;

		Clipboard.SetText( RackSlotTerminalToken( rack ) );
		_rackSlotCopyAckId = rack.GameObject.Id;
		_ = ClearRackSlotCopyAckAsync( rack.GameObject.Id );
	}

	private async System.Threading.Tasks.Task ClearRackSlotCopyAckAsync( Guid rackId )
	{
		await GameTask.DelayRealtimeSeconds( 2f );
		if ( _rackSlotCopyAckId == rackId )
			_rackSlotCopyAckId = Guid.Empty;
		StateHasChanged();
	}

	private async System.Threading.Tasks.Task ClearReceiveCopyAckAsync()
	{
		await GameTask.DelayRealtimeSeconds( 2f );
		_receiveCopyAck = false;
		StateHasChanged();
	}

	private async System.Threading.Tasks.Task ClearSendExampleCopyAckAsync()
	{
		await GameTask.DelayRealtimeSeconds( 2f );
		_sendExampleCopyAck = false;
		StateHasChanged();
	}
