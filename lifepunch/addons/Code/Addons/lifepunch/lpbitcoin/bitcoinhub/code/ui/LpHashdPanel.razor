		=> Hub.IsValid() ? Hub.GetLinkedRacks().ToList() : new List<LpBitcoinRackEntity>();

	private float TotalBtc() => GetLinkedRacks().Sum( r => r.BitcoinAmount );

	private float CombinedBtc() => HubWalletBtc() + RackPendingBtc();

	private int CombinedUsd() => (int)(CombinedBtc() * LpBitcoinEconomy.BitcoinValueUsd);

