	private static string TierRoman( int n ) => n switch
	{
		1 => "I",
		2 => "II",
		3 => "III",
		4 => "IV",
		5 => "V",
		_ => n.ToString()
	};

	// Safe tier accessor — tier 2..5 maps to Tiers[0..3]. Guards against hotload-transient null
	// or out-of-range so a partial reload can never crash the render tree (NRE in build tree).
	private static UpgradeTierShell TierAt( UpgradeTrackShell track, int tier )
	{
		var tiers = track.Tiers;
		var idx = tier - 2;
		if ( tiers is null || idx < 0 || idx >= tiers.Length )
			return new UpgradeTierShell( track.TierOneLabel ?? "—", "" );

		return tiers[idx];
	}

	private string TierTooltip( UpgradeTrackShell track, int tier )
	{
		if ( tier == 1 )
			return $"Tier I · {track.TierOneLabel}\nBaseline — included";

		var t = TierAt( track, tier );
		return $"Tier {TierRoman( tier )} · {t.Label}\n{t.Detail}\nPlanned — purchases not yet enabled";
	}

