	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchMenuInputBlock.Apply();
		LifePunchUiScrollPolicy.Apply( Panel );

		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		if ( _sinceTelemetryRefresh < TelemetryRefreshInterval )
		{
			TickHubLogs();
			TickLogTimeLabels();
			return;
		}

		_sinceTelemetryRefresh = 0;
		var previous = _telemetryHash;
		RecomputeTelemetryHash();
		if ( _telemetryHash != previous )
		{
			if ( _active == OpsTab.Logs )
				SyncHubLogs( force: true );
			else
				StateHasChanged();
		}

		TickHubLogs();
		TickLogTimeLabels();
	}

	private void TickHubLogs()
	{
		if ( _active != OpsTab.Logs )
			return;

		SyncHubLogs();
	}

	private void SyncHubLogs( bool force = false )
	{
		if ( _active != OpsTab.Logs )
			return;

		var alerts = GetHubAlerts();
		var count = alerts.Count;

		if ( count == 0 )
		{
			if ( _lastHubLogsRenderCount != 0 )
			{
				_lastHubLogsRenderCount = 0;
				_lastHubAlertsContentHash = 0;
				_hubLogsScrollReady = false;
				_hubLogsBootstrapRetries = 0;
				StateHasChanged();
			}

			return;
		}

		if ( !FindLogsScrollShell().IsValid() )
		{
			if ( _lastHubLogsRenderCount != count )
			{
				_lastHubLogsRenderCount = count;
				StateHasChanged();
			}

			return;
		}

		if ( !EnsureHubLogsScroll() )
			return;

		var contentHash = ComputeHubAlertsContentHash( alerts );
		var list = GetHubLogsNotifList();
		var needsRebuild = force
		                   || contentHash != _lastHubAlertsContentHash
		                   || !list.IsValid()
		                   || PanelChildCount( list ) != count;

		if ( !needsRebuild )
			return;

		_lastHubLogsRenderCount = count;
		_lastHubAlertsContentHash = contentHash;
		RebuildHubLogRows( alerts );
	}

	private Panel FindLogsScrollShell()
	{
		if ( Panel is null || !Panel.IsValid )
			return null;

		foreach ( var panel in Panel.Descendants )
		{
			if ( panel.IsValid() && panel.HasClass( "logs-scroll" ) )
				return panel;
		}

		return null;
	}

	private bool EnsureHubLogsScroll()
	{
		if ( _hubLogsScrollReady && GetHubLogsScroll().IsValid() )
			return true;

		if ( _hubLogsBootstrapRetries >= 12 )
			return GetHubLogsScroll().IsValid();

		LifePunchScrollRegionBootstrap.UpgradeScrollRegionsFromHost( this );
		_hubLogsBootstrapRetries++;

		var scroll = GetHubLogsScroll();
		_hubLogsScrollReady = scroll.IsValid();
		return _hubLogsScrollReady;
	}

	private LifePunchScrollRegionPanel GetHubLogsScroll()
		=> LifePunchScrollRegionBootstrap.FindFirstFromHost( this, "logs-scroll" );

	private Panel GetHubLogsNotifList()
	{
		var scroll = GetHubLogsScroll();
		if ( !scroll.IsValid() )
			return null;

		return scroll.Children.FirstOrDefault( child => child.HasClass( "notif-list" ) );
	}

	private void EnsureHubLogsNotifList()
	{
		if ( GetHubLogsNotifList().IsValid() )
			return;

		var scroll = GetHubLogsScroll();
		if ( !scroll.IsValid() )
			return;

		var list = new Panel();
		list.AddClass( "notif-list" );
		list.Parent = scroll;
	}

	private void RebuildHubLogRows( IReadOnlyList<LpBitcoinHubAlert> alerts )
	{
		EnsureHubLogsNotifList();
		var list = GetHubLogsNotifList();
		if ( !list.IsValid() )
			return;

		foreach ( var child in list.Children.ToList() )
			child.Delete();

		foreach ( var alert in alerts )
			AddHubLogRow( list, alert );
	}

	private void AddHubLogRow( Panel list, LpBitcoinHubAlert alert )
	{
		var row = new Panel();
		row.AddClass( "notif-row" );
		row.Parent = list;

		var icon = new Label
		{
			Text = AlertIcon( alert.Kind ),
			Parent = row
		};
		icon.AddClass( "material-icons" );

		var copy = new Panel();
		copy.AddClass( "notif-copy" );
		copy.Parent = row;

		var kind = new Label
		{
			Text = AlertKindLabel( alert.Kind ),
			Parent = copy
		};
		kind.AddClass( "notif-kind" );

		var message = new Label
		{
			Text = alert.Message,
			Parent = copy
		};
		message.AddClass( "notif-message" );

		var time = new Label
		{
			Text = AlertTimeLabel( alert.Timestamp ),
			Parent = copy
		};
		time.AddClass( "notif-time" );
	}

	private static int ComputeHubAlertsContentHash( IReadOnlyList<LpBitcoinHubAlert> alerts )
	{
		var hash = new HashCode();
		hash.Add( alerts.Count );
		foreach ( var alert in alerts )
		{
			hash.Add( (int)alert.Kind );
			hash.Add( alert.Message );
			hash.Add( alert.Timestamp );
		}

		return hash.ToHashCode();
	}

	private void SyncHubLogTimeLabels( IReadOnlyList<LpBitcoinHubAlert> alerts )
	{
		var list = GetHubLogsNotifList();
		if ( !list.IsValid() || PanelChildCount( list ) != alerts.Count )
			return;

		var rows = list.Children.ToList();
		for ( var i = 0; i < alerts.Count; i++ )
		{
			if ( i >= rows.Count )
				break;

			var row = rows[i];
			if ( !row.IsValid() )
				continue;

			var timeLabel = FindDescendantLabel( row, "notif-time" );
			if ( timeLabel is null )
				continue;

			timeLabel.Text = AlertTimeLabel( alerts[i].Timestamp );
		}
	}

	private static int PanelChildCount( Panel panel )
		=> panel.IsValid() ? panel.Children.Count() : 0;

	private static Label FindDescendantLabel( Panel root, string className )
	{
		foreach ( var child in root.Children )
		{
			if ( !child.IsValid() )
				continue;

			if ( child is Label label && label.HasClass( className ) )
				return label;

			var nested = FindDescendantLabel( child, className );
			if ( nested is not null )
				return nested;
		}

		return null;
	}

	private void TickLogTimeLabels()
	{
		if ( _active != OpsTab.Logs )
			return;

		if ( _sinceLogTimeRefresh < LogTimeRefreshInterval )
			return;

		_sinceLogTimeRefresh = 0;
		var bucket = (int)(Time.Now / LogTimeRefreshInterval);
		if ( bucket == _logTimeBucket )
			return;

		_logTimeBucket = bucket;

		var alerts = GetHubAlerts();
		if ( alerts.Count == 0 )
			return;

		SyncHubLogTimeLabels( alerts );
	}

	private void RecomputeTelemetryHash()
	{
		var hash = new HashCode();
		hash.Add( MiningRackCount() );
		hash.Add( Hub?.IsPowered );
		hash.Add( HasLinkedTerminal() );
		hash.Add( HasNearbyUnlinkedTerminal() );
		hash.Add( Hub?.UnreadAlertCount ?? 0 );
		hash.Add( (int)(HubWalletBtc() * 10000f) );

		var alerts = GetHubAlerts();
		hash.Add( alerts.Count );
		for ( var i = 0; i < alerts.Count && i < 12; i++ )
		{
			hash.Add( alerts[i].Kind );
			hash.Add( alerts[i].Message );
		}

		foreach ( var rack in GetLinkedRacks() )
		{
			hash.Add( rack.GameObject.Id );
			hash.Add( rack.AdvancedRack );
			hash.Add( rack.IsMining );
			hash.Add( rack.CpuUpgradeLevel );
			hash.Add( rack.CoreUpgradeLevel );
		}

		if ( Hub.IsValid() )
		{
			hash.Add( HasAnyPlayerRacksNearbyOrLinked() );
		}

		_telemetryHash = hash.ToHashCode();
	}

	protected override int BuildHash()
	{
		// _telemetryHash includes wallet (4dp) + rack structure — no per-frame display tick.
		// Do not hash TextEntry bind values (_cashOutAmount).
		var hash = new HashCode();
		hash.Add( _active );
		hash.Add( _upgradeRackId );
		hash.Add( (int)_upgradeSurface );
		hash.Add( (int)_upgradeRackSlot );
		hash.Add( _inUpgradeSurface );
		hash.Add( _rackTargetSelected );
		hash.Add( _openPath ?? string.Empty );
		hash.Add( _receiveCopyAck );
		hash.Add( _sendExampleCopyAck );
		hash.Add( _rackSlotCopyAckId );
		hash.Add( _overviewSlotCopyAck );
		hash.Add( _pinUnlocked );
		hash.Add( _pinBuffer );
		hash.Add( _pinSetupPass );
		hash.Add( _pinError );
		hash.Add( (int)_pinGatePurpose );
		hash.Add( _pinChangePass );
		hash.Add( _pinChangeNotice );
		hash.Add( _hub?.IsPowered );
		hash.Add( _hub?.AccessPinIsSet );
		hash.Add( _perfRange );
		hash.Add( _profitRange );
		hash.Add( LinkedRackCount() );
		hash.Add( _telemetryHash );
		hash.Add( Hub?.Owner ?? 0 );
		hash.Add( _cashOutAmount );
		hash.Add( (int)_partialCashOutFeedback );
		hash.Add( _partialCashOutFeedbackText );
		hash.Add( (int)_allCashOutFeedback );
		hash.Add( _allCashOutFeedbackText );
		hash.Add( LpBitcoinEconomy.PortalBaseCashUsdPerBtc );
		hash.Add( LpBitcoinEconomy.CashUsdPerBtc );
		hash.Add( LpBitcoinEconomy.PortalEconomyRevision );
		return hash.ToHashCode();
	}
