@* ─────────────────────────────────────────────────────────────────────────────
   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Bitcoin Miner for DXRP" (s&box ident: lifepunch.bitcoin · addon ident: bitcoinmining)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()">
	<div class="shell">
		<div class="shell-body">
		@if ( ShowPinGate() )
		{
			<div class="pin-gate">
				<header class="pin-header">
					<div class="pin-brand">
						<div class="brand-mark"></div>
						<div class="pin-brand-copy">
							<div class="pin-title">@PinGateTitle()</div>
							<div class="pin-sub">@PinGateSubtitle()</div>
						</div>
					</div>
					@if ( PinChangeGateMode() )
					{
						<button class="lp-ui-chrome-btn close" tooltip="Cancel" onclick="@CancelPinChangeGate">
							<i class="material-icons">close</i>
						</button>
					}
					else
					{
						<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
							<i class="material-icons">close</i>
						</button>
					}
				</header>

				<div class="pin-body">
					<div class="pin-entry">
						<div class="pin-label">@PinEntryLabel()</div>
						<div class="pin-dots">
							@for ( var i = 0; i < PinTargetLength(); i++ )
							{
								<span class="pin-dot @(i < _pinBuffer.Length ? "filled" : "")"></span>
							}
						</div>
					</div>
					@if ( !string.IsNullOrWhiteSpace( _pinError ) )
					{
						<div class="pin-error">@_pinError</div>
					}

					<div class="pin-pad">
						@foreach ( var key in _pinKeys )
						{
							<button class="pin-key @(key == "ok" ? "ok" : "") @(key == "clr" ? "clr" : "")"
							        onclick="@(() => PressPinKey(key))">
								@if ( key == "clr" )
								{
									<i class="material-icons">backspace</i>
								}
								else if ( key == "ok" )
								{
									<i class="material-icons">check</i>
								}
								else
								{
									<span>@key</span>
								}
							</button>
						}
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="hub-body">
				<div class="hub-main">
					<aside class="sidebar">
						<div class="sidebar-brand hex-mark" title="@LpBitcoinIdent.OpsTitle">
							<div class="brand-mark"></div>
						</div>

						<nav class="sidebar-nav">
							@foreach ( var tab in _tabs )
							{
								<button class="sidebar-btn @(IsSidebarTabActive( tab ) ? "sidebar-btn-sel" : "")"
								        tooltip="@TabLabel(tab)"
								        onclick="@(() => SelectTab(tab))">
									<i class="material-icons">@TabIcon(tab)</i>
								</button>
							}
						</nav>

						<div class="sidebar-foot">
							<div class="sidebar-avatar" title="@GreetingName()">
								@if ( LocalSteamId() > 0 )
								{
									<img class="sidebar-avatar-img" src="avatar:@LocalSteamId()"/>
								}
								else
								{
									<span class="sidebar-avatar-fallback">@AvatarInitial()</span>
								}
							</div>
						</div>
					</aside>

					<div class="workspace">
						<header class="page-header hub-header">
							<div class="lp-ui-panel-title hub-title">
								<i class="material-icons">memory</i>
								<span>@LpBitcoinIdent.OpsTitle</span>
							</div>

							<div class="header-widgets">
								<button class="header-power-switch @(Hub?.IsPowered == true ? "on" : "off")"
								        tooltip="@(Hub?.IsPowered == true ? "Power off hub" : "Power on hub")"
								        onclick="@ToggleHubPower">
									<span class="power-switch-track">
										<span class="power-switch-knob"></span>
									</span>
									<span class="power-switch-label">@(Hub?.IsPowered == true ? "POWER ON" : "POWER OFF")</span>
								</button>
								<button class="header-chip wallet-chip" onclick="@SelectWalletTab">
									<i class="material-icons">account_balance_wallet</i>
									<span>@HeaderWalletBtc() BTC</span>
								</button>
								<div class="header-chip date-chip">
									<i class="material-icons">calendar_today</i>
									<span>@HeaderDateLabel()</span>
								</div>
								<button class="header-chip notif-chip @(HasUnreadAlerts() ? "has-unread" : "")"
								        tooltip="Hub logs"
								        onclick="@SelectLogsTab">
									<i class="material-icons">notifications</i>
									@if ( HasUnreadAlerts() )
									{
										<span class="notif-dot"></span>
									}
								</button>
								<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
									<i class="material-icons">close</i>
								</button>
							</div>
						</header>

						<div class="workspace-body">
							<div class="main-panel">
								@if ( _active == OpsTab.Overview )
								{
									<div class="pane overview">
										<div class="lp-ui-panel-title overview-dash-title">
											<i class="material-icons">home</i>
											<span>Dashboard</span>
										</div>
										<div class="overview-intro-header">
											<div class="overview-intro-terminal-row">
												<div class="overview-intro-terminal-meta">
													<div class="overview-intro-terminal-heading">Bitcoin terminal</div>
													<div class="overview-intro-terminal-status">
														<span class="lp-ui-status-dot @OverviewTerminalStatusDotClass()"></span>
														<span class="overview-intro-terminal-label">@TerminalLinkStatusLabel()</span>
													</div>
												</div>
												<div class="overview-intro-terminal-actions">
												@if ( HasLinkedTerminal() )
												{
													<button class="lp-ui-btn-ghost overview-intro-unlink-btn" onclick="@UnlinkTerminal">Unlink terminal</button>
												}
												else if ( HasNearbyUnlinkedTerminal() )
												{
													<button class="lp-ui-btn-ghost" disabled="@(!HubIsPowered())" onclick="@LinkNearbyTerminal">Link terminal</button>
												}
												else
												{
													<button class="lp-ui-btn-ghost overview-intro-terminal-disabled" disabled>No terminal in range</button>
												}
												</div>
											</div>
										</div>

										<div class="lp-ui-split">
											<div class="lp-ui-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">dns</i>
													<span>Active miners</span>
												</div>

												<div class="overview-miners-scroll">
													@foreach ( var slot in GetServersRackSlots() )
													{
														<div class="overview-miner-card @( slot.Rack.IsValid() ? "" : "empty" )">
															<div class="overview-miner-head">
																<div class="overview-miner-title">@slot.DisplayLabel</div>
																@if ( slot.Rack.IsValid() )
																{
																	<div class="overview-miner-status @( slot.Rack.IsMining ? "on" : "off" )">
																		<span class="lp-ui-status-dot @(slot.Rack.IsMining ? "on" : "off")"></span>
																		<span>@(slot.Rack.IsMining ? "Mining" : "Idle")</span>
																	</div>
																}
																else
																{
																	<div class="overview-miner-status off">
																		<span class="lp-ui-status-dot off"></span>
																		<span>@( HasAnyPlayerRacksNearbyOrLinked() ? "Not linked" : "Available" )</span>
																	</div>
																}
															</div>
																@if ( slot.Rack.IsValid() )
																{
																	<div class="overview-miner-stats">@RackOverviewSubline( slot.Rack )</div>
																}
																else if ( !HasAnyPlayerRacksNearbyOrLinked() )
																{
																	<div class="overview-miner-stats empty market-hint">Purchase racks from the Market.</div>
																}
																else
																{
																	<div class="overview-miner-stats empty">Place rack near hub, then link at rig0 — <span class="hashd-prompt-accent">link @slot.TerminalToken</span></div>
																}
															<button class="rack-slot-id-copy overview-miner-copy"
															        onclick="@(() => CopyOverviewMinerToken( slot ))">
																<span class="rack-slot-id-token">@slot.TerminalToken</span>
																<i class="material-icons">content_copy</i>
																<span class="rack-slot-id-hint">@OverviewMinerCopyHint( slot )</span>
															</button>
														</div>
													}
												</div>
											</div>

											<div class="lp-ui-panel overview-status-panel">
												<div class="lp-ui-panel-title">
													<i class="material-icons">analytics</i>
													<span>Hub status</span>
												</div>

												<div class="overview-status-stack">
													<div class="overview-status-body">
														<div class="lp-ui-info overview-status-info">
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Total mined</span>
																<span class="lp-ui-info-value">@CombinedBtc().ToString("F6") BTC</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">USD value</span>
																<span class="lp-ui-info-value">$@CombinedUsd().ToString("N2")</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Hash rate</span>
																<span class="lp-ui-info-value">@HashRateLabel()</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Hub power</span>
																<span class="lp-ui-info-value">
																	<span class="lp-ui-status-dot @(Hub?.IsPowered == true ? "on" : "off")"></span>
																	<span>@HubPowerStatusLabel()</span>
																</span>
															</div>
															<div class="lp-ui-info-row">
																<span class="lp-ui-info-label">Load / draw</span>
																<span class="lp-ui-info-value">@LoadDrawLabel()</span>
															</div>
														</div>

														<div class="overview-status-perks">
															<div class="overview-status-perk">@LinkedRackCount() linked rack@(LinkedRackCount() == 1 ? "" : "s")</div>
															<div class="overview-status-perk">@MiningRackCount() mining now</div>
															<div class="overview-status-perk">Hub wallet @HubWalletBtc().ToString("F4") BTC</div>
															<div class="overview-status-perk">@RackPendingBtc().ToString("F4") BTC pending on racks</div>
														</div>
													</div>

													<div class="overview-status-footer">
														<div class="lp-ui-btn-row overview-status-actions">
															<button class="lp-ui-btn-primary overview-status-action" onclick="@SelectRacksTab">
																<i class="material-icons">dns</i>
																<span>Manage racks</span>
															</button>
															<button class="lp-ui-btn-ghost overview-status-action" onclick="@SelectWalletTab">
																<i class="material-icons">account_balance_wallet</i>
																<span>Wallet</span>
															</button>
															<button class="lp-ui-btn-ghost overview-status-action" onclick="@SelectTransfersTab">
																<i class="material-icons">swap_horiz</i>
																<span>Transfers</span>
															</button>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Racks )
								{
									<div class="pane racks">
										<div class="lp-ui-panel racks-panel">
											<div class="lp-ui-panel-title">
												<i class="material-icons">dns</i>
												<span>Servers</span>
											</div>

											<div class="lp-ui-intro racks-intro">@RacksIntroCopyLine()</div>

											<div class="racks-scroll">
												<div class="rack-grid">
													@foreach ( var slot in GetServersRackSlots() )
													{
														<div class="rack-card @( slot.Rack.IsValid() ? "" : "empty" )">
															<div class="rack-card-head">
																<div class="rack-card-head-main">
																	<div class="rack-card-title">@slot.DisplayLabel</div>
																</div>
																<div class="rack-card-badges">
																	<button class="rack-slot-id-copy"
																	        onclick="@(() => CopyOverviewMinerToken( slot ))">
																		<span class="rack-slot-id-token">@slot.TerminalToken</span>
																		<i class="material-icons">content_copy</i>
																		<span class="rack-slot-id-hint">@OverviewMinerCopyHint( slot )</span>
																	</button>
																	@if ( slot.Rack.IsValid() )
																	{
																		<span class="rack-badge @(slot.Rack.IsMining ? "on" : "")">@(slot.Rack.IsMining ? "Mining" : "Idle")</span>
																		<span class="rack-badge dim">@RackYieldLabel( slot.Rack )</span>
																	}
																	else
																	{
																		<span class="rack-badge">@( HasAnyPlayerRacksNearbyOrLinked() ? "Not linked" : "Available" )</span>
																	}
																</div>
															</div>
															<div class="rack-card-body">
																@if ( slot.Rack.IsValid() )
																{
																	<div class="rack-stat-tiles">
																		<div class="rack-stat-tile">
																			<div class="rack-stat-tile-label">Balance</div>
																			<div class="rack-stat-tile-value accent">@RackBtcTileValue( slot.Rack )</div>
																			<div class="rack-stat-tile-sub">@RackBtcTileSubline( slot.Rack )</div>
																		</div>
																		<div class="rack-stat-tile">
																			<div class="rack-stat-tile-label">Hardware</div>
																			<div class="rack-stat-tile-value">@RackHardwareTileValue( slot.Rack )</div>
																			<div class="rack-stat-tile-sub">@RackHardwareTileSubline( slot.Rack )</div>
																		</div>
																		<div class="rack-stat-tile">
																			<div class="rack-stat-tile-label">@( slot.Rack.IsMining ? "Mining" : "Status" )</div>
																			<div class="rack-stat-tile-value @( slot.Rack.IsMining ? "on" : "" )">@( slot.Rack.IsMining ? "Active" : "Idle" )</div>
																			<div class="rack-stat-tile-sub">@RackMiningTileSubline( slot.Rack )</div>
																		</div>
																	</div>
																}
																else if ( !HasAnyPlayerRacksNearbyOrLinked() )
																{
																	<div class="rack-stat-tiles empty">
																		<div class="rack-stat-tile rack-stat-tile-wide">
																			<div class="rack-stat-tile-value empty market-hint">Purchase racks from the Market.</div>
																		</div>
																	</div>
																}
																else
																{
																	<div class="rack-stat-tiles empty">
																		<div class="rack-stat-tile rack-stat-tile-wide">
																			<div class="rack-stat-tile-value empty">Place rack near hub, then link at rig0 on the terminal — <span class="hashd-prompt-accent">link @slot.TerminalToken</span></div>
																		</div>
																	</div>
																}
															</div>
															@if ( slot.Rack.IsValid() )
															{
																<div class="rack-card-actions">
																	<button class="lp-ui-btn-primary rack-upgrade-btn"
																	        onclick="@(() => OpenRackUpgrades( slot.Rack ))">
																		Upgrade
																	</button>
																</div>
															}
														</div>
													}
												</div>
											</div>
										</div>
									</div>
								}
								else if ( _active == OpsTab.Upgrades )
								{
									var upgradeRack = GetUpgradeRack();
									<div class="pane upgrades">
										@if ( upgradeRack.IsValid() )
										{
											<div class="lp-ui-panel upgrades-panel">
												<div class="upgrades-toolbar">
													<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@CloseRackUpgrades">
														<i class="material-icons">arrow_back</i>
														<span>Servers</span>
													</button>
													<div class="lp-ui-panel-title upgrades-title">
														<i class="material-icons">upgrade</i>
														<span>@($"{RackSlotDisplayLabel( upgradeRack )} upgrades")</span>
													</div>
												</div>

												<div class="lp-ui-intro upgrades-intro">
													<strong>@RackSlotDisplayLabel( upgradeRack )</strong> · @RackYieldLabel( upgradeRack ) · @RackHardwareLine( upgradeRack ) — Purchases debit your in-game cash. Mining start/stop stays on the CRT. rig0 slot: <strong>@RackSlotTerminalToken( upgradeRack )</strong>
												</div>

												<div class="lp-ui-scroll-region upgrades-scroll">
													<div class="upgrade-tracks">
														<div class="upgrade-track lp-hashd-surface">
															<div class="upgrade-track-head">
																<i class="material-icons">memory</i>
																<span>CPU clock path</span>
															</div>
															@if ( IsCpuPathMaxed( upgradeRack ) )
															{
																<div class="upgrade-tier-row maxed">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">All tiers owned</div>
																		<div class="upgrade-tier-detail">@($"{upgradeRack.ClockGhz:F2} GHz clock")</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<span class="upgrade-tier-badge">Maxed</span>
																	</div>
																</div>
															}
															else
															{
																var cpuTier = upgradeRack.CpuUpgradeLevel;
																<div class="upgrade-tier-row next">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">@CpuTierLabel( cpuTier )</div>
																		<div class="upgrade-tier-detail">@CpuTierDetail( cpuTier )</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<button class="lp-ui-btn-primary upgrade-tier-buy" onclick="@(() => UpgradeCpu( upgradeRack ))">Buy $@LpBitcoinEconomy.CpuUpgradeCosts[cpuTier].ToString("N0")</button>
																	</div>
																</div>
															}
														</div>

														<div class="upgrade-track lp-hashd-surface">
															<div class="upgrade-track-head">
																<i class="material-icons">developer_board</i>
																<span>Core count path</span>
															</div>
															@if ( IsCorePathMaxed( upgradeRack ) )
															{
																<div class="upgrade-tier-row maxed">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">All tiers owned</div>
																		<div class="upgrade-tier-detail">@($"{upgradeRack.CoreCount} cores")</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<span class="upgrade-tier-badge">Maxed</span>
																	</div>
																</div>
															}
															else
															{
																var coreTier = upgradeRack.CoreUpgradeLevel;
																<div class="upgrade-tier-row next">
																	<div class="upgrade-tier-main">
																		<div class="upgrade-tier-label">@CoreTierLabel( coreTier )</div>
																		<div class="upgrade-tier-detail">@CoreTierDetail( coreTier )</div>
																	</div>
																	<div class="upgrade-tier-side">
																		<button class="lp-ui-btn-primary upgrade-tier-buy" onclick="@(() => UpgradeCores( upgradeRack ))">Buy $@LpBitcoinEconomy.CoreUpgradeCosts[coreTier].ToString("N0")</button>
																	</div>
																</div>
															}
														</div>
													</div>
												</div>
											</div>
										}
										else
										{
											<div class="lp-ui-panel upgrades-home">
												<div class="lp-ui-panel-title upgrades-home-title">
													<i class="material-icons">upgrade</i>
													<span>Universal Upgrades</span>
												</div>

												@if ( !_inUpgradeSurface )
												{
													<div class="lp-ui-intro upgrades-home-intro">
														Choose what to upgrade. Each surface opens its own upgrade paths.
													</div>

													<div class="upgrade-home-grid">
														<button class="upgrade-home-box" onclick="@(() => EnterUpgradeSurface( UpgradeSurface.Hub ))">
															<i class="material-icons upgrade-home-box-icon">dns</i>
															<div class="upgrade-home-box-body">
																<span class="upgrade-home-box-title">HUB</span>
																<span class="upgrade-home-box-sub">Controller &amp; Farm Operations</span>
																<span class="upgrade-home-box-desc">Scheduler, share flow, pool client, firmware, and trust policy.</span>
															</div>
															<div class="upgrade-home-box-foot">
																<span class="upgrade-home-box-meta">5 tracks · PLANNED</span>
																<i class="material-icons upgrade-home-box-chevron">chevron_right</i>
															</div>
														</button>
														<button class="upgrade-home-box" onclick="@(() => EnterUpgradeSurface( UpgradeSurface.Terminal ))">
															<i class="material-icons upgrade-home-box-icon">security</i>
															<div class="upgrade-home-box-body">
																<span class="upgrade-home-box-title">TERMINAL</span>
																<span class="upgrade-home-box-sub">Defense &amp; Monitoring</span>
																<span class="upgrade-home-box-desc">Firewall, command security, intrusion detection, audit logs, and monitoring.</span>
															</div>
															<div class="upgrade-home-box-foot">
																<span class="upgrade-home-box-meta">5 tracks · PLANNED</span>
																<i class="material-icons upgrade-home-box-chevron">chevron_right</i>
															</div>
														</button>
														<button class="upgrade-home-box" onclick="@(() => EnterUpgradeSurface( UpgradeSurface.GpuRack ))">
															<i class="material-icons upgrade-home-box-icon">memory</i>
															<div class="upgrade-home-box-body">
																<span class="upgrade-home-box-title">GPU RACK</span>
																<span class="upgrade-home-box-sub">Hardware &amp; Output</span>
																<span class="upgrade-home-box-desc">Choose a rack, then upgrade its hardware profile.</span>
															</div>
															<div class="upgrade-home-box-foot">
																<span class="upgrade-home-box-meta">3 racks · 5 tracks · PLANNED</span>
																<i class="material-icons upgrade-home-box-chevron">chevron_right</i>
															</div>
														</button>
													</div>
												}
												else if ( _upgradeSurface == UpgradeSurface.GpuRack && !_rackTargetSelected )
												{
