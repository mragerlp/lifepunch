	private static readonly UpgradeTrackShell TerminalSkinCosmetic =
		new( "HASHD donor skins", "brush", "Stock bezel", CosmeticTiers( "Carbon Bezel", "Amber Glass", "Neon Edge", "Custom Wrap" ) );

	private static readonly UpgradeTrackShell[] GpuRackUpgradeTracks =
	{
		new( "Compute Profile", "speed", "Stock Clocks", HwTiers( "Mild OC", "Tuned Clocks", "Aggressive OC", "Curve Optimizer" ) ),
		new( "Cooling System", "ac_unit", "Open-Air Cooling", HwTiers( "Fan Wall", "Liquid Loop", "Sub-Ambient", "Immersion Bath" ) ),
