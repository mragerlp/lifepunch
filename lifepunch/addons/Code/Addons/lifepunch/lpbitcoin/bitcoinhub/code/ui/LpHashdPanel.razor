							</div>
						</div>
					</div>
				</div>
			</div>
		}

		</div>

		<div class="lp-window-watermark lp-window-watermark--rounded">
			<LifePunchUiFooter />
		</div>
	</div>
</root>

@code
{
	private enum OpsTab { Overview, Wallet, Transfers, Racks, Upgrades, Logs, Settings }
	private enum PerfRange { Day, Week, Month }
	private enum PinGatePurpose { Unlock, ChangePin }
	private enum UpgradeSurface { Hub, Terminal, GpuRack }
	private enum UpgradeRackSelector { Rack1, Rack2, Advanced }

	// UI-only shell descriptor (DECISION-0010). No economy/persistence yet — display copy + preview
	// progression state only. Tiers carries II..V (index 0 = Tier II). Tier I = TierOneLabel baseline.
	private readonly record struct UpgradeTierShell( string Label, string Detail );
	private readonly record struct UpgradeTrackShell( string Name, string Icon, string TierOneLabel, UpgradeTierShell[] Tiers );

	// Static UI shell — Tier II–V rung names + a plain-language description (G1). No prices:
	// purchases are not yet enabled (DECISION-0010 — economy/cost curves staged, on HOLD).
	private static UpgradeTierShell[] HwTiers( string two, string three, string four, string five ) => new[]
	{
		new UpgradeTierShell( two, "Early efficiency gain over the baseline." ),
		new UpgradeTierShell( three, "Meaningful throughput and reliability step." ),
		new UpgradeTierShell( four, "High-end capability for serious operators." ),
		new UpgradeTierShell( five, "Best-in-class capstone — the top of this track." )
	};

	private static UpgradeTierShell[] CosmeticTiers( string two, string three, string four, string five ) => new[]
	{
		new UpgradeTierShell( two, "Cosmetic only — no performance change." ),
		new UpgradeTierShell( three, "Cosmetic only — no performance change." ),
		new UpgradeTierShell( four, "Cosmetic only — no performance change." ),
		new UpgradeTierShell( five, "Cosmetic only — no performance change." )
	};

	private static readonly UpgradeTrackShell[] HubUpgradeTracks =
	{
		new( "Job Scheduler", "schedule", "Basic Queue", HwTiers( "Priority Queue", "Batch Dispatch", "Predictive Scheduler", "Autonomous Orchestrator" ) ),
		new( "Share Pipeline", "call_split", "Single Handler", HwTiers( "Dual Handler", "Parallel Lanes", "Stream Aggregator", "Zero-Loss Pipeline" ) ),
		new( "Pool Client", "lan", "Basic Stratum Client", HwTiers( "Stratum v2", "Failover Pool", "Multi-Pool Router", "Smart Pool Mesh" ) ),
		new( "Farm Firmware", "settings_applications", "Manual Control", HwTiers( "Assisted Control", "Scheduled Tuning", "Adaptive Firmware", "Autonomous Farm OS" ) ),
		new( "Trust Policy", "verified_user", "Local Trust", HwTiers( "Signed Peers", "Verified Network", "Zero-Trust Gates", "Hardened Enclave" ) )
	};

	private static readonly UpgradeTrackShell HubSoundPackCosmetic =
		new( "Sound Pack", "volume_up", "Stock ambient loop", CosmeticTiers( "Server Room", "Cyber Hum", "Retro Arcade", "Custom Upload" ) );

	private static readonly UpgradeTrackShell[] TerminalUpgradeTracks =
	{
		new( "Endpoint Firewall", "shield", "Open Rules", HwTiers( "Basic Ruleset", "Stateful Firewall", "Deep Packet Filter", "Adaptive Defense Grid" ) ),
		new( "Command Authentication", "key", "PIN Session", HwTiers( "Timed Sessions", "Two-Factor", "Biometric Token", "Hardware Key Vault" ) ),
		new( "Intrusion Detection", "radar", "Manual Review", HwTiers( "Log Alerts", "Signature IDS", "Behavioral IDS", "Autonomous Response" ) ),
		new( "Audit Retention", "history", "Volatile Logs", HwTiers( "Local Archive", "Encrypted Logs", "Off-site Backup", "Immutable Ledger" ) ),
		new( "Monitoring Suite", "monitor_heart", "Basic Status", HwTiers( "Live Metrics", "Alert Routing", "Health Forecast", "Ops Command Deck" ) )
