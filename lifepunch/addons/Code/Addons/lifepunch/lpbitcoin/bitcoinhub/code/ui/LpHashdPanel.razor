	private float TotalMiningRate()
	{
		if ( Hub?.IsPowered != true )
			return 0f;

		return GetLinkedRacks()
			.Where( r => r.IsMining )
			.Sum( r => r.MiningRatePerMinute );
	}

	private int MiningLoadPercent()
	{
		var total = LinkedRackCount();
		if ( total == 0 )
			return 0;

		return (int)Math.Round( 100f * MiningRackCount() / total );
	}

	private bool CanUpgradeCpu( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CpuUpgradeLevel < LpBitcoinEconomy.CpuUpgradeCosts.Length;

	private bool CanUpgradeCores( LpBitcoinRackEntity rack )
		=> rack.IsValid() && rack.CoreUpgradeLevel < LpBitcoinEconomy.CoreUpgradeCosts.Length;

	private string UpgradeCpuCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCpu( rack ) ? $"{LpBitcoinEconomy.CpuUpgradeCosts[rack.CpuUpgradeLevel]:N0}" : "MAX";

	private string UpgradeCoreCost( LpBitcoinRackEntity rack )
		=> CanUpgradeCores( rack ) ? $"{LpBitcoinEconomy.CoreUpgradeCosts[rack.CoreUpgradeLevel]:N0}" : "MAX";

	private void UpgradeCpu( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCpu( rack ) )
			return;

		_hub?.RequestUpgradeCpu( rack.GameObject.Id );
	}

	private void UpgradeCores( LpBitcoinRackEntity rack )
	{
		if ( !CanUpgradeCores( rack ) )
			return;

		_hub?.RequestUpgradeCores( rack.GameObject.Id );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchMenuInputBlock.Apply();
		LifePunchUiScrollPolicy.Apply( Panel );

		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		if ( _sinceTelemetryRefresh < TelemetryRefreshInterval )
		{
			TickLogTimeLabels();
			return;
		}

		_sinceTelemetryRefresh = 0;
		var previous = _telemetryHash;
		RecomputeTelemetryHash();
		if ( _telemetryHash != previous && _active == OpsTab.Logs )
			StateHasChanged();

		TickLogTimeLabels();
	}

	private void TickLogTimeLabels()
	{
		if ( _active != OpsTab.Logs )
			return;

		if ( _sinceLogTimeRefresh < LogTimeRefreshInterval )
			return;

		_sinceLogTimeRefresh = 0;
		var bucket = (int)(Time.Now / LogTimeRefreshInterval);
		if ( bucket == _logTimeBucket )
			return;

		_logTimeBucket = bucket;
		StateHasChanged();
	}

	private void RecomputeTelemetryHash()
	{
		var hash = new HashCode();
		hash.Add( MiningRackCount() );
		hash.Add( Hub?.IsPowered );
		hash.Add( HasLinkedTerminal() );
		hash.Add( HasNearbyUnlinkedTerminal() );
		hash.Add( Hub?.UnreadAlertCount ?? 0 );
		hash.Add( (int)(HubWalletBtc() * 10000f) );

		var alerts = GetHubAlerts();
		hash.Add( alerts.Count );
		for ( var i = 0; i < alerts.Count && i < 12; i++ )
		{
			hash.Add( alerts[i].Kind );
			hash.Add( alerts[i].Message );
		}

		foreach ( var rack in GetLinkedRacks() )
		{
			hash.Add( rack.GameObject.Id );
			hash.Add( rack.IsMining );
			hash.Add( rack.CpuUpgradeLevel );
			hash.Add( rack.CoreUpgradeLevel );
		}

		_telemetryHash = hash.ToHashCode();
	}

	protected override int BuildHash()
	{
		// _telemetryHash includes wallet (4dp) + rack structure — no per-frame display tick.
		// Do not hash TextEntry bind values (_cashOutAmount).
		var hash = new HashCode();
		hash.Add( _active );
		hash.Add( _upgradeRackId );
		hash.Add( _receiveCopyAck );
		hash.Add( _sendExampleCopyAck );
		hash.Add( _rackSlotCopyAckId );
		hash.Add( _pinUnlocked );
		hash.Add( _pinBuffer );
		hash.Add( _pinSetupPass );
		hash.Add( _pinError );
		hash.Add( (int)_pinGatePurpose );
		hash.Add( _pinChangePass );
		hash.Add( _pinChangeNotice );
		hash.Add( _logTimeBucket );
		hash.Add( _active == OpsTab.Logs );
		hash.Add( _hub?.IsPowered );
		hash.Add( _hub?.AccessPinIsSet );
		hash.Add( _perfRange );
		hash.Add( _profitRange );
		hash.Add( LinkedRackCount() );
		hash.Add( _telemetryHash );
		hash.Add( Hub?.Owner ?? 0 );
		hash.Add( _cashOutSuccessActive );
		hash.Add( _cashOutSuccessVisible );
		hash.Add( _cashOutSuccessMessage );
		hash.Add( _cashOutErrorActive );
		hash.Add( _cashOutErrorVisible );
		hash.Add( _cashOutErrorMessage );
		hash.Add( _uiScale );
		return hash.ToHashCode();
	}
