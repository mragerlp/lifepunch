	private void PressPinKey( string key )
	{
		if ( Hub is null )
			return;

		if ( key == "clr" )
		{
			_pinBuffer = "";
			_pinError = "";

			if ( PinChangeGateMode() )
			{
				if ( _pinChangePass >= 2 )
				{
					_pinChangePass = 1;
					_pinChangeNewDraft = "";
				}
				else if ( _pinChangePass == 1 )
				{
					_pinChangePass = 0;
					_pinChangeCurrent = "";
				}

				return;
			}

			if ( PinSetupMode() && _pinSetupPass == 1 )
			{
				_pinSetupPass = 0;
				_pinConfirmDraft = "";
			}

			return;
		}

		if ( key == "ok" )
		{
			if ( _pinBuffer.Length < LpBitcoinHubPin.MinDigits )
				return;

			if ( PinChangeGateMode() )
			{
				if ( _pinChangePass == 0 )
				{
					if ( !LpBitcoinHubPin.Matches( _pinBuffer, Hub.AccessPinHash ) )
					{
						_pinBuffer = "";
						_pinError = "Current PIN incorrect.";
						return;
					}

					_pinChangeCurrent = _pinBuffer;
					_pinBuffer = "";
					_pinChangePass = 1;
					_pinError = "";
					return;
				}

				if ( _pinChangePass == 1 )
				{
					_pinChangeNewDraft = _pinBuffer;
					_pinBuffer = "";
					_pinChangePass = 2;
					_pinError = "";
					return;
				}

				Hub.RequestChangeAccessPin( _pinChangeCurrent, _pinChangeNewDraft, _pinBuffer );
				return;
			}

			if ( PinSetupMode() )
			{
				if ( _pinSetupPass == 0 )
				{
					_pinConfirmDraft = _pinBuffer;
					_pinBuffer = "";
					_pinSetupPass = 1;
					_pinError = "";
					return;
				}

				Hub.RequestSetAccessPin( _pinConfirmDraft, _pinBuffer );
				return;
			}

			Hub.RequestUnlockAccessPin( _pinBuffer );
			return;
		}

		if ( _pinBuffer.Length >= LpBitcoinHubPin.MaxDigits )
			return;

		_pinBuffer += key;
	}

	public void OnPinGateResult( bool success, string message )
	{
		if ( success )
		{
			_pinUnlocked = true;
			_pinGatePurpose = PinGatePurpose.Unlock;
			_pinBuffer = "";
			_pinConfirmDraft = "";
			_pinError = "";
			_pinSetupPass = 0;
			return;
		}

		_pinBuffer = "";
		_pinError = string.IsNullOrWhiteSpace( message ) ? "Access denied." : message;
		if ( PinSetupMode() )
		{
			_pinSetupPass = 0;
			_pinConfirmDraft = "";
		}
	}

	private void StartPinChange()
	{
		if ( Hub?.AccessPinIsSet != true )
			return;

		_returnTabAfterPinGate = OpsTab.Settings;
		_pinGatePurpose = PinGatePurpose.ChangePin;
		_pinUnlocked = false;
		_pinBuffer = "";
		_pinChangeCurrent = "";
		_pinChangeNewDraft = "";
		_pinChangePass = 0;
		_pinError = "";
		_pinChangeNotice = "";
	}

	private void CancelPinChangeGate()
	{
		_pinUnlocked = true;
		_pinGatePurpose = PinGatePurpose.Unlock;
		_pinBuffer = "";
		_pinChangeCurrent = "";
		_pinChangeNewDraft = "";
		_pinChangePass = 0;
		_pinError = "";
		_active = _returnTabAfterPinGate;
	}

	private void ResetPinChangeState( bool keepNotice )
