
// LifePunch gpu-rack ΓÇö GPU slot (graphics cards + 6 card fans). RGB fan LEDs via custom shader.

Layer0
{
	shader "addons/lifepunch/bitcoinmining/shaders/lifepunch_rgb_fan_led.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1
	F_SELF_ILLUM 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"
	TextureAmbientOcclusion "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_AO.png"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_BaseColor.png"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_Metallic.png"

	TextureNormal "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_Normal_GL.png"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_Roughness.png"

	g_flSelfIllumScale "1.000"
	g_vSelfIllumTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureSelfIllumMask "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/gpu/GPU_Emission.png"

	g_flLedActive "0.000"
	g_flIdleGlow "0.040"
	g_flRgbCycleSpeed "0.220"
	g_flRgbIntensity "3.500"

	g_vTexCoordOffset "[0.000 0.000]"
	g_vTexCoordScale "[1.000 1.000]"
	g_vTexCoordScrollSpeed "[0.000 0.000]"
}
