// LifePunch gpu-rack — Cord slot (Wires_Cord). Edit in Material Editor; recompile after texture changes.

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"
	TextureAmbientOcclusion "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/cord/Wires_AO.png"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/cord/Wires_Cord_BaseColor.png"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/cord/Wires_Cord_Metallic.png"

	TextureNormal "materials/default/default_normal.tga"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/bitcoinmining/models/lifepunch/bitcoinmining/gpu-rack/textures/cord/Wires_Cord_Roughness.png"

	g_vTexCoordOffset "[0.000 0.000]"
	g_vTexCoordScale "[1.000 1.000]"
	g_vTexCoordScrollSpeed "[0.000 0.000]"
}
