{
  "mcpServers": {
    "sbox": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "sbox-mcp-server"
      ],
      "env": {
        "SBOX_LOG_PATH": "D:\\Steam\\steamapps\\common\\sbox\\logs\\sbox-dev.log",
        "SBOX_BRIDGE_IPC_DIR": "C:\\Users\\jared\\AppData\\Local\\Temp\\sbox-bridge-ipc"
      }
    },
    "sbox-editor": {
      "type": "http",
      "url": "http://127.0.0.1:9090/sbox-mcp"
    },
    "cornerman-lm": {
      "command": "node",
      "args": [
        "C:\\Users\\jared\\Projects\\local-llm-mcp-server\\dist\\index.js"
      ]
    },
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_API_KEY}"
      }
    },
    "cavelux": {
      "command": "C:\\cavelux\\comms\\cavelux-mcp-launch.cmd",
      "args": [],
      "cwd": "C:\\Users\\jared\\Projects\\cavelux\\mcp",
      "env": {
        "CAVELUX_UPSTREAM_CONFIG": "C:\\cavelux\\comms\\cavelux-upstreams-lifepunch.json",
