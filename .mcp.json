{
  "mcpServers": {
    "sbox": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "sbox-mcp-server"]
    },
    "sbox-editor": {
      "type": "http",
      "url": "http://127.0.0.1:9090/sbox-mcp"
    },
    "sbox-native": {
      "type": "http",
      "url": "http://127.0.0.1:7269/mcp"
    },
    "excalidraw": {
      "type": "http",
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": { "Authorization": "Bearer ${EXCALIDRAW_API_KEY}" }
    }
  }
}
