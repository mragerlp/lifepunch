{
  "$schema": "https://opencode.ai/config.json",
  // Canon: lifepunch/docs/cvl/OPENCODE_HARNESS_ADOPTION_2026-07-14.md
  // Authority follows the model — cloud frontier implementer-eligible under relief;
  // CORNERMAN local = advisory-only. push/merge/tag denied; Bloodwave merge key.
  "instructions": [
    "CLAUDE.md",
    "ARCHI.md",
    "lifepunch/docs/cvl/TRIP_ADOPTION_2026-07-14.md",
    "lifepunch/docs/cvl/OPENCODE_HARNESS_ADOPTION_2026-07-14.md"
  ],
  "provider": {
    "cornerman": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CORNERMAN - LM Studio",
      "options": {
        "baseURL": "http://10.10.10.2:1234/v1",
        "apiKey": "{env:CORNERMAN_LM_API_KEY}"
      },
      "models": {
        "qwen2.5-coder-32b-instruct": {
          "name": "CORNERMAN - Qwen Coder 32B (daytime)"
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "CORNERMAN - Qwen 35B A3B (overnight)"
        },
        "qwen/qwen3.6-27b": {
          "name": "CORNERMAN - Qwen 27B Deep"
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git merge*": "deny",
      "git tag*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny"
    },
    "external_directory": "deny"
  }
}
